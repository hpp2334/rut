// RFC 0017 — strong cycles keep cells alive: every holder retains, so
// `a -> b -> a` never reaches refcount 0. Break back-pointers with a
// pointer field — `next: *Node` — the classic reason `*T` exists.

use core::{ make_ptr };
use ink::{ Logger };

class Node {                              // initializer covers `next`
    next: *Node = nil;                    // a pointer slot — recursive types
                                          // are legal (one word, nullable)
}

impl Node {
    fn new() -> Self { return Self {}; }  // explicit construction — no
                                          // implicit default
    fn link(mut self, other: *Node) {
        self.next = other;
    }
}

fn make_cycle() -> *Node {                  // a -> b -> a : strong cycle
    let a = make_ptr(Node.new());
    let b = make_ptr(Node.new());
    a.link(b);
    b.link(a);
    return a;
}

pub fn main() {
    let log = Logger.new("cycle");
    let head = make_cycle();
    log.info(f"head.next alive: {head.next != nil}");

    // The leak fix: hold `b` from `a` through Weak (RFC 0017 §1) so the
    // pair frees deterministically at scope end.
}
