use { Vec } from "std:collection";
// RFC 0007 — literals & inference. Construction is a TYPE-CALL
// (`Vec<f32>.zeroed(1024)`).
// Arrays `[a, b, c]` are shared heap cells (`Array<T>`, non-growable);
// growables are `Vec<T>`. Both implement `Iter` (RFC 0012), so `a[i]`,
// `a.len()` and `for (x of a)` lower through the same contract. The
// `Iter<Target = T>` object form is a follow-up.

use { Logger } from "std:log";

struct Point { x: f32; y: f32 }

fn literals(name: str) {
    let log = Logger.new("literals");
    let a = 10;                      // i32 (default)
    let b = 10u8;                    // u8 via suffix
    let c: u64 = 10;                 // u64 via annotation — fits the default
    let big = 18446744073709551615u64; // past the `i32` default: suffix REQUIRED
    // let bad = 13503953896175478587; // ERROR —exceeds `i32`, add `u64`
    let cast = 300 as u8;            // 44 — `as` truncates, C/Rust semantics
    let d = 1.5;                     // f32 (default)
    let e = 1.5f32;                  // f32 via suffix
    let d64: f64 = 1.5;              // f64 via annotation
    let s = "hi\tname";              // plain string: escapes processed
    let raw = r"C:\temp\log.txt";    // raw literal: NO escape processing
    let t = f"hi {name}!";           // format literal (§4.1)
    let ch = "h";                    // 1-codepoint str (`char` is gone)
    let mut arr = [1, 2, 3];         // Array<i32> — heap cell
    let mut zero: Vec<f32> = Vec<f32>.zeroed(1024);    // growable, zeroed, flat
    let grow = Vec<i32>.from([1, 2, 3]);  // array -> growable (copies elements)
    arr[0] = 7;                      // static sequence write (fused arrset)
    zero[0] = 9.0f32;                // through the Vec
    let bin = bytes(64);             // binary data: bytes
    let p = Point { x: 1, y: 2 };    // struct literal: no `new`

    log.info(f"a={a} e={e} d64={d64} ch={ch} p.x={p.x} zero[0]={zero[0]} len={grow.len()}");
}

pub fn main() {
    literals("rut");
}
