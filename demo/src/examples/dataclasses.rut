// RFC 0009 — structs: open data records (v1.1 spells the keyword
// `struct`; this classic predates the rename). Copy-by-value (RFC 0016
// §1): every binding owns its own cell — assignment deep-copies, and
// mutations never leak between bindings. All fields public. Methods
// and impl blocks ARE allowed (see traits.rut for impls); here the
// idiom stays data + free functions. Constructed ONLY by literal,
// everywhere (module-level let initializers included).

import { Logger } from "std:log";
import { sqrt } from "std:math";

struct Point {
    x: f32;
    y: f32;
}

struct Rect {
    min: Point;                 // value fields: the record owns them
    max: Point;                 // (RFC 0016 §1) — copies are deep
}

struct Style {
    color: u32 = 0xff00ff;      // field initializer: literals may omit it
    width: f32 = 1;
}

fn nudge(pt: *Point) -> unit {     // pointer param: mutation is shared —
    pt.x += 1;                     // writes through hit the caller's Point
}

fn nudged(pt: Point) -> Point {    // value param: the caller keeps its own
    return Point { x: pt.x + 1, y: pt.y };  // copy — build a NEW one instead
}

fn length(pt: Point) -> f64 {     // free function instead of a method
    return sqrt((pt.x * pt.x + pt.y * pt.y) as f64);
}

fn dataclasses() -> unit {
    let log = Logger.new("dataclasses");
    let mut p = Point { x: 1, y: 2 };   // literal — the only construction
    p.x = 3;                            // needs the `mut` binding (RFC 0003 §1)
    let q = p;                          // COPY: q owns a deep copy of p
    p.x = 4;                            // q.x is still 3 — value semantics

    // pointers share, explicitly (RFC 0005): `make_ptr` boxes the value
    // and writes through the pointer hit every holder of the box
    let rp = make_ptr(p);                 // rp: *Point — shares p's cell
    rp.x = 9;                             // p.x is now 9 too

    // `==` on values is STRUCTURAL, field by field (RFC 0012 §4):
    // two separately-built records with equal fields ARE equal
    let same_fields = q == Point { x: 3, y: 2 };   // true — equal contents
    let diverged = q == p;                    // false — the copy diverged

    let r = Rect { min: p, max: q };    // min and max are p's and q's COPIES
    let s = Style {};              // zero-value defaults fill the fields
    nudge(make_ptr(p));            // shared write: p.x += 1 for real
    nudged(p);                     // value param: builds a new Point, p kept
    log.info(f"len={length(p)} color={s.color} area={r.max.x - r.min.x}");
    log.info(f"same={same_fields} diverged={diverged} rp.x={rp.x}");
}

pub fn main() -> unit {
    dataclasses();
}
