// RFC 0009 §"Representation" — recursive values. A record may name itself
// through a POINTER field: `*Node` is one word, `nil` when absent (RFC
// 0005). A binary tree is the canonical recursive shape.

use { make_ptr } from "std:core";
use { Logger } from "std:log";
struct Node {
    value: i32,
    left: *Node,
    right: *Node,
}

fn make(depth: i32, v: i32) -> Node {
    if (depth <= 0) {
        return Node { value: v, left: nil, right: nil };
    }
    return Node {
        value: v,
        left: make_ptr(make(depth - 1, v * 2)),
        right: make_ptr(make(depth - 1, v * 2 + 1)),
    };
}

fn count(n: *Node) -> i32 {
    let mut c = 1;
    if (n.left != nil) { c += count(n.left); }
    if (n.right != nil) { c += count(n.right); }
    return c;
}

pub fn main() {
    let log = Logger.new("tree");
    let root = make_ptr(make(3, 1));
    log.info(f"nodes={count(root)}");
}
