// str views — text as data (RFC 0042). `s.slice(from, to)` is an O(1)
// VIEW: no octets move or copy; the view cell records a window over the
// parent (`from`/`to` are codepoint indices) and there is no separate
// view type on the surface — a slice of a `str` IS a `str`: it prints,
// compares by content, iterates, and `len()` counts its own codepoints.
// Codepoints, not bytes: `char` is gone (RFC 0004 v1.1) — `s.code()`
// reads the FIRST codepoint as a `u32` and `str.from_code(n)` builds the
// 1-codepoint str back. Slicing a view flattens onto the root, so views
// never chain.

use ink::{ Logger };

pub fn main() {
    let log = Logger.new("views");

    // the O(1) window: the 1 MiB-buffer parse shape at toy scale
    let line = "hello world, rut here";
    let word = line.slice(6, 11);            // "world" — no copy
    let want = "world";
    log.info(f"word={word} len={word.len()} eq={word == want}");

    // a view IS a str: iterate it, slice it again (flattens to the root)
    let mut n = 0;
    for (let c of word) { n += 1; }
    log.info(f"iterated={n} reslice={word.slice(1, 3)}");

    // codepoints vs bytes: the accented string has 6 codepoints, 7 octets
    let accented = "héllo!";
    log.info(f"chars={accented.len()} octets={accented.encode().len()}");
    log.info(f"accent={accented.slice(1, 2)}");

    // the codepoint surface: read the first codepoint, build one back
    let first = accented.code();
    let same = str.from_code(first);
    log.info(f"code={first} back={same} round={same == accented.slice(0, 1)}");
}
