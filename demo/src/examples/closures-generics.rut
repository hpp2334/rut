use pouch::{ Vec };
// RFC 0013 — functions, anonymous closures, generics (monomorphized at
// compile time; each instantiation emits its own typed opcodes).

use ink::{ Logger };

fn first<T>(xs: [T], fallback: T) -> T {   // builtin container: `T` infers
    if (xs.len() == 0) {                  // from the argument's element
        return fallback;                  // type (RFC 0013 §2)
    }
    return xs[0];
}

fn sum(xs: Vec<i32>) -> i32 {             // a generic CLASS (Vec<T>) in a
    let mut total = 0;                    // signature does not unify yet —
    for (let x of xs) {                   // concrete Vec<i32> is fine
        total += x;
    }
    return total;
}

pub fn main() {
    let log = Logger.new("closures");
    let add = fn (a: i32, b: i32) -> i32 { return a + b; };   // anonymous fn
    let area_of = fn (r: f32) -> f32 {                        // block body
        let sq = r * r;
        return sq * 3.14159265f32;
    };
    log.info(f"add={add(1, 2)} area={area_of(1)} sum={sum(Vec<i32>.from([1, 2, 3]))}");

    let head = first([10, 20], -1);       // first<i32>   — monomorphized
    let name = first(["a", "b"], "?");    // first<str>   — separate instance
    log.info(f"head={head} name={name}");
}
