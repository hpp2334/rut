// RFC 0017 §1 — the cache/observer shape Weak<T> exists for. Weak itself
// A cache lookup that finds nothing answers `nil` — the pointer's null
// (RFC 0005) — and a hit answers a pointer that shares the cache's cell.

use { make_ptr } from "std:core";
use { Vec } from "std:collection";
use { Logger } from "std:log";

class Tile {
    n: i32;

    fn new(n: i32) -> Self {
        return Self { n: n };
    }

    fn id(self) -> i32 { return self.n; }
}

// the cache's whole job today: hold entries, evict on demand.
// The hit returns a pointer that shares the cache's element.
fn evict(cache: *Vec<*Tile>, id: i32) -> *Tile {
    for (let i = 0; i < cache.len(); i += 1) {
        if (cache[i].id() == id) {
            return cache[i];
        }
    }
    return nil;
}

pub fn main() {
    let log = Logger.new("weak");
    let cache: Vec<*Tile> = Vec.new();

    let alive = Tile.new(1);
    cache.push(make_ptr(alive));   // the cache now keeps the cell alive too
    let got = evict(make_ptr(cache), 1);
    log.info(f"held: {got != nil} id={got.id()}");
    // `alive` is still a strong handle: dropping the cache entry later
    // would NOT free the cell — that coupling is what Weak<T> breaks
    // (RFC 0017 M5: `let w = Weak(alive); .. w.upgrade().is_some()`)

    // and a lookup that finds nothing is just None — no trap
    let miss = evict(make_ptr(cache), 99);
    log.info(f"miss: {miss != nil}");
}
