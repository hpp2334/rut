// RFC 0010 — classes: sealed VALUE records, class-method construction.
// Classes construct through their OWN class methods — Rect.new(3, 4),
// Counter.new(), Version.parse("1.2"); no `constructor` keyword, no
// type-calls. A class method is just a function without a `self`
// receiver; it builds the instance with the class-private `Self { .. }`
// literal. Instance methods spell `self` explicitly; a method
// without `self` is a class method — no separate "static" form.
// Type bodies are FIELDS ONLY (RFC 0012); every method lives in the
// type's inherent `impl` block. Members follow RFC 0003 §2 visibility:
// unannotated = module-private, `pub` (optionally scoped: `pub(mod)`,
// `pub(super)`, `pub(self)`) exposes them.

use core::{ panic };
use ink::{ Logger };

class Counter {
    n: i32 = 0;             // field initializer — module-private
}

impl Counter {
    pub fn new() -> Self {                 // the construction surface — a
        return Self { };               // class method (no self); free to
    }                                   // run logic. `new` is a convention,
                                        // not syntax (RFC 0002 §4)

    pub fn press(mut self) {         // instance method: explicit receiver,
        self.n = self.n.wrapping_add(1);                // wrapping add (§8) — or `+=` to trap
    }

    pub fn count(self) -> i32 { return self.n; }  // plain method; no get/set syntax
}

class Rect {
    w: f32;
    h: f32;
}

impl Rect {
    pub fn new(w: f32, h: f32) -> Self {     // construction VALIDATES — it's
        if (w <= 0 || h <= 0) {        // just a function
            panic("Rect: negative extents");
        }
        return Self { w: w, h: h }; // must initialize fieldless-initialized
    }

    pub fn from_square(s: f32) -> Self {     // named constructors are siblings:
        return Rect.new(s, s);         // any no-self method returning Self
    }

    pub fn area(self) -> f32 { return self.w * self.h; }
}

// Try-construction: a class method returning a pointer — nil on failure.
class Version {
    major: i32;
    minor: i32;
}

impl Version {
    pub fn parse(s: str) -> ?Version {
        // ... split "1.2" — on failure:
        return nil;                        // nil = the validation failed
    }

    pub fn label(self) -> str { return f"{self.major}.{self.minor}"; }
}

fn classes() {
    let log = Logger.new("classes");
    let c = Counter.new();         // class method -> construction
    c.press();
    c.press();
    let r = Rect.new(3, 4);
    let v = Version.parse("1.2");  // ?Version — nil on failure
    log.info(f"count={c.count()} area={r.area()}");
    // let bad = Rect.new(3);       // ERROR: arity — the class's construction
                                     // contract is whatever its methods say
    // Rect { w: 1, h: 1 };         // ERROR: classes have no outside literal
}

pub fn main() {
    classes();
}
