import { Vec } from "std:collection";
// HTTP fetch — sequential awaits with `?` propagation, Result at the API
// boundary, Task-free simple flow. Future<Result<T,E>> everywhere.

import { HttpError, get } from "std:http";
import { Logger } from "std:log";

suspend fn fetch_all(urls: Vec<string>) -> Result<Vec<bytes>, HttpError> {
    let bodies: Vec<bytes> = Vec.new();
    for (let u of urls) {
        let body = await get(u)?;      // await + propagate in one expression
        bodies.push(body);
    }
    return Result.ok(bodies);
}

pub suspend fn main() -> unit {
    let log = Logger.new("http");
    let r = await fetch_all(["https://example.com", "https://example.org"]);
    if (r.is_ok()) {
        log.info(f"fetched {r.value.len()} pages");
    } else {
        log.error(f"failed: {r.error}");   // enum renders its member name
    }
}
