// RFC 0011 — reference semantics + own + Weak + Disposal.
// Every non-primitive is a shared refcounted cell (RFC 0016 §1):
// assignment/passing ALIASE — mutation is visible through every handle.
// own(x) is the eager shallow copy (fresh cell, handle fields shared).
// Weak(x) demotes a handle to a non-keeping ref (RFC 0017). Classes
// implementing `Disposal` run dispose at rc 0 — no wrapping needed.

import { Logger } from "std:log";

class Circle {
    private r: f32;

    constructor(r: f32): Self {
        return Self { r: r };
    }

    fn grow(mut self): void { self.r += 1; }
    fn radius(self): f32 { return self.r; }
}

class TempFile implements Disposal {
    private path: string;

    constructor(path: string): Self {    // plain Self — the handle IS ownership
        return Self { path: path };
    }

    fn write(self, data: Vec<u8>): void { /* ... */ }

    fn dispose(mut self): void {      // Disposal impl — runs once, at rc 0
        fs.remove(self.path);
    }
}

fn aliasing(): void {
    let log = Logger("cells");
    let a = Circle(3);             // a value — which is a shared cell
    let b = a;                     // ALIAS: same cell, no copy
    b.grow();                      // visible through a too
    let c = own(a);                // private copy: new cell, new identity
    c.grow();                      // touches only c
    log.info(f"a={a.radius()} b={b.radius()} c={c.radius()}");  // 4 4 5
    log.info(f"a==b {a == b} a==c {a == c}");                   // true false
}

fn scratch(): void {
    let f = TempFile("tmp.dat");   // constructor returns Self
    f.write(Vec<u8>(64));
}   // last handle drops HERE: rc hits 0, Disposal.dispose runs,
    // then `path` is released — deterministic destruction (RFC 0016 §3)

export fn main(): void {
    aliasing();
    scratch();
}
