// RFC 0010 — classes: sealed VALUE records, class-method construction.
// Classes construct through their OWN class methods — Rect.new(3, 4),
// Counter.new(), Version.parse("1.2"); no `constructor` keyword, no
// type-calls. A class method is just a function without a `self`
// receiver; it builds the instance with the class-private `Self { .. }`
// literal. Instance methods spell `self` explicitly; a method
// without `self` is a class method — no separate "static" form.

import { Logger } from "std:log";

class Counter {
    private n: i32 = 0;             // field initializer

    fn new() -> Self {                    // the construction surface — a
        return Self { };               // class method (no self); free to
    }                                   // run logic. `new` is a convention,
                                        // not syntax (RFC 0002 §4)

    fn press(mut self) -> unit {           // instance method: explicit receiver,
        self.n &+= 1;                // wrapping add (§8) — or `+=` to trap
    }

    fn count(self) -> i32 { return self.n; }   // plain method; no get/set syntax
}

class Rect {
    private w: f32;
    private h: f32;

    fn new(w: f32, h: f32) -> Self {     // construction VALIDATES — it's
        if (w <= 0 || h <= 0) {        // just a function
            panic("Rect: negative extents");
        }
        return Self { w: w, h: h }; // must initialize fieldless-initialized
    }

    fn from_square(s: f32) -> Self {     // named constructors are siblings:
        return Rect.new(s, s);         // any no-self method returning Self
    }

    fn area(self) -> f32 { return self.w * self.h; }
}

/** Try-construction: a class method returning Option<Self>. */
class Version {
    private major: i32;
    private minor: i32;

    private fn of(major: i32, minor: i32) -> Self {  // trusts its caller —
        return Self { major: major, minor: minor }; // private: seals the class
    }

    fn parse(s: string) -> Option<Version> {    // the public validating door:
        // ... split "1.2" — on failure:      // a class method over the
        return Option.none();                 // private class method
    }

    fn label(self) -> string { return f"{self.major}.{self.minor}"; }
}

fn classes() -> unit {
    let log = Logger.new("classes");
    let c = Counter.new();         // class method -> construction
    c.press();
    c.press();
    let r = Rect.new(3, 4);
    let v = Version.parse("1.2");  // Option<Version> — try-construction
    log.info(f"count={c.count()} area={r.area()}");
    // let bad = Rect.new(3);       // ERROR: arity — the class's construction
                                     // contract is whatever its methods say
    // Rect { w: 1, h: 1 };         // ERROR: classes have no outside literal
}

export fn main() -> unit {
    classes();
}
