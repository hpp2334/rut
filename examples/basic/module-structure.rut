// RFC 0003 §1 — module scope is DECLARATIONS ONLY (C++-style):
// no top-level statements, no load-time code, const initializers must be
// const-expressions.

import { sleep } from "std:time";

const MAX_RETRIES: i32 = 3;                    // const-expression
const TILES: Vec<f32> = Vec<f32>(16);       // zeroed, const size
const ORIGIN: Point = Point { x: 0, y: 0 };    // dataclass literal of consts

enum Mode { Idle, Running }

dataclass Point { x: f32; y: f32 }

interface Service { fn start(self): void; }

class App implements Service {
    private started: bool = false;
    // default factory: App()

    fn start(self): void {
        self.started = true;
    }
}

fn run(m: Mode): void { /* ... */ }           // logic lives in functions

export fn main(): void {                      // entry point — the host calls it
    run(Mode.Running);
    const app = App();
    app.start();
}
