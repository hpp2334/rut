// RFC 0003 §1 — module scope is DECLARATIONS ONLY (C++-style):
// no top-level statements, no load-time code, module let initializers must be
// load-time expressions.

import { sleep } from "std:time";

let MAX_RETRIES: i32 = 3;                    // load-time expression
let TILES: Vec<f32> = Vec<f32>(16);       // zeroed, let size
let ORIGIN: Point = Point { x: 0, y: 0 };    // dataclass literal of consts

enum Mode { Idle, Running }

dataclass Point { x: f32; y: f32 }

trait Service { fn start(mut self): void; }

class App {
    private started: bool = false;
    // no class methods -> sealed: constructible only inside its own body
}

impl Service for App {
    fn start(mut self): void {
        self.started = true;
    }
}

fn run(m: Mode): void { /* ... */ }           // logic lives in functions

export fn main(): void {                      // entry point — the host calls it
    run(Mode.Running);
    let app = App();
    app.start();
}
