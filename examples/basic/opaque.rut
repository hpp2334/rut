// RFC 0014 — Opaque: explicit type erasure with checked recovery.
// Opaque(v) forgets the static type, KEEPS the runtime type; downcast<T>
// recovers it or yields None. The only any-shaped value in rut — and it
// can do nothing until recovered.

import { Logger } from "std:log";

dataclass Point { x: f32; y: f32 }
enum Flavor { Sweet, Sour }

class Session {
    private token: string;

    factory(token: string): Self {
        return Self { token: token };
    }
}

fn erase_and_recover(): void {
    const log = Logger("opaque");
    const box1 = Opaque(Point { x: 1, y: 2 });    // snapshot of a value
    const box2 = Opaque(Flavor.Sour);
    const box3 = Opaque("hello");

    const p = downcast<Point>(box1);              // Option<Point>
    if (p.is_some()) {
        log.info(f"point {p.value.x} {p.value.y}");
    }
    const wrong = downcast<i32>(box2);            // wrong type: None, no trap
    log.info(f"sour? {downcast<Flavor>(box2).is_some()} wrong? {wrong.is_some()}");
    log.info(f"is string: {is<string>(box3)}");   // is<T> sees through
}

fn share_vs_snapshot(): void {
    const log = Logger("opaque");
    const s = Session("abc");
    const snap = Opaque(s);          // VALUE semantics: the box holds a COPY
    const shared = Opaque(Rc(s));    // box the HANDLE: shared identity

    log.info(f"recovered Rc: {downcast<Rc<Session>>(shared).is_some()}");
    log.info(f"recovered bare: {downcast<Session>(snap).is_some()}");
}

export fn main(): void {
    erase_and_recover();
    share_vs_snapshot();
}
