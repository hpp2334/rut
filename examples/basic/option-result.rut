// RFC 0005 — Option<T> / Result<T,E> are builtin VM-native types.
// Methods are snake_case; no ?. / ?? sugar — check, then read `.value`.

import { Logger } from "std:log";

enum IoError { NotFound, Permission, Busy }

fn find(xs: Vec<string>, key: string): Option<i32> {
    for (let i = 0; i < xs.len(); i += 1) {
        if (xs[i] == key) {
            return Option.some(i);
        }
    }
    return Option.none();
}

fn demo(list: Vec<string>): void {
    let log = Logger.new("option");
    let idx = find(list, "beta");
    if (idx.is_some()) {
        log.info(f"{idx.value}");       // `.value` traps on None — check first
    }
    let v = idx.unwrap_or(0);         // Option<T>.unwrap_or(default: T): T
}

fn read_config(path: string): Result<Vec<u8>, IoError> {
    let raw = fs.read(path)?;         // `?` propagates Err upward
    return Result.ok(raw);
}

export fn main(): void {
    let log = Logger.new("option");
    demo(["alpha", "beta"]);

    let r = read_config("app.cfg");
    if (r.is_ok()) {
        log.info(f"read {r.value.len()} bytes");
    } else {
        log.info(f"error: {r.error}");  // enum renders its member name
    }
}
