// RFC 0012 §3 — type tests are the `is` KEYWORD:
// `expr is Type` at relational precedence, NON-associative. The RHS is a
// naming position (like implements/requires): bare interface name or
// instantiation, or a concrete type — never `dyn`-prefixed. Concrete RHS:
// exact-class check (single descriptor lookup). Interface RHS: the
// CAPABILITY probe — does the value's exact type implement it (RFC 0015
// §6 is_a scan). Grants nothing: no narrowing, no widening. `x is Any` is
// a compile error (vacuous naming). No `as`, no upcast, no downcast
// builtin for interface values; erasure/recovery is Opaque(v)/downcast<T>.

import { Canvas, newCanvas } from "app:gfx";
import { Logger } from "std:log";

interface Drawable {
    fn draw(self, g: Canvas): void;
}

interface HitTest {
    fn hit_test(self, x: f32, y: f32): bool;
}

class Sprite implements Drawable, HitTest {
    private x: f32 = 0;
    private y: f32 = 0;
    // default constructor: Sprite()

    fn draw(self, g: Canvas): void { g.circle(self.x, self.y, 1); }
    fn hit_test(self, px: f32, py: f32): bool {
        return px == self.x && py == self.y;
    }
}

class Circle implements Drawable {
    private x: f32 = 0;
    private y: f32 = 0;
    private r: f32 = 1;

    constructor(x: f32, y: f32, r: f32): Self {
        return Self { x: x, y: y, r: r };
    }

    fn draw(self, g: Canvas): void { g.circle(self.x, self.y, self.r); }
}

fn type_tests(d: dyn Drawable, s: Sprite, g: Canvas): void {
    let log = Logger("types");
    if (d is Circle) {               // runtime test — exact-class check
        d.draw(g);                   // no downcast exists; stay on the
    }                                // interface

    // widening to `dyn I` is implicit — the explicit form is the `dyn`
    // annotation at the receiving position, not a builtin:
    let d2: dyn Drawable = s;      // boxes implicitly (RFC 0011 §3)
    let views: Vec<dyn Drawable> = Vec.from([s, d2]);
    let ht: dyn HitTest = s;

    // the CAPABILITY probe — interface RHS, real runtime scan of the
    // value's exact-type descriptor (Sprite implements HitTest):
    if (d is HitTest) {              // true iff d's exact class implements
        log.info("drawable is also hittable");   // HitTest
    }

    // statically-answered probes fold at typecheck (with a lint):
    let known = s is Drawable;       // folds true — Sprite's exact type
    log.info(f"{views.len()} {ht.hit_test(0, 0)} {known}");   // is known

    // `s is Any` does NOT compile — Any may not be named in any list
    // position (implements Any / T requires Any / is Any — all errors).
}

export fn main(): void {
    type_tests(Circle(1, 2, 3), Sprite(), newCanvas());
}
