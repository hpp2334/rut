// RFC 0012 §3 — type tests are the `is` KEYWORD:
// `expr is Type` at relational precedence, NON-associative. The RHS is a
// naming position (like impl heads/requires): bare trait name or
// instantiation, or a concrete type — never `dyn`-prefixed. Concrete RHS:
// exact-class check (single descriptor lookup). Trait RHS: the
// CAPABILITY probe — does the value's exact type have an impl for it (RFC 0015
// §6 is_a scan). Grants nothing: no narrowing, no widening. `x is Any` is
// a compile error (vacuous naming). No `as`, no upcast, no downcast
// builtin for trait objects; erasure/recovery is Opaque.new(v)/downcast<T>.

import { Canvas, newCanvas } from "app:gfx";
import { Logger } from "std:log";

trait Drawable {
    fn draw(self, g: Canvas) -> unit;
}

trait HitTest {
    fn hit_test(self, x: f32, y: f32) -> bool;
}

class Sprite {                  // inherent members only — the impls follow
    private x: f32 = 0;
    private y: f32 = 0;

    fn new() -> Self { return Self {}; }   // explicit — no implicit default
}

impl Drawable for Sprite {
    fn draw(self, g: Canvas) -> unit { g.circle(self.x, self.y, 1); }
}

impl HitTest for Sprite {
    fn hit_test(self, px: f32, py: f32) -> bool {
        return px == self.x && py == self.y;
    }
}

class Circle {
    private x: f32 = 0;
    private y: f32 = 0;
    private r: f32 = 1;

    fn new(x: f32, y: f32, r: f32) -> Self {
        return Self { x: x, y: y, r: r };
    }
}

impl Drawable for Circle {
    fn draw(self, g: Canvas) -> unit { g.circle(self.x, self.y, self.r); }
}

fn type_tests(d: dyn Drawable, s: Sprite, g: Canvas) -> unit {
    let log = Logger.new("types");
    if (d is Circle) {               // runtime test — exact-class check
        d.draw(g);                   // no downcast exists; stay on the
    }                                // trait object

    // widening to `dyn I` is implicit — the explicit form is the `dyn`
    // annotation at the receiving position, not a builtin:
    let d2: dyn Drawable = s;      // boxes implicitly (RFC 0011 §3)
    let views: Vec<dyn Drawable> = Vec.from([s, d2]);
    let ht: dyn HitTest = s;

    // the CAPABILITY probe — trait RHS, real runtime scan of the
    // value's exact-type descriptor (impl HitTest for Sprite exists):
    if (d is HitTest) {              // true iff d's exact class has an
        log.info("drawable is also hittable");   // impl for HitTest
    }

    // statically-answered probes fold at typecheck (with a lint):
    let known = s is Drawable;       // folds true — Sprite's exact type
    log.info(f"{views.len()} {ht.hit_test(0, 0)} {known}");   // is known

    // `s is Any` does NOT compile — Any may not be named in any list
    // position (impl Any / T requires Any / is Any — all errors).
}

export fn main() -> unit {
    type_tests(Circle.new(1, 2, 3), Sprite.new(), newCanvas());
}
