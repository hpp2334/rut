// RFC 0012 §3 — type tests are BUILTIN FUNCTIONS, not keywords:
// is<T>(x): bool, T CONCRETE only (interface type args are a compile
// error — dynamic dispatch is what `dyn I` refs are for). No `as`, no
// upcast builtin, no downcast, ever. Widening to `dyn I` is implicit;
// the `dyn` annotation at the receiving position is the explicit form.

import { Canvas, newCanvas } from "app:gfx";
import { Logger } from "std:log";

interface Drawable {
    fn draw(self, g: Canvas): void;
}

interface HitTest {
    fn hit_test(self, x: f32, y: f32): bool;
}

class Sprite implements Drawable, HitTest {
    private x: f32 = 0;
    private y: f32 = 0;
    // default factory: Sprite()

    fn draw(self, g: Canvas): void { g.circle(self.x, self.y, 1); }
    fn hit_test(self, px: f32, py: f32): bool {
        return px == self.x && py == self.y;
    }
}

class Circle implements Drawable {
    private x: f32 = 0;
    private y: f32 = 0;
    private r: f32 = 1;

    factory(x: f32, y: f32, r: f32): Self {
        return Self { x: x, y: y, r: r };
    }

    fn draw(self, g: Canvas): void { g.circle(self.x, self.y, self.r); }
}

fn type_tests(d: dyn Drawable, s: Sprite, g: Canvas): void {
    const log = Logger("types");
    if (is<Circle>(d)) {             // runtime test — exact class check
        d.draw(g);                   // no downcast exists; stay on the
    }                                // interface

    // widening to `dyn I` is implicit — the explicit form is the `dyn`
    // annotation at the receiving position, not a builtin:
    const d2: dyn Drawable = s;      // boxes implicitly (RFC 0011 §3)
    const views: Vec<dyn Drawable> = Vec.from([s, d2]);
    const ht: dyn HitTest = s;

    log.info(f"{views.length} {ht.hit_test(0, 0)}");
}

export fn main(): void {
    type_tests(Circle(1, 2, 3), Sprite(), newCanvas());
}
