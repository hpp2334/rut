// RFC 0002 §1 — grammar tour: dataclass, interface, class + factory,
// Rc<T>, vtable dispatch, exhaustive when, format literals.
//
// NOTE: rut has no compiler yet — these files are the design corpus the
// RFCs reference; they define the target syntax.

import { Canvas, newCanvas } from "app:gfx";
import { Logger } from "std:log";

enum Color { Red, Green, Blue }

dataclass Point {                          // VALUE type: copied on assignment
    x: f32;                                // NO methods on dataclasses —
    y: f32;                                // behavior is free functions
}

fn length(p: Point): f64 {
    return math.sqrt(f64(p.x * p.x + p.y * p.y));
}

interface Drawable {
    draw(g: Canvas): void;                 // interfaces declare METHODS only
}

class Circle implements Drawable {         // also a VALUE type; Rc<T> for refs
    private center: Point;                 // dataclass field stored INLINE
    private r: f32;

    factory(x: f32, y: f32, r: f32): Self {  // type-call: Circle(1, 2, 3)
        return Self { center: Point { x: x, y: y }, r: r };
    }

    move_by(dx: f32, dy: f32): void {      // all calls direct
        this.center.x += dx;
        this.center.y += dy;
    }

    draw(g: Canvas): void {
        g.circle(this.center.x, this.center.y, this.r);
    }

    area(): f32 { return this.r * this.r * 3.14159265f32; }
}

fn blit_all(g: Canvas, items: Array<Drawable>): void {
    for (const d of items) {               // interface-typed loop variable
        d.draw(g);                         // vtable dispatch
    }
}

fn color_name(c: Color): string {
    return when (c) {                      // exhaustive: all members covered
        Color.Red   -> "red",
        Color.Green -> "green",
        Color.Blue  -> "blue",
    };
}

export fn main(): void {
    const log = Logger("tour");
    let p = Point { x: 1, y: 2 };          // dataclass literal: the only
    p.x = 3;                               // dataclass construction form

    const c = Circle(1, 2, 3);             // class factory type-call
    const shared = Rc(c);                  // want shared/ref semantics? say so
    const g = newCanvas();
    blit_all(g, [shared]);                 // Rc<Circle> widens to Drawable
    log.info(f"{color_name(Color.Red)} area={c.area()} len={length(p)}");
}
