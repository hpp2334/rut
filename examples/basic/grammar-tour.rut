// RFC 0009–0012 — grammar tour: dataclass, interface, class + constructor,
// shared cells + `own`, vtable dispatch, exhaustive when, format literals.
//
// NOTE: rut has no compiler yet — these files are the design corpus the
// RFCs reference; they define the target syntax.

import { Canvas, newCanvas } from "app:gfx";
import { Logger } from "std:log";

enum Color { Red, Green, Blue }

dataclass Point {                          // shared cell: assignment aliases
    x: f32;                                // all fields public; methods and
    y: f32;                                // implements are allowed too
}                                          // (RFC 0009) — here: data only

fn length(p: Point): f64 {
    return math.sqrt(f64(p.x * p.x + p.y * p.y));
}

interface Drawable {
    fn draw(self, g: Canvas): void;             // interfaces declare METHODS only
}

class Circle implements Drawable {         // a shared cell like everything
    private center: Point;                 // composite field: cell-handle slot
    private r: f32;

    constructor(x: f32, y: f32, r: f32): Self {  // type-call: Circle(1, 2, 3)
        return Self { center: Point { x: x, y: y }, r: r };
    }

    fn move_by(mut self, dx: f32, dy: f32): void {   // all calls direct
        self.center.x += dx;
        self.center.y += dy;
    }

    fn draw(self, g: Canvas): void {
        g.circle(self.center.x, self.center.y, self.r);
    }

    fn area(self): f32 { return self.r * self.r * 3.14159265f32; }
}

fn blit_all(g: Canvas, items: Vec<dyn Drawable>): void {
    for (let d of items) {               // `dyn`-typed loop variable
        d.draw(g);                         // vtable dispatch
    }
}

fn color_name(c: Color): string {
    return when (c) {                      // exhaustive: all members covered
        Color.Red   -> "red",
        Color.Green -> "green",
        Color.Blue  -> "blue",
    };
}

export fn main(): void {
    let log = Logger("tour");
    let p = Point { x: 1, y: 2 };          // dataclass literal: the only
    let mut pt = p;                        // dataclass construction form
    pt.x = 3;                              // `mut` binding: writes the SHARED
                                           // cell — p.x is 3 now (RFC 0016 §1)

    let c = Circle(1, 2, 3);             // class constructor type-call
    let g = newCanvas();
    blit_all(g, Vec.from([c]));           // c widens to dyn Drawable:
                                           // vtable attach, same cell
    log.info(f"{color_name(Color.Red)} area={c.area()} len={length(pt)}");
}
