// RFC 0015 — layout & type-identity builtins.
// dataclass AND class payloads are repr C: fields in declaration order,
// natural C alignment, no hidden members. type_id<T>() / size_of<T>() /
// align_of<T>() are compile-time constants; Opaque mirrors them at
// runtime — the toolkit for layout-aware heterogeneous storage WITHOUT
// uncontrolled erasure.

import { Logger } from "std:log";

dataclass Point { x: f32; y: f32 }          // 8 bytes, align 4

dataclass Padded {                          // repr C does what C does:
    a: u8;                                  //   offset 0, pad 3
    b: u32;                                 //   offset 4
    c: u8;                                  //   offset 8, tail pad 3
}                                           // size_of = 12, align_of = 4

class Vertex {                              // classes: SAME layout rule
    private x: f32;
    private y: f32;

    fn new(x: f32, y: f32): Self {
        return Self { x: x, y: y };
    }
}

let TID_POINT: u32 = type_id<Point>();    // load-time expressions (§1.1) —
let SZ_PADDED: u32 = size_of<Padded>();   // folded at compile time,
let AL_PADDED: u32 = align_of<Padded>();  // never executed

fn layout(): void {
    let log = Logger.new("layout");
    log.info(f"point tid={TID_POINT} size={size_of<Point>()} align={align_of<Point>()}");
    log.info(f"padded size={SZ_PADDED} align={AL_PADDED}");    // 12 / 4
    log.info(f"vertex size={size_of<Vertex>()}");              // 8 — same as Point
    log.info(f"own-clone size: {size_of<Point>()}");      // what own() memcpy's
    log.info(f"array payload: {size_of<Array<i32, 8>>()}");// 32 — flat primitive
}                                                        // buffer (RFC 0016 §4)

fn boxed_layout(): void {
    let log = Logger.new("layout");
    let box1 = Opaque.new(Point { x: 1, y: 2 });
    let box2 = Opaque.new(Vertex.new(3, 4));

    // Layout accessors without downcasting — group/slab first,
    // pay a checked downcast only when actually recovering the value.
    log.info(f"box1 tid==Point: {box1.type_id() == TID_POINT}");
    log.info(f"box2 size: {box2.size()}");                     // 8
    log.info(f"box1 bytes: {box1.as_bytes().len()}");          // 8-byte payload snapshot

    // Payload snapshots are Vec<u8> — NOT ==-comparable (Vec implements
    // nothing; RFC 0012 §4). Identity of boxes is cell identity:
    let fresh = Opaque.new(Point { x: 1, y: 2 });
    log.info(f"boxes distinct: {box1 == fresh}");              // false
    log.info(f"same type: {box1.type_id() == fresh.type_id()}"); // true — group by tid
}

export fn main(): void {
    layout();
    boxed_layout();
}
