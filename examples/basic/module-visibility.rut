// RFC 0003 §2 — pub visibility levels (D-style):
//   pub          — public: importable from anywhere (host, other packages)
//   pub(mod)     — visible everywhere inside this package's module tree
//   pub(super)   — visible to the parent module only
//   pub(self)    — module-private (the DEFAULT for unannotated decls)
//
// The same forms apply to class members (RFC 0010 §2): an unannotated
// field or method is module-private; `pub` (+ scopes) exposes it.
// Dataclass members are always public — no visibility dial (RFC 0009).
//
// Imagine this file at ui/panels.rut in package "app": the parent module is
// ui/, and the package root is app/. Module specifiers: RFC 0003 OQ-2.

let INTERNAL_MAGIC: i32 = 7;            // default = pub(self): file-private

pub(self) fn helper() -> i32 {           // explicit form of the default
    return INTERNAL_MAGIC;
}

pub(super) fn panel_internal() -> unit { // callable from ui/* only
    helper();
}

pub(mod) fn app_wide() -> i32 {          // callable from anywhere in "app"
    return helper() * 2;
}

pub fn panels() -> i32 {                 // public API — importable anywhere
    return app_wide() + helper();
}

// Members carry visibility too (RFC 0010 §2) — the construction surface
// is `pub`, the internals stay module-private.
class Registry {
    entries: i32 = 0;                    // unannotated = module-private

    pub fn new() -> Self {               // construction surface (RFC 0010)
        return Self { };
    }

    fn bump(mut self) -> unit {          // module-private helper
        self.entries &+= 1;
    }

    pub fn count(self) -> i32 {          // exposed to importers
        return self.entries;
    }

    pub(mod) fn reset(mut self) -> unit { // package-visible
        self.entries = 0;
    }
}

pub fn registry_smoke() -> i32 {
    let r = Registry.new();
    return r.count();
}
