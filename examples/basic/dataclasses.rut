// RFC 0009 — dataclasses: open VALUE records.
// Copied on assignment/passing/return. All fields public. Methods and
// `implements` ARE allowed (see interfaces.rut for impls); here the
// idiom stays data + free functions. Constructed ONLY by literal,
// everywhere (module-module let initializers included).

import { Logger } from "std:log";

dataclass Point {
    x: f32;
    y: f32;
}

dataclass Rect {
    min: Point;                 // nesting: inline, not a pointer
    max: Point;
}

dataclass Style {
    color: u32 = 0xff00ff;      // field initializer: literals may omit it
    width: f32 = 1;
}

fn nudge(mut pt: Point): Point { // pass-by-value: parameter is a copy;
    pt.x += 1;                  // `mut` param: mutating mutates the COPY only
    return pt;                  // return-by-value: copy out
}

fn length(pt: Point): f64 {     // free function instead of a method
    return math.sqrt(f64(pt.x * pt.x + pt.y * pt.y));
}

fn dataclasses(): void {
    let log = Logger("dataclasses");
    let p = Point { x: 1, y: 2 };    // literal — the only construction
    p.x = 3;                         // mutable through `let`
    let q = p;                     // COPY: q is an independent value
    p.x = 4;                         // q.x is still 3

    let r = Rect { min: p, max: q };   // nested values copied inline
    let s = Style {};              // initializers satisfy all fields
    let p2 = nudge(p);             // p itself is untouched
    log.info(f"len={length(p2)} color={s.color} area={r.max.x - r.min.x}");
}

export fn main(): void {
    dataclasses();
}
