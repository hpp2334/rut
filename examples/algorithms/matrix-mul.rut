// Flat f32 matrix multiply — Array<f32> is a flat unboxed buffer; this is
// the loop shape the typed-VM design targets (no per-element refcounts).

import { Logger } from "std:log";

fn gemm(n: i32, a: Array<f32>, b: Array<f32>, out: Array<f32>): void {
    for (let i = 0; i < n; i += 1) {
        for (let k = 0; k < n; k += 1) {
            const aik = a[i * n + k];
            for (let j = 0; j < n; j += 1) {
                out[i * n + j] += aik * b[k * n + j];
            }
        }
    }
}

export fn main(): void {
    const log = Logger("matrix");
    const n = 4;
    const a = Array<f32>(n * n);
    const b = Array<f32>(n * n);
    const out = Array<f32>(n * n);
    for (let i = 0; i < n * n; i += 1) {
        a[i] = f32(i);
        b[i] = f32(i % 7);
    }
    gemm(n, a, b, out);
    log.info(f"out[0]={out[0]} out[last]={out[n * n - 1]}");
}
