// Sieve of Eratosthenes — Vec<T>/bytes unboxed storage, no boxing.

import { Logger } from "std:log";

fn sieve(limit: i32): Vec<i32> {
    let marks = bytes(limit + 1);       // zeroed: 0 = candidate, 1 = crossed
    let primes: Vec<i32> = Vec();       // empty growable: Vec(), not []
    for (let i = 2; i <= limit; i += 1) {
        if (marks[i] == 0) {
            primes.push(i);
            let m = i * i;
            while (m <= limit) {
                marks[m] = 1;
                m += i;
            }
        }
    }
    return primes;
}

export fn main(): void {
    let log = Logger("sieve");
    let primes = sieve(100);
    let last = primes[primes.len() - 1];
    log.info(f"{primes.len()} primes up to 100, last={last}");
}
