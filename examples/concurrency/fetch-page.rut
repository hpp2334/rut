// RFC 0018 §3 — the compiler splits the body at each `await` into
// states; locals live across suspensions in the coroutine frame's
// register file (a heap object). See the RFC for the lowered pseudo-
// bytecode of THIS function.

import { HttpError, get } from "std:http";
import { Logger } from "std:log";

suspend fn fetch_page(url: string) -> Result<bytes, HttpError> {
    let raw = await get(url)?;       // await + `?` propagate in one expr
    let html = decode(raw)?;         // stays in the resumed state
    return Result.ok(html);
}

fn decode(raw: bytes) -> Result<bytes, HttpError> {
    return Result.ok(raw);             // placeholder
}

pub suspend fn main() -> unit {
    let log = Logger.new("fetch");
    let page = await fetch_page("https://example.com");
    if (page.is_ok()) {
        log.info(f"{bytes_len(page.value)} bytes");
    }
}
