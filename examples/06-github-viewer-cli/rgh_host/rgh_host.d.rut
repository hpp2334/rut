// rgh_host/rgh_host.d.rut — 06-github-viewer-cli's own host rows (the
// CLI I/O the brain cannot reach): two writers and one file write. The
// HTTP rows are NOT here — rgh rides the std lane (`rut/http_host` +
// `rut/http`, bodies in rut-std); a host pkg is example-local only when
// the surface is example-local (RFC 0023 §2).
//
// One naming disclosure: the stdout row is `out`, not `print` — `print`
// is a REMOVED core name whose use sites diagnose by symbol
// (rut-core/src/binary.rs REMOVED_CORE + the lir's own sym::PRINT arm),
// so a bare `print(..)` call can never compile. `out` is the same
// crossing under an honest name.
//
// The `write_file` answer is a `?str` in spirit — nil is success, the
// text is the io error — but the crossing set (RFC 0023 §1) refuses
// `?T` at a decl, so it spells the host-decl-only `any` lane and the
// host answers the caller's static V (the `?str` dst reads the text;
// the `http_err` precedent at rut/http_host).

/// one line to stdout (the host appends the newline and flushes)
pub host fn out(s: str);

/// one line to stderr (the host appends the newline and flushes)
pub host fn eprint(s: str);

/// write `data` over `path` — the answer reads as `?str` at the call:
/// nil = written, the text = the io error
pub host fn write_file(path: str, data: bytes) -> any;
