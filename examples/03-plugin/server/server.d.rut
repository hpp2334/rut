// server/server.d.rut — the host bus surface of 03-plugin: registration by NAME (callbacks cannot cross the boundary as
// values) — `subscribe` hands the host a rut export name
// per topic; `emit` reaches every subscriber of a topic, re-entering
// rut (nested `vm.call`) to render the wire line.

pub host fn subscribe(bus: opaque, topic: str, handler: str);

pub host fn emit(bus: opaque, topic: str, payload: str);
