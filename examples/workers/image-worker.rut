// workers/image-worker.rut — a whole separate VM on its own thread and
// heap; its trap cannot hurt the main VM. Entry args arrive as the
// transferred channel endpoints from image-pipeline.rut.

import { Receiver, Sender } from "std:channel";
import { decode, fetch, Image, Job } from "imaging";

suspend fn main(jobs: Receiver<Job>, out: Sender<Image>): void {
    while (true) {
        const job = await jobs.recv();   // Future<Option<Job>>
        if (job.is_none()) {
            break;                       // all senders gone: exit
        }
        out.send(decode(fetch(job.value.url)));
    }
}   // `out` dropped -> the main side's channel closes
