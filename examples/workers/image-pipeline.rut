// RFC 0021 — workers are separate VM isolates; data crosses typed
// channels; buffers transfer zero-copy when uniquely owned (rc == 1).

import { blit } from "app:gfx";
import { channel, Receiver } from "std:channel";
import { Image, Job } from "imaging";

pub suspend fn main() -> unit {
    let urls = ["a.png", "b.png", "c.png", "d.png"];
    let ports: Vec<Receiver<Image>> = Vec();

    for (let i = 0; i < urls.len(); i += 1) {
        let jobs = Channel<Job>();     // main -> worker (MPSC)
        let imgs = Channel<Image>();   // worker -> main
        spawn_worker("workers/image-worker.rut", [jobs.receiver, imgs.sender]);
        jobs.sender.send(Job { url: urls[i] });
        ports.push(imgs.receiver);
    }

    let left = urls.len();
    while (left > 0) {
        let img = await select_all(ports);   // first decoded wins
        blit(img);
        left -= 1;
    }
}   // senders dropped -> recv() resolves None -> each worker exits
