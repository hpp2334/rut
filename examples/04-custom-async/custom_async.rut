// custom_async.rut — a user-written launcher over the closed `Future`
// class (04-custom-async), in the Future-only vocabulary.
//
// The surface, v20: `Future<T>` is a CLOSED builtin class — engine-
// minted only (an `async fn` call, an `async { }` block, `sleep`, the
// race/completer mints); a user type cannot BE a future, and the cx is
// INJECTED into every async body (never a spelled parameter). What a
// user module CAN re-spell is the launcher tier: the engine's standard
// set (`launch_future` / `LaunchedFutureHandle` / `sleep`) is ordinary
// code over the same `Future` surface, and this file is the proof —
// `launch_custom` plus the stats this example exists to show: one
// audit counter per launch and cancellation, the cancellation probe
// read as data INSIDE the async body (`cx.cancelled()`), and the
// resume state read at each checkpoint (`cx.checkpoint()`).
//
// The shape, in one paragraph: the producers are `async { }` blocks and
// `async fn`s — the engine mints their frames, the driving loop owns
// every launched future, and `launch_custom` only supplies the DRIVING
// and the audit, exactly the division the standard `launch_future`
// keeps. The receipt is the user-space twin of
// `LaunchedFutureHandle`: not a Future, not re-launchable, one member
// (the cancel edge).

// ---------------------------------------------------------------- audit --

// The module-owned record every stat lands in. FIELDS ONLY —
// the counters live in the inherent impl block below. The launcher takes
// `?AuditLog`, so the embedder holds one cell and reads the whole run's
// story out of it afterwards.

struct AuditLog {
    launches: u32;      // futures this log saw started
    yields: u32;        // resumptions driven — one per checkpoint
    cancels: u32;       // cancellation probes that answered true
    checkpoints: u32;   // high-water mark of the context ledger
    finished: u32;      // runs that walked every step they booked
}

impl AuditLog {
    fn new() -> Self {
        return Self { launches: 0, yields: 0, cancels: 0, checkpoints: 0, finished: 0 };
    }

    fn note_launch(mut self) {
        self.launches += 1;
    }

    /// One resumption driven; `at` is the ledger position it ran at.
    fn note_yield(mut self, at: u32) {
        self.yields += 1;
        if (at > self.checkpoints) {
            self.checkpoints = at;      // the ledger's high-water mark
        }
    }

    fn note_cancel(mut self) {
        self.cancels += 1;
    }

    fn note_finish(mut self) {
        self.finished += 1;
    }

    /// The one-line audit the embedder prints after a run.
    fn summary(self) -> str {
        let mut out = f"audit: {self.launches} launches, {self.yields} yields";
        out = f"{out}, {self.cancels} cancels, peak ckpt {self.checkpoints}";
        return out;
    }
}

// ------------------------------------------------------------ producers --

// The async BLOCK is the primitive: one expression form that mints the
// frame where it stands (the mint is pure — legal in sync code), its
// `return` answering the FUTURE, its reads capturing the enclosing
// locals by value. Every producer answers the ONE closed class:
// `Future<nil>` here.
//
// Inside an async body the weave INJECTS the resume context as `cx`
// (an async fn's parameters are ordinary values — a spelled `cx` is
// gone). The frozen cx protocol reads as data: `checkpoint()` answers
// this frame's resume state, `cancelled()` the task's abort flag —
// cancellation is DATA the frame reads, not an exception it catches.

use core::{ Future };
use async_host::{ sleep };

/// A staged producer as an async block: `steps` checkpoints, each
/// parking one tick, the audit counting every resumption off the
/// frame's own ledger (`cx.checkpoint()`).
fn staged(steps: u32, log: ?AuditLog) -> Future<nil> {
    return async {
        let mut i = 0;
        while (i < steps) {
            await sleep(10);
            i += 1;
            // the ledger view: this frame's resume state, read as data
            let at = cx.checkpoint();
            if (log != nil) {
                log.note_yield(at);
            }
        }
        if (log != nil) {
            log.note_finish();
        }
    };
}

/// A cancellable producer: the cancellation probe is the frame's OWN
/// checkpoint read — a cancelled frame stops advancing and runs its
/// drop path (the audit sees "died here, did not advance").
fn cancellable(log: ?AuditLog) -> Future<nil> {
    return async {
        while (true) {
            if (cx.cancelled()) {
                if (log != nil) {
                    log.note_cancel();
                }
                return;
            }
            await sleep(20);
        }
    };
}

// ---------------------------------------------------------------- launch --

// The launched receipt — the user-space twin of the engine standard
// set's `LaunchedFutureHandle` (the async_host package): the future and
// the shared audit cell it was launched with. The receipt is NOT a
// Future (it cannot be awaited), not re-launchable (a type error, never
// a runtime check), one member: the cancel edge.

use async_engine::{ __abort, __launch };

struct CustomLaunched {
    task: ?Future<nil>;  // the cell reference — the driven frame
    log: ?AuditLog;      // shared with the embedder — the stats survive
    alive: bool;         // false once the audit saw the run end
}

impl CustomLaunched {
    fn new(t: ?Future<nil>, log: ?AuditLog) -> Self {
        return Self { task: t, log: log, alive: true };
    }

    /// The cancellation edge: flag the task, let the loop's re-drive
    /// run the probe. `alive` flips off locally so the audit never
    /// counts a second cancel on one receipt.
    fn cancel(mut self) -> bool {
        if (!self.alive) {
            return false;
        }
        self.alive = false;
        let t = self.task;
        if (t == nil) {
            return false;
        }
        let log = self.log;
        if (log != nil) {
            log.note_cancel();
        }
        return __abort(opaque(t));
    }
}

/// The user launcher. A launcher supplies only the DRIVING and the
/// audit — the same division the standard `launch_future` keeps, over
/// the same `Future` surface, so the producer never knows which one
/// started it.
fn launch_custom(f: Future<nil>, log: ?AuditLog) -> CustomLaunched {
    __launch(opaque(f));
    log.note_launch();
    return CustomLaunched { task: f, log: log, alive: true };
}
