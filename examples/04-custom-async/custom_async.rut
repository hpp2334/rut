// custom_async.rut — a user-implemented future and a user-written
// launcher (04-custom-async), in the Future-only vocabulary (RFC 0018).
//
// The async plan LANDED: `async fn(cx: RunContext, ..)` compiles into
// the engine-woven `impl Future<T>` for its hidden frame, the driving
// loop owns every launched future, and the standard launcher set
// (`launch_future` / `LaunchedFutureHandle` / `sleep`) is the embedder's
// host surface (the `async_engine` + `async_host` packages). This file
// remains the user-impl-of-builtin-trait test: `Future<T>` is an
// engine-named builtin trait, and `impl Future<nil> for CustomFuture`
// registers through the ordinary nominal path — builtin traits are
// engine-NAMED, not engine-CLOSED (RFC 0012 §7). A user future is
// LAUNCHER-DRIVABLE (the driving loop finds its `Future::yield` row in
// the vtable); v1 `await` targets engine-woven futures only (async-fn
// results and `sleep`), and join lands with RFC 0019.
//
// The shape, in one paragraph: `CustomFuture` is a hand-written stage
// machine — the same shape the `async fn` weave emits for a hidden
// frame, spelled out in source. `impl Future<nil> for CustomFuture`
// is the resumption surface the driving loop drives, one `yield` per
// checkpoint, the cx carrying the frame edge. `launch_custom` is a USER
// launcher over that same Future surface — the ruling-8 law: the
// engine's standard set is ordinary code any module may re-spell — plus
// the stats this example exists to show: one audit counter per
// resumption, the cancellation probe read as data, and a completion
// audit over the shared `AuditLog` cell.

// ---------------------------------------------------------------- audit --

// The module-owned record every stat lands in. FIELDS ONLY (RFC 0012) —
// the counters live in the inherent impl block below. The launcher takes
// `?AuditLog`, so the embedder holds one cell and reads the whole run's
// story out of it afterwards.

struct AuditLog {
    launches: u32;      // futures this log saw started
    yields: u32;        // resumptions driven — one per checkpoint
    cancels: u32;       // cancellation probes that answered true
    checkpoints: u32;   // high-water mark of the context ledger
    finished: u32;      // runs that walked every step they booked
}

impl AuditLog {
    fn new() -> Self {
        return Self { launches: 0, yields: 0, cancels: 0, checkpoints: 0, finished: 0 };
    }

    fn note_launch(mut self) {
        self.launches += 1;
    }

    /// One resumption driven; `at` is the ledger position it ran at.
    fn note_yield(mut self, at: u32) {
        self.yields += 1;
        if (at > self.checkpoints) {
            self.checkpoints = at;      // the ledger's high-water mark
        }
    }

    fn note_cancel(mut self) {
        self.cancels += 1;
    }

    fn note_finish(mut self) {
        self.finished += 1;
    }

    /// The one-line audit the embedder prints after a run.
    fn summary(self) -> str {
        let mut out = f"audit: {self.launches} launches, {self.yields} yields";
        out = f"{out}, {self.cancels} cancels, peak ckpt {self.checkpoints}";
        return out;
    }
}

// -------------------------------------------------------------- machine --

// The hand-written machine — what the `async fn` weave emits for a
// hidden frame, spelled out: a stage counter, an audit label, the
// payload the stages carry, and the done flag. FIELDS ONLY (RFC 0012) —
// the stage logic lives in the inherent impl block below.

struct CustomFuture {
    steps: u32;      // checkpoints booked before the run finishes
    stage: str;      // what the current stage does (the audit's label)
    done: bool;      // the last stage ran
}

impl CustomFuture {
    fn new(steps: u32, stage: str) -> Self {
        return Self { steps: steps, stage: stage, done: false };
    }

    /// One stage of work — what one resumption advances. `false` when
    /// no stages are left: the runner's completion signal.
    fn advance(mut self) -> bool {
        if (self.done) {
            return false;
        }
        if (self.steps == 0) {
            self.done = true;
            return false;
        }
        self.steps -= 1;
        return true;
    }

    /// The audit label of the current stage.
    fn label(self) -> str {
        return self.stage;
    }
}

// ----------------------------------------------------- the trait surface --

// The nominal registration (RFC 0012): one impl block, one `(trait,
// type)` pair, duplicates are a link error. The trait is `builtin` —
// the engine weaves it for every `async fn`'s hidden frame, invisibly;
// a hand-written machine registers through the same registry and rides
// the same drive law.
//
// The resumption entry the driving loop drives — once per checkpoint,
// with the cx whose one field is the frame edge. The receiver IS the
// frame (the machine's fields are its state, RFC 0018); the context is
// the only handle a resumption needs. Inside, the frozen cx protocol
// reads as data: `checkpoint` answers this frame's resume state,
// `cancelled` answers the task's abort flag — cancellation is DATA the
// frame reads, not an exception it catches (RFC 0018).
impl Future<nil> for CustomFuture {
    fn yield(self, cx: RunContext) {
        // the ledger view: the frame's resume state, read as data
        let at = cx.checkpoint();
        // the cancellation probe: a cancelled frame stops advancing —
        // the audit sees it as "died here, did not advance" — and runs
        // its drop path instead of the next stage
        if (cx.cancelled()) {
            self.done = true;
            self.stage = f"{self.stage}@{at}:cancelled";
        }
    }
}

// ---------------------------------------------------------------- launch --

// The launched receipt — the user-space twin of the engine standard
// set's `LaunchedFutureHandle` (the async_host package): the
// future-typed stage machine and the shared audit cell it was launched
// with. The receipt is NOT a Future (it cannot be awaited), not
// re-launchable (ruling 6: a type error, never a runtime check), one
// member: the cancel edge.

use async_engine::{ __abort, __launch };

struct CustomLaunched {
    task: ?Future<nil>;  // the cell reference (RFC 0044) — the driven frame
    log: ?AuditLog;      // shared with the embedder — the stats survive
    alive: bool;         // false once the audit saw the run end
}

impl CustomLaunched {
    fn new(t: ?Future<nil>, log: ?AuditLog) -> Self {
        return Self { task: t, log: log, alive: true };
    }

    /// The cancellation edge: flag the task, let the loop's re-drive
    /// run the probe. `alive` flips off locally so the audit never
    /// counts a second cancel on one receipt.
    fn cancel(mut self) -> bool {
        if (!self.alive) {
            return false;
        }
        self.alive = false;
        let t = self.task;
        if (t == nil) {
            return false;
        }
        let log = self.log;
        if (log != nil) {
            log.note_cancel();
        }
        return __abort(opaque(t));
    }
}

/// The user launcher. The future registers nothing new here — its impl
/// block already did; a launcher only supplies the DRIVING and the
/// audit. This is the same division the engine standard set's
/// `launch_future` keeps (ruling 8), over the same `Future` surface, so
/// the machine never knows which one started it.
fn launch_custom(f: Future<nil>, log: ?AuditLog) -> CustomLaunched {
    __launch(opaque(f));
    log.note_launch();
    return CustomLaunched { task: f, log: log, alive: true };
}

/// The audit drive — the runnable twin of the engine loop's columns
/// (RFC 0035 §4). The engine drives the TRAIT surface (the vtable's
/// `Future::yield`, the cx minted per drive); this walks the machine's
/// own stages, one `advance` per booked checkpoint, and counts every
/// resumption the audit would see. The shape is the drive law either
/// way: run a stage, count it, stop on completion.
fn audit_drive(m: CustomFuture, l: CustomLaunched) -> bool {
    let mut driven: u32 = 0;
    while (m.advance()) {
        driven += 1;
        l.log.note_yield(driven);
    }
    l.log.note_finish();
    return m.done;      // true: every booked stage ran — a clean finish
}
