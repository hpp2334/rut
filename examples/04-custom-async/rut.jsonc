{
  // 04-custom-async — a PARSE-ONLY example: no runnable harness yet (the
  // disclosed follow-up). The manifest exists for the shape law — every
  // rut program the repo carries is a module dir with a `rut.jsonc` — and
  // the parser conformance suite is the gate that keeps the entry
  // parseable; the program itself is not runnable today.
  // The deps rows are honesty: the entry imports `async_host`
  // (`__abort`/`__launch`) AND `futures` (`sleep`), so the manifest
  // names both — `core` stays off the list (engine-ambient). A run
  // resolves the rows and mounts the pkgs; binding the launcher rows
  // (and running) rides in with the harness. There is no other lane
  // here to declare in: nothing walks or parses this dir yet, so the
  // manifest text is the example's only declaration surface.
  "name": "custom_async",
    "deps": {
    "async_host": {
      "path": "../../rut/async_host"
    },
    "futures": {
      "path": "../../rut/futures"
    }
  }
}
