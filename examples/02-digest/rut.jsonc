{
  // 02-digest — the app is a module dir, like every rut program: the
  // manifest carries the deps, and the embedder (`src/main.rs`,
  // `tests/session.rs`) loads this dir through the manifest lane
  // (`load_dir_session_with`) — same host half, new mount lane.
  //
  // THE CDN ROWS: pouch, json and nmapset ship as COMMITTED source
  // zips (dist/std-v17/<pkg>.zip, jsDelivr-served at the tag, pinned in
  // rut.lock — the pin is law at the mount door on every load).
  // All three are GENERIC owners: this consumer spells `Vec<opaque>`
  // and drives json's writer directly through its
  // own `encode` member (json's interface observes it structurally),
  // and
  // the shapes monomorphize from the bundles at the link. The embedder names
  // its remote policy (Loader + HttpRemote::project_local) — a cold start
  // networks on its misses, a warm start is pure cache; the TESTS prime
  // an offline remote from the committed artifacts (dist/std plays the
  // wire), so the gates never touch the network. json's container
  // wrappers are json's OWN source, and its `[deps]` pull
  // strbuild/pouch/nmapset along (the bundle is closed), so the `nmapset`
  // row here is redundant-but-legal — an unused declared row is inert,
  // and the app spells no `use nmapset::` head.
  // json's own `[deps]` pulls strbuild (the writer's accumulator), so the
  // embedder pairs the load with `strbuild::pkg()` — and nmapset's bundle
  // carries `nmap_host`, whose bodies bind beside it (the tests do;
  // exactly ink + `logger::pkg`).
  "name": "digests",
    "deps": {
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v17/dist/std/pouch.zip" },
    "json": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v17/dist/std/json.zip" },
    "nmapset": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v17/dist/std/nmapset.zip" }
  }
}
