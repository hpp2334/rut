        10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635,
        14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208,
        500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939,
        2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356,
        5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127,
    ]);
    return k;
}

/// SHA-512 pads to 112 mod 128 and appends a 128-bit big-endian length
/// (the high 64 bits are zero for any input this side of 2 EiB).
fn sha512_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    m.push(0x80);
    while (m.len() % 128 != 112) { m.push(0); }
    let bits = u64(bytes_len(msg)) * 8;
    for (let i = 0; i < 8; i += 1) { m.push(0); }
    m.push(u8((bits >> 56) & 0xFF));
    m.push(u8((bits >> 48) & 0xFF));
    m.push(u8((bits >> 40) & 0xFF));
    m.push(u8((bits >> 32) & 0xFF));
    m.push(u8((bits >> 24) & 0xFF));
    m.push(u8((bits >> 16) & 0xFF));
    m.push(u8((bits >> 8) & 0xFF));
    m.push(u8(bits & 0xFF));
    let h = sha512_h();
    let k = sha512_k();
    let mut st: Vec<u64> = Vec.new();
    for (let i = 0; i < 8; i += 1) { st.push(h[i]); }
    let blocks = m.len() / 128;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u64> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 128 + j * 8;
            let mut word: u64 = 0;
            for (let t = 0; t < 8; t += 1) {
                word = (word << 8) | u64(m[o + t]);
            }
            w.push(word);
        }
        for (let i = 16; i < 80; i += 1) {
            let s0 = rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7);
            let s1 = rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6);
            w.push(Math.wrapping_add(Math.wrapping_add(Math.wrapping_add(w[i - 16], s0), w[i - 7]), s1));
        }
        let mut a = st[0];
        let mut b = st[1];
        let mut c = st[2];
        let mut d = st[3];
        let mut e = st[4];
        let mut f = st[5];
        let mut g = st[6];
        let mut hh = st[7];
        for (let i = 0; i < 80; i += 1) {
            let big1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
            let ch = (e & f) ^ ((e ^ 18446744073709551615) & g);
            let t1 = Math.wrapping_add(Math.wrapping_add(hh, big1), Math.wrapping_add(ch, Math.wrapping_add(k[i], w[i])));
            let big0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = Math.wrapping_add(big0, maj);
            hh = g;
            g = f;
            f = e;
            e = Math.wrapping_add(d, t1);
            d = c;
            c = b;
            b = a;
            a = Math.wrapping_add(t1, t2);
        }
        st[0] = Math.wrapping_add(st[0], a);
        st[1] = Math.wrapping_add(st[1], b);
        st[2] = Math.wrapping_add(st[2], c);
        st[3] = Math.wrapping_add(st[3], d);
        st[4] = Math.wrapping_add(st[4], e);
        st[5] = Math.wrapping_add(st[5], f);
        st[6] = Math.wrapping_add(st[6], g);
        st[7] = Math.wrapping_add(st[7], hh);
    }
    let mut out: Vec<u8> = Vec.new();
    for (let j = 0; j < 8; j += 1) {
        out.push(u8((st[j] >> 56) & 0xFF));
        out.push(u8((st[j] >> 48) & 0xFF));
        out.push(u8((st[j] >> 40) & 0xFF));
        out.push(u8((st[j] >> 32) & 0xFF));
        out.push(u8((st[j] >> 24) & 0xFF));
        out.push(u8((st[j] >> 16) & 0xFF));
        out.push(u8((st[j] >> 8) & 0xFF));
        out.push(u8(st[j] & 0xFF));
    }
    return out.freeze();
}

entry fn md5(data: bytes) -> bytes { return md5_impl(data); }
entry fn sha1(data: bytes) -> bytes { return sha1_impl(data); }
entry fn sha256(data: bytes) -> bytes { return sha256_impl(data); }
entry fn sha512(data: bytes) -> bytes { return sha512_impl(data); }

/// One name, one call — the 01-sort dispatcher pattern on strings.
entry fn digest(algo: str, data: bytes) -> Result<bytes, str> {
    return when (algo) {
        "md5"    -> Result.ok(md5_impl(data)),
        "sha1"   -> Result.ok(sha1_impl(data)),
        "sha256" -> Result.ok(sha256_impl(data)),
        "sha512" -> Result.ok(sha512_impl(data)),
        else     -> Result.err(f"unknown algorithm: {algo}"),
    };
}

// ---------------------------------------------------------------- JSON ---
//
// RFC 0006: enums carry no data, and recursive dataclasses are not
// expressible — so the tree is a tagged union by hand (JTag + Json),
// with children boxed in `Opaque` (RFC 0014) to break the recursion:
// `Json` contains `Vec<Opaque>`, each Opaque boxes another `Json`.

enum JTag { Null, False, True, Num, Str, Arr, Obj }

dataclass Json {
    tag:  JTag;
    num: str;          // verbatim lexeme — exact round-trips, no
    str: str;          // float formatting anywhere in this file
    arr:  Vec<Opaque>;
    keys: Vec<str>;
    vals: Vec<Opaque>;
}

fn noopaques() -> Vec<Opaque> {
    let v: Vec<Opaque> = Vec.new();
    return v;
}
fn nostrings() -> Vec<str> {
    let v: Vec<str> = Vec.new();
    return v;
}

fn jnull() -> Json { return Json { tag: JTag.Null, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jbool(b: bool) -> Json {
    if (b) { return Json { tag: JTag.True, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
    return Json { tag: JTag.False, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() };
}
fn jnum(n: str) -> Json { return Json { tag: JTag.Num, num: n, str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jstr(s: str) -> Json { return Json { tag: JTag.Str, num: "", str: s, arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jarr() -> Json { return Json { tag: JTag.Arr, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jobj() -> Json { return Json { tag: JTag.Obj, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }

/// The parser cursor. Strings iterate as `char`s, so the source is
/// split once into single-char strings and walked by index.
dataclass Cur { cs: Vec<str>; pos: i32; depth: i32; }

fn split_chars(s: str) -> Vec<str> {
    let cs: Vec<str> = Vec.new();
    for (let c of s) { cs.push(f"{c}"); }
    return cs;
}

fn jpeek(cur: Cur) -> str {
    if (cur.pos < cur.cs.len()) { return cur.cs[cur.pos]; }
    return "";
}

fn jskip(mut cur: Cur) -> unit {
    let mut again = true;
    while (again) {
        let c = jpeek(cur);
        again = c == " " || c == "\t" || c == "\n" || c == "\r";
        if (again) { cur.pos = cur.pos + 1; }
    }
}

fn is_digit(c: str) -> bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

fn join_chars(cs: Vec<str>) -> str {
    let mut out = "";
    for (let i = 0; i < cs.len(); i += 1) {
        out = f"{out}{cs[i]}";
    }
    return out;
}

/// JSON number grammar: -?int (.int)? ([eE][+-]?int)? — validated as a
/// lexeme, stored verbatim.
fn valid_number(cs: Vec<str>) -> bool {
    let n = cs.len();
    if (n == 0) { return false; }
    let mut i = 0;
    if (cs[0] == "-") { i = 1; }
    let mut intd = 0;
    while (i < n && is_digit(cs[i])) { i = i + 1; intd = intd + 1; }
    if (intd == 0) { return false; }
    if (i < n && cs[i] == ".") {
        i = i + 1;
        let mut fracd = 0;
        while (i < n && is_digit(cs[i])) { i = i + 1; fracd = fracd + 1; }
        if (fracd == 0) { return false; }
    }
    if (i < n && (cs[i] == "e" || cs[i] == "E")) {
        i = i + 1;
        if (i < n && (cs[i] == "+" || cs[i] == "-")) { i = i + 1; }
        let mut exd = 0;
        while (i < n && is_digit(cs[i])) { i = i + 1; exd = exd + 1; }
        if (exd == 0) { return false; }
    }
    return i == n;
}

fn jparse_value(mut cur: Cur) -> Result<Opaque, str> {
    jskip(cur);
    let c = jpeek(cur);
    if (c == "") { return Result.err("json: unexpected end of input"); }
    if (c == "n") { return jparse_lit(cur, "null", jnull()); }
    if (c == "t") { return jparse_lit(cur, "true", jbool(true)); }
    if (c == "f") { return jparse_lit(cur, "false", jbool(false)); }
    if (c == "\"") { return jparse_string(cur); }
    if (c == "-" || is_digit(c)) { return jparse_number(cur); }
    if (c == "[") { return jparse_array(cur); }
    if (c == "{") { return jparse_object(cur); }
    return Result.err(f"json: unexpected `{c}` at index {cur.pos}");
}

fn jparse_lit(mut cur: Cur, word: str, v: Json) -> Result<Opaque, str> {
    let start = cur.pos;
    let mut ok = true;
    for (let wch of word) {
        if (jpeek(cur) != f"{wch}") { ok = false; }
        cur.pos = cur.pos + 1;
    }
    if (ok == false) {
        return Result.err(f"json: bad literal at index {start}");
    }
    return Result.ok(Opaque.new(v));
}

fn jparse_string(mut cur: Cur) -> Result<Opaque, str> {
    let start = cur.pos;
    cur.pos = cur.pos + 1;   // opening quote
    let out: Vec<str> = Vec.new();
    let mut closed = false;
    let mut open = true;
    while (open && cur.pos < cur.cs.len()) {
        let c = cur.cs[cur.pos];
        cur.pos = cur.pos + 1;
        if (c == "\"") {
            closed = true;
            open = false;
        } else if (c == "\\") {
            if (cur.pos >= cur.cs.len()) {
                return Result.err(f"json: unterminated escape at index {cur.pos}");
            }
            let e = cur.cs[cur.pos];
            cur.pos = cur.pos + 1;
            if (e == "n") { out.push("\n"); }
            else if (e == "t") { out.push("\t"); }
            else if (e == "r") { out.push("\r"); }
            else if (e == "b") { out.push("\b"); }
            else if (e == "f") { out.push("\f"); }
            else if (e == "\"") { out.push("\""); }
            else if (e == "\\") { out.push("\\"); }
            else if (e == "/") { out.push("/"); }
            else if (e == "u") {
                return Result.err("json: \\u escapes are not supported in this build");
            } else {
                return Result.err(f"json: bad escape at index {cur.pos - 1}");
            }
        } else {
            out.push(c);
        }
    }
    if (closed == false) {
        return Result.err(f"json: unterminated string starting at index {start}");
    }
    return Result.ok(Opaque.new(jstr(join_chars(out))));
}

fn jparse_number(mut cur: Cur) -> Result<Opaque, str> {
    let start = cur.pos;
    let chars: Vec<str> = Vec.new();
    let mut again = true;
    while (again) {
        let c = jpeek(cur);
        again = is_digit(c) || c == "-" || c == "+" || c == "." || c == "e" || c == "E";
        if (again) {
            chars.push(c);
            cur.pos = cur.pos + 1;
        }
    }
    if (valid_number(chars) == false) {
        return Result.err(f"json: malformed number at index {start}");
    }
    return Result.ok(Opaque.new(jnum(join_chars(chars))));
}

fn jparse_array(mut cur: Cur) -> Result<Opaque, str> {
    cur.depth = cur.depth + 1;
    if (cur.depth > 64) {
        return Result.err("json: nesting deeper than 64");
    }
    cur.pos = cur.pos + 1;   // '['
    let v = jarr();
    jskip(cur);
    if (jpeek(cur) == "]") {
        cur.pos = cur.pos + 1;
        return Result.ok(Opaque.new(v));
    }
    let mut again = true;
    while (again) {
        let item = jparse_value(cur);
        if (item.is_err()) { return item; }
        let boxed = unwrap_box(item);
        v.arr.push(boxed);
        jskip(cur);
        let c = jpeek(cur);
        if (c == ",") {
            cur.pos = cur.pos + 1;
        } else if (c == "]") {
            cur.pos = cur.pos + 1;
            again = false;
        } else {
            return Result.err(f"json: expected `,` or `]` at index {cur.pos}");
        }
    }
    cur.depth = cur.depth - 1;
    return Result.ok(Opaque.new(v));
}

fn jparse_object(mut cur: Cur) -> Result<Opaque, str> {
    cur.depth = cur.depth + 1;
    if (cur.depth > 64) {
        return Result.err("json: nesting deeper than 64");
    }
    cur.pos = cur.pos + 1;   // '{'
    let v = jobj();
    jskip(cur);
    if (jpeek(cur) == "}") {
        cur.pos = cur.pos + 1;
        return Result.ok(Opaque.new(v));
    }
    let mut again = true;
    while (again) {
        jskip(cur);
        if (jpeek(cur) != "\"") {
            return Result.err(f"json: expected a key string at index {cur.pos}");
        }
        let key = jparse_string(cur);
        if (key.is_err()) { return key; }
        let kstr = downcast<Json>(unwrap_box(key)).value.str;
        jskip(cur);
        if (jpeek(cur) != ":") {
            return Result.err(f"json: expected `:` at index {cur.pos}");
        }
        cur.pos = cur.pos + 1;
        let val = jparse_value(cur);
        if (val.is_err()) { return val; }
        v.keys.push(kstr);
        v.vals.push(unwrap_box(val));
        jskip(cur);
        let c = jpeek(cur);
        if (c == ",") {
            cur.pos = cur.pos + 1;
        } else if (c == "}") {
            cur.pos = cur.pos + 1;
            again = false;
        } else {
            return Result.err(f"json: expected a comma or close-brace at index {cur.pos}");
        }
    }
    cur.depth = cur.depth - 1;
    return Result.ok(Opaque.new(v));
}

/// Unwrap a Result<Opaque, str> that is known-Ok (checked above);
/// the unwrap_or default is unreachable and exists only because there
/// is no `.unwrap()` in the surface.
fn unwrap_box(r: Result<Opaque, str>) -> Opaque {
    return r.unwrap_or(Opaque.new(jnull()));
}

/// Encode a tree back to compact JSON.
fn jencode(j: Json) -> str {
    let mut out = "";
    when (j.tag) {
        JTag.Null -> { out = "null"; },
        JTag.False -> { out = "false"; },
        JTag.True -> { out = "true"; },
        JTag.Num -> { out = j.num; },
        JTag.Str -> { out = jquote(j.str); },
        JTag.Arr -> {
            let mut s = "[";
            for (let i = 0; i < j.arr.len(); i += 1) {
                if (i > 0) { s = f"{s},"; }
                s = f"{s}{jencode(downcast<Json>(j.arr[i]).value)}";
            }
            out = f"{s}]";
        },
        JTag.Obj -> {
            let rb = "}";
            let mut s = "{";
            for (let i = 0; i < j.keys.len(); i += 1) {
                if (i > 0) { s = f"{s},"; }
                let vs = jencode(downcast<Json>(j.vals[i]).value);
                s = f"{s}{jquote(j.keys[i])}:{vs}";
            }
            out = f"{s}{rb}";
        },
    }
    return out;
}

/// Quote + minimally escape a JSON string body.
fn jquote(s: str) -> str {
    let q = "\"";
    let body: Vec<str> = Vec.new();
    for (let c of s) {
        if (c == '"') { body.push("\\\""); }
        else if (c == '\\') { body.push("\\\\"); }
        else if (c == '\n') { body.push("\\n"); }
        else if (c == '\r') { body.push("\\r"); }
        else if (c == '\t') { body.push("\\t"); }
        else if (c == '\b') { body.push("\\b"); }
        else if (c == '\f') { body.push("\\f"); }
        else { body.push(f"{c}"); }
    }
    return f"{q}{join_chars(body)}{q}";
}

entry fn json_dec(s: str) -> Result<Opaque, str> {
    let cur = Cur { cs: split_chars(s), pos: 0, depth: 0 };
    let v = jparse_value(cur);
    if (v.is_err()) { return v; }
    jskip(cur);
    if (cur.pos != cur.cs.len()) {
        return Result.err(f"json: trailing data at index {cur.pos}");
    }
    return v;
}

entry fn json_enc(o: Opaque) -> str {
    return jencode(downcast<Json>(o).value);
}

entry fn json_roundtrip(s: str) -> Result<str, str> {
    let v = json_dec(s);
    if (v.is_err()) {
        return Result.err(v.error);
    }
    return Result.ok(jencode(downcast<Json>(v.value).value));
}

/// A hand-built document for the embedder demo.
entry fn sample_doc() -> Opaque {
    let tags = jarr();
    tags.arr.push(Opaque.new(jstr("tiny")));
    tags.arr.push(Opaque.new(jstr("fast")));
    tags.arr.push(Opaque.new(jstr("verified")));
    let meta = jobj();
    meta.keys.push("ok");
    meta.vals.push(Opaque.new(jbool(true)));
    meta.keys.push("lines");
    meta.vals.push(Opaque.new(jnum("607")));
    let root = jobj();
    root.keys.push("name");
    root.vals.push(Opaque.new(jstr("rut")));
    root.keys.push("version");
    root.vals.push(Opaque.new(jnum("0.2")));
    root.keys.push("tags");
    root.vals.push(Opaque.new(tags));
    root.keys.push("meta");
    root.vals.push(Opaque.new(meta));
    return Opaque.new(root);
}

fn sha256_h() -> Vec<u32> {
    let h: Vec<u32> = Vec<u32>.from([
        1779033703, 3144134277, 1013904242, 2773480762,
        1359893119, 2600822924, 528734635, 1541459225,
    ]);
    return h;
}

fn sha512_h() -> Vec<u64> {
    let h: Vec<u64> = Vec<u64>.from([
        7640891576956012808, 13503953896175478587, 4354685564936845355, 11912009170470909681,
        5840696475078001361, 11170449401992604703, 2270897969802886507, 6620516959819538809,
    ]);
    return h;
}
