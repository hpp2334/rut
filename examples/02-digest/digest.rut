        16472876342353939154u64, 17275323862435702243u64, 1135362057144423861u64, 2597628984639134821u64,
        3308224258029322869u64, 5365058923640841347u64, 6679025012923562964u64, 8573033837759648693u64,
        10970295158949994411u64, 12119686244451234320u64, 12683024718118986047u64, 13788192230050041572u64,
        14330467153632333762u64, 15395433587784984357u64, 489312712824947311u64, 1452737877330783856u64,
        2861767655752347644u64, 3322285676063803686u64, 5560940570517711597u64, 5996557281743188959u64,
        7280758554555802590u64, 8532644243296465576u64, 9350256976987008742u64, 10552545826968843579u64,
        11727347734174303076u64, 12113106623233404929u64, 14000437183269869457u64, 14369950271660146224u64,
        15101387698204529176u64, 15463397548674623760u64, 17586052441742319658u64, 1182934255886127544u64,
        1847814050463011016u64, 2177327727835720531u64, 2830643537854262169u64, 3796741975233480872u64,
        4115178125766777443u64, 5681478168544905931u64, 6601373596472566643u64, 7507060721942968483u64,
        8399075790359081724u64, 8693463985226723168u64, 9568029438360202098u64, 10144078919501101548u64,
        10430055236837252648u64, 11840083180663258601u64, 13761210420658862357u64, 14299343276471374635u64,
        14566680578165727644u64, 15097957966210449927u64, 16922976911328602910u64, 17689382322260857208u64,
        500013540394364858u64, 748580250866718886u64, 1242879168328830382u64, 1977374033974150939u64,
        2944078676154940804u64, 3659926193048069267u64, 4368137639120453308u64, 4836135668995329356u64,
        5532061633213252278u64, 6448918945643986474u64, 6902733635092675308u64, 7801388544844847127u64,
    ]);
    return k;
}

/// SHA-512 pads to 112 mod 128 and appends a 128-bit big-endian length
/// (the high 64 bits are zero for any input this side of 2 EiB).
fn sha512_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    m.push(0x80);
    while (m.len() % 128 != 112) { m.push(0); }
    let bits = msg.len() as u64 * 8;
    for (let i = 0; i < 8; i += 1) { m.push(0); }
    m.push(((bits >> 56) & 0xFF) as u8);
    m.push(((bits >> 48) & 0xFF) as u8);
    m.push(((bits >> 40) & 0xFF) as u8);
    m.push(((bits >> 32) & 0xFF) as u8);
    m.push(((bits >> 24) & 0xFF) as u8);
    m.push(((bits >> 16) & 0xFF) as u8);
    m.push(((bits >> 8) & 0xFF) as u8);
    m.push((bits & 0xFF) as u8);
    let h = sha512_h();
    let k = sha512_k();
    let mut st: Vec<u64> = Vec.new();
    for (let i = 0; i < 8; i += 1) { st.push(h[i]); }
    let blocks = m.len() / 128;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u64> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 128 + j * 8;
            let mut word: u64 = 0;
            for (let t = 0; t < 8; t += 1) {
                word = (word << 8) | m[o + t] as u64;
            }
            w.push(word);
        }
        for (let i = 16; i < 80; i += 1) {
            let s0 = rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7);
            let s1 = rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6);
            w.push((((w[i - 16]).wrapping_add(s0)).wrapping_add(w[i - 7])).wrapping_add(s1));
        }
        let mut a = st[0];
        let mut b = st[1];
        let mut c = st[2];
        let mut d = st[3];
        let mut e = st[4];
        let mut f = st[5];
        let mut g = st[6];
        let mut hh = st[7];
        for (let i = 0; i < 80; i += 1) {
            let big1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
            let ch = (e & f) ^ ((e ^ 18446744073709551615u64) & g);
            let t1 = (hh.wrapping_add(big1)).wrapping_add(ch.wrapping_add((k[i]).wrapping_add(w[i])));
            let big0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = big0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        st[0] = (st[0]).wrapping_add(a);
        st[1] = (st[1]).wrapping_add(b);
        st[2] = (st[2]).wrapping_add(c);
        st[3] = (st[3]).wrapping_add(d);
        st[4] = (st[4]).wrapping_add(e);
        st[5] = (st[5]).wrapping_add(f);
        st[6] = (st[6]).wrapping_add(g);
        st[7] = (st[7]).wrapping_add(hh);
    }
    let mut out: Vec<u8> = Vec.new();
    for (let j = 0; j < 8; j += 1) {
        out.push(((st[j] >> 56) & 0xFF) as u8);
        out.push(((st[j] >> 48) & 0xFF) as u8);
        out.push(((st[j] >> 40) & 0xFF) as u8);
        out.push(((st[j] >> 32) & 0xFF) as u8);
        out.push(((st[j] >> 24) & 0xFF) as u8);
        out.push(((st[j] >> 16) & 0xFF) as u8);
        out.push(((st[j] >> 8) & 0xFF) as u8);
        out.push((st[j] & 0xFF) as u8);
    }
    return out.freeze();
}

entry fn md5(data: bytes) -> bytes { return md5_impl(data); }
entry fn sha1(data: bytes) -> bytes { return sha1_impl(data); }
entry fn sha256(data: bytes) -> bytes { return sha256_impl(data); }
entry fn sha512(data: bytes) -> bytes { return sha512_impl(data); }

/// One name, one call — the 01-sort dispatcher pattern on strings.
entry fn digest(algo: str, data: bytes) -> (bytes, str) {
    return when (algo) {
        "md5"    -> (md5_impl(data), ""),
        "sha1"   -> (sha1_impl(data), ""),
        "sha256" -> (sha256_impl(data), ""),
        "sha512" -> (sha512_impl(data), ""),
        else     -> (bytes.zeroed(0), f"unknown algorithm: {algo}"),
    };
}

// ---------------------------------------------------------------- JSON ---
//
// RFC 0006: enums carry no data, and recursive dataclasses are not
// expressible — so the tree is a tagged union by hand (JTag + Json),
// with children boxed in `opaque` (RFC 0014) to break the recursion:
// `Json` contains `Vec<opaque>`, each opaque boxes another `Json`.

enum JTag { Null, False, True, Num, Str, Arr, Obj }

struct Json {
    tag:  JTag;
    num: str;          // verbatim lexeme — exact round-trips, no
    str: str;          // float formatting anywhere in this file
    arr:  Vec<opaque>;
    keys: Vec<str>;
    vals: Vec<opaque>;
}

fn noopaque() -> opaque { return opaque.new(0); }

fn noopaques() -> Vec<opaque> {
    let v: Vec<opaque> = Vec.new();
    return v;
}
fn nostrings() -> Vec<str> {
    let v: Vec<str> = Vec.new();
    return v;
}

fn jnull() -> Json { return Json { tag: JTag.Null, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jbool(b: bool) -> Json {
    if (b) { return Json { tag: JTag.True, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
    return Json { tag: JTag.False, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() };
}
fn jnum(n: str) -> Json { return Json { tag: JTag.Num, num: n, str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jstr(s: str) -> Json { return Json { tag: JTag.Str, num: "", str: s, arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jarr() -> Json { return Json { tag: JTag.Arr, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }
fn jobj() -> Json { return Json { tag: JTag.Obj, num: "", str: "", arr: noopaques(), keys: nostrings(), vals: noopaques() }; }

/// The parser cursor. Strings iterate as `char`s, so the source is
/// split once into single-char strings and walked by index.
struct Cur { cs: Vec<str>; pos: i32; depth: i32; }

fn split_chars(s: str) -> Vec<str> {
    let cs: Vec<str> = Vec.new();
    for (let c of s) { cs.push(f"{c}"); }
    return cs;
}

fn jpeek(cur: *Cur) -> str {
    if (cur.pos < cur.cs.len()) { return cur.cs[cur.pos]; }
    return "";
}

fn jskip(cur: *Cur) {
    let mut again = true;
    while (again) {
        let c = jpeek(cur);
        again = c == " " || c == "\t" || c == "\n" || c == "\r";
        if (again) { cur.pos = cur.pos + 1; }
    }
}

fn is_digit(c: str) -> bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

fn join_chars(cs: Vec<str>) -> str {
    let mut out = "";
    for (let i = 0; i < cs.len(); i += 1) {
        out = f"{out}{cs[i]}";
    }
    return out;
}

/// JSON number grammar: -?int (.int)? ([eE][+-]?int)? — validated as a
/// lexeme, stored verbatim.
fn valid_number(cs: Vec<str>) -> bool {
    let n = cs.len();
    if (n == 0) { return false; }
    let mut i = 0;
    if (cs[0] == "-") { i = 1; }
    let mut intd = 0;
    while (i < n && is_digit(cs[i])) { i = i + 1; intd = intd + 1; }
    if (intd == 0) { return false; }
    if (i < n && cs[i] == ".") {
        i = i + 1;
        let mut fracd = 0;
        while (i < n && is_digit(cs[i])) { i = i + 1; fracd = fracd + 1; }
        if (fracd == 0) { return false; }
    }
    if (i < n && (cs[i] == "e" || cs[i] == "E")) {
        i = i + 1;
        if (i < n && (cs[i] == "+" || cs[i] == "-")) { i = i + 1; }
        let mut exd = 0;
        while (i < n && is_digit(cs[i])) { i = i + 1; exd = exd + 1; }
        if (exd == 0) { return false; }
    }
    return i == n;
}

fn jparse_value(cur: *Cur) -> (opaque, str) {
    jskip(cur);
    let c = jpeek(cur);
    if (c == "") { return (noopaque(), "json: unexpected end of input"); }
    if (c == "n") { return jparse_lit(cur, "null", jnull()); }
    if (c == "t") { return jparse_lit(cur, "true", jbool(true)); }
    if (c == "f") { return jparse_lit(cur, "false", jbool(false)); }
    if (c == "\"") { return jparse_string(cur); }
    if (c == "-" || is_digit(c)) { return jparse_number(cur); }
    if (c == "[") { return jparse_array(cur); }
    if (c == "{") { return jparse_object(cur); }
    return (noopaque(), f"json: unexpected `{c}` at index {cur.pos}");
}

fn jparse_lit(cur: *Cur, word: str, v: Json) -> (opaque, str) {
    let start = cur.pos;
    let mut ok = true;
    for (let wch of word) {
        if (jpeek(cur) != f"{wch}") { ok = false; }
        cur.pos = cur.pos + 1;
    }
    if (ok == false) {
        return (noopaque(), f"json: bad literal at index {start}");
    }
    return (opaque.new(v), "");
}

fn jparse_string(cur: *Cur) -> (opaque, str) {
    let start = cur.pos;
    cur.pos = cur.pos + 1;   // opening quote
    let out: Vec<str> = Vec.new();
    let mut closed = false;
    let mut open = true;
    while (open && cur.pos < cur.cs.len()) {
        let c = cur.cs[cur.pos];
        cur.pos = cur.pos + 1;
        if (c == "\"") {
            closed = true;
            open = false;
        } else if (c == "\\") {
            if (cur.pos >= cur.cs.len()) {
                return (noopaque(), f"json: unterminated escape at index {cur.pos}");
            }
            let e = cur.cs[cur.pos];
            cur.pos = cur.pos + 1;
            if (e == "n") { out.push("\n"); }
            else if (e == "t") { out.push("\t"); }
            else if (e == "r") { out.push("\r"); }
            else if (e == "b") { out.push("\b"); }
            else if (e == "f") { out.push("\f"); }
            else if (e == "\"") { out.push("\""); }
            else if (e == "\\") { out.push("\\"); }
            else if (e == "/") { out.push("/"); }
            else if (e == "u") {
                return (noopaque(), "json: \\u escapes are not supported in this build");
            } else {
                return (noopaque(), f"json: bad escape at index {cur.pos - 1}");
            }
        } else {
            out.push(c);
        }
    }
    if (closed == false) {
        return (noopaque(), f"json: unterminated string starting at index {start}");
    }
    return (opaque.new(jstr(join_chars(out))), "");
}

fn jparse_number(cur: *Cur) -> (opaque, str) {
    let start = cur.pos;
    let chars: Vec<str> = Vec.new();
    let mut again = true;
    while (again) {
        let c = jpeek(cur);
        again = is_digit(c) || c == "-" || c == "+" || c == "." || c == "e" || c == "E";
        if (again) {
            chars.push(c);
            cur.pos = cur.pos + 1;
        }
    }
    if (valid_number(chars) == false) {
        return (noopaque(), f"json: malformed number at index {start}");
    }
    return (opaque.new(jnum(join_chars(chars))), "");
}

fn jparse_array(cur: *Cur) -> (opaque, str) {
    cur.depth = cur.depth + 1;
    if (cur.depth > 64) {
        return (noopaque(), "json: nesting deeper than 64");
    }
    cur.pos = cur.pos + 1;   // '['
    let v = jarr();
    jskip(cur);
    if (jpeek(cur) == "]") {
        cur.pos = cur.pos + 1;
        return (opaque.new(v), "");
    }
    let mut again = true;
    while (again) {
        let item = jparse_value(cur);
        if (item.1 != "") { return (noopaque(), item.1); }
        let boxed = unwrap_box(item);
        v.arr.push(boxed);
        jskip(cur);
        let c = jpeek(cur);
        if (c == ",") {
            cur.pos = cur.pos + 1;
        } else if (c == "]") {
            cur.pos = cur.pos + 1;
            again = false;
        } else {
            return (noopaque(), f"json: expected `,` or `]` at index {cur.pos}");
        }
    }
    cur.depth = cur.depth - 1;
    return (opaque.new(v), "");
}

fn jparse_object(cur: *Cur) -> (opaque, str) {
    cur.depth = cur.depth + 1;
    if (cur.depth > 64) {
        return (noopaque(), "json: nesting deeper than 64");
    }
    cur.pos = cur.pos + 1;   // '{'
    let v = jobj();
    jskip(cur);
    if (jpeek(cur) == "}") {
        cur.pos = cur.pos + 1;
        return (opaque.new(v), "");
    }
    let mut again = true;
    while (again) {
        jskip(cur);
        if (jpeek(cur) != "\"") {
            return (noopaque(), f"json: expected a key string at index {cur.pos}");
        }
        let key = jparse_string(cur);
        if (key.1 != "") { return (noopaque(), key.1); }
        let (kdoc, _) = opaque.downcast<Json>(unwrap_box(key));
        let kstr = kdoc.str;
        jskip(cur);
        if (jpeek(cur) != ":") {
            return (noopaque(), f"json: expected `:` at index {cur.pos}");
        }
        cur.pos = cur.pos + 1;
        let val = jparse_value(cur);
        if (val.1 != "") { return (noopaque(), val.1); }
        v.keys.push(kstr);
        v.vals.push(unwrap_box(val));
        jskip(cur);
        let c = jpeek(cur);
        if (c == ",") {
            cur.pos = cur.pos + 1;
        } else if (c == "}") {
            cur.pos = cur.pos + 1;
            again = false;
        } else {
            return (noopaque(), f"json: expected a comma or close-brace at index {cur.pos}");
        }
    }
    cur.depth = cur.depth - 1;
    return (opaque.new(v), "");
}

/// The `opaque` of a known-Ok `(opaque, str)` pair (the error string is
/// the unwrap_or default is unreachable and exists only because there
/// is no `.unwrap()` in the surface.
fn unwrap_box(r: (opaque, str)) -> opaque {
    return r.0;
}

/// Encode a tree back to compact JSON.
fn jencode(j: Json) -> str {
    let mut out = "";
    when (j.tag) {
        JTag.Null -> { out = "null"; },
        JTag.False -> { out = "false"; },
        JTag.True -> { out = "true"; },
        JTag.Num -> { out = j.num; },
        JTag.Str -> { out = jquote(j.str); },
        JTag.Arr -> {
            let mut s = "[";
            for (let i = 0; i < j.arr.len(); i += 1) {
                if (i > 0) { s = f"{s},"; }
                let ae = opaque.downcast<Json>(j.arr[i]).0;
                s = f"{s}{jencode(ae)}";
            }
            out = f"{s}]";
        },
        JTag.Obj -> {
            let rb = "}";
            let mut s = "{";
            for (let i = 0; i < j.keys.len(); i += 1) {
                if (i > 0) { s = f"{s},"; }
                let vs = jencode(opaque.downcast<Json>(j.vals[i]).0);
                s = f"{s}{jquote(j.keys[i])}:{vs}";
            }
            out = f"{s}{rb}";
        },
    }
    return out;
}

/// Quote + minimally escape a JSON string body.
fn jquote(s: str) -> str {
    let q = "\"";
    let body: Vec<str> = Vec.new();
    for (let c of s) {
        if (c == "\"") { body.push("\\\""); }
        else if (c == "\\") { body.push("\\\\"); }
        else if (c == "\n") { body.push("\\n"); }
        else if (c == "\r") { body.push("\\r"); }
        else if (c == "\t") { body.push("\\t"); }
        else if (c == "\b") { body.push("\\b"); }
        else if (c == "\f") { body.push("\\f"); }
        else { body.push(f"{c}"); }
    }
    return f"{q}{join_chars(body)}{q}";
}

entry fn json_dec(s: str) -> (opaque, str) {
    let cur = &Cur { cs: split_chars(s), pos: 0, depth: 0 };
    let v = jparse_value(cur);
    if (v.1 != "") { return (noopaque(), v.1); }
    jskip(cur);
    if (cur.pos != cur.cs.len()) {
        return (noopaque(), f"json: trailing data at index {cur.pos}");
    }
    return v;
}

entry fn json_enc(o: opaque) -> str {
    return jencode(opaque.downcast<Json>(o).0);
}

entry fn json_roundtrip(s: str) -> (str, str) {
    let v = json_dec(s);
    if (v.1 != "") {
        return ("", v.1);
    }
        let (vv, _) = opaque.downcast<Json>(v.0);
    return (jencode(vv), "");
}

/// A hand-built document for the embedder demo.
entry fn sample_doc() -> opaque {
    let tags = jarr();
    tags.arr.push(opaque.new(jstr("tiny")));
    tags.arr.push(opaque.new(jstr("fast")));
    tags.arr.push(opaque.new(jstr("verified")));
    let meta = jobj();
    meta.keys.push("ok");
    meta.vals.push(opaque.new(jbool(true)));
    meta.keys.push("lines");
    meta.vals.push(opaque.new(jnum("607")));
    let root = jobj();
    root.keys.push("name");
    root.vals.push(opaque.new(jstr("rut")));
    root.keys.push("version");
    root.vals.push(opaque.new(jnum("0.2")));
    root.keys.push("tags");
    root.vals.push(opaque.new(tags));
    root.keys.push("meta");
    root.vals.push(opaque.new(meta));
    return opaque.new(root);
}

fn sha256_h() -> Vec<u32> {
    let h: Vec<u32> = Vec<u32>.from([
        1779033703, 3144134277u32, 1013904242, 2773480762u32,
        1359893119, 2600822924u32, 528734635, 1541459225,
    ]);
    return h;
}

fn sha512_h() -> Vec<u64> {
    let h: Vec<u64> = Vec<u64>.from([
        7640891576956012808u64, 13503953896175478587u64, 4354685564936845355u64, 11912009170470909681u64,
        5840696475078001361u64, 11170449401992604703u64, 2270897969802886507u64, 6620516959819538809u64,
    ]);
    return h;
}
