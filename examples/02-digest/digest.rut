use pouch::{ Vec };
use calc::{ Math };
// digest.rut — 02-digest: byte-level encodings, hashes, and JSON in rut.
//
// The second algorithmic example: everything here operates on `bytes`
// (the immutable binary primitive, which crosses the host boundary
// directly, RFC 0023 §2 / RFC 0004) and proves
// that the language's integer surface — hex literals, `u32`/`u64`,
// `x.wrapping_add(y)`/`wrapping_mul`/`wrapping_shl` (RFC 0004 §3), and
// the signedness rules for `>>` — is enough to write real, verifiable
// algorithms:
//
//   encodings : hex, base64 (standard + URL-safe)
//   digests   : MD5, SHA-1, SHA-256, SHA-512
//   hash keys : CRC-32, FNV-1a 32/64, djb2, sdbm
//   JSON      : decode -> opaque tree, encode, round-trip
//
// The Rust host (src/main.rs, tests/session.rs) verifies every result
// against the md-5 / sha1 / sha2 / base64 / serde_json / crc32fast
// crates — the rut side never talks to them, only the tests do.
//
// SHA-512 is the u64-heavy one: its rotations lean on `>>` being a
// LOGICAL shift for unsigned types (fixed in this repo) and
// `x.wrapping_shl(n)` truncating to the operand width.

// ---------------------------------------------------------------- hex ---

fn hex_digits() -> Vec<str> {
    let d: Vec<str> = Vec.new();
    let src = "0123456789abcdef";
    for (let c of src) {
        d.push(f"{c}");
    }
    return d;
}

/// bytes -> lowercase hex string.
entry fn hex_enc(data: bytes) -> str {
    let d = hex_digits();
    let mut out = "";
    for (let b of data) {
        let hi = (b as u32 >> 4) as i32;
        let lo = (b as u32 & 15) as i32;
        out = f"{out}{d[hi]}{d[lo]}";
    }
    return out;
}

/// hex string -> bytes; -1 if the char is not a hex digit.
fn hex_val(c: str) -> i32 {
    let lower = "0123456789abcdef";
    let upper = "0123456789ABCDEF";
    let mut i = 0;
    for (let t of lower) {
        if (f"{t}" == c) { return i; }
        i = i + 1;
    }
    i = 0;
    for (let t of upper) {
        if (f"{t}" == c) { return i; }
        i = i + 1;
    }
    return -1;
}

entry fn hex_dec(s: str) -> (bytes, str) {
    if (s.len() % 2 != 0) {
        return (bytes.zeroed(0), "hex: odd-length input");
    }
    let mut out: Vec<u8> = Vec.new();
    let mut cur: u32 = 0;
    let mut i = 0;
    for (let c of s) {
        let v = hex_val(f"{c}");
        if (v < 0) {
            return (bytes.zeroed(0), f"hex: invalid character at index {i}");
        }
        if (i % 2 == 0) {
            cur = v as u32;
        } else {
            out.push((cur * 16 + v as u32) as u8);
        }
        i = i + 1;
    }
    return (out.freeze(), "");
}

// ------------------------------------------------------------ base64 ---

fn b64_table(url: bool) -> Vec<str> {
    let mut t: Vec<str> = Vec.new();
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    for (let c of alpha) {
        t.push(f"{c}");
    }
    if (url) {
        t[62] = "-";
        t[63] = "_";
    }
    return t;
}

entry fn b64_enc(data: bytes, url: bool) -> str {
    let t = b64_table(url);
    let n = data.len();
    let mut out = "";
    for (let i = 0; i < n; i += 3) {
        let b0: u32 = data[i] as u32;
        let mut b1: u32 = 0;
        let mut b2: u32 = 0;
        let mut have1 = false;
        let mut have2 = false;
        if (i + 1 < n) { b1 = data[i + 1] as u32; have1 = true; }
        if (i + 2 < n) { b2 = data[i + 2] as u32; have2 = true; }
        let w: u32 = (b0 << 16) | (b1 << 8) | b2;
        out = f"{out}{t[((w >> 18) & 63) as i32]}{t[((w >> 12) & 63) as i32]}";
        if (have2) {
            out = f"{out}{t[((w >> 6) & 63) as i32]}{t[(w & 63) as i32]}";
        } else if (have1) {
            out = f"{out}{t[((w >> 6) & 63) as i32]}=";
        } else {
            out = f"{out}==";
        }
    }
    return out;
}

entry fn b64_dec(s: str, url: bool) -> (bytes, str) {
    let t = b64_table(url);
    let mut vals: Vec<u32> = Vec.new();
    let mut pad = 0;
    for (let c of s) {
        let cs = f"{c}";
        if (cs == "=") {
            pad = pad + 1;
        } else {
            if (pad > 0) {
                return (bytes.zeroed(0), "base64: data after padding");
            }
            let mut v: u32 = 256;
            for (let i = 0; i < t.len(); i += 1) {
                if (t[i] == cs) { v = i as u32; }
            }
            if (v == 256) {
                return (bytes.zeroed(0), f"base64: invalid character `{cs}`");
            }
            vals.push(v);
        }
    }
    if (vals.len() % 4 == 1) {
        return (bytes.zeroed(0), "base64: impossible length");
    }
    let mut out: Vec<u8> = Vec.new();
    let n = vals.len();
    for (let i = 0; i < n; i += 4) {
        let mut rem = n - i;
        if (rem > 4) { rem = 4; }
        let mut w = (vals[i] << 18) | (vals[i + 1] << 12);
        if (rem >= 3) { w = w | (vals[i + 2] << 6); }
        if (rem == 4) { w = w | vals[i + 3]; }
        out.push((w >> 16) as u8);
        if (rem >= 3) { out.push(((w >> 8) & 255) as u8); }
        if (rem == 4) { out.push((w & 255) as u8); }
    }
    return (out.freeze(), "");
}

// ------------------------------------------------- hashmap hash keys ---

/// CRC-32/ISO-HDLC (the zlib/PNG/zip one): reflected poly 0xEDB88320,
/// bitwise — no table. "123456789" -> 0xCBF43926.
entry fn crc32(data: bytes) -> u32 {
    let mut crc: u32 = 0xFFFFFFFFu32;
    for (let b of data) {
        crc = crc ^ b as u32;
        for (let k = 0; k < 8; k += 1) {
            if ((crc & 1) == 1) {
                crc = (crc >> 1) ^ 0xEDB88320u32;
            } else {
                crc = crc >> 1;
            }
        }
    }
    return crc ^ 0xFFFFFFFFu32;
}

entry fn fnv1a32(data: bytes) -> u32 {
    let mut h: u32 = 2166136261u32;
    for (let b of data) {
        h = (h ^ b as u32).wrapping_mul(16777619);
    }
    return h;
}

/// FNV-1a 64: only `x.wrapping_mul(y)` and `^` — no 64-bit shifts needed, so the u64
/// words never even exercise the shift path.
entry fn fnv1a64(data: bytes) -> u64 {
    let mut h: u64 = 14695981039346656037u64;
    for (let b of data) {
        h = (h ^ b as u64).wrapping_mul(1099511628211u64);
    }
    return h;
}

entry fn djb2(data: bytes) -> u64 {
    let mut h: u64 = 5381;
    for (let b of data) {
        h = (h.wrapping_mul(33)).wrapping_add(b as u64);
    }
    return h;
}

/// sdbm: h = c + h*65599 (== c + (h<<6) + (h<<16) - h, mod 2^64).
entry fn sdbm(data: bytes) -> u64 {
    let mut h: u64 = 0;
    for (let b of data) {
        h = (b as u64).wrapping_add(h.wrapping_mul(65599));
    }
    return h;
}

// ------------------------------------------------------ crypto core ---

/// rotate left, 32-bit: `x.wrapping_shl(n)` truncates, `>>` on u32 is logical.
fn rotl32(x: u32, n: u32) -> u32 {
    let bits = 32 as u32;
    return x.wrapping_shl(n) | (x >> (bits - n));
}

fn rotr32(x: u32, n: u32) -> u32 {
    let bits = 32 as u32;
    return (x >> n) | x.wrapping_shl(bits - n);
}

/// rotate right, 64-bit — THE `u64 >>` dogfood: SHA-512 words regularly
/// carry bit 63, so an arithmetic `>>` would corrupt every one of them.
fn rotr64(x: u64, n: u64) -> u64 {
    let bits = 64 as u64;
    return (x >> n) | x.wrapping_shl(bits - n);
}

fn copy_bytes(msg: bytes) -> Vec<u8> {
    let m: Vec<u8> = Vec.new();
    for (let b of msg) { m.push(b); }
    return m;
}

fn md5_k() -> Vec<u32> {
    let k: Vec<u32> = Vec<u32>.from([
        3614090360u32, 3905402710u32, 606105819, 3250441966u32,
        4118548399u32, 1200080426, 2821735955u32, 4249261313u32,
        1770035416, 2336552879u32, 4294925233u32, 2304563134u32,
        1804603682, 4254626195u32, 2792965006u32, 1236535329,
        4129170786u32, 3225465664u32, 643717713, 3921069994u32,
        3593408605u32, 38016083, 3634488961u32, 3889429448u32,
        568446438, 3275163606u32, 4107603335u32, 1163531501,
        2850285829u32, 4243563512u32, 1735328473, 2368359562u32,
        4294588738u32, 2272392833u32, 1839030562, 4259657740u32,
        2763975236u32, 1272893353, 4139469664u32, 3200236656u32,
        681279174, 3936430074u32, 3572445317u32, 76029189,
        3654602809u32, 3873151461u32, 530742520, 3299628645u32,
        4096336452u32, 1126891415, 2878612391u32, 4237533241u32,
        1700485571, 2399980690u32, 4293915773u32, 2240044497u32,
