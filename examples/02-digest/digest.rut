import { Vec } from "std:collection";
import { Math } from "std:math";
// digest.rut — 02-digest: byte-level encodings, hashes, and JSON in rut.
//
// The second algorithmic example: everything here operates on `bytes`
// (the immutable binary primitive, which crosses the host boundary
// directly, RFC 0023 §2 / RFC 0004) and proves
// that the language's integer surface — hex literals, `u32`/`u64`,
// `Math.wrapping_add`/`wrapping_mul`/`wrapping_shl` (RFC 0004 §3), and
// the signedness rules for `>>` — is enough to write real, verifiable
// algorithms:
//
//   encodings : hex, base64 (standard + URL-safe)
//   digests   : MD5, SHA-1, SHA-256, SHA-512
//   hash keys : CRC-32, FNV-1a 32/64, djb2, sdbm
//   JSON      : decode -> Opaque tree, encode, round-trip
//
// The Rust host (src/main.rs, tests/session.rs) verifies every result
// against the md-5 / sha1 / sha2 / base64 / serde_json / crc32fast
// crates — the rut side never talks to them, only the tests do.
//
// SHA-512 is the u64-heavy one: its rotations lean on `>>` being a
// LOGICAL shift for unsigned types (fixed in this repo) and
// `Math.wrapping_shl` truncating to the operand width.

// ---------------------------------------------------------------- hex ---

fn hex_digits() -> Vec<str> {
    let d: Vec<str> = Vec.new();
    let src = "0123456789abcdef";
    for (let c of src) {
        d.push(f"{c}");
    }
    return d;
}

/// bytes -> lowercase hex string.
entry fn hex_enc(data: bytes) -> str {
    let d = hex_digits();
    let mut out = "";
    for (let b of data) {
        let hi = i32(u32(b) >> 4);
        let lo = i32(u32(b) & 15);
        out = f"{out}{d[hi]}{d[lo]}";
    }
    return out;
}

/// hex string -> bytes; -1 if the char is not a hex digit.
fn hex_val(c: str) -> i32 {
    let lower = "0123456789abcdef";
    let upper = "0123456789ABCDEF";
    let mut i = 0;
    for (let t of lower) {
        if (f"{t}" == c) { return i; }
        i = i + 1;
    }
    i = 0;
    for (let t of upper) {
        if (f"{t}" == c) { return i; }
        i = i + 1;
    }
    return -1;
}

entry fn hex_dec(s: str) -> Result<bytes, str> {
    if (string_len(s) % 2 != 0) {
        return Result.err("hex: odd-length input");
    }
    let mut out: Vec<u8> = Vec.new();
    let mut cur: u32 = 0;
    let mut i = 0;
    for (let c of s) {
        let v = hex_val(f"{c}");
        if (v < 0) {
            return Result.err(f"hex: invalid character at index {i}");
        }
        if (i % 2 == 0) {
            cur = u32(v);
        } else {
            out.push(u8(cur * 16 + u32(v)));
        }
        i = i + 1;
    }
    return Result.ok(out.freeze());
}

// ------------------------------------------------------------ base64 ---

fn b64_table(url: bool) -> Vec<str> {
    let mut t: Vec<str> = Vec.new();
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    for (let c of alpha) {
        t.push(f"{c}");
    }
    if (url) {
        t[62] = "-";
        t[63] = "_";
    }
    return t;
}

entry fn b64_enc(data: bytes, url: bool) -> str {
    let t = b64_table(url);
    let n = bytes_len(data);
    let mut out = "";
    for (let i = 0; i < n; i += 3) {
        let b0: u32 = u32(data[i]);
        let mut b1: u32 = 0;
        let mut b2: u32 = 0;
        let mut have1 = false;
        let mut have2 = false;
        if (i + 1 < n) { b1 = u32(data[i + 1]); have1 = true; }
        if (i + 2 < n) { b2 = u32(data[i + 2]); have2 = true; }
        let w: u32 = (b0 << 16) | (b1 << 8) | b2;
        out = f"{out}{t[i32((w >> 18) & 63)]}{t[i32((w >> 12) & 63)]}";
        if (have2) {
            out = f"{out}{t[i32((w >> 6) & 63)]}{t[i32(w & 63)]}";
        } else if (have1) {
            out = f"{out}{t[i32((w >> 6) & 63)]}=";
        } else {
            out = f"{out}==";
        }
    }
    return out;
}

entry fn b64_dec(s: str, url: bool) -> Result<bytes, str> {
    let t = b64_table(url);
    let mut vals: Vec<u32> = Vec.new();
    let mut pad = 0;
    for (let c of s) {
        let cs = f"{c}";
        if (cs == "=") {
            pad = pad + 1;
        } else {
            if (pad > 0) {
                return Result.err("base64: data after padding");
            }
            let mut v: u32 = 256;
            for (let i = 0; i < t.len(); i += 1) {
                if (t[i] == cs) { v = u32(i); }
            }
            if (v == 256) {
                return Result.err(f"base64: invalid character `{cs}`");
            }
            vals.push(v);
        }
    }
    if (vals.len() % 4 == 1) {
        return Result.err("base64: impossible length");
    }
    let mut out: Vec<u8> = Vec.new();
    let n = vals.len();
    for (let i = 0; i < n; i += 4) {
        let mut rem = n - i;
        if (rem > 4) { rem = 4; }
        let mut w = (vals[i] << 18) | (vals[i + 1] << 12);
        if (rem >= 3) { w = w | (vals[i + 2] << 6); }
        if (rem == 4) { w = w | vals[i + 3]; }
        out.push(u8(w >> 16));
        if (rem >= 3) { out.push(u8((w >> 8) & 255)); }
        if (rem == 4) { out.push(u8(w & 255)); }
    }
    return Result.ok(out.freeze());
}

// ------------------------------------------------- hashmap hash keys ---

/// CRC-32/ISO-HDLC (the zlib/PNG/zip one): reflected poly 0xEDB88320,
/// bitwise — no table. "123456789" -> 0xCBF43926.
entry fn crc32(data: bytes) -> u32 {
    let mut crc: u32 = 0xFFFFFFFF;
    for (let b of data) {
        crc = crc ^ u32(b);
        for (let k = 0; k < 8; k += 1) {
            if ((crc & 1) == 1) {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc = crc >> 1;
            }
        }
    }
    return crc ^ 0xFFFFFFFF;
}

entry fn fnv1a32(data: bytes) -> u32 {
    let mut h: u32 = 2166136261;
    for (let b of data) {
        h = Math.wrapping_mul(h ^ u32(b), 16777619);
    }
    return h;
}

/// FNV-1a 64: only `Math.wrapping_mul` and `^` — no 64-bit shifts needed, so the u64
/// words never even exercise the shift path.
entry fn fnv1a64(data: bytes) -> u64 {
    let mut h: u64 = 14695981039346656037;
    for (let b of data) {
        h = Math.wrapping_mul(h ^ u64(b), 1099511628211);
    }
    return h;
}

entry fn djb2(data: bytes) -> u64 {
    let mut h: u64 = 5381;
    for (let b of data) {
        h = Math.wrapping_add(Math.wrapping_mul(h, 33), u64(b));
    }
    return h;
}

/// sdbm: h = c + h*65599 (== c + (h<<6) + (h<<16) - h, mod 2^64).
entry fn sdbm(data: bytes) -> u64 {
    let mut h: u64 = 0;
    for (let b of data) {
        h = Math.wrapping_add(u64(b), Math.wrapping_mul(h, 65599));
    }
    return h;
}

// ------------------------------------------------------ crypto core ---

/// rotate left, 32-bit: `Math.wrapping_shl` truncates, `>>` on u32 is logical.
fn rotl32(x: u32, n: u32) -> u32 {
    let bits = u32(32);
    return Math.wrapping_shl(x, n) | (x >> (bits - n));
}

fn rotr32(x: u32, n: u32) -> u32 {
    let bits = u32(32);
    return (x >> n) | Math.wrapping_shl(x, bits - n);
}

/// rotate right, 64-bit — THE `u64 >>` dogfood: SHA-512 words regularly
/// carry bit 63, so an arithmetic `>>` would corrupt every one of them.
fn rotr64(x: u64, n: u64) -> u64 {
    let bits = u64(64);
    return (x >> n) | Math.wrapping_shl(x, bits - n);
}

fn copy_bytes(msg: bytes) -> Vec<u8> {
    let m: Vec<u8> = Vec.new();
    for (let b of msg) { m.push(b); }
    return m;
}

fn md5_k() -> Vec<u32> {
    let k: Vec<u32> = Vec<u32>.from([
        3614090360, 3905402710, 606105819, 3250441966,
        4118548399, 1200080426, 2821735955, 4249261313,
        1770035416, 2336552879, 4294925233, 2304563134,
        1804603682, 4254626195, 2792965006, 1236535329,
        4129170786, 3225465664, 643717713, 3921069994,
        3593408605, 38016083, 3634488961, 3889429448,
        568446438, 3275163606, 4107603335, 1163531501,
        2850285829, 4243563512, 1735328473, 2368359562,
        4294588738, 2272392833, 1839030562, 4259657740,
        2763975236, 1272893353, 4139469664, 3200236656,
        681279174, 3936430074, 3572445317, 76029189,
        3654602809, 3873151461, 530742520, 3299628645,
        4096336452, 1126891415, 2878612391, 4237533241,
        1700485571, 2399980690, 4293915773, 2240044497,
        1873313359, 4264355552, 2734768916, 1309151649,
        4149444226, 3174756917, 718787259, 3951481745,
    ]);
    return k;
}

fn md5_s() -> Vec<u32> {
    let s: Vec<u32> = Vec<u32>.from([
        7, 12, 17, 22,
        7, 12, 17, 22,
        7, 12, 17, 22,
        7, 12, 17, 22,
        5, 9, 14, 20,
        5, 9, 14, 20,
        5, 9, 14, 20,
        5, 9, 14, 20,
        4, 11, 16, 23,
        4, 11, 16, 23,
        4, 11, 16, 23,
        4, 11, 16, 23,
        6, 10, 15, 21,
        6, 10, 15, 21,
        6, 10, 15, 21,
        6, 10, 15, 21,
    ]);
    return s;
}

fn md5_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    m.push(0x80);
    while (m.len() % 64 != 56) { m.push(0); }
    let bits = u64(bytes_len(msg)) * 8;
    for (let i = 0; i < 8; i += 1) {
        m.push(u8((bits >> (u64(i) * 8)) & 0xFF));   // little-endian length
    }
    let mut a0: u32 = 0x67452301;
    let mut b0: u32 = 0xefcdab89;
    let mut c0: u32 = 0x98badcfe;
    let mut d0: u32 = 0x10325476;
    let k = md5_k();
    let s = md5_s();
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut x: Vec<u32> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            x.push(u32(m[o]) | (u32(m[o + 1]) << 8) | (u32(m[o + 2]) << 16) | (u32(m[o + 3]) << 24));
        }
        let mut a = a0;
        let mut b = b0;
        let mut c = c0;
        let mut d = d0;
        for (let i = 0; i < 64; i += 1) {
            let mut f: u32 = 0;
            let mut g = 0;
            if (i < 16) {
                f = (b & c) | (d & (b ^ 4294967295));
                g = i;
            } else if (i < 32) {
                f = (d & b) | (c & (d ^ 4294967295));
                g = (5 * i + 1) % 16;
            } else if (i < 48) {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (d ^ 4294967295));
                g = (7 * i) % 16;
            }
            let tmp = d;
            d = c;
            c = b;
            let sum = Math.wrapping_add(Math.wrapping_add(a, f), Math.wrapping_add(k[i], x[g]));
            b = Math.wrapping_add(b, rotl32(sum, s[i]));
            a = tmp;
        }
        a0 = Math.wrapping_add(a0, a);
        b0 = Math.wrapping_add(b0, b);
        c0 = Math.wrapping_add(c0, c);
        d0 = Math.wrapping_add(d0, d);
    }
    let mut out: Vec<u8> = Vec.new();
    let mut w = a0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    w = b0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    w = c0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    w = d0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    return out.freeze();
}

/// SHA-1/SHA-2 padding: 0x80, zeros to n%{mod}=={res}, then the message
/// length in bits as a big-endian 64-bit word.
fn sha_tail(m: Vec<u8>, msg_len: i32) -> unit {
    m.push(0x80);
    while (m.len() % 64 != 56) { m.push(0); }
    let bits = u64(msg_len) * 8;
    m.push(u8((bits >> 56) & 0xFF));
    m.push(u8((bits >> 48) & 0xFF));
    m.push(u8((bits >> 40) & 0xFF));
    m.push(u8((bits >> 32) & 0xFF));
    m.push(u8((bits >> 24) & 0xFF));
    m.push(u8((bits >> 16) & 0xFF));
    m.push(u8((bits >> 8) & 0xFF));
    m.push(u8(bits & 0xFF));
}

fn sha1_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    sha_tail(m, bytes_len(msg));
    let mut h0: u32 = 0x67452301;
    let mut h1: u32 = 0xEFCDAB89;
    let mut h2: u32 = 0x98BADCFE;
    let mut h3: u32 = 0x10325476;
    let mut h4: u32 = 0xC3D2E1F0;
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u32> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            w.push(u32(m[o]) << 24 | u32(m[o + 1]) << 16 | u32(m[o + 2]) << 8 | u32(m[o + 3]));
        }
        for (let i = 16; i < 80; i += 1) {
            w.push(rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1));
        }
        let mut a = h0;
        let mut b = h1;
        let mut c = h2;
        let mut d = h3;
        let mut e = h4;
        for (let i = 0; i < 80; i += 1) {
            let mut f: u32 = 0;
            let mut kk: u32 = 0;
            if (i < 20) {
                f = (b & c) | (d & (b ^ 4294967295));
                kk = 0x5A827999;
            } else if (i < 40) {
                f = b ^ c ^ d;
                kk = 0x6ED9EBA1;
            } else if (i < 60) {
                f = (b & c) | (b & d) | (c & d);
                kk = 0x8F1BBCDC;
            } else {
                f = b ^ c ^ d;
                kk = 0xCA62C1D6;
            }
            let tmp = Math.wrapping_add(Math.wrapping_add(rotl32(a, 5), Math.wrapping_add(f, e)), Math.wrapping_add(kk, w[i]));
            e = d;
            d = c;
            c = rotl32(b, 30);
            b = a;
            a = tmp;
        }
        h0 = Math.wrapping_add(h0, a);
        h1 = Math.wrapping_add(h1, b);
        h2 = Math.wrapping_add(h2, c);
        h3 = Math.wrapping_add(h3, d);
        h4 = Math.wrapping_add(h4, e);
    }
    let mut out: Vec<u8> = Vec.new();
    let ws: Vec<u32> = Vec.new();
    ws.push(h0); ws.push(h1); ws.push(h2); ws.push(h3); ws.push(h4);
    for (let j = 0; j < 5; j += 1) {
        out.push(u8((ws[j] >> 24) & 0xFF));
        out.push(u8((ws[j] >> 16) & 0xFF));
        out.push(u8((ws[j] >> 8) & 0xFF));
        out.push(u8(ws[j] & 0xFF));
    }
    return out.freeze();
}

fn sha256_k() -> Vec<u32> {
    let k: Vec<u32> = Vec<u32>.from([
        1116352408, 1899447441, 3049323471, 3921009573,
        961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987,
        1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628,
        770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671,
        3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291,
        1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771,
        3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877,
        958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424,
        2428436474, 2756734187, 3204031479, 3329325298,
    ]);
    return k;
}

fn sha256_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    sha_tail(m, bytes_len(msg));
    let h = sha256_h();
    let k = sha256_k();
    let mut st: Vec<u32> = Vec.new();
    for (let i = 0; i < 8; i += 1) { st.push(h[i]); }
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u32> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            w.push(u32(m[o]) << 24 | u32(m[o + 1]) << 16 | u32(m[o + 2]) << 8 | u32(m[o + 3]));
        }
        for (let i = 16; i < 64; i += 1) {
            let s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            let s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w.push(Math.wrapping_add(Math.wrapping_add(Math.wrapping_add(w[i - 16], s0), w[i - 7]), s1));
        }
        let mut a = st[0];
        let mut b = st[1];
        let mut c = st[2];
        let mut d = st[3];
        let mut e = st[4];
        let mut f = st[5];
        let mut g = st[6];
        let mut hh = st[7];
        for (let i = 0; i < 64; i += 1) {
            let big1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch = (e & f) ^ ((e ^ 4294967295) & g);
            let t1 = Math.wrapping_add(Math.wrapping_add(hh, big1), Math.wrapping_add(ch, Math.wrapping_add(k[i], w[i])));
            let big0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = Math.wrapping_add(big0, maj);
            hh = g;
            g = f;
            f = e;
            e = Math.wrapping_add(d, t1);
            d = c;
            c = b;
            b = a;
            a = Math.wrapping_add(t1, t2);
        }
        st[0] = Math.wrapping_add(st[0], a);
        st[1] = Math.wrapping_add(st[1], b);
        st[2] = Math.wrapping_add(st[2], c);
        st[3] = Math.wrapping_add(st[3], d);
        st[4] = Math.wrapping_add(st[4], e);
        st[5] = Math.wrapping_add(st[5], f);
        st[6] = Math.wrapping_add(st[6], g);
        st[7] = Math.wrapping_add(st[7], hh);
    }
    let mut out: Vec<u8> = Vec.new();
    for (let j = 0; j < 8; j += 1) {
        out.push(u8((st[j] >> 24) & 0xFF));
        out.push(u8((st[j] >> 16) & 0xFF));
        out.push(u8((st[j] >> 8) & 0xFF));
        out.push(u8(st[j] & 0xFF));
    }
    return out.freeze();
}

