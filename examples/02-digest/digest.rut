fn sha256_impl(msg: Vec<u8>) -> Vec<u8> {
    let mut m = copy_bytes(msg);
    sha_tail(m, msg.len());
    let h = sha256_h();
    let k = sha256_k();
    let mut st: Vec<u32> = Vec();
    for (let i = 0; i < 8; i += 1) { st.push(h[i]); }
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u32> = Vec();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            w.push(u32(m[o]) << 24 | u32(m[o + 1]) << 16 | u32(m[o + 2]) << 8 | u32(m[o + 3]));
        }
        for (let i = 16; i < 64; i += 1) {
            let s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            let s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w.push(w[i - 16] &+ s0 &+ w[i - 7] &+ s1);
        }
        let mut a = st[0];
        let mut b = st[1];
        let mut c = st[2];
        let mut d = st[3];
        let mut e = st[4];
        let mut f = st[5];
        let mut g = st[6];
        let mut hh = st[7];
        for (let i = 0; i < 64; i += 1) {
            let big1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch = (e & f) ^ ((e ^ 4294967295) & g);
            let t1 = (hh &+ big1) &+ (ch &+ (k[i] &+ w[i]));
            let big0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = big0 &+ maj;
            hh = g;
            g = f;
            f = e;
            e = d &+ t1;
            d = c;
            c = b;
            b = a;
            a = t1 &+ t2;
        }
        st[0] = st[0] &+ a;
        st[1] = st[1] &+ b;
        st[2] = st[2] &+ c;
        st[3] = st[3] &+ d;
        st[4] = st[4] &+ e;
        st[5] = st[5] &+ f;
        st[6] = st[6] &+ g;
        st[7] = st[7] &+ hh;
    }
    let mut out: Vec<u8> = Vec();
    for (let j = 0; j < 8; j += 1) {
        out.push(u8((st[j] >> 24) & 0xFF));
        out.push(u8((st[j] >> 16) & 0xFF));
        out.push(u8((st[j] >> 8) & 0xFF));
        out.push(u8(st[j] & 0xFF));
    }
    return out;
}

