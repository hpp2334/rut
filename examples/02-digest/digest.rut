        4149444226u32, 3174756917u32, 718787259, 3951481745u32,
    ]);
    return k;
}

fn md5_s() -> Vec<u32> {
    let s: Vec<u32> = Vec<u32>.from([
        7, 12, 17, 22,
        7, 12, 17, 22,
        7, 12, 17, 22,
        7, 12, 17, 22,
        5, 9, 14, 20,
        5, 9, 14, 20,
        5, 9, 14, 20,
        5, 9, 14, 20,
        4, 11, 16, 23,
        4, 11, 16, 23,
        4, 11, 16, 23,
        4, 11, 16, 23,
        6, 10, 15, 21,
        6, 10, 15, 21,
        6, 10, 15, 21,
        6, 10, 15, 21,
    ]);
    return s;
}

fn md5_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    m.push(0x80);
    while (m.len() % 64 != 56) { m.push(0); }
    let bits = msg.len() as u64 * 8;
    for (let i = 0; i < 8; i += 1) {
        m.push(((bits >> (i as u64 * 8)) & 0xFF) as u8);   // little-endian length
    }
    let mut a0: u32 = 0x67452301;
    let mut b0: u32 = 0xefcdab89u32;
    let mut c0: u32 = 0x98badcfeu32;
    let mut d0: u32 = 0x10325476;
    let k = md5_k();
    let s = md5_s();
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut x: Vec<u32> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            x.push(m[o] as u32 | (m[o + 1] as u32 << 8) | (m[o + 2] as u32 << 16) | (m[o + 3] as u32 << 24));
        }
        let mut a = a0;
        let mut b = b0;
        let mut c = c0;
        let mut d = d0;
        for (let i = 0; i < 64; i += 1) {
            let mut f: u32 = 0;
            let mut g = 0;
            if (i < 16) {
                f = (b & c) | (d & (b ^ 4294967295u32));
                g = i;
            } else if (i < 32) {
                f = (d & b) | (c & (d ^ 4294967295u32));
                g = (5 * i + 1) % 16;
            } else if (i < 48) {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (d ^ 4294967295u32));
                g = (7 * i) % 16;
            }
            let tmp = d;
            d = c;
            c = b;
            let sum = (a.wrapping_add(f)).wrapping_add((k[i]).wrapping_add(x[g]));
            b = b.wrapping_add(rotl32(sum, s[i]));
            a = tmp;
        }
        a0 = a0.wrapping_add(a);
        b0 = b0.wrapping_add(b);
        c0 = c0.wrapping_add(c);
        d0 = d0.wrapping_add(d);
    }
    let mut out: Vec<u8> = Vec.new();
    let mut w = a0;
    for (let i = 0; i < 4; i += 1) { out.push(((w >> (i as u32 * 8)) & 0xFF) as u8); }
    w = b0;
    for (let i = 0; i < 4; i += 1) { out.push(((w >> (i as u32 * 8)) & 0xFF) as u8); }
    w = c0;
    for (let i = 0; i < 4; i += 1) { out.push(((w >> (i as u32 * 8)) & 0xFF) as u8); }
    w = d0;
    for (let i = 0; i < 4; i += 1) { out.push(((w >> (i as u32 * 8)) & 0xFF) as u8); }
    return out.freeze();
}

/// SHA-1/SHA-2 padding: 0x80, zeros to n%{mod}=={res}, then the message
/// length in bits as a big-endian 64-bit word.
fn sha_tail(m: *Vec<u8>, msg_len: i32) {
    m.push(0x80);
    while (m.len() % 64 != 56) { m.push(0); }
    let bits = msg_len as u64 * 8;
    m.push(((bits >> 56) & 0xFF) as u8);
    m.push(((bits >> 48) & 0xFF) as u8);
    m.push(((bits >> 40) & 0xFF) as u8);
    m.push(((bits >> 32) & 0xFF) as u8);
    m.push(((bits >> 24) & 0xFF) as u8);
    m.push(((bits >> 16) & 0xFF) as u8);
    m.push(((bits >> 8) & 0xFF) as u8);
    m.push((bits & 0xFF) as u8);
}

fn sha1_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    let mp = &m;
    sha_tail(mp, msg.len());
    m = *mp;
    let mut h0: u32 = 0x67452301;
    let mut h1: u32 = 0xEFCDAB89u32;
    let mut h2: u32 = 0x98BADCFEu32;
    let mut h3: u32 = 0x10325476;
    let mut h4: u32 = 0xC3D2E1F0u32;
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u32> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            w.push(m[o] as u32 << 24 | m[o + 1] as u32 << 16 | m[o + 2] as u32 << 8 | m[o + 3] as u32);
        }
        for (let i = 16; i < 80; i += 1) {
            w.push(rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1));
        }
        let mut a = h0;
        let mut b = h1;
        let mut c = h2;
        let mut d = h3;
        let mut e = h4;
        for (let i = 0; i < 80; i += 1) {
            let mut f: u32 = 0;
            let mut kk: u32 = 0;
            if (i < 20) {
                f = (b & c) | (d & (b ^ 4294967295u32));
                kk = 0x5A827999;
            } else if (i < 40) {
                f = b ^ c ^ d;
                kk = 0x6ED9EBA1;
            } else if (i < 60) {
                f = (b & c) | (b & d) | (c & d);
                kk = 0x8F1BBCDCu32;
            } else {
                f = b ^ c ^ d;
                kk = 0xCA62C1D6u32;
            }
            let tmp = ((rotl32(a, 5)).wrapping_add(f.wrapping_add(e))).wrapping_add(kk.wrapping_add(w[i]));
            e = d;
            d = c;
            c = rotl32(b, 30);
            b = a;
            a = tmp;
        }
        h0 = h0.wrapping_add(a);
        h1 = h1.wrapping_add(b);
        h2 = h2.wrapping_add(c);
        h3 = h3.wrapping_add(d);
        h4 = h4.wrapping_add(e);
    }
    let mut out: Vec<u8> = Vec.new();
    let ws: Vec<u32> = Vec.new();
    ws.push(h0); ws.push(h1); ws.push(h2); ws.push(h3); ws.push(h4);
    for (let j = 0; j < 5; j += 1) {
        out.push(((ws[j] >> 24) & 0xFF) as u8);
        out.push(((ws[j] >> 16) & 0xFF) as u8);
        out.push(((ws[j] >> 8) & 0xFF) as u8);
        out.push((ws[j] & 0xFF) as u8);
    }
    return out.freeze();
}

fn sha256_k() -> Vec<u32> {
    let k: Vec<u32> = Vec<u32>.from([
        1116352408, 1899447441, 3049323471u32, 3921009573u32,
        961987163, 1508970993, 2453635748u32, 2870763221u32,
        3624381080u32, 310598401, 607225278, 1426881987,
        1925078388, 2162078206u32, 2614888103u32, 3248222580u32,
        3835390401u32, 4022224774u32, 264347078, 604807628,
        770255983, 1249150122, 1555081692, 1996064986,
        2554220882u32, 2821834349u32, 2952996808u32, 3210313671u32,
        3336571891u32, 3584528711u32, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291,
        1695183700, 1986661051, 2177026350u32, 2456956037u32,
        2730485921u32, 2820302411u32, 3259730800u32, 3345764771u32,
        3516065817u32, 3600352804u32, 4094571909u32, 275423344,
        430227734, 506948616, 659060556, 883997877,
        958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452u32, 2361852424u32,
        2428436474u32, 2756734187u32, 3204031479u32, 3329325298u32,
    ]);
    return k;
}

fn sha256_impl(msg: bytes) -> bytes {
    let mut m = copy_bytes(msg);
    let mp = &m;
    sha_tail(mp, msg.len());
    m = *mp;
    let h = sha256_h();
    let k = sha256_k();
    let mut st: Vec<u32> = Vec.new();
    for (let i = 0; i < 8; i += 1) { st.push(h[i]); }
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u32> = Vec.new();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            w.push(m[o] as u32 << 24 | m[o + 1] as u32 << 16 | m[o + 2] as u32 << 8 | m[o + 3] as u32);
        }
        for (let i = 16; i < 64; i += 1) {
            let s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            let s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w.push((((w[i - 16]).wrapping_add(s0)).wrapping_add(w[i - 7])).wrapping_add(s1));
        }
        let mut a = st[0];
        let mut b = st[1];
        let mut c = st[2];
        let mut d = st[3];
        let mut e = st[4];
        let mut f = st[5];
        let mut g = st[6];
        let mut hh = st[7];
        for (let i = 0; i < 64; i += 1) {
            let big1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch = (e & f) ^ ((e ^ 4294967295u32) & g);
            let t1 = (hh.wrapping_add(big1)).wrapping_add(ch.wrapping_add((k[i]).wrapping_add(w[i])));
            let big0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = big0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        st[0] = (st[0]).wrapping_add(a);
        st[1] = (st[1]).wrapping_add(b);
        st[2] = (st[2]).wrapping_add(c);
        st[3] = (st[3]).wrapping_add(d);
        st[4] = (st[4]).wrapping_add(e);
        st[5] = (st[5]).wrapping_add(f);
        st[6] = (st[6]).wrapping_add(g);
        st[7] = (st[7]).wrapping_add(hh);
    }
    let mut out: Vec<u8> = Vec.new();
    for (let j = 0; j < 8; j += 1) {
        out.push(((st[j] >> 24) & 0xFF) as u8);
        out.push(((st[j] >> 16) & 0xFF) as u8);
        out.push(((st[j] >> 8) & 0xFF) as u8);
        out.push((st[j] & 0xFF) as u8);
    }
    return out.freeze();
}

