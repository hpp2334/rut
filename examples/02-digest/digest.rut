// digest.rut — 02-digest: byte-level encodings, hashes, and JSON in rut.
//
// The second algorithmic example: everything here operates on `Vec<u8>`
// (which crosses the host boundary directly, RFC 0023 §2) and proves
// that the language's integer surface — hex literals, `u32`/`u64`,
// the wrapping family `&+ &* &<<` (RFC 0004 §3), and the signedness
// rules for `>>` — is enough to write real, verifiable algorithms:
//
//   encodings : hex, base64 (standard + URL-safe)
//   digests   : MD5, SHA-1, SHA-256, SHA-512
//   hash keys : CRC-32, FNV-1a 32/64, djb2, sdbm
//   JSON      : decode -> Opaque tree, encode, round-trip
//
// The Rust host (src/main.rs, tests/session.rs) verifies every result
// against the md-5 / sha1 / sha2 / base64 / serde_json / crc32fast
// crates — the rut side never talks to them, only the tests do.
//
// SHA-512 is the u64-heavy one: its rotations lean on `>>` being a
// LOGICAL shift for unsigned types (fixed in this repo) and `&<<`
// truncating to the operand width.

// ---------------------------------------------------------------- hex ---

fn hex_digits() -> Vec<string> {
    let d: Vec<string> = Vec();
    let src = "0123456789abcdef";
    for (let c of src) {
        d.push(f"{c}");
    }
    return d;
}

/// bytes -> lowercase hex string.
entry fn hex_enc(data: Vec<u8>) -> string {
    let d = hex_digits();
    let mut out = "";
    for (let b of data) {
        let hi = i32(u32(b) >> 4);
        let lo = i32(u32(b) & 15);
        out = f"{out}{d[hi]}{d[lo]}";
    }
    return out;
}

/// hex string -> bytes; -1 if the char is not a hex digit.
fn hex_val(c: string) -> i32 {
    let lower = "0123456789abcdef";
    let upper = "0123456789ABCDEF";
    let mut i = 0;
    for (let t of lower) {
        if (f"{t}" == c) { return i; }
        i = i + 1;
    }
    i = 0;
    for (let t of upper) {
        if (f"{t}" == c) { return i; }
        i = i + 1;
    }
    return -1;
}

entry fn hex_dec(s: string) -> Result<Vec<u8>, string> {
    if (s.len() % 2 != 0) {
        return Result.err("hex: odd-length input");
    }
    let mut out: Vec<u8> = Vec();
    let mut cur: u32 = 0;
    let mut i = 0;
    for (let c of s) {
        let v = hex_val(f"{c}");
        if (v < 0) {
            return Result.err(f"hex: invalid character at index {i}");
        }
        if (i % 2 == 0) {
            cur = u32(v);
        } else {
            out.push(u8(cur * 16 + u32(v)));
        }
        i = i + 1;
    }
    return Result.ok(out);
}

// ------------------------------------------------------------ base64 ---

fn b64_table(url: bool) -> Vec<string> {
    let mut t: Vec<string> = Vec();
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    for (let c of alpha) {
        t.push(f"{c}");
    }
    if (url) {
        t[62] = "-";
        t[63] = "_";
    }
    return t;
}

entry fn b64_enc(data: Vec<u8>, url: bool) -> string {
    let t = b64_table(url);
    let n = data.len();
    let mut out = "";
    for (let i = 0; i < n; i += 3) {
        let b0: u32 = u32(data[i]);
        let mut b1: u32 = 0;
        let mut b2: u32 = 0;
        let mut have1 = false;
        let mut have2 = false;
        if (i + 1 < n) { b1 = u32(data[i + 1]); have1 = true; }
        if (i + 2 < n) { b2 = u32(data[i + 2]); have2 = true; }
        let w: u32 = (b0 << 16) | (b1 << 8) | b2;
        out = f"{out}{t[i32((w >> 18) & 63)]}{t[i32((w >> 12) & 63)]}";
        if (have2) {
            out = f"{out}{t[i32((w >> 6) & 63)]}{t[i32(w & 63)]}";
        } else if (have1) {
            out = f"{out}{t[i32((w >> 6) & 63)]}=";
        } else {
            out = f"{out}==";
        }
    }
    return out;
}

entry fn b64_dec(s: string, url: bool) -> Result<Vec<u8>, string> {
    let t = b64_table(url);
    let mut vals: Vec<u32> = Vec();
    let mut pad = 0;
    for (let c of s) {
        let cs = f"{c}";
        if (cs == "=") {
            pad = pad + 1;
        } else {
            if (pad > 0) {
                return Result.err("base64: data after padding");
            }
            let mut v: u32 = 256;
            for (let i = 0; i < t.len(); i += 1) {
                if (t[i] == cs) { v = u32(i); }
            }
            if (v == 256) {
                return Result.err(f"base64: invalid character `{cs}`");
            }
            vals.push(v);
        }
    }
    if (vals.len() % 4 == 1) {
        return Result.err("base64: impossible length");
    }
    let mut out: Vec<u8> = Vec();
    let n = vals.len();
    for (let i = 0; i < n; i += 4) {
        let mut rem = n - i;
        if (rem > 4) { rem = 4; }
        let mut w = (vals[i] << 18) | (vals[i + 1] << 12);
        if (rem >= 3) { w = w | (vals[i + 2] << 6); }
        if (rem == 4) { w = w | vals[i + 3]; }
        out.push(u8(w >> 16));
        if (rem >= 3) { out.push(u8((w >> 8) & 255)); }
        if (rem == 4) { out.push(u8(w & 255)); }
    }
    return Result.ok(out);
}

// ------------------------------------------------- hashmap hash keys ---

/// CRC-32/ISO-HDLC (the zlib/PNG/zip one): reflected poly 0xEDB88320,
/// bitwise — no table. "123456789" -> 0xCBF43926.
entry fn crc32(data: Vec<u8>) -> u32 {
    let mut crc: u32 = 0xFFFFFFFF;
    for (let b of data) {
        crc = crc ^ u32(b);
        for (let k = 0; k < 8; k += 1) {
            if ((crc & 1) == 1) {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc = crc >> 1;
            }
        }
    }
    return crc ^ 0xFFFFFFFF;
}

entry fn fnv1a32(data: Vec<u8>) -> u32 {
    let mut h: u32 = 2166136261;
    for (let b of data) {
        h = (h ^ u32(b)) &* 16777619;
    }
    return h;
}

/// FNV-1a 64: only `&*` and `^` — no 64-bit shifts needed, so the u64
/// words never even exercise the shift path.
entry fn fnv1a64(data: Vec<u8>) -> u64 {
    let mut h: u64 = 14695981039346656037;
    for (let b of data) {
        h = (h ^ u64(b)) &* 1099511628211;
    }
    return h;
}

entry fn djb2(data: Vec<u8>) -> u64 {
    let mut h: u64 = 5381;
    for (let b of data) {
        h = (h &* 33) &+ u64(b);
    }
    return h;
}

/// sdbm: h = c + h*65599 (== c + (h<<6) + (h<<16) - h, mod 2^64).
entry fn sdbm(data: Vec<u8>) -> u64 {
    let mut h: u64 = 0;
    for (let b of data) {
        h = u64(b) &+ (h &* 65599);
    }
    return h;
}

// ------------------------------------------------------ crypto core ---

/// rotate left, 32-bit: `&<<` truncates, `>>` on u32 is logical.
fn rotl32(x: u32, n: u32) -> u32 {
    let bits = u32(32);
    return (x &<< n) | (x >> (bits - n));
}

fn rotr32(x: u32, n: u32) -> u32 {
    let bits = u32(32);
    return (x >> n) | (x &<< (bits - n));
}

/// rotate right, 64-bit — THE `u64 >>` dogfood: SHA-512 words regularly
/// carry bit 63, so an arithmetic `>>` would corrupt every one of them.
fn rotr64(x: u64, n: u64) -> u64 {
    let bits = u64(64);
    return (x >> n) | (x &<< (bits - n));
}

fn copy_bytes(msg: Vec<u8>) -> Vec<u8> {
    let m: Vec<u8> = Vec();
    for (let b of msg) { m.push(b); }
    return m;
}

