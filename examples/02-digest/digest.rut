fn md5_s() -> Vec<u32> {
    let s: Vec<u32> = Vec();
    for (let r = 0; r < 4; r += 1) {
        s.push(7); s.push(12); s.push(17); s.push(22);
    }
    for (let r = 0; r < 4; r += 1) {
        s.push(5); s.push(9); s.push(14); s.push(20);
    }
    for (let r = 0; r < 4; r += 1) {
        s.push(4); s.push(11); s.push(16); s.push(23);
    }
    for (let r = 0; r < 4; r += 1) {
        s.push(6); s.push(10); s.push(15); s.push(21);
    }
    return s;
}

fn md5_impl(msg: Vec<u8>) -> Vec<u8> {
    let mut m = copy_bytes(msg);
    m.push(0x80);
    while (m.len() % 64 != 56) { m.push(0); }
    let bits = u64(msg.len()) * 8;
    for (let i = 0; i < 8; i += 1) {
        m.push(u8((bits >> (u64(i) * 8)) & 0xFF));   // little-endian length
    }
    let mut a0: u32 = 0x67452301;
    let mut b0: u32 = 0xefcdab89;
    let mut c0: u32 = 0x98badcfe;
    let mut d0: u32 = 0x10325476;
    let k = md5_k();
    let s = md5_s();
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut x: Vec<u32> = Vec();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            x.push(u32(m[o]) | (u32(m[o + 1]) << 8) | (u32(m[o + 2]) << 16) | (u32(m[o + 3]) << 24));
        }
        let mut a = a0;
        let mut b = b0;
        let mut c = c0;
        let mut d = d0;
        for (let i = 0; i < 64; i += 1) {
            let mut f: u32 = 0;
            let mut g = 0;
            if (i < 16) {
                f = (b & c) | (d & (b ^ 4294967295));
                g = i;
            } else if (i < 32) {
                f = (d & b) | (c & (d ^ 4294967295));
                g = (5 * i + 1) % 16;
            } else if (i < 48) {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (d ^ 4294967295));
                g = (7 * i) % 16;
            }
            let tmp = d;
            d = c;
            c = b;
            let sum = (a &+ f) &+ (k[i] &+ x[g]);
            b = b &+ rotl32(sum, s[i]);
            a = tmp;
        }
        a0 = a0 &+ a;
        b0 = b0 &+ b;
        c0 = c0 &+ c;
        d0 = d0 &+ d;
    }
    let mut out: Vec<u8> = Vec();
    let mut w = a0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    w = b0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    w = c0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    w = d0;
    for (let i = 0; i < 4; i += 1) { out.push(u8((w >> (u32(i) * 8)) & 0xFF)); }
    return out;
}

/// SHA-1/SHA-2 padding: 0x80, zeros to n%{mod}=={res}, then the message
/// length in bits as a big-endian 64-bit word.
fn sha_tail(m: Vec<u8>, msg_len: i32) -> unit {
    m.push(0x80);
    while (m.len() % 64 != 56) { m.push(0); }
    let bits = u64(msg_len) * 8;
    m.push(u8((bits >> 56) & 0xFF));
    m.push(u8((bits >> 48) & 0xFF));
    m.push(u8((bits >> 40) & 0xFF));
    m.push(u8((bits >> 32) & 0xFF));
    m.push(u8((bits >> 24) & 0xFF));
    m.push(u8((bits >> 16) & 0xFF));
    m.push(u8((bits >> 8) & 0xFF));
    m.push(u8(bits & 0xFF));
}

fn sha1_impl(msg: Vec<u8>) -> Vec<u8> {
    let mut m = copy_bytes(msg);
    sha_tail(m, msg.len());
    let mut h0: u32 = 0x67452301;
    let mut h1: u32 = 0xEFCDAB89;
    let mut h2: u32 = 0x98BADCFE;
    let mut h3: u32 = 0x10325476;
    let mut h4: u32 = 0xC3D2E1F0;
    let blocks = m.len() / 64;
    for (let blk = 0; blk < blocks; blk += 1) {
        let mut w: Vec<u32> = Vec();
        for (let j = 0; j < 16; j += 1) {
            let o = blk * 64 + j * 4;
            w.push(u32(m[o]) << 24 | u32(m[o + 1]) << 16 | u32(m[o + 2]) << 8 | u32(m[o + 3]));
        }
        for (let i = 16; i < 80; i += 1) {
            w.push(rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1));
        }
        let mut a = h0;
        let mut b = h1;
        let mut c = h2;
        let mut d = h3;
        let mut e = h4;
        for (let i = 0; i < 80; i += 1) {
            let mut f: u32 = 0;
            let mut kk: u32 = 0;
            if (i < 20) {
                f = (b & c) | (d & (b ^ 4294967295));
                kk = 0x5A827999;
            } else if (i < 40) {
                f = b ^ c ^ d;
                kk = 0x6ED9EBA1;
            } else if (i < 60) {
                f = (b & c) | (b & d) | (c & d);
                kk = 0x8F1BBCDC;
            } else {
                f = b ^ c ^ d;
                kk = 0xCA62C1D6;
            }
            let tmp = rotl32(a, 5) &+ (f &+ e) &+ (kk &+ w[i]);
            e = d;
            d = c;
            c = rotl32(b, 30);
            b = a;
            a = tmp;
        }
        h0 = h0 &+ a;
        h1 = h1 &+ b;
        h2 = h2 &+ c;
        h3 = h3 &+ d;
        h4 = h4 &+ e;
    }
    let mut out: Vec<u8> = Vec();
    let ws: Vec<u32> = Vec();
    ws.push(h0); ws.push(h1); ws.push(h2); ws.push(h3); ws.push(h4);
    for (let j = 0; j < 5; j += 1) {
        out.push(u8((ws[j] >> 24) & 0xFF));
        out.push(u8((ws[j] >> 16) & 0xFF));
        out.push(u8((ws[j] >> 8) & 0xFF));
        out.push(u8(ws[j] & 0xFF));
    }
    return out;
}

