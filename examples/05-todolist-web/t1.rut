// t1.rut — the toy widget framework over the DOM crossings (phase 1 of
// the `todolist-ui-framework` batch). Lives example-local next to
// `store.rut`; the design is `docs/t1-design.md` (phase 0), which is
// authoritative — including its five recorded deviations:
//
//   * Checkbox lowers to a FRAMEWORK-OWNED button (`role=checkbox`
//     + `t1-check--on/--off`), never a native input — app state is
//     100% rut's, a toggle is one class-token patch;
//   * there is NO `ui_unlisten` — listener retirement is rut-side
//     table work (§4.3), the crossings stay ten;
//   * gap/pad/size lower to a FIXED utility-token ladder
//     (`t1-gap-8`, never arbitrary values, never a style attr);
//   * there is no closure-taking `Each` in v1 — rows are widgets
//     with keys, built by a plain loop;
//   * styling tokens are assert-able by the twin — the lowering's
//     token map is the whole styling contract (§5).
//
// THE SHAPE (§2.3, the Json ruling's idiom): one fat `Widget` struct +
// payloadless kind/variant enums (RFC 0006), recursive `Vec<Widget>`
// children (RFC 0009 §6), optional variants as `?T` with `nil`
// absence. Biz composes widgets with plain constructor fns and fluent
// builders and never names a tag, a class token, a `web::` crossing,
// or a listener id — tags and tokens live ONLY in the lowering table
// below (§2.1's law; phase 2's grep gate enforces it).
//
// THE PATCH (§4.2): `t1_render` diffs the new tree against the
// previous tree held in `T1Root` and applies minimal ops over the ten
// unchanged crossings — match by key at each level, patch-in-place
// deltas only (text / class tokens / value / placeholder), new keys
// create, gone keys remove, reorder re-appends survivors (appendChild
// moves — fake_dom.rs:324). Nothing changed = nothing fires, so a
// toggle patches one row's tokens instead of rebuilding the list.
//
// THE REGISTRY (§4.3): the framework owns ONE id->subject table.
// Listeners register exactly once per widget LIFETIME (on appear) and
// retire on remove; a fire on a retired or unknown id is LOUD.
//
// Element handles are keyed by PATH (`parent/child/...`), not by bare
// key: the crossings have no child enumeration, so `T1Root.els` is the
// only map of live handles, and path keys make two same-named
// descendants in different subtrees impossible to collide.
//
// One recorded addition to §7.1's `T1Root` shape: `lids` (path ->
// listener id). Retirement needs the path->id direction — `prev`,
// `els`, `regs` alone cannot answer "which ids did this removed
// subtree own". Framework-private, like the rest of the tables.

use pouch::{ Vec };
use nmapset::{ HashMap };
use web::{
    ui_get, ui_create, ui_set_text, ui_attr, ui_append, ui_remove,
    ui_set_input_value, ui_listen,
};

// ---- the widget vocabulary (§2.2/§2.3) ------------------------------

// The kinds — payloadless (RFC 0006), the json ruling's JTag shape.
enum WKind { Column, Row, Spacer, Card, Text, Button, Checkbox, Field }

// Text's variants: title (page header), body (a row title), done
// (struck, muted), pending (the `... title` in-flight row), muted
// (the counts line).
enum TVariant { Title, Body, Done, Pending, Muted }

// Button's variants: primary (Add), quiet (the row's mark and del).
enum BVariant { Primary, Quiet }

/// One widget — the fat `Json` shape: kinds as enums, irrelevant
/// fields defaulted, `children` making the tree recursive. Semantic
/// options ONLY: there is no `tag` field and no `class` field.
struct Widget {
    kind: WKind = WKind.Text;
    // -- controls
    text: str = "";
    tvar: ?TVariant = nil; // Text's variant
    bvar: ?BVariant = nil; // Button's variant
    on: bool = false; // Checkbox
    placeholder: str = "";
    value: str = ""; // Field (mirrors the draft)
    // -- semantic options
    subject: str = ""; // what this widget fires
    hook: str = ""; // stable test id (the lowering emits it as `id`)
    key: str = ""; // keyed-diff identity (defaults from hook)
    // -- layout data (the utility-token ladder's inputs)
    gap: i32 = 0;
    pad: i32 = 0;
    size: i32 = 0;
    // -- layout
    children: Vec<Widget> = Vec.new();
}

// ---- constructors (§2.4 — tur's helper-factory idiom: plain fns) ----

pub fn col() -> Widget {
    return Widget { kind: WKind.Column };
}

pub fn row() -> Widget {
    return Widget { kind: WKind.Row };
}

pub fn card() -> Widget {
    return Widget { kind: WKind.Card };
}

pub fn spacer(size: i32) -> Widget {
    return Widget { kind: WKind.Spacer, size: size };
}

pub fn text(t: str) -> Widget {
    return Widget { kind: WKind.Text, tvar: TVariant.Body, text: t };
}

pub fn done(t: str) -> Widget {
    return Widget { kind: WKind.Text, tvar: TVariant.Done, text: t };
}

pub fn title(t: str) -> Widget {
    return Widget { kind: WKind.Text, tvar: TVariant.Title, text: t };
}

pub fn pending(t: str) -> Widget {
    return Widget { kind: WKind.Text, tvar: TVariant.Pending, text: t };
}

pub fn muted(t: str) -> Widget {
    return Widget { kind: WKind.Text, tvar: TVariant.Muted, text: t };
}

pub fn btn(label: str) -> Widget {
    return Widget { kind: WKind.Button, bvar: BVariant.Primary, text: label };
}

pub fn quiet(label: str) -> Widget {
    return Widget { kind: WKind.Button, bvar: BVariant.Quiet, text: label };
}

pub fn check(on: bool) -> Widget {
    return Widget { kind: WKind.Checkbox, on: on };
}

pub fn field() -> Widget {
    return Widget { kind: WKind.Field };
}

// ---- the fluent builders (impl Widget, `mut self -> Self`) ----------

impl Widget {
    /// Append a child (no variadics — one at a time, per §2.4).
    fn w(mut self, child: Widget) -> Self {
        self.children.push(child);
        return self;
    }

    fn gap(mut self, n: i32) -> Self {
        self.gap = n;
        return self;
    }

    fn pad(mut self, n: i32) -> Self {
        self.pad = n;
        return self;
    }

    fn size(mut self, n: i32) -> Self {
        self.size = n;
        return self;
    }

    /// The stable test id — the lowering emits it as the `id` attr.
    fn hook(mut self, id: str) -> Self {
        self.hook = id;
        return self;
    }

    /// The keyed-diff identity; defaults from `hook` when unset.
    fn key(mut self, id: str) -> Self {
        self.key = id;
        return self;
    }

    /// What this widget fires — the event's SEMANTIC name.
    fn subject(mut self, s: str) -> Self {
        self.subject = s;
        return self;
    }

    /// The field's value (mirrors the app's draft).
    fn value(mut self, v: str) -> Self {
        self.value = v;
        return self;
    }

    /// The placeholder (Field).
    fn placeholder(mut self, p: str) -> Self {
        self.placeholder = p;
        return self;
    }

    /// The checkbox state (app state, rendered as a token).
    fn on(mut self, b: bool) -> Self {
        self.on = b;
        return self;
    }

    fn variant_primary(mut self) -> Self {
        self.bvar = BVariant.Primary;
        return self;
    }

    fn variant_quiet(mut self) -> Self {
        self.bvar = BVariant.Quiet;
        return self;
    }
}

// ---- the lowering (§4.1 — framework-private, biz never sees it) ----

/// One row of the lowering table: the tag, the space-joined class
/// tokens, and the event this widget listens to ("" = none).
struct Lowered {
    tag: str;
    cls: str;
    listens: str;
}

fn kind_name(w: Widget) -> str {
    return when (w.kind) {
        WKind.Column -> "Column",
        WKind.Row -> "Row",
        WKind.Spacer -> "Spacer",
        WKind.Card -> "Card",
        WKind.Text -> "Text",
        WKind.Button -> "Button",
        WKind.Checkbox -> "Checkbox",
        WKind.Field -> "Field",
    };
}

fn is_text(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Text -> true,
        else -> false,
    };
}

fn is_field(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Field -> true,
        else -> false,
    };
}

fn is_check(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Checkbox -> true,
        else -> false,
    };
}

fn is_button(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Button -> true,
        else -> false,
    };
}

/// Whose text content is real: Text's words and a Button's label.
/// (Checkbox's glyph is its class token — the framework owns the
/// visual; Field and the layout kinds carry no text.)
fn takes_text(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Text -> true,
        WKind.Button -> true,
        else -> false,
    };
}

fn takes_children(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Column -> true,
        WKind.Row -> true,
        WKind.Card -> true,
        else -> false,
    };
}

fn tag_of_kind(w: Widget) -> str {
    return when (w.kind) {
        WKind.Column -> "div",
        WKind.Row -> "div",
        WKind.Spacer -> "div",
        WKind.Card -> "div",
        WKind.Text -> "span",
        WKind.Button -> "button",
        WKind.Checkbox -> "button", // framework-owned, NOT a native input
        WKind.Field -> "input",
    };
}

fn tvar_token(v: TVariant) -> str {
    return when (v) {
        TVariant.Title -> "t1-text--title",
        TVariant.Body -> "t1-text--body",
        TVariant.Done -> "t1-text--done",
        TVariant.Pending -> "t1-text--pending",
        TVariant.Muted -> "t1-text--muted",
    };
}

fn bvar_token(v: BVariant) -> str {
    return when (v) {
        BVariant.Primary -> "t1-btn--primary",
        BVariant.Quiet -> "t1-btn--quiet",
    };
}

fn check_token(on: bool) -> str {
    if (on) {
        return "t1-check--on";
    }
    return "t1-check--off";
}

/// The FIXED utility ladder (§5): `gap(8)` -> `t1-gap-8`. 0 means "no
/// token"; anything off the ladder is a LOUD lowering trap — the token
/// set stays enumerable and twin-assertible, and no `style` attr ever
/// exists to smuggle CSS back into biz.
fn ladder_token(name: str, n: i32) -> str {
    if (n == 0) {
        return "";
    }
    if (n == 4) {
        return f"t1-{name}-4";
    }
    if (n == 8) {
        return f"t1-{name}-8";
    }
    if (n == 12) {
        return f"t1-{name}-12";
    }
    if (n == 16) {
        return f"t1-{name}-16";
    }
    panic(f"t1: {name} {n} is off the utility ladder — 0/4/8/12/16 only");
}

/// Space-join two tokens, skipping empties.
fn join_cls(a: str, b: str) -> str {
    if (a == "") {
        return b;
    }
    if (b == "") {
        return a;
    }
    return f"{a} {b}";
}

/// The lowering table — TOTAL over WKind. Also the boundary where the
/// fat struct's one dishonesty is caught: a control with children is
/// an app bug, and it panics here, named, at lowering time.
fn lower(w: Widget) -> Lowered {
    if (takes_children(w) == false) {
        if (w.children.len() > 0) {
            let name = kind_name(w);
            panic(f"t1: {name} takes no children — build layout with Column/Row/Card");
        }
    }

    let tag = tag_of_kind(w);
    let mut cls = when (w.kind) {
        WKind.Column -> "t1-col",
        WKind.Row -> "t1-row",
        WKind.Spacer -> "t1-spacer",
        WKind.Card -> "t1-card",
        WKind.Text -> "t1-text",
        WKind.Button -> "t1-btn",
        WKind.Checkbox -> "t1-check",
        WKind.Field -> "t1-field",
    };
    let mut listens = "";

    if (is_text(w)) {
        if (w.tvar == nil) {
            panic("t1: Text without a variant — construct with text/done/title/pending/muted");
        }
        let v: TVariant = w.tvar;
        cls = join_cls(cls, tvar_token(v));
    }
    if (is_button(w)) {
        if (w.bvar == nil) {
            panic("t1: Button without a variant — construct with btn/quiet");
        }
        let v: BVariant = w.bvar;
        cls = join_cls(cls, bvar_token(v));
        listens = "click";
    }
    if (is_check(w)) {
        cls = join_cls(cls, check_token(w.on));
        listens = "click";
    }
    if (is_field(w)) {
        listens = "input"; // the value rides the event (event-carried law)
    }

    cls = join_cls(cls, ladder_token("gap", w.gap));
    cls = join_cls(cls, ladder_token("pad", w.pad));
    cls = join_cls(cls, ladder_token("size", w.size));

    return Lowered { tag: tag, cls: cls, listens: listens };
}

/// The diff's identity for one child among its siblings: the explicit
/// key, else the hook, else the positional `@i` (unkeyed static
/// children match by position). The els table's key is the FULL PATH
/// from the root, so equal sibling names in different subtrees cannot
/// collide.
fn key_of(w: Widget, i: i32) -> str {
    if (w.key != "") {
        return w.key;
    }
    if (w.hook != "") {
        return w.hook;
    }
    return f"@{i}";
}

// ---- T1Root (§7.1) and the mount ------------------------------------

/// The patch state — plain rut data, a field of the app container
/// (RFC 0003 §1: the state crosses, the host re-passes it).
pub struct T1Root {
    parent: ?opaque = nil; // the mounted root element
    prev: ?Widget = nil; // the previous tree — the diff's left side
    els: ?HashMap<str, opaque> = nil; // path -> live handle (op application)
    regs: ?HashMap<str, str> = nil; // listener id (as crossed) -> subject
    lids: ?HashMap<str, i64> = nil; // path -> listener id (retirement)
}

/// Mount the framework on the element `root_id` (index.html's seeded
/// `#app`). Unknown ids trap loud at the crossing (`web::ui_get: no
/// element ...`) — a wiring bug is never a rut-side optional.
pub fn t1_mount(root_id: str) -> T1Root {
    let parent = ui_get(root_id);
    let els: HashMap<str, opaque> = HashMap.new();
    let regs: HashMap<str, str> = HashMap.new();
    let lids: HashMap<str, i64> = HashMap.new();
    return T1Root {
        parent: parent,
        els: els,
        regs: regs,
        lids: lids,
    };
}

// ---- the registry reads the framework needs -------------------------

/// The listener registry's one lookup, LOUD on a miss (§4.3): a firing
/// id that answers no subject is stale or unknown — an app bug is a
/// named trap, never a silent no-op.
pub fn t1_subject(r: ?T1Root, id: str) -> str {
    let mut regs: ?HashMap<str, str> = r.regs;
    let hit = regs.get(id);
    if (hit == nil) {
        panic(f"t1: listener '{id}' answered no subject — stale or unknown");
    }
    let s: str = hit;
    return s;
}

// ---- the keyed diff/patch (§4.2) ------------------------------------

/// THE render — once per turn, any turn. First render builds the whole
/// tree; every later render diffs against the previous tree and fires
/// only the deltas. Nothing here ever rebuilds a surviving node.
pub fn t1_render(mut r: ?T1Root, next: Widget) -> nil {
    let path = key_of(next, 0);
    let prev = r.prev;
    if (prev == nil) {
        create_subtree(r, next, path, r.parent);
    } else {
        let old: Widget = prev;
        if (key_of(old, 0) != path) {
            let a = key_of(old, 0);
            panic(f"t1: the root's key changed '{a}' -> '{path}' — remount is not a patch");
        }
        patch_tree(r, old, next, path);
    }
    r.prev = next;
}

/// The live handle for a path — LOUD when the framework's own table
/// has drifted (the patch named an element that never appeared).
fn els_handle(r: ?T1Root, path: str) -> opaque {
    let mut els: ?HashMap<str, opaque> = r.els;
    let hit = els.get(path);
    if (hit == nil) {
        panic(f"t1: no live handle for '{path}' — the patch named an element that never appeared");
    }
    let el: opaque = hit;
    return el;
}

fn els_drop(r: ?T1Root, path: str) -> nil {
    let mut els: ?HashMap<str, opaque> = r.els;
    els.remove(path);
}

/// First appearance: mint the element, the attrs (ui_attr only), the
/// text or value, the ONE listener of its lifetime, then the children
/// (parent-before-child, so handles stay live).
fn create_subtree(mut r: ?T1Root, w: Widget, path: str, parent: ?opaque) -> nil {
    let low = lower(w);
    let el: opaque = ui_create(low.tag);

    let mut els: ?HashMap<str, opaque> = r.els;
    els.put(path, el);

    if (w.hook != "") {
        ui_attr(el, "id", w.hook);
    }
    ui_attr(el, "class", low.cls);
    if (is_check(w)) {
        ui_attr(el, "role", "checkbox");
    }
    if (w.placeholder != "") {
        ui_attr(el, "placeholder", w.placeholder);
    }
    if (low.listens != "") {
        if (w.subject == "") {
            panic(f"t1: '{path}' listens but answers no subject — set .subject(...)");
        }
        let id: i64 = ui_listen(el, low.listens);
        let mut regs: ?HashMap<str, str> = r.regs;
        regs.put(f"{id}", w.subject);
        let mut lids: ?HashMap<str, i64> = r.lids;
        lids.put(path, id);
    }

    let p: opaque = parent;
    ui_append(p, el);

    if (takes_text(w)) {
        if (w.text != "") {
            ui_set_text(el, w.text);
        }
    }
    if (is_field(w)) {
        if (w.value != "") {
            ui_set_input_value(el, w.value);
        }
    }

    let kids: Vec<Widget> = w.children;
    for (let j = 0; j < kids.len(); j += 1) {
        create_subtree(r, kids[j], f"{path}/{key_of(kids[j], j)}", el);
    }
}

/// Patch one surviving node in place — deltas only. The class compare
/// is token-exact: a checkbox flip is one `ui_attr`, a text change is
/// one `ui_set_text`, and a Field's value rides the input crossing.
fn patch_tree(mut r: ?T1Root, old: Widget, new: Widget, path: str) -> nil {
    if (kind_name(old) != kind_name(new)) {
        let a = kind_name(old);
        let b = kind_name(new);
        panic(f"t1: '{path}' changed kind {a} -> {b} — keys are identity");
    }
    let el = els_handle(r, path);
    let low_old = lower(old);
    let low_new = lower(new);

    if (takes_text(new)) {
        if (old.text != new.text) {
            ui_set_text(el, new.text);
        }
    }
    if (low_old.cls != low_new.cls) {
        ui_attr(el, "class", low_new.cls);
    }
    if (is_field(new)) {
        if (old.placeholder != new.placeholder) {
            ui_attr(el, "placeholder", new.placeholder);
        }
        if (old.value != new.value) {
            ui_set_input_value(el, new.value);
        }
    }

    patch_children(r, old, new, path, el);
}

fn key_index_of(v: Vec<str>, k: str) -> i32 {
    for (let i = 0; i < v.len(); i += 1) {
        if (v[i] == k) {
            return i;
        }
    }
    return -1;
}

fn old_index_of(olds: Vec<Widget>, k: str) -> i32 {
    for (let j = 0; j < olds.len(); j += 1) {
        if (key_of(olds[j], j) == k) {
            return j;
        }
    }
    return -1;
}

/// `cur` with the entry at `p` moved to the back — the model of what
/// `ui_append` does to a surviving child (appendChild MOVES).
fn key_moved_to_back(v: Vec<str>, p: i32) -> Vec<str> {
    let mut out: Vec<str> = Vec.new();
    let moved = v[p];
    for (let i = 0; i < v.len(); i += 1) {
        if (i != p) {
            out.push(v[i]);
        }
    }
    out.push(moved);
    return out;
}

/// The children level of the diff: match by key, patch in place,
/// create the new, remove the gone, and re-append survivors whose
/// position broke (reorder = appends, zero creates, zero re-listens).
///
/// `cur` models the live child order. A child is ALREADY in place when
/// its live predecessor is the previously-placed new key; anything
/// else moves to the back with one append. Walks the new order left to
/// right, so after the walk the model IS the new order.
fn patch_children(mut r: ?T1Root, old: Widget, new: Widget, path: str, parent: ?opaque) -> nil {
    let olds: Vec<Widget> = old.children;
    let news: Vec<Widget> = new.children;

    let mut new_keys: Vec<str> = Vec.new();
    for (let i = 0; i < news.len(); i += 1) {
        new_keys.push(key_of(news[i], i));
    }

    let mut cur: Vec<str> = Vec.new();
    for (let j = 0; j < olds.len(); j += 1) {
        cur.push(key_of(olds[j], j));
    }

    for (let i = 0; i < news.len(); i += 1) {
        let k = new_keys[i];
        let cpath = f"{path}/{k}";
        let at = old_index_of(olds, k);
        if (at >= 0) {
            patch_tree(r, olds[at], news[i], cpath);
            // in place iff the live predecessor is the previous new key
            let mut pred = "";
            if (i > 0) {
                pred = new_keys[i - 1];
            }
            let live_at = key_index_of(cur, k);
            let mut in_place = false;
            if (live_at == 0) {
                if (pred == "") {
                    in_place = true;
                }
            } else {
                if (live_at > 0) {
                    if (cur[live_at - 1] == pred) {
                        in_place = true;
                    }
                }
            }
            if (in_place == false) {
                ui_append(parent, els_handle(r, cpath));
                cur = key_moved_to_back(cur, live_at);
            }
        } else {
            create_subtree(r, news[i], cpath, parent);
            cur.push(k);
        }
    }

    // gone keys: fetch the live handle, retire the subtree's table
    // rows, then detach — the registry tracks live ids only
    for (let j = 0; j < olds.len(); j += 1) {
        let ok = key_of(olds[j], j);
        if (key_index_of(new_keys, ok) < 0) {
            let cpath = f"{path}/{ok}";
            let child = els_handle(r, cpath);
            retire_subtree(r, olds[j], cpath);
            ui_remove(parent, child);
        }
    }
}

/// Retirement (§4.3 — the no-ui_unlisten law's rut-side half): drop
/// every live handle and every listener row the removed subtree owns,
/// so the registry tracks LIVE ids only.
fn retire_subtree(mut r: ?T1Root, w: Widget, path: str) -> nil {
    els_drop(r, path);
    let low = lower(w);
    if (low.listens != "") {
        let mut lids: ?HashMap<str, i64> = r.lids;
        let hit = lids.get(path);
        if (hit != nil) {
            let id: i64 = hit;
            let mut regs: ?HashMap<str, str> = r.regs;
            regs.remove(f"{id}");
            lids.remove(path);
        }
    }
    let kids: Vec<Widget> = w.children;
    for (let j = 0; j < kids.len(); j += 1) {
        retire_subtree(r, kids[j], f"{path}/{key_of(kids[j], j)}");
    }
}
