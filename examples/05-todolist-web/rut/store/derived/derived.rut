// derived.rut — the DERIVED layer (restructure survey §4.3/§4.4): the
// declared dependency DAG and the within-turn refresh machinery.
//
// rut has no closures to auto-track through (survey §1.3), so a
// derived DECLARES its deps and its recompute as data + a trait impl —
// jotai's `derive(() => ...)` with the read graph made explicit. This
// is the one place the design is deliberately LESS clever than tur
// (whose tracker_stack discovers edges by intercepting reads inside a
// running closure): rut's dep edges are a static declaration the
// twins can assert on, and a stale declaration is a FAILING TEST, not
// a silent wrong render (§4.4). The dependency GRAPH survives tur
// intact; only its discovery mechanism changes. And because the graph
// is declared (hence acyclic by construction — the twins pin it), tur's
// `in_flight_derives` cycle guard has NOTHING to guard: NOT
// TRANSFERRED, like the SubscriberGraph, watch(), mutation atoms and
// the multi-store split (the survey's rejections, all law).
//
// THE TRAIT. Generic over the store type — the domain's deriveds impl
// `Derived<TodoStore>`; the store-test fixture impls its own. A store
// holds its deriveds in DECLARATION ORDER (a `Vec<Derived<Store>>` —
// trait-typed values, vtable dispatch) and the flush is one pass in
// that order (survey §4.3's refresh; declaration order is topological
// — derived-on-derived needs no re-sort):
//
//   rail.drain();                    // the turn's writes, taken once
//   for (let d of self.deriveds) {   // declaration order
//       if (d.stale(self)) { refresh }   // recompute at most once
//   }
//
// The staleness test is the GENERATION RAIL: `stale(d)` iff any dep's
// current gen ≠ the gen recorded in the derived's `seen` — tur's
// `Slot.epoch` check, minus the multi-store walks. `Seen` below is
// that bookkeeping, shared by every domain derived so the per-dep
// machinery lives here, in the store layer, not in the domain.
//
// DERIVED FRESHNESS IS NOT A RENDER GATE (survey §4.3): refresh runs,
// then render runs — once per turn, unconditionally. This layer adds
// bookkeeping BEFORE the view; it never adds conditionality around
// the diff, and nothing here pushes to the DOM (the turn law).

use pouch::{ Vec };
use nmapset::{ HashMap };
use atom::{ Rail };

// ---- the declared DAG (the dependency tracking) ----------------------

/// A derived atom, declared: its name, its DEPS (the declared DAG —
/// atom names in the store's rail), and its two rail-facing halves
/// (the staleness test and the recompute). The domain impls read
/// their dep atoms and store one cached value; the flush calls the
/// trait through the store's declaration-order Vec.
pub trait Derived<S> {
    /// The derived's name — the fixture twins read it; the DAG's node
    /// identity in the tests.
    fn dname(self) -> str;

    /// The DECLARED dependencies — atom names in the rail. A write to
    /// a name NOT in here must not recompute this derived (the
    /// per-dep-staleness twin pins the declaration's truth).
    fn deps(self) -> Vec<str>;

    /// The staleness test: true iff any declared dep's current rail
    /// generation differs from the generation recorded at the last
    /// recompute (or the derived never computed).
    fn stale(self, st: S) -> bool;

    /// The recompute: read the dep atoms' CURRENT values, store the
    /// cached result, note the dep generations. Runs AT MOST ONCE per
    /// turn (the flush's one pass guarantees it — the within-turn
    /// freshness law).
    fn refresh(mut self, st: S) -> nil;
}

// ---- the seen-generations bookkeeping (tur's Slot.epoch) -------------

/// The dep generations a derived last computed at, keyed by the
/// declared dep names. `refresh` notes, `stale` compares — the exact
/// tur Slot shape (value + epoch), with the value living in the
/// domain derived and the epochs living here.
pub class Seen {
    m: HashMap<str, i64>; // dep name -> the gen at last recompute
}

impl Seen {
    pub fn new() -> Self {
        return Self { m: HashMap.new() };
    }

    /// Record the current generation of every declared dep — called
    /// by a derived's `refresh` AFTER it stored its fresh value, so
    /// the cache's epoch line is the one this recompute happened at.
    pub fn note(mut self, deps: Vec<str>, rail: Rail) -> nil {
        for (let d of deps) {
            self.m.put(d, rail.gen_of(d));
        }
    }

    /// The staleness test over the declared deps: never-computed is
    /// stale (no entry); any dep whose rail gen moved since `note`
    /// is stale. A dep NOT in `deps` cannot make this true — the
    /// per-dep law the twins pin.
    pub fn stale(self, deps: Vec<str>, rail: Rail) -> bool {
        for (let d of deps) {
            let g = self.m.get(d);
            if (g == nil) {
                return true;
            }
            if (g != rail.gen_of(d)) {
                return true;
            }
        }
        return false;
    }
}
