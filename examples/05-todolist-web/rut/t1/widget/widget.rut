// widget.rut — the Widget TYPE's package (t1's data layer, survey
// §3.1): the fat `Json`-shape struct, the payloadless kind/variant
// enums (RFC 0006), the fluent builders, and the predicates the
// lowering and the core read. Everything here is data + fluent
// construction — no state, no crossings, no tags, no tokens.
//
// The inherent impl LIVES HERE — the type's module (rut-lir
// collect.rs's law, RFC 0012 §2): the fluent `.w()/.gap()/.hook()`
// methods cannot live anywhere else, which is the law-merge that
// folded the old sketch's "builders" file into this package. The free
// CONSTRUCTORS are not methods — they are the component vocabulary
// (`rut/components/*`), the layer biz actually speaks.
//
// Members marked `pub` are exactly the surface the other packages
// bind: the type + enums (components construct; the app names the
// type), the fluent builders (every consumer chains them), and the
// predicates (the lowering's table and the core's diff read them
// across the link). Fields have no member visibility — dataclasses
// are all-public (RFC 0009); privacy at t1 is kept by PACKAGE
// placement, not by field spelling.

use pouch::{ Vec };

// ---- the widget vocabulary (§2.2/§2.3) ------------------------------

// The kinds — payloadless (RFC 0006), the json ruling's JTag shape.
pub enum WKind { Column, Row, Spacer, Card, Text, Button, Checkbox, Field }

// Text's variants: title (page header), body (a row title), done
// (struck, muted), pending (the `... title` in-flight row), muted
// (the counts line).
pub enum TVariant { Title, Body, Done, Pending, Muted }

// Button's variants: primary (Add), quiet (the row's mark and del).
pub enum BVariant { Primary, Quiet }

/// One widget — the fat `Json` shape: kinds as enums, irrelevant
/// fields defaulted, `children` making the tree recursive. Semantic
/// options ONLY: there is no `tag` field and no `class` field.
pub struct Widget {
    kind: WKind = WKind.Text;
    // -- controls
    text: str = "";
    tvar: ?TVariant = nil; // Text's variant
    bvar: ?BVariant = nil; // Button's variant
    on: bool = false; // Checkbox
    placeholder: str = "";
    value: str = ""; // Field (mirrors the draft)
    // -- semantic options
    subject: str = ""; // what this widget fires
    hook: str = ""; // stable test id (the lowering emits it as `id`)
    key: str = ""; // keyed-diff identity (defaults from hook)
    // -- layout data (the utility-token ladder's inputs)
    gap: i32 = 0;
    pad: i32 = 0;
    size: i32 = 0;
    // -- layout
    children: Vec<Widget> = Vec.new();
}

// ---- the fluent builders (impl Widget, `mut self -> Self`) ----------
// Inherent impls live in the type's module — this one. The
// constructors live in the component packages. No `pub` is spelled on
// these methods: Widget is a DATACLASS (RFC 0009) — all members are
// public, and member visibility is not spellable; the fluent surface
// crosses the link by that law.

impl Widget {
    /// Append a child (no variadics — one at a time, per §2.4).
    fn w(mut self, child: Widget) -> Self {
        self.children.push(child);
        return self;
    }

    fn gap(mut self, n: i32) -> Self {
        self.gap = n;
        return self;
    }

    fn pad(mut self, n: i32) -> Self {
        self.pad = n;
        return self;
    }

    fn size(mut self, n: i32) -> Self {
        self.size = n;
        return self;
    }

    /// The stable test id — the lowering emits it as the `id` attr.
    fn hook(mut self, id: str) -> Self {
        self.hook = id;
        return self;
    }

    /// The keyed-diff identity; defaults from `hook` when unset.
    fn key(mut self, id: str) -> Self {
        self.key = id;
        return self;
    }

    /// What this widget fires — the event's SEMANTIC name.
    fn subject(mut self, s: str) -> Self {
        self.subject = s;
        return self;
    }

    /// The field's value (mirrors the app's draft).
    fn value(mut self, v: str) -> Self {
        self.value = v;
        return self;
    }

    /// The placeholder (Field).
    fn placeholder(mut self, p: str) -> Self {
        self.placeholder = p;
        return self;
    }

    /// The checkbox state (app state, rendered as a token).
    fn on(mut self, b: bool) -> Self {
        self.on = b;
        return self;
    }

    fn variant_primary(mut self) -> Self {
        self.bvar = BVariant.Primary;
        return self;
    }

    fn variant_quiet(mut self) -> Self {
        self.bvar = BVariant.Quiet;
        return self;
    }
}

// ---- the predicates (read across the link by lowering + core) -------

pub fn kind_name(w: Widget) -> str {
    return when (w.kind) {
        WKind.Column -> "Column",
        WKind.Row -> "Row",
        WKind.Spacer -> "Spacer",
        WKind.Card -> "Card",
        WKind.Text -> "Text",
        WKind.Button -> "Button",
        WKind.Checkbox -> "Checkbox",
        WKind.Field -> "Field",
    };
}

pub fn is_text(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Text -> true,
        else -> false,
    };
}

pub fn is_field(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Field -> true,
        else -> false,
    };
}

pub fn is_check(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Checkbox -> true,
        else -> false,
    };
}

pub fn is_button(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Button -> true,
        else -> false,
    };
}

/// Whose text content is real: Text's words and a Button's label.
/// (Checkbox's glyph is its class token — the framework owns the
/// visual; Field and the layout kinds carry no text.)
pub fn takes_text(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Text -> true,
        WKind.Button -> true,
        else -> false,
    };
}

pub fn takes_children(w: Widget) -> bool {
    return when (w.kind) {
        WKind.Column -> true,
        WKind.Row -> true,
        WKind.Card -> true,
        else -> false,
    };
}

/// The diff's identity for one child among its siblings: the explicit
/// key, else the hook, else the positional `@i` (unkeyed static
/// children match by position). The els table's key is the FULL PATH
/// from the root, so equal sibling names in different subtrees cannot
/// collide.
pub fn key_of(w: Widget, i: i32) -> str {
    if (w.key != "") {
        return w.key;
    }
    if (w.hook != "") {
        return w.hook;
    }
    return f"@{i}";
}
