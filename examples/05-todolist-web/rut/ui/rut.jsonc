{
  // ui/ — the UI-FRAMEWORK package (the two-package law): the atom store
  // machinery + the t1 widget framework + the component vocabulary. ONE
  // directory, ONE module, SEVERAL files (the multi-lib
  // entry): `entry.libs` names the section files, the base splices first,
  // the array IS the order. See ui.rut's header for the store's surface
  // law and the file map.
  //
  // `web` is the HOST DECL surface: the embedder
  // registers it in both lanes (src/mount.rs), so it rides no manifest
  // path here — the registration prefix every crossing carries is `web`.
  "name": "ui",
  "entry": {
    "lib": "./ui.rut",
    "libs": [
      "./store.rut",
      "./widget.rut",
      "./lowering.rut",
      "./diff.rut",
      "./components.rut"
    ]
  },
  "deps": {
    // THE STD CLOSURE, from the CDN — the same pinned jsDelivr rows biz
    // spells (first-mount-wins: whichever package mounts first serves
    // both, one archive per name)
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v8/dist/std/pouch.rutbundle", "sha256": "d0bc36bb385bcc14e76d6275c92613edeab2d46ae0d162f7104282caef1a12cd" },
    "nmapset": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v8/dist/std/nmapset.rutbundle", "sha256": "160b70cd5f3ae9275ee50619ec884afdf50d93a5486115fe7cf0bf16f5030b10" }
  }
}
