{
  // ui/ — the UI-FRAMEWORK package (the two-package law): the atom store
  // machinery + the t1 widget framework + the component vocabulary. ONE
  // directory, ONE module, a FILE-MODULE TREE: the root module is
  // `mod.rut` (the surface law), and `mod` declarations mount the
  // children — `store/`, `widget/`, `lowering/`, `diff/`,
  // `components/` (each its own `mod.rut`).
  //
  // `web` is the HOST DECL surface: the embedder
  // registers it in both lanes (src/mount.rs), so it rides no manifest
  // path here — the registration prefix every crossing carries is `web`.
  "name": "ui",
  "deps": {
    // THE STD CLOSURE, from the CDN — the same pinned jsDelivr rows biz
    // spells (first-mount-wins: whichever package mounts first serves
    // both, one archive per name)
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v9/dist/std/pouch.rutbundle", "sha256": "2f6e6a201083c012edb5362d1ed79bce409747d68c48ff48f23383be4cc54466" },
    "nmapset": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v9/dist/std/nmapset.rutbundle", "sha256": "62b92c34beeda942ffb5cbf8ca84146c56bb33131ac3c0c0a0f8f9ebd643aa02" }
  }
}
