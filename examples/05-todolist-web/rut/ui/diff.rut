// =====================================================================
// §4 THE DIFF CORE (the old t1/core — verbatim shape)
// =====================================================================

// T1Root — the patch state with its framework-private tables — the
// mount, the listener registry, the keyed diff, and retirement. The
// design is docs/t1-design.md (phase 0), authoritative, including its
// five recorded deviations (checkbox-as-button, no ui_unlisten,
// patch-in-place, no closure Each, enumerable tokens).
//
// THE PATCH (§4.2): t1_render diffs the new tree against the previous
// tree held in T1Root and applies minimal ops over the ten unchanged
// crossings — match by key at each level, patch-in-place deltas only,
// new keys create, gone keys remove, reorder re-appends survivors.
// Nothing changed = nothing fires.
//
// THE REGISTRY (§4.3): the framework owns ONE id->mutation table.
// Listeners register exactly once per widget LIFETIME and retire on
// remove; a fire on a retired or unknown id is LOUD. The row is the
// widget's event mutation (tur's onClick/onInput prop) — the handle
// carries its store, so the framework never holds a store itself.
//
// Element handles are keyed by PATH; `lids` (path -> listener id)
// backs retirement. One stateful module on purpose: the tables are
// written across mount/render/retire and module-private is the only
// privacy rut lands — the sections share this file so the tables stay
// framework-private for real (the old package split's recorded reason,
// kept by the merge).

// ---- T1Root (§7.1) and the mount ------------------------------------

/// One registered event wiring — DATA, never a runtime closure: the
/// detail-fed arm (on_click/on_input) or the arg-bound arm (on_row +
/// its arg, tur's captured index). `ev_run` picks the arm and RUNS it
/// through the handle's own store (the ONE write lane).
pub struct Ev {
    m: ?Mutation<str, opaque> = nil; // the detail-fed arm
    row: ?Mutation<i64, opaque> = nil; // the arg-bound arm
    arg: i64 = 0; // the bound arg
}

/// Run a registered wiring: the detail arm if present, else the bound
/// arm with its arg. The answer passes through (the booking box).
pub fn ev_run(e: Ev, detail: str) -> opaque {
    if (e.m != nil) {
        let m: Mutation<str, opaque> = e.m;
        return m.run(detail);
    }
    let r: Mutation<i64, opaque> = e.row;
    return r.run(e.arg);
}

/// The patch state — plain rut data, a field of the app container
/// (RFC 0003 §1: the state crosses, the host re-passes it).
pub struct T1Root {
    parent: opaque; // the mounted root element
    prev: ?Widget = nil; // the previous tree — the diff's left side
    els: HashMap<str, opaque>; // path -> live handle (ops application)
    regs: HashMap<str, Ev>; // listener id (as crossed) -> the
    // widget's event wiring (a data-shaped binding)
    lids: HashMap<str, i64>; // path -> listener id (retirement)
}

/// Mount the framework on the element `root_id` (index.html's seeded
/// `#app`). Unknown ids trap loud at the crossing.
pub fn t1_mount(root_id: str) -> T1Root {
    let parent = ui_get(root_id);
    let els: HashMap<str, opaque> = HashMap.new();
    let regs: HashMap<str, Ev> = HashMap.new();
    let lids: HashMap<str, i64> = HashMap.new();
    return T1Root {
        parent: parent,
        els: els,
        regs: regs,
        lids: lids,
    };
}

// ---- the registry reads the framework needs -------------------------

/// The listener registry's one resolution, LOUD on a miss (§4.3): run
/// the firing widget's event mutation with the event's detail — the
/// mutation carries its store, so the run rides the ONE write lane
/// (the cycle guard, the in-flight set, all of it). The mutation's
/// answer passes through: the app's event wrappers return the BOOKING
/// (an `opaque(Req)`) or `opaque(nil)` when there is nothing to book.
pub fn t1_event(r: T1Root, id: str, detail: str) -> opaque {
    let mut regs: HashMap<str, Ev> = r.regs;
    let hit = regs.get(id);
    if (hit == nil) {
        panic(f"t1: listener '{id}' answers no mutation — stale or unknown");
    }
    let e: Ev = hit;
    return ev_run(e, detail);
}

// ---- the keyed diff/patch (§4.2) ------------------------------------

/// Materialize the reactive props (tur's reads-as-props): a `live`
/// node is REPLACED by its resolved subtree; `text$`/`value$` resolve
/// into the concrete fields — THE RENDER DOOR, where pull-on-read
/// meets the page (a derived recomputes here iff its deps moved, at
/// most once per write-set; the view that built this tree read
/// nothing). The resolved tree is what the diff sees and what `prev`
/// stores, so reactive and literal arms compare alike.
fn resolve_tree(w: Widget) -> Widget {
    let mut out = w;
    if (out.live != nil) {
        let d: Derived<Widget> = out.live;
        return resolve_tree(d.get());
    }
    if (out.text$ != nil) {
        let d: Derived<str> = out.text$;
        out.text = d.get();
    }
    if (out.value$ != nil) {
        let d: Derived<str> = out.value$;
        out.value = d.get();
    }
    let kids: Vec<Widget> = out.children;
    let mut resolved: Vec<Widget> = Vec.new();
    for (let k of kids) {
        resolved.push(resolve_tree(k));
    }
    out.children = resolved;
    return out;
}

/// THE render — once per turn, any turn. First render builds the whole
/// tree; every later render diffs against the previous tree and fires
/// only the deltas.
pub fn t1_render(mut r: T1Root, next: Widget) -> nil {
    let next = resolve_tree(next);
    let path = key_of(next, 0);
    let prev = r.prev;
    if (prev == nil) {
        create_subtree(r, next, path, r.parent);
    } else {
        let old: Widget = prev;
        if (key_of(old, 0) != path) {
            let a = key_of(old, 0);
            panic(f"t1: the root's key changed '{a}' -> '{path}' — remount is not a patch");
        }
        patch_tree(r, old, next, path);
    }
    r.prev = next;
}

/// The live handle for a path — LOUD when the framework's own table
/// has drifted.
fn els_handle(r: T1Root, path: str) -> opaque {
    let mut els: HashMap<str, opaque> = r.els;
    let hit = els.get(path);
    if (hit == nil) {
        panic(f"t1: no live handle for '{path}' — the patch named an element that never appeared");
    }
    let el: opaque = hit;
    return el;
}

fn els_drop(r: T1Root, path: str) -> nil {
    let mut els: HashMap<str, opaque> = r.els;
    els.remove(path);
}

/// First appearance: mint the element, the attrs, the text or value,
/// the ONE listener of its lifetime, then the children.
fn create_subtree(mut r: T1Root, w: Widget, path: str, parent: opaque) -> nil {
    let low = lower(w);
    let el: opaque = ui_create(low.tag);

    let mut els: HashMap<str, opaque> = r.els;
    els.put(path, el);

    if (w.hook != "") {
        ui_attr(el, "id", w.hook);
    }
    ui_attr(el, "class", low.cls);
    if (is_check(w)) {
        ui_attr(el, "role", "checkbox");
    }
    if (w.placeholder != "") {
        ui_attr(el, "placeholder", w.placeholder);
    }
    if (low.listens != "") {
        // the event wiring: on_input when the widget takes input, else
        // on_click, else the arg-bound on_row — at least one arm must
        // exist (the vocabulary enforces the pairing: fields take
        // on_input; buttons/checks take on_click or on_row)
        let mut e = Ev { };
        if (w.on_input != nil) {
            e.m = w.on_input;
        } else {
            if (w.on_click != nil) {
                e.m = w.on_click;
            } else {
                if (w.on_row != nil) {
                    e.row = w.on_row;
                    e.arg = w.row_arg;
                } else {
                    panic(f"t1: '{path}' listens but carries no mutation — set .on_click(...)/.on_input(...)/.on_row(...)");
                }
            }
        }
        let id: i64 = ui_listen(el, low.listens);
        let mut regs: HashMap<str, Ev> = r.regs;
        regs.put(f"{id}", e);
        let mut lids: HashMap<str, i64> = r.lids;
        lids.put(path, id);
    }

    ui_append(parent, el);

    if (takes_text(w)) {
        if (w.text != "") {
            ui_set_text(el, w.text);
        }
    }
    if (is_field(w)) {
        if (w.value != "") {
            ui_set_input_value(el, w.value);
        }
    }

    let kids: Vec<Widget> = w.children;
    for (let j = 0; j < kids.len(); j += 1) {
        create_subtree(r, kids[j], f"{path}/{key_of(kids[j], j)}", el);
    }
}

/// Patch one surviving node in place — deltas only.
fn patch_tree(mut r: T1Root, old: Widget, new: Widget, path: str) -> nil {
    if (kind_name(old) != kind_name(new)) {
        let a = kind_name(old);
        let b = kind_name(new);
        panic(f"t1: '{path}' changed kind {a} -> {b} — keys are identity");
    }
    let el = els_handle(r, path);
    let low_old = lower(old);
    let low_new = lower(new);

    if (takes_text(new)) {
        if (old.text != new.text) {
            ui_set_text(el, new.text);
        }
    }
    if (low_old.cls != low_new.cls) {
        ui_attr(el, "class", low_new.cls);
    }
    if (is_field(new)) {
        if (old.placeholder != new.placeholder) {
            ui_attr(el, "placeholder", new.placeholder);
        }
        if (old.value != new.value) {
            ui_set_input_value(el, new.value);
        }
    }

    patch_children(r, old, new, path, el);
}

fn key_index_of(v: Vec<str>, k: str) -> i32 {
    for (let i = 0; i < v.len(); i += 1) {
        if (v[i] == k) {
            return i;
        }
    }
    return -1;
}

fn old_index_of(olds: Vec<Widget>, k: str) -> i32 {
    for (let j = 0; j < olds.len(); j += 1) {
        if (key_of(olds[j], j) == k) {
            return j;
        }
    }
    return -1;
}

/// `cur` with the entry at `p` moved to the back — the model of what
/// ui_append does to a surviving child (appendChild MOVES).
fn key_moved_to_back(v: Vec<str>, p: i32) -> Vec<str> {
    let mut out: Vec<str> = Vec.new();
    let moved = v[p];
    for (let i = 0; i < v.len(); i += 1) {
        if (i != p) {
            out.push(v[i]);
        }
    }
    out.push(moved);
    return out;
}

/// The children level of the diff: match by key, patch in place,
/// create the new, remove the gone, and re-append survivors whose
/// position broke (reorder = appends, zero creates, zero re-listens).
fn patch_children(mut r: T1Root, old: Widget, new: Widget, path: str, parent: opaque) -> nil {
    let olds: Vec<Widget> = old.children;
    let news: Vec<Widget> = new.children;

    let mut new_keys: Vec<str> = Vec.new();
    for (let i = 0; i < news.len(); i += 1) {
        new_keys.push(key_of(news[i], i));
    }

    let mut cur: Vec<str> = Vec.new();
    for (let j = 0; j < olds.len(); j += 1) {
        cur.push(key_of(olds[j], j));
    }

    for (let i = 0; i < news.len(); i += 1) {
        let k = new_keys[i];
        let cpath = f"{path}/{k}";
        let at = old_index_of(olds, k);
        if (at >= 0) {
            patch_tree(r, olds[at], news[i], cpath);
            // in place iff the live predecessor is the previous new key
            let mut pred = "";
            if (i > 0) {
                pred = new_keys[i - 1];
            }
            let live_at = key_index_of(cur, k);
            let mut in_place = false;
            if (live_at == 0) {
                if (pred == "") {
                    in_place = true;
                }
            } else {
                if (live_at > 0) {
                    if (cur[live_at - 1] == pred) {
                        in_place = true;
                    }
                }
            }
            if (in_place == false) {
                ui_append(parent, els_handle(r, cpath));
                cur = key_moved_to_back(cur, live_at);
            }
        } else {
            create_subtree(r, news[i], cpath, parent);
            cur.push(k);
        }
    }

    // gone keys: fetch the live handle, retire the subtree's table
    // rows, then detach — the registry tracks live ids only
    for (let j = 0; j < olds.len(); j += 1) {
        let ok = key_of(olds[j], j);
        if (key_index_of(new_keys, ok) < 0) {
            let cpath = f"{path}/{ok}";
            let child = els_handle(r, cpath);
            retire_subtree(r, olds[j], cpath);
            ui_remove(parent, child);
        }
    }
}

/// Retirement (§4.3 — the no-ui_unlisten law's rut-side half): drop
/// every live handle and every listener row the removed subtree owns.
fn retire_subtree(mut r: T1Root, w: Widget, path: str) -> nil {
    els_drop(r, path);
    let low = lower(w);
    if (low.listens != "") {
        let mut lids: HashMap<str, i64> = r.lids;
        let hit = lids.get(path);
        if (hit != nil) {
            let id: i64 = hit;
            let mut regs: HashMap<str, Ev> = r.regs;
            regs.remove(f"{id}");
            lids.remove(path);
        }
    }
    let kids: Vec<Widget> = w.children;
    for (let j = 0; j < kids.len(); j += 1) {
        retire_subtree(r, kids[j], f"{path}/{key_of(kids[j], j)}");
    }
}

