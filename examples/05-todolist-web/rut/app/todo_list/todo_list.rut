// todo_list.rut — THE LIST (TodoList, the survey §3 tree's view
// layer): one keyed row per committed todo (commit order), then a
// pending line per outstanding add (book order) — the round trip made
// visible in the tree.
//
// THE TABLES. The §7.3 subject tables are built HERE, beside the
// `.subject(...)` calls they mirror — drop-then-refill, fresh per
// render, so the tables track THIS render's rows only and a stale
// subject is a LOUD miss, the phase-1 action table's own law. rut has
// no module state (RFC 0003 §1), so the tables RETURN to the app,
// which owns them on the container: todo_list is pure but for the
// maps it mints and hands back.
//
// This is the old `todolist.rut`'s `todo_list` fn, promoted to its
// own package (the module law; and the view packages carry unambiguous
// names — the component `row` took the short one, survey §3.3).

use todos::{ TodoStore };
use widget::{ Widget };
use nmapset::{ HashMap };
use card::{ card };
use text::{ pending };
use todo_row::{ todo_row };

/// The list tree plus this render's two subject tables (toggle, then
/// remove) — the caller drops them onto the container. The tables are
/// the keyed-collection family spelling (`HashMap<str, i64>` — the
/// generic class; one name, one decl).
pub fn todo_list(store: ?TodoStore) -> (Widget, HashMap<str, i64>, HashMap<str, i64>) {
    let mut st: ?TodoStore = store;
    let mut tg: HashMap<str, i64> = HashMap.new();
    let mut rm: HashMap<str, i64> = HashMap.new();

    let mut list = card().pad(12).gap(8).hook("list");
    for (let t of st.todos()) {
        tg.put(f"toggle:{t.id}", t.id);
        rm.put(f"remove:{t.id}", t.id);
        list.w(todo_row(t, st.has_pending_for(t.id)));
    }
    for (let p of st.pending_add_titles()) {
        list.w(pending(f"... {p}"));
    }

    return (list, tg, rm);
}
