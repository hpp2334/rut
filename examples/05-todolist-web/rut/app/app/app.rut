// app.rut — the todolist APP (the restructure's project entry, survey
// §3): the rewrite ON t1, now honestly multi-package. The hand-built
// DOM shape — clear-and-rebuild paints, per-paint listener churn, the
// packed action numbers — is GONE. This package composes WIDGETS and
// routes SEMANTIC subjects; the framework owns the tags, the tokens,
// the listener registry, and the keyed diff (`rut/t1/*`); the store
// owns the list and the request table (`rut/store/todos`); the two
// view builders are their own packages (`todo_list`, `todo_row`).
//
// THE LAW (design §2.1, enforced by tests/app_law.rs over this
// package). Biz code never sinks to the DOM's vocabulary: the import
// set is EXACT — the widget vocabulary, the store's domain types, the
// framework's four names, and ONE crossing name, `tim_after`, imported
// by name from the `web` host pkg (the host's time, RFC 0018's own
// law; the phase-1 shape resolved it through the app unit's bound
// surface — the restructure imports it honestly). No tag or style
// token is spelled, no listener id is named, no second crossing can
// ride in: the gate pins the set.
//
// THE STATE MODEL (unchanged, RFC 0003 §1). rut has no mutable module
// state, so the state lives in ONE container this module builds at
// boot and the HOST holds:
//
//   main -> opaque(AppRoot)   the host keeps it; the pump re-passes it
//                             on EVERY turn
//   on_event(c, kind, s, d)   the one re-entry point; kind 1 = a DOM
//                             event row, kind 2 = a timer answer.
//                             Returns (opaque(c), "") — or (nil, why)
//                             on a soft failure (the entry-err shape
//                             (?opaque, str))
//
// The container is a shared cell (RFC 0016): every turn mints write
// access with one `let mut` and the writes survive the turn. T1Root —
// the framework's patch state — is a FIELD of the container (§7.1),
// exactly like the store and the draft.
//
// THE COMPONENTS (the only vocabulary this package speaks):
//
//   view(r)                  App — the page tree: the head row, the
//                            counts line, the card of rows + flights
//   todo_list(store)         TodoList — one keyed row per committed
//                            todo, one line per outstanding add, and
//                            the subject tables RETURNED
//   todo_row(t, flying)      TodoRow — check + title + quiet del,
//                            keyed `row-<id>` (lives in its package)
//
// view is PURE: it reads the store and the draft and builds widgets;
// it runs no crossing (the one rut-side write it makes is §7.3's
// subject tables, which todo_list returns and view drops onto the
// container). `paint` is the turn's ONE render: it hands the tree to
// `t1_render`, whose keyed diff patches the live page in place —
// nothing changed = nothing fires, a toggle = one token patch, a
// committed remove retires the row's listeners. No rebuild, ever.
//
// THE SUBJECTS (§7.3). Widgets fire SEMANTIC subjects; the dispatch is
// equality and map lookups, never arithmetic:
//
//   "add"          the Add button — books the request from the draft
//   "field"        the field's typing rows — detail carries the value
//   "toggle:<id>"  a row's check — routed through the toggles table
//   "remove:<id>"  a row's del — routed through the removes table
//
// The tables are built beside the matching `.subject(...)` calls (the
// todo id and the role are MAP lookups, never digit packing) and
// drop-then-refill on every render, so a subject for a row that left
// the list is a LOUD miss — the same law the phase-1 action table
// had. A stale or unknown LISTENER id dies one step earlier, in the
// framework's registry (`t1_subject`'s named trap).
//
// INPUT VALUES ARE EVENT-CARRIED (the phase-1 deviation's law: there
// is no read-back crossing). The field's rows carry its current value
// as `detail`; this module mirrors it into the draft. The Add click
// carries no value — it reads the draft, and an empty draft is gated
// client-side with a status line, no request booked. After a booked
// add the draft clears, and the DIFF clears the field: the value patch
// rides the framework's one input crossing.
//
// THE SERVER. `rut/store/todos` owns the list and the request table.
// An add here does NOT touch the list: it books a Req row and one
// timer — `tim_after`, the ONE crossing name this package spells. The
// simulated round trip is VISIBLE twice over: a "... title" pending
// line paints immediately, and the committed row appears only when
// the timer's EV_TIMER turn answers the tag. Per-kind latencies
// (add 400ms, toggle 250ms, remove 120ms) make deadline-order commits
// observable across kinds.
//
// Event kinds are the frozen numbers: 1 = EV_DOM, 2 = EV_TIMER.

// The app's imports — the EXACT set the law gate pins (survey §5.1):
// the widget type, the store's domain types, the framework's four
// names, the two view builders, the component vocabulary, and the one
// crossing name. PrimMapI64 needs NO import: the t1 core mounts
// `inline`, its transitive nmapset splices into this unit, and the
// name is unit-local — the same composition the tables have always
// ridden (the gate's set equality is what keeps any OTHER package
// from riding in).
use web::{ tim_after };
use todos::{ Store, Todo };
use t1::{ T1Root, t1_mount, t1_render, t1_subject };
use widget::{ Widget };
use todo_list::{ todo_list };
use todo_row::{ todo_row };
use col::{ col };
use row::{ row };
use text::{ text, done, pending, muted };
use button::{ btn, quiet };
use checkbox::{ check };
use field::{ field };
use card::{ card };

/// The app container: everything a turn needs, built once at boot and
/// returned to the host, which re-passes it on every `on_event` turn.
/// The framework's T1Root rides as a FIELD (§7.1) — the patch state is
/// app state, nothing more.
struct AppRoot {
    store: ?Store = nil; // the "server" (untouched)
    t1: ?T1Root = nil; // the framework's diff/registry state
    draft: str = ""; // the field's last event-carried value
    note: str = ""; // the status line's tail — this turn's fact
    toggles: ?PrimMapI64<str> = nil; // subject -> todo id (§7.3)
    removes: ?PrimMapI64<str> = nil; // subject -> todo id (§7.3)
}

// The boot turn: mount the framework on the seeded root (index.html's
// static contract — the twin seeds the same element for its page),
// paint the first tree, and RETURN the container the host holds for
// the page's life. The whole shell is WIDGETS: there is no boot-time
// DOM to build by hand anymore — the first render IS the create path
// of the diff.
entry fn main() -> opaque {
    let toggles: PrimMapI64<str> = PrimMapI64.new();
    let removes: PrimMapI64<str> = PrimMapI64.new();
    let root: ?AppRoot = AppRoot {
        store: Store.new(),
        t1: t1_mount("app"),
        draft: "",
        note: "booted — type a title, press Add",
        toggles: toggles,
        removes: removes,
    };
    paint(root);
    return opaque(root);
}

// The ONE re-entry point: every asynchronous fact arrives as an event
// row, the pump re-passing the container. One entry, one shape. The
// return is the ENTRY-ERR shape (err-channel phase 3): `(?opaque, str)`
// — `(opaque(c), "")` on a clean turn — the container re-crosses, the
// state-crossing law made explicit — and `(nil, why)` on a soft
// failure, where `why` is
// DATA the host reads and acts on (the pump reports it and keeps
// draining). Drift stays on the panic channel, loud: an unknown kind,
// a stale subject, a foreign container.
entry fn on_event(c: opaque, kind: i32, subject: str, detail: str) -> (?opaque, str) {
    let root = opaque.downcast<?AppRoot>(c);
    if (root == nil) {
        panic("app: the event container is not an AppRoot — host drift");
    }
    let mut r: ?AppRoot = root;

    if (kind == 1) {
        // EV_DOM — the framework translates the firing listener id to
        // its widget's SUBJECT (§7.3); a stale or unknown id is the
        // registry's LOUD miss, named as such.
        let mut t1: ?T1Root = r.t1;
        let s = t1_subject(t1, subject);
        dispatch(r, s, detail);
        return (opaque(r), "");
    }
    if (kind == 2) {
        // EV_TIMER — the "server" answers the booked request. The
        // answer's own err leg (a rejected title, a lost id) is DATA:
        // the status line still tells the user, and the err channel
        // tells the host. The container does NOT re-cross on a failed
        // turn — exactly-one-non-nil; the pump keeps the one it holds.
        let mut store: ?Store = r.store;
        let ans = store.answer(subject);
        if (ans.1 != "") {
            r.note = ans.1;
            paint(r);
            return (nil, ans.1);
        }
        r.note = ans.0;
        paint(r);
        return (opaque(r), "");
    }
    panic(f"app: unknown event kind {kind}");
}

// One DOM event = one SUBJECT. Reads the container, books at most one
// request, paints. Requests NEVER touch the list here — the commit is
// the timer turn's job. Page-level subjects by equality; row subjects
// by table hit — WHICH table hits names the role, WHAT it yields is
// the todo id. No digit ever carries meaning.
fn dispatch(mut r: ?AppRoot, subject: str, detail: str) -> nil {
    let mut store: ?Store = r.store;

    if (subject == "add") {
        // the click row carries no value; the field's value arrived
        // event-carried on the typing rows (the draft)
        let title = r.draft;
        if (title == "") {
            r.note = "type a title first";
            paint(r);
            return;
        }
        let req = store.request_add(title);
        tim_after(req.latency, req.tag);
        r.draft = ""; // the draft moved into the request — the diff
        // clears the field on this turn's render
        r.note = f"requested add '{title}'";
        paint(r);
        return;
    }
    if (subject == "field") {
        // typing mirrors the carried value; the render patches one
        // text line (the rows are untouched by construction — the diff
        // fires nothing for them)
        r.draft = detail;
        r.note = f"typing '{detail}'";
        paint(r);
        return;
    }

    let mut toggles: ?PrimMapI64<str> = r.toggles;
    let thit = toggles.get(subject);
    if (thit != nil) {
        let todo: i64 = thit;
        let req = store.request_toggle(todo);
        if (req == nil) {
            panic(f"app: toggle booked for todo {todo} — no such todo (subject drift)");
        }
        tim_after(req.latency, req.tag);
        r.note = f"requested toggle #{todo}";
        paint(r);
        return;
    }
    let mut removes: ?PrimMapI64<str> = r.removes;
    let rhit = removes.get(subject);
    if (rhit != nil) {
        let todo: i64 = rhit;
        let req = store.request_remove(todo);
        if (req == nil) {
            panic(f"app: remove booked for todo {todo} — no such todo (subject drift)");
        }
        tim_after(req.latency, req.tag);
        r.note = f"requested remove #{todo}";
        paint(r);
        return;
    }
    panic(f"app: subject '{subject}' answers no action — stale or unknown");
}

// THE PAINT (§7.2): build the view, hand it to the framework — once
// per turn, any turn. The diff does the rest; nothing here names an
// element, and an unchanged subtree costs zero crossings.
fn paint(r: ?AppRoot) -> nil {
    let tree = view(r);
    let mut root: ?T1Root = r.t1;
    t1_render(root, tree);
}

// THE VIEW — App (§7.2). PURE: reads the store and the draft, builds
// the whole widget tree. No crossing runs here; the tree is plain rut
// data the twin could assert on its own. The one rut-side write is
// §7.3's: the subject tables `todo_list` RETURNS are dropped onto the
// container here, where the container lives.
fn view(mut r: ?AppRoot) -> Widget {
    let mut store: ?Store = r.store;

    let mut tree = col().gap(12).pad(16).hook("root");

    let mut head = row().gap(8).hook("head");
    head.w(field().placeholder("What needs doing?").value(r.draft).subject("field").hook("new-todo"));
    head.w(btn("Add").subject("add").hook("add-btn"));
    tree.w(head);

    // the counts line — EXACT, as every phase before: the numbers lead,
    // this turn's fact tails the line
    tree.w(
        muted(f"{store.open_count()} open | {store.done_count()} done | {store.pending_count()} in flight — {r.note}")
            .hook("status"),
    );

    let out = todo_list(store);
    r.toggles = out.1;
    r.removes = out.2;
    tree.w(out.0);
    return tree;
}

