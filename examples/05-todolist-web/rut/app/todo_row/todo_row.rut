// todo_row.rut — THE ROW (TodoRow, the survey §3 tree's view layer):
// check + title + quiet del, keyed `row-<id>` — the diff's identity,
// so the row SURVIVES every patch between commits (a rebuild would
// mint fresh listeners per paint — that churn is dead). The check's
// `on` is app state: a done flip patches one token. `flying` (a toggle
// or remove in flight) turns the title into its in-flight variant —
// the "... " cue the old hand-built paint spelled into the mark's
// text, now a variant patch plus a text patch and nothing else.
//
// This is the old `todolist.rut`'s `todo_row` fn, promoted to its own
// package (the module law: one directory, one entry; and `row` was
// taken by the component, so the package carries the unambiguous
// name — survey §3.3). Biz-law clean by construction: widgets and
// subjects only, the tables it feeds live with the list.

use todos::{ Todo };
use widget::{ Widget };
use row::{ row };
use checkbox::{ check };
use text::{ text, done, pending };
use button::{ quiet };

pub fn todo_row(t: Todo, flying: bool) -> Widget {
    let mut w = row().gap(8).key(f"row-{t.id}").hook(f"row-{t.id}");
    w.w(check(t.done).subject(f"toggle:{t.id}").hook(f"mark-{t.id}"));
    let mut lbl = text(t.title);
    if (flying) {
        lbl = pending(f"... {t.title}");
    } else {
        if (t.done) {
            lbl = done(t.title);
        }
    }
    w.w(lbl.hook(f"lbl-{t.id}"));
    w.w(quiet("del").subject(f"remove:{t.id}").hook(f"del-{t.id}"));
    return w;
}
