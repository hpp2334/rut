{
  // biz/ — THE BIZ PACKAGE (the two-package law) and THE PROJECT ROOT:
  // the todolist's domain and app — the sources, the derived counts line,
  // the machine as mutations, the views, the app shell. ONE directory,
  // ONE module, SEVERAL files (the multi-lib entry):
  // `entry.libs` names the section files, the base splices first, the
  // array IS the order. The root spec stays `app`
  // (the ABI shape: the host boots `main`, re-passes the container to
  // the event doors; the mirror lane compiles the handed-over source under
  // this spec).
  //
  // THE SURFACE LAW (see biz.rut's header): biz reads with store.get,
  // writes with store.set (plain or mutation), and spells ONE crossing
  // name — tim_after. The ui package's machinery traits are
  // module-private; biz cannot name them even to import them.
  "name": "app",
  "entry": {
    "lib": "./biz.rut",
    "libs": [
      "./domain.rut",
      "./world.rut",
      "./app.rut"
    ]
  },
  "deps": {
    // the sibling package — the consumer's OWN local package is what
    // `path` is for (the two-package law's ui side)
    "ui": {
      "path": "../ui"
    },
    // THE STD CLOSURE, from the CDN: pouch and nmapset ship as committed
    // compiled bundles on jsDelivr at the std-v3 tag, sha256-pinned here
    // (the pin is law at the mount door on every load). Both are GENERIC
    // owners — since the generic-source riding law their bundles carry
    // the source beside the binaries, so this app's consumer-spelled
    // shapes compile from the bundles at the link. The tests prime an
    // offline remote from the committed artifacts (dist/std plays the
    // wire), so the gates never network.
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v3/dist/std/pouch.rutbundle", "sha256": "ce820058dd64669bb018331e03c8557ed9e6d16d946d045e482dac302c52698a" },
    "nmapset": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v3/dist/std/nmapset.rutbundle", "sha256": "941d76d97c67c0fe54eb7b0ea8ca7de399478d61b0584274a29229602dc8ba2a" }
  }
}
