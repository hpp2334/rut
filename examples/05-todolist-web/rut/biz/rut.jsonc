{
  // biz/ — THE BIZ PACKAGE (the two-package law) and THE PROJECT ROOT:
  // the todolist's domain and app — the domain types, the machine as
  // mutations, the views, the app shell. ONE directory, ONE module, a
  // FILE-MODULE TREE: the root module is `mod.rut` (the law header),
  // and `mod` declarations mount the children — `domain/`, `world/`,
  // `app/` (each its own `mod.rut`). The root spec stays `app`
  // (the ABI shape: the host boots `main`, re-passes the container to
  // the event doors; the mirror lane compiles the handed-over tree under
  // this spec).
  //
  // THE SURFACE LAW (see mod.rut's header): biz reads with ctx.get,
  // writes with ctx.set (plain or mutation), and spells ONE crossing
  // name — tim_after. The ui package's store machinery is
  // module-private; biz cannot name it even to import it.
  "name": "app",
  "deps": {
    // the sibling package — the consumer's OWN local package is what
    // `path` is for (the two-package law's ui side)
    "ui": {
      "path": "../ui"
    },
    // THE STD CLOSURE, from the CDN: pouch and nmapset ship as committed
    // compiled bundles on jsDelivr at the std-v7 tag, sha256-pinned here
    // (the pin is law at the mount door on every load). Both are GENERIC
    // owners — since the generic-source riding law their bundles carry
    // the source beside the binaries, so this app's consumer-spelled
    // shapes compile from the bundles at the link. The tests prime an
    // offline remote from the committed artifacts (dist/std plays the
    // wire), so the gates never network.
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v8/dist/std/pouch.rutbundle", "sha256": "d0bc36bb385bcc14e76d6275c92613edeab2d46ae0d162f7104282caef1a12cd" },
    "nmapset": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v8/dist/std/nmapset.rutbundle", "sha256": "160b70cd5f3ae9275ee50619ec884afdf50d93a5486115fe7cf0bf16f5030b10" }
  }
}
