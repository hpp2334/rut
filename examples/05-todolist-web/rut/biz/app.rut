// ---- THE APP (the shell; the views live below) ------------------------

/// The app container: everything a turn needs, built once at boot and
/// returned to the host, which re-passes it on every on_event turn.
/// The framework's T1Root rides as a FIELD (§7.1) beside THE WORLD (the
/// handles bundle — no domain container). The draft and the note live
/// IN the store; no duplicates on the container. THE SUBJECT TABLES
/// ARE GONE (tur's lesson): a row's event semantics ride the mutation
/// the view wires onto the widget — nothing to look up, nothing to
/// stale.
pub class AppRoot {
    world: World; // the handles + the machine
    t1: T1Root; // the framework's diff/registry state
}

// The boot turn: mount the framework on the seeded root (index.html's
// static contract), paint the first tree, and RETURN the container the
// host holds for the page's life. The store boots its atoms; the note$
// atom takes the boot line BEFORE the first paint, so the status line
// is pixel-identical from turn one (survey §4.5).
entry fn main() -> opaque {
    let boot: World = world_boot("booted — type a title, press Add");
    let root = AppRoot {
        world: boot,
        t1: t1_mount("app"),
    };
    paint(root);
    return opaque(root);
}

// The ONE re-entry point: every asynchronous fact arrives as an event
// row, the pump re-passing the container. Returns the ENTRY-ERR shape:
// (opaque(c), "") on a clean turn, (nil, why) on a soft failure — the
// container does NOT re-cross on a failed turn; the pump keeps the one
// it holds. Drift stays on the panic channel, loud.
entry fn on_event(c: opaque, kind: i32, subject: str, detail: str) -> (?opaque, str) {
    let root = opaque.downcast<AppRoot>(c);
    if (root == nil) {
        panic("app: the event container is not an AppRoot — host drift");
    }
    let mut r: AppRoot = root;

    if (kind == 1) {
        // EV_DOM — the framework resolves the firing listener to the
        // widget's OWN event mutation and runs it through the ONE
        // write lane (tur's onClick/onInput, framework-side). The
        // answer is the booking box: opaque(Req) — book the timer —
        // or opaque(nil), nothing to book.
        let booked = t1_event(r.t1, subject, detail);
        let req = opaque.downcast<Req>(booked);
        if (req != nil) {
            tim_after(req.latency, req.tag);
        }
        paint(r);
        return (opaque(r), "");
    }
    if (kind == 2) {
        // EV_TIMER — the "server" answers the booked request, THROUGH
        // the machine's answer wrapper (the answer mutation + the
        // status line's tail, one write lane). The answer's own err
        // leg (a rejected title, a lost id) is DATA: the status line
        // tells the user, and the err channel tells the host.
        let ans = r.world.answer_ev.run(subject);
        if (ans.1 != "") {
            paint(r);
            return (nil, ans.1);
        }
        paint(r);
        return (opaque(r), "");
    }
    panic(f"app: unknown event kind {kind}");
}

// THE PAINT (§7.2): NO flush line — pull-on-read. The view's first get
// computes what this turn's writes staled, at most once per write-set;
// then the tree goes to t1_render, whose keyed diff patches the live
// page in place — nothing changed = nothing fires. The turn-turn
// flush the old paint ran is RETIRED (the survey addendum records the
// reversal); the render itself stays unconditional, once per turn.
fn paint(r: AppRoot) -> nil {
    let tree = view(r);
    let mut root: T1Root = r.t1;
    t1_render(root, tree);
}

// THE VIEW — App (§7.2). PURE WIRING: the tree is STATIC COMPOSITION
// plus REACTIVE PROPS (tur's reads-as-props) — the draft rides the
// field as a derived, the status line is a derived, the whole list is
// a derived subtree. The view READS NOTHING and writes nothing
// (survey §4.2 kept, completed: the pulls moved to the render door);
// the events ride the widgets' own mutations (on_click/on_input).
fn view(mut r: AppRoot) -> Widget {
    let mut world: World = r.world;

    let mut tree = col().gap(12).pad(16).hook("root");

    let mut head = row().gap(8).hook("head");
    head.w(field().placeholder("What needs doing?").value_of(world.draft_view$).on_input(world.draft_ev).hook("new-todo"));
    head.w(btn("Add").on_click(world.add_ev).hook("add-btn"));
    tree.w(head);

    // the status line — a derived prop, resolved at the render door:
    // "N open | M done | K in flight — <note>", byte-identical to
    // every phase before
    tree.w(muted("").text_of(world.status_line$).hook("status"));

    // the list — tur's Each, package-sized: the whole card is one
    // derived subtree
    tree.w(live(world.list_tree$));
    return tree;
}

// ---- THE ROW (the old todo_row package) -------------------------------
// check + title + quiet del, keyed `row-<id>` — the diff's identity, so
// the row SURVIVES every patch between commits. The check's `on` is app
// state: a done flip patches one token. `flying` turns the title into
// its in-flight variant. THE EVENT WIRING: each control carries its
// machine mutation with the row's id BOUND AS DATA (tur's
// `mutate((ctx, _ev) => act(ctx, index))` — .on_row(m, id), no
// runtime closure).

pub fn todo_row(t: Todo, flying: bool, toggle_row: Mutation<i64, opaque>, remove_row: Mutation<i64, opaque>) -> Widget {
    let mut row_w = row().gap(8).key(f"row-{t.id}").hook(f"row-{t.id}");
    row_w.w(check(t.done).on_row(toggle_row, t.id).hook(f"mark-{t.id}"));
    let mut lbl = text(t.title);
    if (flying) {
        lbl = pending(f"... {t.title}");
    } else {
        if (t.done) {
            lbl = done(t.title);
        }
    }
    row_w.w(lbl.hook(f"lbl-{t.id}"));
    row_w.w(quiet("del").on_row(remove_row, t.id).hook(f"del-{t.id}"));
    return row_w;
}
