// world/ — THE WORLD: the handles bundle (there is no domain
// container). A CHILD module of the biz root: the state record and its
// boot fn are `pub` (the app shell and the store-probe spec both take
// the World), the machine closures read the domain through the
// `domain.` qualified positions.

use ui::store::{ Store, Source, Derived, Mutation };
use ui::widget::{ Widget };
use ui::components::{ card, pending };
use pouch::{ Vec };

/// The state record: the store, the atoms, the derived, the machine's
/// mutations. Fields are HANDLES — keys into the store — and the
/// bundle owns no machinery: no rail, no flush, no recompute pass.
/// Built ONCE at boot; the host re-passes it every turn.
pub class World {
    // THE FIELDS ARE PUB: the world is the app's state home and the
    // store-probe spec (tests/store_probe/) reads the same handles
    // the app does — one surface, no probe-only shape.
    pub store: Store;
    pub items$: Source<Vec<domain.Todo>>; // the committed list — "the board"
    pub reqs$: Source<Vec<domain.Req>>; // the booked requests
    pub draft$: Source<str>; // the field's event-carried value (str lane)
    pub note$: Source<str>; // the status line's tail (str lane)
    pub last$: Source<str>; // the answer channel's own log (str lane)
    pub next_todo$: Source<i64>; // the id machine's counters — state cells
    pub next_req$: Source<i64>; // now that the store is the state home
    pub counts$: Derived<str>; // "N open | M done | K in flight"
    pub add_m: Mutation<str, domain.Req>;
    pub toggle_m: Mutation<i64, ?domain.Req>;
    pub remove_m: Mutation<i64, ?domain.Req>;
    pub answer_m: Mutation<str, (str, str)>;
    // THE EVENT SURFACE (tur's onClick/onInput props): the mutations
    // the WIDGETS carry. The app wires them; the framework runs them.
    // Every wrapper returns the BOOKING as a box — opaque(domain.Req) when a
    // timer must be booked, opaque(nil) when there is nothing to book.
    pub draft_ev: Mutation<str, opaque>; // typing: draft$ + note$
    pub add_ev: Mutation<str, opaque>; // the Add click (reads the draft)
    pub toggle_row: Mutation<i64, opaque>; // per-row, arg-captured
    pub remove_row: Mutation<i64, opaque>; // per-row, arg-captured
    pub answer_ev: Mutation<str, (str, str)>; // the timer's wrapper
    // THE REACTIVE PROPS (tur's reads-as-props): what the view WIRES,
    // resolved at the render door
    pub draft_view$: Derived<str>; // the field's value mirror
    pub status_line$: Derived<str>; // counts$ + note$ composed
    pub list_tree$: Derived<Widget>; // the whole list card (tur's Each)
}

/// Boot the world: the sources, the derived (deps DISCOVERED through
/// the ctx), the machine's mutations. `boot_line` seeds the note (the
/// app's boot turn; the DOM-free suite passes "").
pub fn world_boot(boot_line: str) -> World {
    let mut store = Store.new();
    let items$ = store.source<Vec<domain.Todo>>(Vec.new());
    let reqs$ = store.source<Vec<domain.Req>>(Vec.new());
    let draft$ = store.source_str("");
    // the boot line is the note's SEED (never a write): the app boots
    // "booted — ..." and the status line is pixel-identical from turn
    // one; the DOM-free suite boots "" and leaves the note never-
    // written (the str-lane twin's pinned shape)
    let note$ = store.source_str(boot_line);
    let last$ = store.source_str("");
    let next_todo$ = store.source<i64>(1);
    let next_req$ = store.source<i64>(1);
    // THE DERIVED — the counts line, deps discovered through the ctx,
    // never declared. The SAME formula the status line has always
    // shown; the first get computes it.
    let counts$ = store.derive(fn (ctx) -> str {
        let items = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
        let reqs = ctx.get<Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$);
        let mut open = 0;
        for (let t of items) {
            if (t.done == false) {
                open += 1;
            }
        }
        let done_n = items.len() - open;
        return f"{open} open | {done_n} done | {reqs.len()} in flight";
    });

    // ---- THE MACHINE (mutations; every write is a ctx.set) ----

    /// Book an add: the request table grows, the list does not — the
    /// list changes when the timer's answer lands, as its own turn.
    let add_m = store.mutation(fn (ctx, title: str) -> domain.Req {
        let id = ctx.get<i64, Source<i64>>(next_req$);
        ctx.set<i64, i64, Source<i64>>(next_req$, id + 1);
        let req = domain.mk_req(id, f"req:{id}", domain.KIND_ADD, 0, title, domain.LATENCY_ADD);
        let rs = ctx.get<Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$);
        rs.push(req);
        ctx.set<Vec<domain.Req>, Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$, rs); // the write point: store + mark
        return req;
    });

    /// Book a toggle; nil when the todo id is unknown — the caller
    /// (the UI) turns that into its loud listener-drift trap.
    let toggle_m = store.mutation(fn (ctx, todo: i64) -> ?domain.Req {
        let items = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
        if (domain.find_todo(items, todo) < 0) {
            return nil;
        }
        let id = ctx.get<i64, Source<i64>>(next_req$);
        ctx.set<i64, i64, Source<i64>>(next_req$, id + 1);
        let req = domain.mk_req(id, f"req:{id}", domain.KIND_TOGGLE, todo, "", domain.LATENCY_TOGGLE);
        let rs = ctx.get<Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$);
        rs.push(req);
        ctx.set<Vec<domain.Req>, Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$, rs);
        return req;
    });

    /// Book a remove; nil when the todo id is unknown.
    let remove_m = store.mutation(fn (ctx, todo: i64) -> ?domain.Req {
        let items = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
        if (domain.find_todo(items, todo) < 0) {
            return nil;
        }
        let id = ctx.get<i64, Source<i64>>(next_req$);
        ctx.set<i64, i64, Source<i64>>(next_req$, id + 1);
        let req = domain.mk_req(id, f"req:{id}", domain.KIND_REMOVE, todo, "", domain.LATENCY_REMOVE);
        let rs = ctx.get<Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$);
        rs.push(req);
        ctx.set<Vec<domain.Req>, Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$, rs);
        return req;
    });

    /// THE SERVER'S ONE COMMIT POINT, as a mutation. An unknown tag is
    /// a LOUD trap; a rejected title or a lost id is an ANSWER — data
    /// the turn reads (the ("", why) leg). Consumes the answered row,
    /// then commits per kind, writing items$/last$ through the ctx.
    let answer_m = store.mutation(fn (ctx, tag: str) -> (str, str) {
        let rs = ctx.get<Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$);
        let at = domain.find_req(rs, tag);
        if (at < 0) {
            panic(f"server: no request '{tag}' — the answer names no booked row");
        }
        let req = rs[at];
        let kept: Vec<domain.Req> = Vec.new();
        for (let r of rs) {
            if (r.tag != tag) {
                kept.push(r);
            }
        }
        ctx.set<Vec<domain.Req>, Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$, kept); // consume the answered row

        if (req.kind == domain.KIND_ADD) {
            // commit_add
            let title = req.title;
            if (title == "") {
                let line = "rejected '' — the title is empty";
                ctx.set<str, str, Source<str>>(last$, line);
                return ("", line);
            }
            let items = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
            if (domain.find_by_title(items, title) >= 0) {
                let line = f"rejected '{title}' — already on the list";
                ctx.set<str, str, Source<str>>(last$, line);
                return ("", line);
            }
            let id = ctx.get<i64, Source<i64>>(next_todo$);
            ctx.set<i64, i64, Source<i64>>(next_todo$, id + 1);
            let its = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
            its.push(domain.mk_todo(id, title));
            ctx.set<Vec<domain.Todo>, Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$, its); // the write point: store + mark
            let line = f"added '{title}' as #{id}";
            ctx.set<str, str, Source<str>>(last$, line);
            return (line, "");
        }
        if (req.kind == domain.KIND_TOGGLE) {
            // commit_toggle
            let items = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
            let at2 = domain.find_todo(items, req.todo);
            if (at2 < 0) {
                // the lost-id shape: a remove landed first — the answer
                // says so, the turn moves on
                let line = f"skipped toggle #{req.todo} — the row is gone";
                ctx.set<str, str, Source<str>>(last$, line);
                return ("", line);
            }
            let mut its = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
            its[at2].done = its[at2].done == false;
            ctx.set<Vec<domain.Todo>, Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$, its); // the write point: store + mark
            let mut to = "open";
            if (its[at2].done) {
                to = "done";
            }
            let line = f"toggled #{req.todo} to {to}";
            ctx.set<str, str, Source<str>>(last$, line);
            return (line, "");
        }
        // commit_remove
        let items = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
        let at3 = domain.find_todo(items, req.todo);
        if (at3 < 0) {
            let line = f"skipped remove #{req.todo} — the row is gone";
            ctx.set<str, str, Source<str>>(last$, line);
            return ("", line);
        }
        let its = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
        let gone = its[at3].title;
        let kept2: Vec<domain.Todo> = Vec.new();
        for (let t of its) {
            if (t.id != req.todo) {
                kept2.push(t);
            }
        }
        ctx.set<Vec<domain.Todo>, Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$, kept2); // the write point: store + mark
        let line = f"removed '{gone}' (#{req.todo})";
        ctx.set<str, str, Source<str>>(last$, line);
        return (line, "");
    });

    // ---- THE EVENT WRAPPERS (tur's onClick/onInput props) -----------
    //
    // What the WIDGETS carry. Each returns the BOOKING as a box:
    // opaque(domain.Req) — the app books tim_after from it — or opaque(nil)
    // when there is nothing to book. The write ORDER is the law: the
    // same writes, in the same order, as the dispatch legs they
    // replace (the sessions' status lines are byte-pinned).

    /// typing: mirror the carried value into the draft, note the line.
    let draft_ev = store.mutation(fn (ctx, text: str) -> opaque {
        ctx.set<str, str, Source<str>>(draft$, text);
        ctx.set<str, str, Source<str>>(note$, f"typing '{text}'");
        return opaque(nil);
    });

    /// the Add click: read the draft, gate, book, clear, note.
    let add_ev = store.mutation(fn (ctx, ev: str) -> opaque {
        let title = ctx.get<str, Source<str>>(draft$);
        if (title == "") {
            ctx.set<str, str, Source<str>>(note$, "type a title first");
            return opaque(nil);
        }
        let req = ctx.set<str, domain.Req, Mutation<str, domain.Req>>(add_m, title);
        ctx.set<str, str, Source<str>>(draft$, ""); // the draft moved into the request
        ctx.set<str, str, Source<str>>(note$, f"requested add '{title}'");
        return opaque(req);
    });

    /// a row's check: book the toggle, note it. The machine's nil (an
    /// unknown todo) is DATA — nothing to book, no trap (the twins
    /// pin the empty-tag answer; the lost-id shape is the answer's).
    let toggle_row = store.mutation(fn (ctx, todo: i64) -> opaque {
        let req = ctx.set<i64, ?domain.Req, Mutation<i64, ?domain.Req>>(toggle_m, todo);
        if (req == nil) {
            return opaque(nil);
        }
        ctx.set<str, str, Source<str>>(note$, f"requested toggle #{todo}");
        let r: domain.Req = req;
        return opaque(r);
    });

    /// a row's del: book the remove, note it. Same nil law.
    let remove_row = store.mutation(fn (ctx, todo: i64) -> opaque {
        let req = ctx.set<i64, ?domain.Req, Mutation<i64, ?domain.Req>>(remove_m, todo);
        if (req == nil) {
            return opaque(nil);
        }
        ctx.set<str, str, Source<str>>(note$, f"requested remove #{todo}");
        let r: domain.Req = req;
        return opaque(r);
    });

    /// THE TIMER'S WRAPPER: run the server's answer, then write the
    /// status line's tail (the why on an err leg, the line on an ok
    /// leg) — the app's timer door no longer writes anything itself.
    let answer_ev = store.mutation(fn (ctx, tag: str) -> (str, str) {
        let ans = ctx.set<str, (str, str), Mutation<str, (str, str)>>(answer_m, tag);
        if (ans.1 != "") {
            ctx.set<str, str, Source<str>>(note$, ans.1);
        } else {
            ctx.set<str, str, Source<str>>(note$, ans.0);
        }
        return ans;
    });

    // ---- THE REACTIVE PROPS (tur's reads-as-props) --------------------
    //
    // The view wires RECIPES, never pulled values: these deriveds ride
    // the widget tree as props and t1_render resolves them at the
    // RENDER DOOR (pull-on-read freshness, where the tree meets the
    // page). The view fn reads NOTHING; deps are discovered on first
    // resolve and re-discovered on every recompute.

    /// the draft mirror: the field's value, reactive.
    let draft_view$ = store.derive(fn (ctx) -> str {
        return ctx.get<str, Source<str>>(draft$);
    });

    /// the status line: counts$ + note$ composed — "N open | M done |
    /// K in flight — <note>", byte-identical to every phase before.
    let status_line$ = store.derive(fn (ctx) -> str {
        return f"{ctx.get<str, Derived<str>>(counts$)} — {ctx.get<str, Source<str>>(note$)}";
    });

    /// THE LIST, reactive (tur's Each): the whole card is a derived —
    /// one keyed row per committed todo, one pending line per booked
    /// add; the row controls carry their own arg-captured mutations,
    /// minted fresh per recompute (the registry keeps a row's listener
    /// from its CREATE; a row's id is stable for its lifetime, so the
    /// captured args are equivalent).
    let list_tree$ = store.derive(fn (ctx) -> Widget {
        let items = ctx.get<Vec<domain.Todo>, Source<Vec<domain.Todo>>>(items$);
        let rs = ctx.get<Vec<domain.Req>, Source<Vec<domain.Req>>>(reqs$);
        let mut list = card().pad(12).gap(8).hook("list");
        for (let t of items) {
            list.w(app.todo_row(t, domain.has_pending_for(rs, t.id), toggle_row, remove_row));
        }
        for (let rq of rs) {
            if (rq.kind == domain.KIND_ADD) {
                list.w(pending(f"... {rq.title}"));
            }
        }
        return list;
    });

    return World {
        store: store,
        items$: items$,
        reqs$: reqs$,
        draft$: draft$,
        note$: note$,
        last$: last$,
        next_todo$: next_todo$,
        next_req$: next_req$,
        counts$: counts$,
        add_m: add_m,
        toggle_m: toggle_m,
        remove_m: remove_m,
        answer_m: answer_m,
        draft_ev: draft_ev,
        add_ev: add_ev,
        toggle_row: toggle_row,
        remove_row: remove_row,
        answer_ev: answer_ev,
        draft_view$: draft_view$,
        status_line$: status_line$,
        list_tree$: list_tree$,
    };
}

