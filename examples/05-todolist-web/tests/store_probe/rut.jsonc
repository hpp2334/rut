{
  // tests/store_probe/ — the DOM-free store-probe spec
  // (tests/store.rs's fixture), its own module dir like every rut
  // program: the manifest names the probe's imports, the load mounts the
  // closure. `app` is the biz package (rut/biz — its spec IS `app`).
  "name": "store_probe",
    "deps": {
    "ui": {
      "path": "../../rut/ui"
    },
    "app": {
      "path": "../../rut/biz"
    },
    // the toolchain's pouch, from the CDN — the same pinned jsDelivr row
    // the app's own manifests spell (the tests prime an offline remote
    // from the committed dist/std artifacts, so the gate never networks)
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v8/dist/std/pouch.rutbundle", "sha256": "d0bc36bb385bcc14e76d6275c92613edeab2d46ae0d162f7104282caef1a12cd" }
  }
}
