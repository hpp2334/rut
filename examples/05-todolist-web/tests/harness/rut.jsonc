{
  // tests/harness/ — the crossing harness (tests/host_surface.rs's
  // probe), its own module dir like every rut program. Dep-free on
  // purpose: the only `use` names `web`, and `web` is the HOST DECL
  // surface — the embedder registers it in both lanes (src/mount.rs), so
  // it rides no manifest path here, the same shape the rut/ packages ride.
  "name": "harness"}
