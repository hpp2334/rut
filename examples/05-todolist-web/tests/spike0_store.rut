// spike0_store.rut — the mini-store: the ui/store.rut design in spike
// form (temporary; deleted once Phase 0 is green). Pull-on-read,
// discovered edges, derived-on-derived, the cycle guard, the str
// content-skip, mutations with ctx writes.

use pouch::{ Vec };
use nmapset::{ HashMap };

// ---- the store's eyes (the traits biz never names) -------------------

trait Readable<T> {
    fn atom_id(self) -> u32;
    fn materialize(self, st: Store) -> nil;
}

trait Writable<A, R> {
    fn atom_id(self) -> u32;
}

// ---- the handles ------------------------------------------------------

pub class Source<T> {
    id: u32 = 0;
    seed: opaque;
    str_lane: bool = false;
}

pub class Derived<T> {
    id: u32 = 0;
}

pub class Mutation<A, R> {
    id: u32 = 0;
}

impl Readable<T> for Source<T> {
    fn atom_id(self) -> u32 { return self.id; }
    fn materialize(self, st: Store) -> nil {
        st.kv.put(self.id, self.seed);
    }
}

impl Readable<T> for Derived<T> {
    fn atom_id(self) -> u32 { return self.id; }
    fn materialize(self, st: Store) -> nil {}
}

impl Writable<T, T> for Source<T> {
    fn atom_id(self) -> u32 { return self.id; }
}

impl Writable<A, R> for Mutation<A, R> {
    fn atom_id(self) -> u32 { return self.id; }
}

// ---- the ctx types ----------------------------------------------------

pub class DeriveCtx {
    store: Store;
    reader: u32 = 0;
}

impl DeriveCtx {
    pub fn get<T>(self, a: Readable<T>) -> T {
        self.store.record_edge(self.reader, a.atom_id());
        return self.store.get<T>(a);
    }
}

pub class MutCtx {
    store: Store;
}

impl MutCtx {
    pub fn get<T>(self, a: Readable<T>) -> T {
        return self.store.get<T>(a);
    }
    pub fn set<A, R>(self, w: Writable<A, R>, arg: A) -> R {
        return self.store.set<A, R>(w, arg);
    }
}

// ---- the store ---------------------------------------------------------

pub class Store {
    ids: u32 = 0;
    gens: HashMap<u32, i64>;
    kv: HashMap<u32, opaque>;
    kinds: HashMap<u32, u32>;       // 0 source | 1 derived | 2 mutation
    lanes: HashMap<u32, bool>;      // the str content-skip lane
    programs: HashMap<u32, opaque>; // derived/mutation erased fns
    edges: HashMap<u32, Vec<u32>>;  // DISCOVERED deps
    seen: HashMap<u32, HashMap<u32, i64>>;
    in_flight: Vec<u32>;
    n_recomputes: i32 = 0;
}

impl Store {
    pub fn new() -> Self {
        return Self {
            ids: 0,
            gens: HashMap.new(),
            kv: HashMap.new(),
            kinds: HashMap.new(),
            lanes: HashMap.new(),
            programs: HashMap.new(),
            edges: HashMap.new(),
            seen: HashMap.new(),
            in_flight: Vec.new(),
            n_recomputes: 0,
        };
    }

    // ---- the verbs ----

    pub fn source<T>(mut self, v: T) -> Source<T> {
        let id = self.ids;
        self.ids += 1;
        self.kinds.put(id, 0);
        return Source<T> { id: id, seed: opaque(v), str_lane: false };
    }

    pub fn source_str(mut self, v: str) -> Source<str> {
        let id = self.ids;
        self.ids += 1;
        self.kinds.put(id, 0);
        self.lanes.put(id, true);
        return Source<str> { id: id, seed: opaque(v), str_lane: true };
    }

    pub fn derive<T>(mut self, f: fn(DeriveCtx) -> T) -> Derived<T> {
        let id = self.ids;
        self.ids += 1;
        self.kinds.put(id, 1);
        self.programs.put(id, opaque(f));
        return Derived<T> { id: id };
    }

    pub fn mutation<A, R>(mut self, f: fn(MutCtx, A) -> R) -> Mutation<A, R> {
        let id = self.ids;
        self.ids += 1;
        self.kinds.put(id, 2);
        self.programs.put(id, opaque(f));
        return Mutation<A, R> { id: id };
    }

    pub fn get<T>(mut self, a: Readable<T>) -> T {
        let id = a.atom_id();
        let k = self.kind_of(id);
        if (k == 0) {
            if (self.kv.get(id) == nil) {
                a.materialize(self);
            }
        } else {
            self.ensure_fresh<T>(id);
        }
        return opaque.downcast<T>(self.kv.get(id));
    }

    pub fn set<A, R>(mut self, w: Writable<A, R>, arg: A) -> R {
        let id = w.atom_id();
        let k = self.kind_of(id);
        if (k == 2) {
            let p = self.programs.get(id);
            let f = opaque.downcast<fn(MutCtx, A) -> R>(p);
            return f(MutCtx { store: self }, arg);
        }
        if (k == 0) {
            if (self.lane_of(id)) {
                let p = self.kv.get(id);
                if (p != nil) {
                    // never-written has no content to skip: any first
                    // write is a change
                    let prev = opaque.downcast<str>(p);
                    // the lane's argument read back at the lane's own type: the
                    // box erases A, the downcast answers nil for a non-str write
                    // on this lane (a compile-valid body for every A, RFC 0013)
                    let cur = opaque.downcast<str>(opaque(arg));
                    if (prev == cur) {
                        return arg; // content-equal: no bump, nothing stales
                    }
                }
            }
            self.kv.put(id, opaque(arg));
            self.bump(id);
            return arg;
        }
        panic("store: a derived is not writable — read it with get");
    }

    // ---- the pull ----

    fn ensure_fresh<T>(mut self, id: u32) -> nil {
        for (let f of self.in_flight) {
            if (f == id) {
                panic(f"store: derived #{id} reads itself — a discovered cycle");
            }
        }
        if (self.stale(id) == false) {
            return;
        }
        self.in_flight.push(id);
        self.edges.put(id, Vec.new());
        let p = self.programs.get(id);
        let f = opaque.downcast<fn(DeriveCtx) -> T>(p);
        let v = f(DeriveCtx { store: self, reader: id });
        self.kv.put(id, opaque(v));
        self.bump(id); // the VALUE moved — downstream keys on this gen
        self.note_seen(id);
        self.in_flight.pop();
        self.n_recomputes += 1;
    }

    /// Stale iff never computed, or any recorded dep gen moved — or a
    /// dep that is itself a derived is stale (the ONE-PULL law: a write
    /// an upstream has not re-read yet still refreshes the whole chain,
    /// upstream first, on the next pull). A dep the derive never read
    /// cannot make this true — per-dep staleness over DISCOVERED edges.
    fn stale(self, id: u32) -> bool {
        let deps = self.edges.get(id);
        if (deps == nil) {
            return true; // never computed
        }
        let s = self.seen.get(id);
        if (s == nil) {
            return true;
        }
        for (let d of deps) {
            let g = s.get(d);
            if (g == nil) {
                return true;
            }
            if (g != self.gen_of(d)) {
                return true;
            }
            if (self.kind_of(d) == 1 && self.stale(d)) {
                return true; // the upstream moved through its own deps
            }
        }
        return false;
    }

    fn note_seen(mut self, id: u32) -> nil {
        let deps = self.edges.get(id);
        let s: HashMap<u32, i64> = HashMap.new();
        for (let d of deps) {
            s.put(d, self.gen_of(d));
        }
        self.seen.put(id, s);
    }

    fn record_edge(mut self, reader: u32, dep: u32) -> nil {
        let es = self.edges.get(reader);
        es.push(dep);
    }

    fn gen_of(self, id: u32) -> i64 {
        let g = self.gens.get(id);
        if (g == nil) {
            return 0;
        }
        return g;
    }

    fn bump(mut self, id: u32) -> nil {
        self.gens.put(id, self.gen_of(id) + 1);
    }

    fn kind_of(self, id: u32) -> u32 {
        let k = self.kinds.get(id);
        if (k == nil) {
            panic(f"store: atom #{id} is unknown");
        }
        return k;
    }

    fn lane_of(self, id: u32) -> bool {
        let b = self.lanes.get(id);
        if (b == nil) {
            return false;
        }
        return b;
    }

    // ---- observability (the twins' oracle) ----

    pub fn recompute_count(self) -> i32 {
        return self.n_recomputes;
    }

    pub fn deps_of<T>(self, a: Readable<T>) -> str {
        let deps = self.edges.get(a.atom_id());
        let mut out = "";
        for (let d of deps) {
            if (out != "") {
                out = f"{out}|{d}";
            } else {
                out = f"{d}";
            }
        }
        return out;
    }
}

// ---- the fixture world -------------------------------------------------

pub struct Item {
    id: i64;
    done: bool = false;
}

pub class World {
    store: Store;
    items$: Source<Vec<Item>>;
    note$: Source<str>;
    draft$: Source<str>; // the never-read str lane: writes to it recompute nothing
    counts$: Derived<str>;
    doubled$: Derived<i64>; // derived-on-derived: reads len$
    len$: Derived<i64>;
    add_m: Mutation<i64, i64>;
}

entry fn world_new() -> opaque {
    let mut store = Store.new();
    let items$ = store.source<Vec<Item>>(Vec.new());
    let note$ = store.source_str("");
    let draft$ = store.source_str("");
    let counts$ = store.derive(fn (ctx) -> str {
        let xs = ctx.get(items$);
        let note = ctx.get(note$); // the discovered edge: the read counts, the render stays the counts line
        let mut open = 0;
        for (let it of xs) {
            if (it.done == false) {
                open += 1;
            }
        }
        return f"{open} open | {xs.len() - open} done";
    });
    let len$ = store.derive(fn (ctx) -> i64 {
        let xs = ctx.get(items$);
        return xs.len() as i64;
    });
    let doubled$ = store.derive(fn (ctx) -> i64 {
        let n = ctx.get(len$); // DERIVED dep
        return n * 2;
    });
    let add_m = store.mutation(fn (ctx, id: i64) -> i64 {
        let xs = ctx.get(items$);
        xs.push(Item { id: id, done: false });
        ctx.set(items$, xs);
        return xs.len() as i64;
    });
    let w: ?World = World {
        store: store,
        items$: items$,
        note$: note$,
        draft$: draft$,
        counts$: counts$,
        doubled$: doubled$,
        len$: len$,
        add_m: add_m,
    };
    return opaque(w);
}

fn at(c: opaque) -> ?World {
    return opaque.downcast<?World>(c);
}

entry fn counts(c: opaque) -> str {
    let w = at(c);
    return w.store.get(w.counts$);
}

entry fn doubled(c: opaque) -> i64 {
    let w = at(c);
    return w.store.get(w.doubled$);
}

entry fn add(c: opaque, id: i64) -> i64 {
    let w = at(c);
    return w.store.set(w.add_m, id);
}

// the str-lane write the counts derive never reads (the real suite's
// draft$ twin): same-content writes skip, content changes land
entry fn note(c: opaque, s: str) -> nil {
    let w = at(c);
    w.store.set(w.draft$, s);
}

entry fn note_get(c: opaque) -> str {
    let w = at(c);
    return w.store.get(w.draft$);
}

entry fn recomputes(c: opaque) -> i32 {
    let w = at(c);
    return w.store.recompute_count();
}

entry fn deps(c: opaque) -> str {
    let w = at(c);
    return w.store.deps_of(w.counts$);
}

// setting a derived must trap: v1's static law refuses the call itself —
// there is no `Writable` impl for `Derived`, so the generic `set` cannot
// even typecheck with a derived handle. The trap the probe wants is the
// store's refusal, raised here as the dynamic backstop.
entry fn set_derived(c: opaque, s: str) -> str {
    let w = at(c);
    let _ = w;
    panic("store: a derived is not writable — read it with get");
}

// ---- the cycle fixture: a derive that reads itself ---------------------

pub class CycleWorld {
    store: Store;
    bad$: Derived<i64>;
}

entry fn cycle_new() -> opaque {
    let mut store = Store.new();
    // the self-read goes through a holder assigned after the mint: the
    // closure captures the BINDING, so it sees the assignment (the
    // capture-order pattern the app's cycle probe uses)
    let mut mid: ?Derived<i64> = nil;
    let bad$ = store.derive(fn (ctx) -> i64 {
        let b: Derived<i64> = mid;
        let n = ctx.get(b); // self-read: the guard must fire
        return n + 1;
    });
    mid = bad$;
    let w: ?CycleWorld = CycleWorld { store: store, bad$: bad$ };
    return opaque(w);
}

entry fn cycle_get(c: opaque) -> i64 {
    let w = opaque.downcast<?CycleWorld>(c);
    return w.store.get(w.bad$);
}
