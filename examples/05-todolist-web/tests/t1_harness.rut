// t1_harness.rut — phase 1's framework harness (the harness.rut
// shape): a minimal page program that mounts a T1Root on the seeded
// `#app` and exposes the t1 surface to the twin tests as probes —
// scenario renders (the ordinary `t1_mount` + `t1_render` calls),
// registry reads, and the trap shapes. NOT the todolist app (the app
// package `rut/app/app` is); nothing here is test-only machinery
// beyond naming the scenarios.
//
// The imports are the two-package shape: the framework's names from
// `ui` — the type + the four t1 names + the component vocabulary (the
// one package now; its machinery traits are module-private and CANNOT
// be imported even by name).
use ui::{
    Widget, WKind, T1Root, t1_mount, t1_render, t1_event,
    Store, Source, Derived, Mutation, live,
    col, row, card, spacer, field, check,
    text, done, title, pending, muted, btn, quiet,
};
use nmapset::{ HashMap };
use pouch::{ Vec };
//
// The "biz" half of this harness is tur's law: every listening widget
// CARRIES its event mutation (on_click/on_input), the framework runs
// it on the firing listener (`t1_event` — a stale or unknown id is the
// LOUD miss), and the mutation's own body logs its label, so the tests
// can read what a click delivered without parsing ids.

struct Harness {
    root: T1Root;
    store: Store; // the label mutations' mint + write lane
    log$: Source<Vec<str>>; // the delivered labels, in order
    num$: Source<i64>; // the reactive-props scenario's cell
    num_view$: Derived<str>; // ... its derived view
    each_view$: Derived<Widget>; // ... its derived SUBTREE (live)
}

/// The harness's one event shape: a mutation whose body appends its
/// LABEL to the log — the label spellings are the old subjects
/// ("toggle:1", "remove:2"), so the log's bytes are unchanged.
fn log_m(h: ?Harness, label: str) -> Mutation<str, opaque> {
    let lg = h.log$;
    let lab = label;
    return h.store.mutation(fn (ctx, ev: str) -> opaque {
        let l = ctx.get(lg);
        l.push(lab);
        ctx.set(lg, l);
        return opaque(nil);
    });
}

// The boot turn: mount the framework on #app and return the container
// the pump re-passes every turn. No tree yet — the first render is a
// probe's job (t1_render's create path).
entry fn main() -> opaque {
    let store = Store.new();
    let log$ = store.source<Vec<str>>(Vec.new());
    let num$ = store.source<i64>(7);
    let num_view$ = store.derive(fn (ctx) -> str {
        return f"n={ctx.get(num$)}";
    });
    let each_view$ = store.derive(fn (ctx) -> Widget {
        return col().hook("lvc").w(text(f"v={ctx.get(num$)}").hook("lvt"));
    });
    let h: ?Harness = Harness {
        root: t1_mount("app"),
        store: store,
        log$: log$,
        num$: num$,
        num_view$: num_view$,
        each_view$: each_view$,
    };
    return opaque(h);
}

// The ONE re-entry point: a DOM event row arrives with the listener id
// as its subject; the framework resolves the widget's OWN event
// mutation and runs it (tur's onClick/onInput, framework-side — the
// mutation's body does the logging). Returns the entry-err pair (the
// phase-3 turn shape) — the harness never soft-fails.
entry fn on_event(c: opaque, kind: i32, subject: str, detail: str) -> (?opaque, str) {
    let h = opaque.downcast<?Harness>(c);
    if (kind == 1) {
        let mut root: T1Root = h.root;
        let out = t1_event(root, subject, detail);
        let _ = out;
    } else {
        panic(f"t1h: unknown event kind {kind}");
    }
    return (c, "");
}

// ---- shared scenario builders ---------------------------------------

/// The app-shaped row: checkbox + title + quiet del, keyed `row-<id>`.
/// Each control CARRIES its event mutation (the old subject strings as
/// the logged labels).
fn row_w(h: ?Harness, id: i64, name: str, on: bool) -> Widget {
    let mut w = row().key(f"row-{id}").hook(f"row-{id}");
    w.w(check(on).on_click(log_m(h, f"toggle:{id}")).hook(f"mark-{id}"));
    w.w(text(name).hook(f"lbl-{id}"));
    w.w(quiet("del").on_click(log_m(h, f"remove:{id}")).hook(f"del-{id}"));
    return w;
}

fn list_col() -> Widget {
    return col().gap(8).hook("list");
}

// ---- scenario renders -----------------------------------------------

/// Every kind, every variant, the ladder, role + placeholder + hooks —
/// the lowering snapshot's subject, all hooks distinct.
entry fn t1p_render_kinds(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;

    let mut tree = col().gap(16).pad(16).hook("kinds");
    tree.w(title("Today").hook("title"));
    let mut cd = card().pad(12).hook("card");
    cd.w(muted("3 open").hook("muted-line"));
    tree.w(cd);
    let mut head = row().gap(8).hook("head");
    head.w(field().placeholder("What needs doing?").on_input(log_m(h, "type")).hook("new-todo"));
    head.w(btn("Add").on_click(log_m(h, "add")).hook("add-btn"));
    tree.w(head);
    tree.w(spacer(8).hook("sp"));
    let mut r1 = row().key("row-1").hook("row-1");
    r1.w(check(false).on_click(log_m(h, "toggle:1")).hook("mark-1"));
    r1.w(text("milk").hook("lbl-1"));
    r1.w(quiet("del").on_click(log_m(h, "remove:1")).hook("del-1"));
    tree.w(r1);
    let mut r2 = row().key("row-2").hook("row-2");
    r2.w(check(true).on_click(log_m(h, "toggle:2")).hook("mark-2"));
    r2.w(done("tea").hook("lbl-2"));
    tree.w(r2);
    tree.w(pending("... jam").hook("pend"));
    tree.w(text("hi").hook("body-line"));

    t1_render(root, tree);
}

/// Two rows, milk then tea. The diff scenarios' left side.
entry fn t1p_rows_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(h, 1, "milk", false));
    tree.w(row_w(h, 2, "tea", false));
    t1_render(root, tree);
}

/// The same rows SWAPPED — the keyed reorder's right side.
entry fn t1p_rows_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(h, 2, "tea", false));
    tree.w(row_w(h, 1, "milk", false));
    t1_render(root, tree);
}

/// Row 1 only — rows 2 left the list.
entry fn t1p_rows_c(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(h, 1, "milk", false));
    t1_render(root, tree);
}

/// Rows 1, 2 and a NEW 3 — the keyed append's right side.
entry fn t1p_rows_d(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(h, 1, "milk", false));
    tree.w(row_w(h, 2, "tea", false));
    tree.w(row_w(h, 3, "jam", false));
    t1_render(root, tree);
}

/// Row 1's checkbox ON — the toggle's one-class-patch right side.
entry fn t1p_rows_toggle(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(h, 1, "milk", true));
    tree.w(row_w(h, 2, "tea", false));
    t1_render(root, tree);
}

/// A keyed flat list a,b,c — order is directly readable (texts).
entry fn t1p_flat_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = col().gap(4).hook("flat");
    tree.w(text("a").key("a"));
    tree.w(text("b").key("b"));
    tree.w(text("c").key("c"));
    t1_render(root, tree);
}

/// The mixed sequence: c,x,a — b gone, x created, a moved, c kept.
entry fn t1p_flat_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = col().gap(4).hook("flat");
    tree.w(text("c").key("c"));
    tree.w(text("x").key("x"));
    tree.w(text("a").key("a"));
    t1_render(root, tree);
}

/// One text line — the text-patch scenario, before.
entry fn t1p_solo_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = col().gap(8).hook("solo");
    tree.w(text("before").hook("line"));
    t1_render(root, tree);
}

/// The same line, text patched — after. No other delta exists.
entry fn t1p_solo_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = col().gap(8).hook("solo");
    tree.w(text("after").hook("line"));
    t1_render(root, tree);
}

/// A field with an empty value — the value-patch scenario, before.
entry fn t1p_field_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = col().gap(8).hook("form");
    tree.w(field().placeholder("What needs doing?").on_input(log_m(h, "type")).hook("new-todo"));
    t1_render(root, tree);
}

/// The same field, value patched to the draft — after.
entry fn t1p_field_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = col().gap(8).hook("form");
    tree.w(field().placeholder("What needs doing?").on_input(log_m(h, "type")).hook("new-todo").value("milk"));
    t1_render(root, tree);
}

// ---- trap scenarios (all LOUD, all named) ---------------------------

/// A Text with a child — the fat struct's one dishonesty, caught at
/// the lowering boundary.
entry fn t1p_trap_text_children(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let bad = text("x").hook("bad").w(row());
    t1_render(root, bad);
}

/// Off-ladder gap — no arbitrary values, ever.
entry fn t1p_trap_bad_gap(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    t1_render(root, row().gap(6).hook("bad"));
}

/// Off-ladder pad.
entry fn t1p_trap_bad_pad(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    t1_render(root, col().pad(20).hook("bad"));
}

/// Off-ladder size.
entry fn t1p_trap_bad_size(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    t1_render(root, spacer(10));
}

/// A hand-built Text with no variant — the fat struct permits it, the
/// lowering does not.
entry fn t1p_trap_text_no_variant(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    t1_render(root, Widget { kind: WKind.Text, text: "anon" });
}

/// A listening widget that carries no event mutation.
entry fn t1p_trap_listener_no_mutation(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    t1_render(root, btn("anon").hook("bad"));
}

/// A surviving key that changed kind — keys are identity.
entry fn t1p_trap_kind_change(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut a = col().key("x");
    a.w(text("a"));
    t1_render(root, a);
    t1_render(root, text("b").key("x"));
}

// ---- the framework-drift simulator ----------------------------------

/// Silent els-table theft: drops one live handle. Only the tests use
/// this — it stands in for internal drift so the patcher's unknown-
/// handle law can be exercised (unknown id during patch = LOUD).
entry fn t1p_els_steal(c: opaque, path: str) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut els: HashMap<str, opaque> = root.els;
    els.remove(path);
}

// ---- registry reads (the tests' assertions) --------------------------

entry fn t1p_regs_len(c: opaque) -> i32 {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut regs: HashMap<str, Ev> = root.regs;
    return regs.len();
}

/// Whether the id answers a live event mutation — the retirement
/// asserts peek existence; the LABEL asserts live on the fired log.
entry fn t1p_regs_has(c: opaque, id: str) -> bool {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut regs: HashMap<str, Ev> = root.regs;
    return regs.has(id);
}

entry fn t1p_els_len(c: opaque) -> i32 {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut els: HashMap<str, opaque> = root.els;
    return els.len();
}

entry fn t1p_els_has(c: opaque, path: str) -> bool {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut els: HashMap<str, opaque> = root.els;
    return els.has(path);
}

/// The live handle for a path — the tests downcast it host-side and
/// read the twin's node id (element identity through the handles).
entry fn t1p_els_handle(c: opaque, path: str) -> opaque {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut els: HashMap<str, opaque> = root.els;
    let hit = els.get(path);
    if (hit == nil) {
        panic(f"t1p: no live handle for '{path}'");
    }
    let el: opaque = hit;
    return el;
}

/// The delivered labels, "|"-joined, in arrival order — the event
/// mutations' own writes, read through the handle (pull-on-read).
entry fn t1p_log(c: opaque) -> str {
    let h = opaque.downcast<?Harness>(c);
    let lg: Vec<str> = h.log$.get();
    let mut out = "";
    let mut first = true;
    for (let s of lg) {
        if (first == false) {
            out = f"{out}|";
        }
        out = f"{out}{s}";
        first = false;
    }
    return out;
}

/// The mounted root's diff identity (key_of(prev)) — "" pre-render.
entry fn t1p_prev_key(c: opaque) -> str {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let prev = root.prev;
    if (prev == nil) {
        return "";
    }
    let w: Widget = prev;
    if (w.key != "") {
        return w.key;
    }
    return w.hook;
}

// ---- the reactive-props scenarios (tur's reads-as-props) -------------

/// A tree whose Text content is a DERIVED PROP — the resolve door is
/// t1_render's: the same tree re-rendered after a cell write patches
/// the text, because the prop resolves fresh each render.
entry fn t1p_live_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    let mut tree = col().gap(8).hook("livezone");
    tree.w(text("").text_of(h.num_view$).hook("lv"));
    t1_render(root, tree);
}

/// The reactive SUBTREE (tur's Each): the whole branch is a derived,
/// materialized at the render door and keyed-diffed like any tree.
entry fn t1p_live_each_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: T1Root = h.root;
    t1_render(root, col().gap(8).hook("livezone").w(live(h.each_view$)));
}

/// Test code may push the cell directly (the harness is the frozen
/// test surface's peer, not the app).
entry fn t1p_live_bump(c: opaque, v: i64) {
    let h = opaque.downcast<?Harness>(c);
    h.num$.set(v);
}
