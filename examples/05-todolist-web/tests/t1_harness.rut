// t1_harness.rut — phase 1's framework harness (the harness.rut
// shape): a minimal page program that mounts a T1Root on the seeded
// `#app` and exposes the t1 surface to the twin tests as probes —
// scenario renders (the ordinary `t1_mount` + `t1_render` calls),
// registry reads, and the trap shapes. NOT the todolist app (the app
// package `rut/app/app` is); nothing here is test-only machinery
// beyond naming the scenarios.
//
// The imports are the split shape: the framework's four names from
// `t1`, the Widget TYPE (and WKind, for the hand-built trap fixtures)
// from `widget`, and each constructor from its component package.
//
// The "biz" half of this harness is one law: a fired listener is
// translated through the framework's registry (`t1_subject` — a stale
// or unknown id is the LOUD miss) and the SUBJECT is logged, so the
// tests can read what a click delivered without parsing ids.

use t1::{ T1Root, t1_mount, t1_render, t1_subject };
use nmapset::{ HashMap };
use pouch::{ Vec };
use widget::{ Widget, WKind };
use col::{ col };
use row::{ row };
use card::{ card };
use spacer::{ spacer };
use text::{ text, done, title, pending, muted };
use button::{ btn, quiet };
use checkbox::{ check };
use field::{ field };

struct Harness {
    root: ?T1Root = nil;
    log: Vec<str> = Vec.new(); // the delivered subjects, in order
}

// The boot turn: mount the framework on #app and return the container
// the pump re-passes every turn. No tree yet — the first render is a
// probe's job (t1_render's create path).
entry fn main() -> opaque {
    let h: ?Harness = Harness { root: t1_mount("app") };
    return opaque(h);
}

// The ONE re-entry point: a DOM event row arrives with the listener id
// as its subject; the framework translates id -> subject (LOUD miss),
// and this harness's "biz" logs it. Returns the entry-err pair (the
// phase-3 turn shape) — the harness never soft-fails.
entry fn on_event(c: opaque, kind: i32, subject: str, detail: str) -> (?opaque, str) {
    let h = opaque.downcast<?Harness>(c);
    if (kind == 1) {
        let mut root: ?T1Root = h.root;
        let s = t1_subject(root, subject);
        let mut lg: Vec<str> = h.log;
        lg.push(s);
    } else {
        panic(f"t1h: unknown event kind {kind}");
    }
    let _ = detail;
    return (c, "");
}

// ---- shared scenario builders ---------------------------------------

/// The app-shaped row: checkbox + title + quiet del, keyed `row-<id>`.
fn row_w(id: i64, name: str, on: bool) -> Widget {
    let mut w = row().key(f"row-{id}").hook(f"row-{id}");
    w.w(check(on).subject(f"toggle:{id}").hook(f"mark-{id}"));
    w.w(text(name).hook(f"lbl-{id}"));
    w.w(quiet("del").subject(f"remove:{id}").hook(f"del-{id}"));
    return w;
}

fn list_col() -> Widget {
    return col().gap(8).hook("list");
}

// ---- scenario renders -----------------------------------------------

/// Every kind, every variant, the ladder, role + placeholder + hooks —
/// the lowering snapshot's subject, all hooks distinct.
entry fn t1p_render_kinds(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;

    let mut tree = col().gap(16).pad(16).hook("kinds");
    tree.w(title("Today").hook("title"));
    let mut cd = card().pad(12).hook("card");
    cd.w(muted("3 open").hook("muted-line"));
    tree.w(cd);
    let mut head = row().gap(8).hook("head");
    head.w(field().placeholder("What needs doing?").subject("type").hook("new-todo"));
    head.w(btn("Add").subject("add").hook("add-btn"));
    tree.w(head);
    tree.w(spacer(8).hook("sp"));
    let mut r1 = row().key("row-1").hook("row-1");
    r1.w(check(false).subject("toggle:1").hook("mark-1"));
    r1.w(text("milk").hook("lbl-1"));
    r1.w(quiet("del").subject("remove:1").hook("del-1"));
    tree.w(r1);
    let mut r2 = row().key("row-2").hook("row-2");
    r2.w(check(true).subject("toggle:2").hook("mark-2"));
    r2.w(done("tea").hook("lbl-2"));
    tree.w(r2);
    tree.w(pending("... jam").hook("pend"));
    tree.w(text("hi").hook("body-line"));

    t1_render(root, tree);
}

/// Two rows, milk then tea. The diff scenarios' left side.
entry fn t1p_rows_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(1, "milk", false));
    tree.w(row_w(2, "tea", false));
    t1_render(root, tree);
}

/// The same rows SWAPPED — the keyed reorder's right side.
entry fn t1p_rows_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(2, "tea", false));
    tree.w(row_w(1, "milk", false));
    t1_render(root, tree);
}

/// Row 1 only — rows 2 left the list.
entry fn t1p_rows_c(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(1, "milk", false));
    t1_render(root, tree);
}

/// Rows 1, 2 and a NEW 3 — the keyed append's right side.
entry fn t1p_rows_d(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(1, "milk", false));
    tree.w(row_w(2, "tea", false));
    tree.w(row_w(3, "jam", false));
    t1_render(root, tree);
}

/// Row 1's checkbox ON — the toggle's one-class-patch right side.
entry fn t1p_rows_toggle(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = list_col();
    tree.w(row_w(1, "milk", true));
    tree.w(row_w(2, "tea", false));
    t1_render(root, tree);
}

/// A keyed flat list a,b,c — order is directly readable (texts).
entry fn t1p_flat_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = col().gap(4).hook("flat");
    tree.w(text("a").key("a"));
    tree.w(text("b").key("b"));
    tree.w(text("c").key("c"));
    t1_render(root, tree);
}

/// The mixed sequence: c,x,a — b gone, x created, a moved, c kept.
entry fn t1p_flat_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = col().gap(4).hook("flat");
    tree.w(text("c").key("c"));
    tree.w(text("x").key("x"));
    tree.w(text("a").key("a"));
    t1_render(root, tree);
}

/// One text line — the text-patch scenario, before.
entry fn t1p_solo_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = col().gap(8).hook("solo");
    tree.w(text("before").hook("line"));
    t1_render(root, tree);
}

/// The same line, text patched — after. No other delta exists.
entry fn t1p_solo_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = col().gap(8).hook("solo");
    tree.w(text("after").hook("line"));
    t1_render(root, tree);
}

/// A field with an empty value — the value-patch scenario, before.
entry fn t1p_field_a(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = col().gap(8).hook("form");
    tree.w(field().placeholder("What needs doing?").subject("type").hook("new-todo"));
    t1_render(root, tree);
}

/// The same field, value patched to the draft — after.
entry fn t1p_field_b(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut tree = col().gap(8).hook("form");
    tree.w(field().placeholder("What needs doing?").subject("type").hook("new-todo").value("milk"));
    t1_render(root, tree);
}

// ---- trap scenarios (all LOUD, all named) ---------------------------

/// A Text with a child — the fat struct's one dishonesty, caught at
/// the lowering boundary.
entry fn t1p_trap_text_children(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let bad = text("x").hook("bad").w(row());
    t1_render(root, bad);
}

/// Off-ladder gap — no arbitrary values, ever.
entry fn t1p_trap_bad_gap(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    t1_render(root, row().gap(6).hook("bad"));
}

/// Off-ladder pad.
entry fn t1p_trap_bad_pad(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    t1_render(root, col().pad(20).hook("bad"));
}

/// Off-ladder size.
entry fn t1p_trap_bad_size(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    t1_render(root, spacer(10));
}

/// A hand-built Text with no variant — the fat struct permits it, the
/// lowering does not.
entry fn t1p_trap_text_no_variant(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    t1_render(root, Widget { kind: WKind.Text, text: "anon" });
}

/// A listening widget that answers no subject.
entry fn t1p_trap_listener_no_subject(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    t1_render(root, btn("anon").hook("bad"));
}

/// A surviving key that changed kind — keys are identity.
entry fn t1p_trap_kind_change(c: opaque) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut a = col().key("x");
    a.w(text("a"));
    t1_render(root, a);
    t1_render(root, text("b").key("x"));
}

// ---- the framework-drift simulator ----------------------------------

/// Silent els-table theft: drops one live handle. Only the tests use
/// this — it stands in for internal drift so the patcher's unknown-
/// handle law can be exercised (unknown id during patch = LOUD).
entry fn t1p_els_steal(c: opaque, path: str) {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut els: ?HashMap<str, opaque> = root.els;
    els.remove(path);
}

// ---- registry reads (the tests' assertions) --------------------------

entry fn t1p_regs_len(c: opaque) -> i32 {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut regs: ?HashMap<str, str> = root.regs;
    return regs.len();
}

/// "" when the id is absent — the tests assert exact subjects.
entry fn t1p_regs_subject(c: opaque, id: str) -> str {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut regs: ?HashMap<str, str> = root.regs;
    let hit = regs.get(id);
    if (hit == nil) {
        return "";
    }
    let s: str = hit;
    return s;
}

entry fn t1p_els_len(c: opaque) -> i32 {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut els: ?HashMap<str, opaque> = root.els;
    return els.len();
}

entry fn t1p_els_has(c: opaque, path: str) -> bool {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut els: ?HashMap<str, opaque> = root.els;
    return els.has(path);
}

/// The live handle for a path — the tests downcast it host-side and
/// read the twin's node id (element identity through the handles).
entry fn t1p_els_handle(c: opaque, path: str) -> opaque {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let mut els: ?HashMap<str, opaque> = root.els;
    let hit = els.get(path);
    if (hit == nil) {
        panic(f"t1p: no live handle for '{path}'");
    }
    let el: opaque = hit;
    return el;
}

/// The delivered subjects, "|"-joined, in arrival order.
entry fn t1p_log(c: opaque) -> str {
    let h = opaque.downcast<?Harness>(c);
    let lg: Vec<str> = h.log;
    let mut out = "";
    let mut first = true;
    for (let s of lg) {
        if (first == false) {
            out = f"{out}|";
        }
        out = f"{out}{s}";
        first = false;
    }
    return out;
}

/// The mounted root's diff identity (key_of(prev)) — "" pre-render.
entry fn t1p_prev_key(c: opaque) -> str {
    let h = opaque.downcast<?Harness>(c);
    let mut root: ?T1Root = h.root;
    let prev = root.prev;
    if (prev == nil) {
        return "";
    }
    let w: Widget = prev;
    if (w.key != "") {
        return w.key;
    }
    return w.hook;
}
