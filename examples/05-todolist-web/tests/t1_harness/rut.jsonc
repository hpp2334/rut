{
  // tests/t1_harness/ — the framework harness (the t1 twin gate's
  // probe), its own module dir like every rut program: the manifest names
  // the two-package imports, the load mounts the closure.
  "name": "t1_harness",
  "entry": {
    "lib": "./t1_harness.rut"
  },
  "deps": {
    "ui": {
      "path": "../../rut/ui"
    },
    // the toolchain's std closure, from the CDN — the same pinned
    // jsDelivr rows the app's own manifests spell (the tests prime an
    // offline remote from the committed dist/std artifacts, so the gate
    // never networks)
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v7/dist/std/pouch.rutbundle", "sha256": "49f9958c7cec1b6b3ab87aa8c87cddadf31461d8dc6cd2e66f3d6b7b140c389b" },
    "nmapset": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v7/dist/std/nmapset.rutbundle", "sha256": "ff8e542e73644cea0f2e117231a74179cbfcdaec98cbce577ab6c0c3c3c5fb1a" }
  }
}
