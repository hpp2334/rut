{
  // tests/t1_harness/ — the framework harness (the t1 twin gate's
  // probe), its own module dir like every rut program: the manifest names
  // the two-package imports, the load mounts the closure.
  "name": "t1_harness",
  "entry": {
    "lib": "./t1_harness.rut"
  },
  "deps": {
    "ui": {
      "path": "../../rut/ui"
    },
    // the toolchain's std closure, from the CDN — the same pinned
    // jsDelivr rows the app's own manifests spell (the tests prime an
    // offline remote from the committed dist/std artifacts, so the gate
    // never networks)
    "pouch": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v3/dist/std/pouch.rutbundle", "sha256": "ce820058dd64669bb018331e03c8557ed9e6d16d946d045e482dac302c52698a" },
    "nmapset": { "url": "https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v3/dist/std/nmapset.rutbundle", "sha256": "941d76d97c67c0fe54eb7b0ea8ca7de399478d61b0584274a29229602dc8ba2a" }
  }
}
