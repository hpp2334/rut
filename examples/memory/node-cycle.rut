// RFC 0017 — strong cycles LEAK by design (no collector). Disposal.dispose of a
// leaked cycle never runs. Fix back-pointers with Weak<T>:
// `next: Weak<Node>` instead of `Rc<Node>` breaks the cycle.

import { Logger } from "std:log";

class Node {                              // initializer covers `next`
    next: Option<Rc<Node>> = Option.none; // -> default constructor: Node()

    fn link(mut self, other: Rc<Node>): void {
        self.next = Option.some(other);
    }
}

fn make_cycle(): Rc<Node> {               // a -> b -> a : strong cycle
    let a = Rc(Node());
    let b = Rc(Node());
    a.link(b);
    b.link(a);
    return a;
}

export fn main(): void {
    let log = Logger("cycle");
    let head = make_cycle();
    log.info(f"head.next alive: {head.next.is_some()}");

    // The leak fix: hold `b` from `a` through Weak (RFC 0017 §1) so the
    // pair frees deterministically at scope end.
}
