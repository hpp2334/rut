// RFC 0009 §"Representation" — recursive dataclasses. Composite fields are
// cell-handle slots, so a record may name itself; assignment shares the
// handle (reference semantics, RFC 0011 §1), and cycles leak by design
// (RFC 0017). A binary tree is the canonical recursive shape.

import { Option } from "std:core";
dataclass Node {
    value: i32,
    left: Option<Node>,
    right: Option<Node>,
}

fn make(depth: i32, v: i32) -> Node {
    if (depth <= 0) {
        return Node { value: v, left: Option.none(), right: Option.none() };
    }
    return Node {
        value: v,
        left: Option.some(make(depth - 1, v * 2)),
        right: Option.some(make(depth - 1, v * 2 + 1)),
    };
}

fn count(n: Node) -> i32 {
    let mut c = 1;
    if (n.left.is_some()) { c += count(n.left.value); }
    if (n.right.is_some()) { c += count(n.right.value); }
    return c;
}

pub fn main() -> unit {
    let root = make(3, 1);
    print(f"nodes={count(root)}");
}
