// RFC 0017 §1 — Weak<T> does not keep the cell alive; upgrade() returns
// Option<T>. Works over ANY cell (RFC 0016 §1). For caches/observers —
// not destructors.

import { Logger } from "std:log";

class Tile {
    private n: i32;

    constructor(n: i32): Self {
        return Self { n: n };
    }

    fn id(self): i32 { return self.n; }
}

fn probe(): Weak<Tile> {
    let log = Logger("weak");
    let t = Tile(7);
    let w = Weak(t);            // Weak<Tile> — no strong reference held
    log.info(f"alive inside: {w.upgrade().is_some()}");   // true
    return w;
}   // t dropped; no strong refs remain -> the cell dies, the WeakBox nulls

export fn main(): void {
    let log = Logger("weak");
    let alive = Tile(1);
    let a = Weak(alive);
    log.info(f"held: {a.upgrade().is_some()} id={a.upgrade().value.id()}");

    let w = probe();
    log.info(f"alive after drop: {w.upgrade().is_some()}");   // false
}
