// RFC 0017 §1 — Weak<T> does not keep the cell alive; upgrade() returns
// Option<Rc<C>>. For caches/observers — not destructors.

import { Logger } from "std:log";

class Tile {
    private n: i32;

    factory(n: i32): Self {
        return Self { n: n };
    }

    fn id(): i32 { return this.n; }
}

fn probe(): Weak<Tile> {
    const log = Logger("weak");
    const t = Rc(Tile(7));
    const w = Weak(t);            // Weak<Tile> — no strong reference held
    log.info(f"alive inside: {w.upgrade().is_some()}");   // true
    return w;
}   // t dropped; no strong refs remain -> the cell dies, the WeakBox nulls

export fn main(): void {
    const log = Logger("weak");
    const alive = Rc(Tile(1));
    const a = Weak(alive);
    log.info(f"held: {a.upgrade().is_some()} id={a.upgrade().value.id()}");

    const w = probe();
    log.info(f"alive after drop: {w.upgrade().is_some()}");   // false
}
