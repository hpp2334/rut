// RFC 0016 §3 — deterministic destruction: the `Disposal` impl runs at
// rc 0, then fields are released in order. No FinalizationRegistry, no
// "maybe later".

import { remove } from "std:fs";
import { Logger } from "std:log";
import { Disposal } from "std:core";

class TempFile implements Disposal {
    private path: string;

    constructor(path: string): Self {   // the handle IS the ownership —
        return Self { path: path };     // no boxing needed (RFC 0011 §2)
    }

    fn write(self, data: Vec<u8>): void { /* ... */ }

    fn dispose(mut self): void {      // Disposal impl — runs once, at rc 0
        remove(self.path);
    }
}

export fn main(): void {
    let log = Logger("tempfile");
    let f = TempFile("tmp.dat");     // a Disposal class is just a class
    f.write(Vec<u8>(64));
    log.info("working...");
}   // last handle drops HERE: rc hits 0, Disposal.dispose runs,
    // then `path` is released
