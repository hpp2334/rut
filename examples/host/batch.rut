// RFC 0022/0023/0025 — the host-handle ROUND TRIP.
//
// The host provides plugin:batch as HOST FNS over an `Opaque` handle
// (examples/host/plugin/batch.d.rut; Rust in examples/host/batch.rs).
// This module wraps them in a class, receives a handle from the host,
// runs several procedures on it in plain rut, then passes it BACK by
// calling submit — the host callback.

import { Opaque } from "std:core";
import { batch_new, batch_push, batch_len, submit } from "plugin:batch";
import { Logger } from "std:log";

// plain rut data feeding the pipeline (RFC 0009) — no host involvement
dataclass Sample {
    metric: str;
    value: i64;
}

// the wrapper class: the handle plus the methods (the `Logger` pattern,
// RFC 0028). `submit` stays a free fn — it consumes the batch, it is
// not a member.
class Batch {
    h: Opaque;

    fn new(name: str) -> Self { return Self { h: batch_new(name) }; }
    fn push(mut self, metric: str, value: i64) -> unit { batch_push(self.h, metric, value); }
    fn len(self) -> i32 { return batch_len(self.h); }
}

pub fn main() -> unit {
    let log = Logger.new("batch");

    // 1. construction: batch_new runs in Rust — the instance is an
    // Opaque box (RFC 0014), rc 1, owned by this wrapper's field.
    let b = Batch.new("hud-metrics");

    // 2. several procedures, all ordinary rut: filter, aggregate, and
    // push — each push is one host fn crossing (RFC 0032); the host
    // never sees the loop.
    let samples = [
        Sample { metric: "fps",     value: 60 },
        Sample { metric: "draw_ms", value: 3 },
        Sample { metric: "fps",     value: 59 },
        Sample { metric: "heap_kb", value: 812 },
    ];
    let mut total: i64 = 0;
    for (let s of samples) {
        if (s.value > 0) {
            b.push(s.metric, s.value);             // rut -> host
            total += s.value;
        }
    }
    b.push("total", total);                        // rut-computed aggregate
    if (b.len() < 2) {
        log.warn("batch suspiciously small");
    }

    // 3. pass it BACK: submit is a host fn whose parameter is the same
    // handle the wrapper holds — the callback. The instance crosses
    // rut -> Rust as the box's call-scoped borrow (checked at the call
    // site by TypeId, RFC 0022 §2), and the receipt crosses back out as
    // the ordinary checked return value.
    let receipt = submit(b.h);
    log.info(f"submit -> {receipt} (batch holds {b.len()})");

    // b is STILL usable here: submit borrowed the box for the call's
    // duration only (RFC 0023 §2) — a host that wants it past the
    // return retains an owning clone (see batch.rs). rc semantics are
    // unchanged by the crossing.
}   // rc 0: the box releases and the Rust Batch's Drop runs NOW — the
    // Vec of metrics releases, deterministic, never "at GC someday"
    // (RFC 0016 §3)
