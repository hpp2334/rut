// RFC 0022–0028 — host & FFI: host-class handles, repr C struct passing,
// zero-copy buffer borrows, and Template (structured f"...", for l10n).
// The host side of this module is sketched in RFC 0022–0028. Native
// surfaces are DECLARED in rut-source declaration files (RFC 0025) —
// app/gfx.d.rut declares Canvas, newCanvas, and Source below; the Rust
// bodies bind by name at embedder startup.

import { Canvas, newCanvas, Source } from "app:gfx";  // declaration file
import { log_l10n } from "app:log";                // host fn log_l10n(t: Template): unit
import { Logger } from "std:log";

// app/gfx.d.rut (the declaration file) contains, among others:
//     export host class Source<T> {  // instantiation identity KEPT:
//         fn get(): T;               // Source<i32> != Source<string>
//     }
// — declared for typing; built and implemented entirely host-side.

// Mirrored on the host as #[repr(C)] struct Vertex { x: f32, y: f32, color: u32 }
// — register_struct::<Vertex>("Vertex") verified size/align/offsets at startup.
dataclass Vertex {
    x: f32;
    y: f32;
    color: u32;
}

fn draw_frame(c: Canvas, verts: Array<Vertex, 2>): unit {
    // verts borrows zero-copy: the host reads the inline repr-C block for
    // the duration of the call (a fixed Array<Vertex, N> IS the N-slot
    // block — RFC 0005); rut-side mutation inside re-entrant calls
    // would trap (borrow guard) instead of racing.
    c.blit(verts);
}

fn localized(count: i32, user: string): unit {
    // The SAME literal that would concat to a string builds a structured
    // Template here, because log_l10n expects one — the host formats
    // per-locale with typed args; nothing was parsed back out of a string.
    log_l10n(f"{user} has {count} alerts");
}

export fn main(): unit {
    let log = Logger.new("interop");
    let c = newCanvas();                         // host constructs the handle
    let verts: Array<Vertex, 2> = [
        Vertex { x: 0, y: 0, color: 0xFF00FF },
        Vertex { x: 1, y: 1, color: 0x00FFFF },
    ];
    draw_frame(c, verts);

    let hits: Source<i32> = c.hit_source();
    log.info(f"hits={hits.get()}");                // checked: Source<i32>.get(): i32

    localized(3, "ada");
}   // c's rc hits 0 -> the host's Canvas::drop runs NOW (deterministic)
