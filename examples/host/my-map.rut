// RFC 0023/0025 — an EMBEDDER-DEFINED native module in use.
//
// rut sees ONLY THE DECLARATION of plugin:my_map (the host fns in
// examples/host/plugin/my_map.d.rut — `.d.rut` is the only place `host`
// may appear, RFC 0029). The Rust IMPLEMENTATION is the sibling file
// examples/host/my_map.rs, bound by name at embedder startup and proven
// signature-equal at vm.load link. `rutc check` of THIS file runs with
// no implementation (no Rust at all) present; referencing a fn with none
// bound fails at link, not mysteriously later.
//
// There is no `host class` to import: native state crosses as `Opaque`
// and the WRAPPER CLASS below gives it back its name, its methods, and
// its impl blocks (the `Logger` pattern, RFC 0028). Every method body is
// one host fn call — the same single crossing a host-class method would
// have paid — and the wrapper is ordinary rut: auditable, optimizable
// around the calls, and free to grow helpers the host never ships.

import { Opaque, downcast } from "std:core";
import { my_map_new, my_map_set, my_map_get, my_map_size } from "plugin:my_map";
import { Canvas, newCanvas } from "app:gfx";
import { Logger } from "std:log";

// The wrapper: one Opaque field, one host fn per method. Construction is
// a class method (RFC 0010 §1) — `Self { .. }` over the host's handle.
class MyMap {
    h: Opaque;                              // the Rust HashMap, boxed

    fn new(cap: i32) -> Self { return Self { h: my_map_new(cap) }; }
    fn set(mut self, k: str, v: Opaque) -> unit { my_map_set(self.h, k, v); }
    fn get(self, k: str) -> Option<Opaque> { return my_map_get(self.h, k); }
    fn size(self) -> i32 { return my_map_size(self.h); }
}

pub fn main() -> unit {
    let log = Logger.new("my-map");

    // str keys hash by content host-side (a registered builtin impl —
    // no user code needed). Values cross as Opaque: RFC 0014's checked
    // erasure is the value story now that generic host state is gone —
    // set/get just move the boxes, `downcast<T>` recovers them typed.
    let counts = MyMap.new(32);
    for (let i = 0; i < 20; i += 1) {
        let k = f"key-{i % 7}";                  // 7 distinct keys
        let prev = counts.get(k).unwrap_or(Opaque.new(0));
        let n = downcast<i32>(prev).unwrap_or(0) + 1;
        counts.set(k, Opaque.new(n));
    }
    let hits = downcast<i32>(counts.get("key-3").unwrap_or(Opaque.new(-1))).unwrap_or(-1);
    log.info(f"size={counts.size()} key-3={hits}");  // native get returns
                                                    // rut's builtin Option
    // A value of a HOST type rides just as well: box the Canvas handle
    // (it is already an Opaque), fish it back, downcast on OUR side.
    let surfaces = MyMap.new(4);
    surfaces.set("hud", newCanvas());
    let hud = downcast<Canvas>(surfaces.get("hud").expect("hud present"));
    if (hud.is_some()) {
        hud.value.circle(10, 10, 5);               // back in typed host API
    }

    // What the wrapper cannot give back (the honest cost of no host
    // class): admission-only bounds — `MyMap<Canvas, ..>` once failed at
    // COMPILE against `K requires Hashable`; any Opaque fits anywhere
    // now, and wrong downcasts yield None (checked, never a trap).
    // Keys are str: a dataclass key would need an explicit Opaque wrap
    // and a host-side hash with no `Hashable` contract to call back
    // into (the vtable re-entry story left with host class generics).
}   // the Opaque boxes' rc hit 0 here — each boxed value's Rust Drop
    // runs NOW, deterministic, never "at GC someday" (RFC 0016 §3/§5)
