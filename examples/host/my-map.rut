// RFC 0025/0026 — an EMBEDDER-DEFINED native module in use.
//
// rut sees ONLY THE DECLARATION of MyMap: `pub host class MyMap<
// K: Hashable, V> { .. }` — signatures, no bodies — in the declaration
// file examples/host/plugin/my_map.d.rut (`.d.rut` is the only place
// `host` may appear, RFC 0029). The Rust IMPLEMENTATION is the sibling
// file examples/host/my_map.rs, bound by name at embedder startup and
// proven signature-equal at vm.load link. `rutc check` of THIS file runs
// with no implementation (no Rust at all) present; referencing MyMap
// with none bound fails at link, not mysteriously later. std:collection's
// Map<K,V>/Set<T> ride this same machinery (RFC 0005, resolved —
// RFC 0028): containers are library types — declaration files + Rust
// bodies — not VM builtins.
//
// Boundary crossings in this file: the class type itself (first use of
// MyMap<A, B> reifies the instantiation and builds its method table),
// the native class method (construction), every method call (callnat by slot —
// names never dispatch, RFC 0032), and Option/Vec values flowing
// back out.

import { MyMap } from "plugin:my_map";                // resolves to the .d.rut
import { Hashable } from "std:collection";            // declaration file: the
import { Canvas, newCanvas } from "app:gfx";          // constraint interface
import { Logger } from "std:log";

// A DATACLASS key (RFC 0009): an all-public, literal-constructed
// record — with impl blocks, because dataclasses implement traits.
// Its limits, exhaustively: no `pub` on fields, no hidden
// members, no class methods, no `Disposal`.
dataclass Name {                        // hash + eq: ONE contract (RFC 0028) —
    first: string;                      // the value-keyed Map/Set key interface
    last: string;
}

impl Hashable for Name {
    fn hash(self) -> u64 {                             // demo hash (length mix);
        return u64(self.first.len()) * 1000003      // real impls mix bytes
             + u64(self.last.len());
    }

    fn eq(self, other: Name) -> bool {                 // field-wise equality —
        return other.first == self.first            // what the map compares
            && other.last == self.last;             // keys with after a hash
    }                                                // hit (`==` itself is
}                                                    // identity — RFC 0012 §4)

pub fn main() -> unit {
    let log = Logger.new("my-map");

    // K = string: satisfies Hashable via a REGISTERED builtin impl —
    // no user code needed. Construction is a METHOD CALL on the
    // instantiated host class: MyMap<string, i32>.new(32) reifies the
    // instantiation and runs its native class method with a capacity
    // hint (RFC 0026 §3).
    let counts: MyMap<string, i32> = MyMap<string, i32>.new(32);

    for (let i = 0; i < 20; i += 1) {
        let k = f"key-{i % 7}";                  // 7 distinct keys
        counts.set(k, counts.get(k).unwrap_or(0) + 1);
    }
    let hits = counts.get("key-3").unwrap_or(-1); // native get returns
    log.info(f"size={counts.size()} key-3={hits}"); // rut's builtin Option

    // K = a DATACLASS: satisfies Hashable because `impl Hashable for
    // Name` exists in this module. The map's hashing calls back into
    // THIS hash() and eq()
    // — rut code reached through the interface-object vtable (re-entrant VM
    // call, borrow-guarded).
    let roster: MyMap<Name, i32> = MyMap<Name, i32>.new(4);
    roster.set(Name { first: "ada", last: "lovelace" }, 1);
    roster.set(Name { first: "grace", last: "hopper" }, 2);
    log.info(f"roster size={roster.size()}");

    // K = a class with no impl — rejected at COMPILE (IR) time against
    // the host-class DECLARATION (plugin/my_map.d.rut); the verifier
    // re-checks at load:
    //
    // let bad = MyMap<Canvas, i32>.new(4);
    //                    ^^^^^^ error: no `impl Hashable for Canvas`
    //                    — required by MyMap's K
    //                    (satisfiable by: impl Hashable for Canvas, or a
    //                    registered builtin/struct impl)

    // V = Opaque: a SECOND instantiation (own TypeId) storing values rut
    // cannot see inside. Native set/get just move the boxes — the Rust
    // side never inspects them; downcast<Canvas> recovers on OUR side.
    let surfaces: MyMap<string, Opaque> = MyMap<string, Opaque>.new(4);
    surfaces.set("hud", Opaque.new(newCanvas()));
    let hud = downcast<Canvas>(surfaces.get("hud").expect("hud present"));
    if (hud.is_some()) {
        hud.value.circle(10, 10, 5);               // back in typed host API
    }

    // counts.keys() -> Vec<string> (K is preserved, not erased to
    // Hashable — built host-side from the instantiation's K Ty, each
    // key unerased to its natural value); the loop itself is pure rut.
    for (let k of counts.keys()) {
        log.debug(f"{k} -> {counts.get(k).unwrap_or(0)}");
    }
}   // MyMap's Rust Drop releases the boxed values; each Canvas's Rust Drop
    // runs at its rc-0 — deterministic, never "at GC someday" (RFC 0025)
