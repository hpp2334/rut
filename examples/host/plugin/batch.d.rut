// plugin/batch.d.rut — the DECLARATION FILE for "plugin:batch".
//
// One host class, one host fn — the whole surface of a telemetry-style
// batch plugin. `host`/`extern` are .d.rut-ONLY keywords (RFC 0029):
// signatures, no bodies. The Rust IMPLEMENTATION is the sibling file
// examples/host/batch.rs, bound by name at embedder startup and proven
// signature-equal at vm.load link; the consumer is examples/host/
// batch.rut (construct in Rust, operate in rut, hand the instance BACK
// through the submit callback).
//
// Import specifiers map to declaration files by path: "plugin:batch" ->
// plugin/batch.d.rut. Only EXPORTED decls are nameable outside.

export host class Batch {
    fn new(name: string) -> Self;              // native class method — the
    fn push(self, metric: string, value: i64) -> unit;   // construction
    fn len(self) -> i32;                       // surface (RFC 0010/0025)
}

// The HOST CALLBACK: a module-level host fn whose PARAMETER TYPE is the
// host class itself. Calling submit(b) hands the instance back across
// the boundary — rut -> Rust — where it arrives as a call-scoped
// Handle<Batch> (RFC 0022 §2, RFC 0023 §2); the receipt crosses back
// out as an ordinary checked return value.
export host fn submit(b: Batch) -> string;

// Slot table (declaration order; part of the decl digest — RFC 0029 §3):
//     Batch: new -> 0, push -> 1, len -> 2; module fn submit -> its own
// slot in the module table. Consumer calls compile to callnat { slot } —
// names are binding-time labels for the Rust impl, never dispatch keys,
// never in the IR (RFC 0032).
