// plugin/batch.d.rut — the DECLARATION FILE for "plugin:batch".
//
// A telemetry-style batch plugin: native state (a Rust Batch) held by
// rut as an `Opaque` box, operated on through host fns, and handed BACK
// across the boundary through a host fn parameter — the callback.
//
// `host` is a .d.rut-ONLY keyword (RFC 0029): signatures, no bodies. The
// Rust IMPLEMENTATION is the sibling file examples/host/batch.rs, bound
// by name at embedder startup and proven signature-equal at vm.load
// link; the consumer is examples/host/batch.rut (a rut wrapper class
// over these fns — the `Logger` pattern, RFC 0028). No `host class`:
// the handle IS the crossing value, and the class lives in rut where it
// can carry methods and impl blocks.
//
// Import specifiers map to declaration files by path: "plugin:batch" ->
// plugin/batch.d.rut. Only EXPORTED decls are nameable outside.

// the instance handle: an Opaque box; its Rust Drop runs at rc 0
pub host fn batch_new(name: str) -> Opaque;
pub host fn batch_push(b: Opaque, metric: str, value: i64) -> unit;
pub host fn batch_len(b: Opaque) -> i32;

// the HOST CALLBACK: a host fn whose PARAMETER is the same Opaque the
// wrapper holds. Calling submit(b) hands the instance back across the
// boundary — rut -> Rust — where it arrives as the box's call-scoped
// borrow (RFC 0022 §2, RFC 0023 §2); the receipt crosses back out as an
// ordinary checked return value.
pub host fn submit(b: Opaque) -> str;

// Slot table (declaration order; part of the decl digest — RFC 0029 §3):
//     batch_new -> 0, batch_push -> 1, batch_len -> 2; module fn submit
// -> its own slot in the module table. Consumer calls compile to
// callnat { slot } — names are binding-time labels for the Rust impl,
// never dispatch keys, never in the IR (RFC 0032).
