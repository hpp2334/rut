// plugin/my_map.d.rut — the DECLARATION FILE for "plugin:my_map".
//
// `host`/`extern` are .d.rut-ONLY keywords (RFC 0029): a .rut file that
// spells either is a compile error. This file is pure surface —
// signatures, no bodies — and compiles to a DeclIr (.d.ir cache;
// version-locked, regenerable) plus a native slot table. rutc, the LSP,
// and AOT builds consume it with ZERO Rust linked (the tur index.d.ts
// role, in-language and type-checked). The Rust IMPLEMENTATION is the
// sibling file examples/host/my_map.rs, bound by name at embedder
// startup and proven signature-equal at vm.load link.
//
// Import specifiers map to declaration files by path: "plugin:my_map" ->
// plugin/my_map.d.rut. Only EXPORTED decls are nameable outside.

// Param bounds on host decls are ADMISSION-ONLY syntax (RFC 0013 §2 —
// user generics have no bounds): they constrain which instantiations
// compile, and grant no method calls on bare K. "Hashable" imports from
// std:collection — whose own declaration file ships with the toolchain
// exactly like this one.
import { Hashable } from "std:collection";

export host class MyMap<K: Hashable, V> {
    fn new(cap: i32): Self;              // native class method — the
    fn set(self, k: K, v: V): unit;      // construction surface (RFC 0010/0025)
    fn get(self, k: K): Option<V>;
    fn size(self): i32;
    fn keys(self): Vec<K>;             // Vec<K>, NOT Vec<dyn Hashable>:
}                                     // keys are unerased at the boundary
                                      // (trait objects cannot be
                                      // downcast — RFC 0012 §3)
// What compiling this file produces: a slot table
//     new -> 0, set -> 1, get -> 2, size -> 3, keys -> 4
// (declaration order; part of the decl digest). Consumer calls compile
// to callnat { slot } — names are binding-time labels for the Rust impl,
// never dispatch keys, never in the IR (RFC 0032).
