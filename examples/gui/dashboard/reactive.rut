import { Vec } from "std:collection";
// reactive.rut — tur's reactive primitives (state / source / derive /
// mutation / watch / Store) implemented ENTIRELY in user rut. No host
// support, no language magic. The one thing a heterogeneous store needs —
// values of many types behind one table — is the `Opaque` object type
// (RFC 0014): entries are `Opaque` cells keyed by atom id, made with
// `Opaque.new(v)`, recovered with `downcast<T>`, checked by the reified
// runtime type.
//
//   state(v)       -> State<T>      writable atom; the store materializes
//                                   it on first read/write
//   source(f)      -> Source<T>     EXTERNAL data, read-only: `f` seeds it,
//                                   services push snapshots via source_push
//   derive(fn)     -> Derived<T>    computed on every read (pull-based;
//                                   OQ-19 tracks caching)
//   mutation(fn)   -> Mutation<P,R> deferred handler; dispatched with a
//                                   payload (Nil {} for zero-arg actions)
//   watch(a, cb)   -> WatchHandle  change-only callback on any Atom,
//                                   flushed to a fixed point after the top
//                                   dispatch or source_push

import { Logger } from "std:log";
import { Disposal } from "std:core";

// ------------------------------------------------------------------ atoms

/** Anything with an identity in the store — State, Source, Derived.
 *  Passing a bare atom to watch() widens it to dyn Atom (RFC 0012 §2). */
trait Atom {
    fn atom_id(self) -> u32;
}

/** Atom-id allocator: explicit, threaded — there is no mutable module
 *  state (RFC 0003 §1); the owner (setup) creates one and passes it in. */
pub dataclass Ids {
    next: u32 = 0;
}

fn fresh(ids: Ids) -> u32 {               // dataclass aliasing = shared cell
    ids.next &+= 1;
    return ids.next;
}

pub class State<T> {
    id: u32;
    seed: Opaque;                // first read materializes it

    fn new(ids: Ids, v: T) -> Self {      // class methods run logic too
        return Self { id: fresh(ids), seed: Opaque.new(v) };
    }

    fn seed_value(self) -> Opaque { return self.seed; }
}

impl Atom for State<T> {
    fn atom_id(self) -> u32 { return self.id; }
}

pub fn state<T>(ids: Ids, v: T) -> State<T> {
    return State.new(ids, v);
}

pub class Source<T> {
    id: u32;
    pull: fn() -> T;                // seeds the entry; steady state is push

    fn new(ids: Ids, f: fn() -> T) -> Self {
        return Self { id: fresh(ids), pull: f };
    }

    fn pull_fn(self) -> fn() -> T { return self.pull; }
}

impl Atom for Source<T> {
    fn atom_id(self) -> u32 { return self.id; }
}

pub fn source<T>(ids: Ids, f: fn() -> T) -> Source<T> {
    return Source.new(ids, f);
}

pub class Derived<T> {
    id: u32;
    compute: fn(ReadCtx) -> T;

    fn new(ids: Ids, f: fn(ReadCtx) -> T) -> Self {
        return Self { id: fresh(ids), compute: f };
    }

    fn compute_fn(self) -> fn(ReadCtx) -> T { return self.compute; }
}

impl Atom for Derived<T> {
    fn atom_id(self) -> u32 { return self.id; }
}

pub fn derive<T>(ids: Ids, f: fn(ReadCtx) -> T) -> Derived<T> {
    return Derived.new(ids, f);
}

/** Payload for zero-argument mutations (rut has no unit type, no variadics). */
pub dataclass Nil {}

pub class Mutation<P, R> {
    run: fn(Store, P) -> R;

    fn new(f: fn(Store, P) -> R) -> Self {
        return Self { run: f };
    }

    fn run_fn(self) -> fn(Store, P) -> R { return self.run; }
}

pub fn mutation<P, R>(f: fn(Store, P) -> R) -> Mutation<P, R> {
    return Mutation(f);
}

// ------------------------------------------------------------------ ctx

/** Read-only view handed to `derive` closures (tur's ReadonlyStoreCtx). */
pub class ReadCtx {
    store: Store;

    fn new(store: Store) -> Self {
        return Self { store: store };
    }

    fn get<T>(self, s: State<T>) -> T { return atom_get(self.store, s); }

    fn latest<T>(self, s: Source<T>) -> T { return source_read(self.store, s); }

    fn read<T>(self, d: Derived<T>) -> T { return derived_read(self.store, d); }
}

// ------------------------------------------------------------------ store

pub(self) dataclass Entry {
    id: u32;
    ver: u32;
    value: Opaque;
}

class Watch {
    wid: u32;                 // watch identity (for dispose)
    atom: u32;                // watched atom id
    last_ver: u32;
    cb: fn() -> unit;

    fn new(wid: u32, atom: u32, last_ver: u32, cb: fn() -> unit) -> Self {
        return Self { wid: wid, atom: atom, last_ver: last_ver, cb: cb };
    }
}

let MAX_FLUSH_ROUNDS: i32 = 1000;

pub class Store {
    entries: Vec<Entry> = Vec.new();        // internal — module-private by default
    watches: Vec<Watch> = Vec.new();
    depth: i32 = 0;

    // all fields initialized -> an explicit no-arg constructor: bare
    // Store.new()

    fn find(self, id: u32) -> Option<Entry> {
        for (let i = 0; i < self.entries.len(); i += 1) {
            if (self.entries[i].id == id) {
                return Option.some(self.entries[i]);
            }
        }
        return Option.none();
    }

    fn upsert(self, id: u32, v: Opaque) -> unit {
        for (let i = 0; i < self.entries.len(); i += 1) {
            if (self.entries[i].id == id) {
                self.entries[i].ver &+= 1;
                self.entries[i].value = v;
                return;
            }
        }
        self.entries.push(Entry { id: id, ver: 1, value: v });
    }

    fn version_of(self, id: u32) -> u32 {
        let e = self.find(id);
        if (e.is_some()) { return e.value.ver; }
        return 0;
    }
}

// ------------------------------------------------------------- public ops

/** Read (and on first use, materialize) a state atom. */
pub fn atom_get<T>(store: Store, s: State<T>) -> T {
    let found = store.find(s.atom_id());
    let cell = when (found.is_some()) {
        true  -> found.value.value,
        else  -> seed_into(store, s),
    };
    return downcast<T>(cell).expect("store: atom type mismatch");
}

pub(self) fn seed_into<T>(store: Store, s: State<T>) -> Opaque {
    store.upsert(s.atom_id(), s.seed_value());
    return s.seed_value();
}

/** Write a state atom (inside mutations); watchers flush at the top. */
pub fn atom_set<T>(store: Store, s: State<T>, v: T) -> unit {
    store.upsert(s.atom_id(), Opaque.new(v));
}

/** Read a source's latest snapshot (pull-seeded on first read). */
pub fn source_read<T>(store: Store, s: Source<T>) -> T {
    let found = store.find(s.atom_id());
    let cell = when (found.is_some()) {
        true  -> found.value.value,
        else  -> seed_source(store, s),
    };
    return downcast<T>(cell).expect("store: source type mismatch");
}

pub(self) fn seed_source<T>(store: Store, s: Source<T>) -> Opaque {
    let v = Opaque.new(s.pull_fn()());
    store.upsert(s.atom_id(), v);
    return v;
}

/** External data arrived: store the snapshot; flush at the top level. */
pub fn source_push<T>(store: Store, s: Source<T>, v: T) -> unit {
    store.depth &+= 1;
    store.upsert(s.atom_id(), Opaque.new(v));
    store.depth -= 1;
    if (store.depth == 0) {
        flush(store);
    }
}

/** Read a derived atom — recomputes on every read (OQ-19: caching). */
pub fn derived_read<T>(store: Store, d: Derived<T>) -> T {
    let ctx = ReadCtx(store);
    return d.compute_fn()(ctx);
}

/** Dispatch a mutation; nested dispatches flush once, at the top. */
pub fn dispatch<P, R>(store: Store, m: Mutation<P, R>, p: P) -> R {
    store.depth &+= 1;
    let r = m.run_fn()(store, p);
    store.depth -= 1;
    if (store.depth == 0) {
        flush(store);
    }
    return r;
}

/** Subscribe a change-only callback to any atom (State, Source, Derived). */
pub fn watch(store: Store, ids: Ids, a: dyn Atom, cb: fn() -> unit) -> WatchHandle {
    let w = Watch.new(fresh(ids), a.atom_id(), store.version_of(a.atom_id()), cb);
    store.watches.push(w);
    return WatchHandle.new(store, w.wid);
}

pub class WatchHandle {
    store: Store;
    wid: u32;

    fn new(store: Store, wid: u32) -> Self {
        return Self { store: store, wid: wid };
    }
}

impl Disposal for WatchHandle {   // runs when the last handle drops
    fn dispose(mut self) -> unit {
        let kept: Vec<Watch> = Vec.new();
        for (let i = 0; i < self.store.watches.len(); i += 1) {
            if (self.store.watches[i].wid != self.wid) {
                kept.push(self.store.watches[i]);
            }
        }
        self.store.watches = kept;
    }
}

/** Run changed watchers to a fixed point (tur's flush). */
pub fn flush(store: Store) -> unit {
    let rounds = 0;
    let changed = true;
    while (changed) {
        rounds += 1;
        if (rounds > MAX_FLUSH_ROUNDS) {
            panic("reactive: watch loop detected");
        }
        changed = false;
        for (let i = 0; i < store.watches.len(); i += 1) {
            let w = store.watches[i];
            let cur = store.version_of(w.atom);
            if (cur != w.last_ver) {
                w.last_ver = cur;        // shared cell: visible to readers
                w.cb();
                changed = true;
            }
        }
    }
}

// ------------------------------------------------------------------ smoke

pub(self) fn smoke() -> unit {
    let log = Logger.new("reactive");
    let store = Store.new();
    let ids = Ids { };

    let count = state(ids, 0);
    let clock = source(ids, () -> i32 => 0);   // external world, lazily seeded

    let label = derive(ids, (ctx) -> string => f"count is {ctx.get(count)} at t={ctx.latest(clock)}");

    let bump = mutation((st: Store, by: i32) -> unit => {
        atom_set(st, count, atom_get(st, count) + by);
    });

    let handle = watch(store, ids, count, () -> unit => {   // State is an Atom
        log.debug("count changed");
    });

    dispatch(store, bump, 2);            // logs "count changed" once (flush)
    source_push(store, clock, 42);       // external arrival — flushes too
    log.info(derived_read(store, label));   // "count is 2 at t=42"
    handle.dispose();
    dispatch(store, bump, 1);            // watcher gone: no log
    source_push(store, clock, 43);
    log.info(derived_read(store, label));   // "count is 3 at t=43"
}
