// components/sidebar.rut — navigation: one nav item per Tab with click
// handlers that mutate the shared state (closures capture the cell handle —
// the default regime, RFC 0016 §1). The active item is highlighted.

import { Option } from "std:core";
import { box, BoxProps, ClickProps, click, Color, column, Element, FlexProps, TextProps, text } from "app:ui";
import { GAP, PAD, RADIUS } from "../theme.rut";
import { Palette } from "../theme.rut";
import { Dashboard } from "../state.rut";
import { dispatch } from "../reactive.rut";
import { Tab } from "../models.rut";
import { body, transparent } from "./common.rut";

let SIDEBAR_W: f32 = 168;

pub fn sidebar(th: Palette, st: Dashboard) -> Element {
    return box(BoxProps {
        w: SIDEBAR_W,
        pad: PAD,
        color: th.surface,
        radius: RADIUS,
        border: Option.some(th.border),
        border_w: 1,
        child: Option.some(column(FlexProps {
            gap: GAP,
            children: [
                nav_item(th, st, Tab.Overview, "Overview"),
                nav_item(th, st, Tab.Users, f"Users ({st.users_count()})"),
                nav_item(th, st, Tab.Alerts, f"Alerts ({st.alert_count()})"),
                box(BoxProps { h: 1, color: th.border }),
                body(th, "v0.1.0 · rut"),
            ],
        })),
    });
}

pub(self) fn nav_item(th: Palette, st: Dashboard, tab: Tab, label: str) -> Element {
    let active = st.tab() == tab;
    let bg = when (active) {
        true -> th.accent,
        else -> transparent(),
    };
    let fg = when (active) {
        true -> Color.hex("#ffffff"),
        else -> th.text_dim,
    };
    return click(ClickProps {
        on_click$: () -> unit => dispatch(st.store(), st.set_tab$, tab),   // mutation
        child: box(BoxProps {
            pad: 10,
            radius: 8,
            color: bg,
            child: Option.some(text(TextProps { text: label, size: 14, weight: 500, color: fg })),
        }),
    });
}
