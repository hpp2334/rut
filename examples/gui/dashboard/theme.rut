// theme.rut — palette + spacing. Color handles are host values (opaque),
// so the palette is BUILT by a function (host calls are not const-exprs);
// the spacing constants are plain module consts.

import { Color } from "app:ui";

export const PAD: f32 = 16;
export const PAD_S: f32 = 8;
export const GAP: f32 = 12;
export const CARD_W: f32 = 220;
export const CARD_H: f32 = 96;
export const RADIUS: f32 = 10;
export const TITLE_SIZE: f32 = 20;
export const BODY_SIZE: f32 = 14;

export dataclass Palette {
    bg: Color;
    surface: Color;
    border: Color;
    text: Color;
    text_dim: Color;
    accent: Color;
    ok: Color;
    warn: Color;
    err: Color;
}

export fn theme(): Palette {
    return Palette {
        bg:       Color.hex("#0f1216"),
        surface:  Color.hex("#171c23"),
        border:   Color.hex("#262d37"),
        text:     Color.hex("#e6e9ee"),
        text_dim: Color.hex("#8b94a3"),
        accent:   Color.hex("#6366f1"),
        ok:       Color.hex("#22c55e"),
        warn:     Color.hex("#eab308"),
        err:      Color.hex("#ef4444"),
    };
}
