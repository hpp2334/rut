// state.rut — the dashboard's reactive setup, tur-style: the Dashboard
// construction method DECLARES the graph — state atoms (UI writes), sources (services
// push snapshots), derives (computed views) — all living in the Store;
// mutations are dispatched values, not methods. The instance itself holds
// only inert handles (atom ids + closures), so sharing it is
// safe; writes land in the store by atom id, never in the instance.

import {
    Nil, Store, State, Source, Derived, Mutation, WatchHandle,
    atom_get, atom_set, derive, derived_read, dispatch, mutation,
    source, source_push, source_read, state, watch,
} from "./reactive.rut";
import {
    EventKind, LiveEvent, Series, SortDir, StatsSummary, Tab, User,
    event_label,
} from "./models.rut";

let MAX_SAMPLES: i32 = 120;
let MAX_ALERTS: i32 = 8;

export class Dashboard {
    private store: Store;

    // --- state: writable atoms (UI-owned) ---
    private tab: State<Tab>;
    private query: State<string>;
    private sort_dir: State<SortDir>;
    private live: State<bool>;
    private visits: State<i32>;
    private events_seen: State<i32>;
    private alerts: State<Vec<string>>;
    private samples: State<Vec<f32>>;
    private started_ms: i64;               // plain field — deliberately NOT
                                           // reactive: set once at boot

    // --- sources: external snapshots (services push) ---
    private users_src: Source<Vec<User>>;     // mock API replies land here
    private summary_src: Source<StatsSummary>;  // worker-isolate replies

    // --- derives: computed views ---
    private users_view: Derived<Vec<User>>;
    private users_count: Derived<i32>;
    private alert_count: Derived<i32>;

    // --- mutations: dispatched with payload dataclasses. The trailing `$`
    //     marks dispatch-inverted members (tur's start$/onMounted$ rule).
    set_tab$: Mutation<Tab, unit>;
    set_query$: Mutation<string, unit>;
    toggle_sort$: Mutation<Nil, unit>;
    ingest_series$: Mutation<Series, unit>;
    apply_event$: Mutation<LiveEvent, unit>;

    fn new(now_ms: i64): Self {
        let store = Store.new();

        // --- state: writable atoms (UI-owned) ---
        let tab = state(Tab.Overview);
        let query = state("");
        let sort_dir = state(SortDir.Desc);
        let live = state(true);
        let visits = state(0);
        let events_seen = state(0);
        let alerts = state([]);
        let samples = state([]);

        // --- sources: external snapshots (services push) ---
        let users_src = source((): Vec<User> => Vec());
        let summary_src = source((): StatsSummary =>
            StatsSummary { n: 0, mean: 0, min: 0, max: 0, last: 0 });

        // --- derives: computed views ---
        let users_view = derive((ctx): Vec<User> => {
            let users = ctx.latest(users_src);
            let q = ctx.get(query);
            let out: Vec<User> = Vec();
            for (let i = 0; i < users.len(); i += 1) {
                let u = users[i];
                if (q.len() == 0 || u.name.contains(q)) {
                    out.push(u);
                }
            }
            sort_by_score(out, ctx.get(sort_dir));
            return out;
        });
        let users_count = derive((ctx): i32 => ctx.latest(users_src).len());
        let alert_count = derive((ctx): i32 => ctx.get(alerts).len());

        // --- mutations: dispatched with payload dataclasses. The trailing
        //     `$` marks dispatch-inverted members (tur's start$/onMounted$
        //     rule). Closures capture the locals above by reference
        //     (RFC 0013) — the instance fields and the closures stay in
        //     lockstep because they were built from the same locals. ---
        let set_tab$ = mutation((st: Store, t: Tab): unit => {
            atom_set(st, tab, t);
        });

        let set_query$ = mutation((st: Store, q: string): unit => {
            atom_set(st, query, q);
        });

        let toggle_sort$ = mutation((st: Store, n: Nil): unit => {
            let flipped = when (atom_get(st, sort_dir)) {
                SortDir.Asc  -> SortDir.Desc,
                SortDir.Desc -> SortDir.Asc,
            };
            atom_set(st, sort_dir, flipped);
        });

        let ingest_series$ = mutation((st: Store, s: Series): unit => {
            atom_set(st, samples, s.samples);
        });

        let apply_event$ = mutation((st: Store, ev: LiveEvent): unit => {
            atom_set(st, events_seen, atom_get(st, events_seen) + 1);
            when (ev.kind) {
                EventKind.Tick -> {
                    let xs = atom_get(st, samples);
                    xs.push(ev.value);
                    if (xs.len() > MAX_SAMPLES) {
                        shift_left(xs);               // drop the oldest
                    }
                    atom_set(st, samples, xs);        // same handle: version bump
                },
                EventKind.Visit -> {
                    atom_set(st, visits, atom_get(st, visits) + 1);
                },
                EventKind.Alert -> {
                    let msgs = atom_get(st, alerts);
                    msgs.push(f"{event_label(ev.kind)} at {ev.who}: {ev.value}");
                    if (msgs.len() > MAX_ALERTS) {
                        shift_left_str(msgs);
                    }
                    atom_set(st, alerts, msgs);
                    atom_set(st, live, false);        // fatal alert -> halt
                },
            }
        });

        return Self {
            store: store,
            started_ms: now_ms,          // deliberately NOT reactive
            tab: tab,
            query: query,
            sort_dir: sort_dir,
            live: live,
            visits: visits,
            events_seen: events_seen,
            alerts: alerts,
            samples: samples,
            users_src: users_src,
            summary_src: summary_src,
            users_view: users_view,
            users_count: users_count,
            alert_count: alert_count,
            set_tab$: set_tab$,
            set_query$: set_query$,
            toggle_sort$: toggle_sort$,
            ingest_series$: ingest_series$,
            apply_event$: apply_event$,
        };
    }

    // --- reads (through the store; derives recompute per read) ---

    fn store(self): Store { return self.store; }
    fn started_ms(self): i64 { return self.started_ms; }
    fn tab(self): Tab { return atom_get(self.store, self.tab); }
    fn query(self): string { return atom_get(self.store, self.query); }
    fn sort_dir(self): SortDir { return atom_get(self.store, self.sort_dir); }
    fn live(self): bool { return atom_get(self.store, self.live); }
    fn events_seen(self): i32 { return atom_get(self.store, self.events_seen); }
    fn visits(self): i32 { return atom_get(self.store, self.visits); }
    fn samples(self): Vec<f32> { return atom_get(self.store, self.samples); }
    fn users(self): Vec<User> { return source_read(self.store, self.users_src); }
    fn summary(self): StatsSummary { return source_read(self.store, self.summary_src); }
    fn users_view(self): Vec<User> { return derived_read(self.store, self.users_view); }
    fn users_count(self): i32 { return derived_read(self.store, self.users_count); }
    fn alert_count(self): i32 { return derived_read(self.store, self.alert_count); }

    fn alerts_text(self): string {
        let out = "";
        let msgs = atom_get(self.store, self.alerts);
        for (let i = 0; i < msgs.len(); i += 1) {
            out = f"{out}{msgs[i]}\n";
        }
        return out;
    }

    // --- service bridges: push snapshots into the sources ---

    fn set_users(self, users: Vec<User>): unit {
        source_push(self.store, self.users_src, users);
    }

    fn set_summary(self, s: StatsSummary): unit {
        source_push(self.store, self.summary_src, s);
    }

    // --- re-render subscription: one callback, every watched atom ---

    fn redraw_on_change(self, cb: fn(): unit): Vec<WatchHandle> {
        return [
            watch(self.store, self.tab, cb),
            watch(self.store, self.query, cb),
            watch(self.store, self.sort_dir, cb),
            watch(self.store, self.live, cb),
            watch(self.store, self.visits, cb),
            watch(self.store, self.events_seen, cb),
            watch(self.store, self.alerts, cb),
            watch(self.store, self.samples, cb),
            watch(self.store, self.users_src, cb),
            watch(self.store, self.summary_src, cb),
        ];
    }
}

// --- vec helpers (shared by mutations; free fns keep models data-only) ---

export(self) fn shift_left(xs: Vec<f32>): unit {
    for (let i = 1; i < xs.len(); i += 1) {
        xs[i - 1] = xs[i];
    }
    xs.pop();
}

export(self) fn shift_left_str(xs: Vec<string>): unit {
    for (let i = 1; i < xs.len(); i += 1) {
        xs[i - 1] = xs[i];
    }
    xs.pop();
}

export(self) fn sort_by_score(xs: Vec<User>, dir: SortDir): unit {
    for (let i = 1; i < xs.len(); i += 1) {
        let j = i;
        while (j > 0 && score_lt(xs[j], xs[j - 1], dir)) {
            swap_users(xs, j, j - 1);
            j -= 1;
        }
    }
}

export(self) fn score_lt(a: User, b: User, dir: SortDir): bool {
    return when (dir) {
        SortDir.Asc  -> a.score < b.score,
        SortDir.Desc -> b.score < a.score,
    };
}

export(self) fn swap_users(xs: Vec<User>, a: i32, b: i32): unit {
    let t = xs[a];
    xs[a] = xs[b];
    xs[b] = t;
}
