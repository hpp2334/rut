// services/api.rut — mock HTTP layer: suspend fns returning Result, LCG-
// generated deterministic data, simulated latency. The Result boundary is
// the API contract (network calls fail); callers decide fallbacks.

import { sleep } from "std:time";
import { ApiError, Series, Status, User } from "../models.rut";

// --- deterministic pseudo-randomness (no std rand in v1) ---

pub fn lcg_next(state: u32) -> u32 {
    return (state &* 1664525u32) &+ 1013904223u32;
}

pub(self) fn lcg_f32(state: u32) -> f32 {
    return f32(lcg_next(state) % 1000u32) / 1000.0f32;
}

let FIRST: Array<string> = ["ada", "linus", "grace", "alan", "barbara", "dennis", "katherine", "ken"];
let LAST: Array<string> = ["lovelace", "torvalds", "hopper", "turing", "liskov", "ritchie", "johnson", "thompson"];
let ROLES: Array<string> = ["engineer", "designer", "ops", "pm", "analyst"];   // fixed arrays:
                                                                                   // module-let data,
                                                                                   // no allocation
// --- API ---

pub suspend fn fetch_users(seed: u32) -> Result<Vec<User>, ApiError> {
    await sleep(120);                                  // simulated latency
    if (seed == 0) {
        return Result.err(ApiError.Network);           // the unhappy path exists
    }
    let rng = seed;
    let users: Vec<User> = Vec();
    for (let i = 0; i < 12; i += 1) {
        rng = lcg_next(rng);
        let first = FIRST[i32(rng % 8u32)];
        rng = lcg_next(rng);
        let last = LAST[i32(rng % 8u32)];
        rng = lcg_next(rng);
        let role = ROLES[i32(rng % 5u32)];
        rng = lcg_next(rng);
        let status = when (rng % 3u32) {
            0u32 -> Status.Active,
            1u32 -> Status.Idle,
            else -> Status.Blocked,
        };
        rng = lcg_next(rng);
        users.push(User {
            name: f"{first}.{last}",
            role: role,
            status: status,
            score: lcg_f32(rng) * 100.0f32,
        });
    }
    return Result.ok(users);
}

pub suspend fn fetch_series(metric: string, unit: string, n: i32, seed: u32) -> Result<Series, ApiError> {
    await sleep(80);
    let samples: Vec<f32> = Vec();
    let v = 50.0f32;
    let rng = seed;
    for (let i = 0; i < n; i += 1) {
        rng = lcg_next(rng);
        let drift = (lcg_f32(rng) - 0.5f32) * 14.0f32;
        v = clamp_f32(v + drift, 4.0f32, 96.0f32);
        samples.push(v);
    }
    return Result.ok(Series { metric: metric, unit: unit, samples: samples });
}

pub fn clamp_f32(v: f32, lo: f32, hi: f32) -> f32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
