#: src/quick-start/installation.md:32
msgid ""
"# usage: rut — run <file.rut | dir | mod.rutbundle> [--fuel N] | fmt "
"<file.rut | dir> [--check] | pack <dir> [-o out.rutbundle] | dump "
"<file.rut>\n"
