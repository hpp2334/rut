"  \"deps\": {\n"
"    // the vendored logger package, from a dir at the repo root\n"
"    \"ink\": { \"path\": \"../rut/ink\" }\n"
"  }\n"
"}\n"
"EOF\n"
"cat > hello/main.rut <<'EOF'\n"
"use ink::{ Logger };\n"
"\n"
"pub fn main() {\n"
"    let log = Logger.new(\"hello\");\n"
"    log.info(f\"hello, rut!\");\n"
"}\n"
"EOF\n"
"rut run hello\n"
