msgid "```rut\nuse ink::{ Logger };\n\nstruct Node {\n    value: i32;\n    left: ?Node;\n    right: ?Node;\n}\n\nfn count(n: ?Node) -> i32 {\n    let mut c = 1;\n    if (n.left != nil) { c += count(n.left); }\n    if (n.right != nil) { c += count(n.right); }\n    return c;\n}\n\npub fn main() {\n    let log = Logger.new(\"nodes\");\n    let n = Node {\n        value: 1,\n        left: Node { value: 2, left: nil, right: nil },\n        right: nil,\n    };\n    log.info(f\"count={count(n)}\");\n}\n```"
