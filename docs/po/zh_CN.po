#: src/tutorial/values-and-variables.md:245
msgid ""
"```rut\n"
"use ink::{ Logger };\n"
"\n"
"fn divmod(a: i32, b: i32) -> (i32, i32) {\n"
"    return (a / b, a % b);\n"
"}\n"
"\n"
"pub fn main() {\n"
"    let log = Logger.new(\"tuples\");\n"
"    let (q, r) = divmod(17, 5);   // destructuring\n"
"    let t = (1, true);\n"
"    log.info(f\"q={q} r={r} t.0={t.0}\");\n"
"}\n"
"```"
msgstr ""
"```rut\n"
