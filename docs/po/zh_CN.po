#: src/examples/playground-corpus.md:77
msgid "```rut\nuse pouch::{ Vec };\n// Quicksort â in-place Vec<i32> mutation (vecs are handles: the\n// mutation is shared with the caller), recursion, explicit conversions.\n\nuse ink::{ Logger };\n\nfn swap(mut xs: Vec<i32>, a: i32, b: i32) {\n    let t = xs[a];\n    xs[a] = xs[b];\n    xs[b] = t;\n}\n\nfn partition(xs: Vec<i32>, lo: i32, hi: i32) -> i32 {\n    let pivot = xs[hi];\n    let mut i = lo - 1;\n    for (let j = lo; j < hi; j += 1) {\n        if (xs[j] <= pivot) {\n            i += 1;\n            swap(xs, i, j);\n        }\n    }\n    swap(xs, i + 1, hi);\n    return i + 1;\n}\n\nfn quicksort(xs: Vec<i32>, lo: i32, hi: i32) {\n    if (lo >= hi) { return; }\n    let p = partition(xs, lo, hi);\n    quicksort(xs, lo, p - 1);\n    quicksort(xs, p + 1, hi);\n}\n\npub fn main() {\n    let log = Logger.new(\"sort\");\n    let xs = Vec<i32>.from([5, 2, 9, 1, 7, 3, 8, 2]);   // fixed -> growable\n    quicksort(xs, 0, xs.len() - 1);\n\n    let mut out = \"\";\n    for (let i = 0; i < xs.len(); i += 1) {\n        out = f\"{out}{xs[i]} \";      // `mut`: rebinding; the f-string form builds in place\n    }\n    log.info(f\"sorted: {out}\");\n}\n```"
msgstr "```rut\nuse pouch::{ Vec };\n// Quicksort â in-place Vec<i32> mutation (vecs are handles: the\n// mutation is shared with the caller), recursion, explicit conversions.\n\nuse ink::{ Logger };\n\nfn swap(mut xs: Vec<i32>, a: i32, b: i32) {\n    let t = xs[a];\n    xs[a] = xs[b];\n    xs[b] = t;\n}\n\nfn partition(xs: Vec<i32>, lo: i32, hi: i32) -> i32 {\n    let pivot = xs[hi];\n    let mut i = lo - 1;\n    for (let j = lo; j < hi; j += 1) {\n        if (xs[j] <= pivot) {\n            i += 1;\n            swap(xs, i, j);\n        }\n    }\n    swap(xs, i + 1, hi);\n    return i + 1;\n}\n\nfn quicksort(xs: Vec<i32>, lo: i32, hi: i32) {\n    if (lo >= hi) { return; }\n    let p = partition(xs, lo, hi);\n    quicksort(xs, lo, p - 1);\n    quicksort(xs, p + 1, hi);\n}\n\npub fn main() {\n    let log = Logger.new(\"sort\");\n    let xs = Vec<i32>.from([5, 2, 9, 1, 7, 3, 8, 2]);   // fixed -> growable\n    quicksort(xs, 0, xs.len() - 1);\n\n    let mut out = \"\";\n    for (let i = 0; i < xs.len(); i += 1) {\n        out = f\"{out}{xs[i]} \";      // `mut`: rebinding; the f-string form builds in place\n    }\n    log.info(f\"sorted: {out}\");\n}\n```"

