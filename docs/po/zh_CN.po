#: src/examples/03-plugin.md:60
msgid "```rut\npub fn on_msg(mut self, user: str, text: str) {\n    if (self.is_muted(user)) {\n        self.say(\"muted\", user);\n    } else if (text == \"!stats\") {\n        self.say(\"direct\", f\"{user}: {self.stats()}\");\n    } else {\n        if (user == self.last_sender) {\n            self.streak += 1;\n        } else {\n            self.last_sender = user;\n            self.streak = 1;\n        }\n        if (self.streak == 3) {\n            self.muted.push(user);\n            self.mutes += 1;\n            self.say(\"system\", f\"{user} muted for flooding\");\n        } else {\n            self.msgs += 1;\n            self.say(\"broadcast\", f\"<{user}> {text}\");\n        }\n    }\n}\n```"
msgstr "```rut\npub fn on_msg(mut self, user: str, text: str) {\n    if (self.is_muted(user)) {\n        self.say(\"muted\", user);\n    } else if (text == \"!stats\") {\n        self.say(\"direct\", f\"{user}: {self.stats()}\");\n    } else {\n        if (user == self.last_sender) {\n            self.streak += 1;\n        } else {\n            self.last_sender = user;\n            self.streak = 1;\n        }\n        if (self.streak == 3) {\n            self.muted.push(user);\n            self.mutes += 1;\n            self.say(\"system\", f\"{user} muted for flooding\");\n        } else {\n            self.msgs += 1;\n            self.say(\"broadcast\", f\"<{user}> {text}\");\n        }\n    }\n}\n```"

