#: src/reference/weak-refs.md:31
msgid "```rut\nuse ink::{ Logger };\n\nclass Node {\n    value: u32;\n    next: ?Node;          // strong â keeps the tail alive\n}\n\nimpl Node {\n    pub fn new(value: u32) -> Self { return Self { value: value, next: nil }; }\n}\n\nfn use_node(n: Node) {\n    let log = Logger.new(\"t\");\n    log.info(f\"node {n.value}\");\n}\n\npub fn main() {\n    let n = Node.new(1);\n    let w = Weak.new(n);        // Weak<Node>; T infers from n\n    let b = w.upgrade();        // ?Node â a live handle\n    if (b != nil) {\n        use_node(b);\n    }\n}\n```"
