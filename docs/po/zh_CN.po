"use calc::{ Math };\n"
"use ink::{ Logger };\n"
"\n"
"pub fn main() {\n"
"    let log = Logger.new(\"t\");\n"
"    let x = 3.0f64;\n"
"    let y = 4.0f64;\n"
"    let d = Math.sqrt(x * x + y * y);\n"
"    let a = Math.abs(x);\n"
"    let hf = Math.sqrt_f(2.0);            // f32 twin — the width is in the name\n"
"    log.info(f\"{d} {a} {hf}\");\n"
"}\n"
"```"
