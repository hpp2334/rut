msgid "```rut\nuse ink::{ Logger };\n\nenum Light { Green, Yellow, Red }\n\nfn action(l: Light) -> str {\n    return when (l) {\n        Light.Green  -> \"go\",\n        Light.Yellow -> \"brake\",\n        Light.Red    -> \"stop\",\n    };\n}\n\nfn light_for(i: i32) -> Light {\n    return when (i) {\n        0    -> Light.Green,\n        1    -> Light.Yellow,\n        else -> Light.Red,\n    };\n}\n\nfn classify(n: i32) -> str {\n    return when (n) {\n        0       -> \"zero\",\n        1, 2, 3 -> \"small\",\n        else    -> \"big\",\n    };\n}\n\npub fn main() {\n    let log = Logger.new(\"lights\");\n\n    for (let n of [0, 2, 9]) {\n        log.info(f\"{n}: {classify(n)}\");\n    }\n\n    let mut i = 0;\n    while (i < 3) {\n        log.info(action(light_for(i)));\n        i += 1;\n    }\n}\n```"
msgstr "```rut\nuse ink::{ Logger };\n\nenum Light { Green, Yellow, Red }\n\nfn action(l: Light) -> str {\n    return when (l) {\n        Light.Green  -> \"go\",\n        Light.Yellow -> \"brake\",\n        Light.Red    -> \"stop\",\n    };\n}\n\nfn light_for(i: i32) -> Light {\n    return when (i) {\n        0    -> Light.Green,\n        1    -> Light.Yellow,\n        else -> Light.Red,\n    };\n}\n\nfn classify(n: i32) -> str {\n    return when (n) {\n        0       -> \"zero\",\n        1, 2, 3 -> \"small\",\n        else    -> \"big\",\n    };\n}\n\npub fn main() {\n    let log = Logger.new(\"lights\");\n\n    for (let n of [0, 2, 9]) {\n        log.info(f\"{n}: {classify(n)}\");\n    }\n\n    let mut i = 0;\n    while (i < 3) {\n        log.info(action(light_for(i)));\n        i += 1;\n    }\n}\n```"

