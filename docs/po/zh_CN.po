msgstr ""

#: src/reference/builtin-generic-types.md:107
msgid ""
"remove and return the last element; traps on empty — guard with `len() > 0`"
msgstr ""

#: src/reference/builtin-generic-types.md:108
msgid "`v[i]`, `v[i] = x`"
msgstr ""

#: src/reference/builtin-generic-types.md:108
msgid "element access; out-of-bounds traps"
msgstr ""

#: src/reference/builtin-generic-types.md:109 src/reference/stdlib.md:293
msgid "`len() -> i32`"
msgstr ""

