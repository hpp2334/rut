#: src/tutorial/stdlib.md:246
msgid ""
"rut has no overloading, so the width lives in the name. The integer ladder "
"is _not_ here — those are core's, always available."
msgstr "rut 没有重载，所以宽度活在名字里。整数阶梯_不_在这里——那些是 core 的方法，永远可用。"

#: src/tutorial/stdlib.md:249
msgid "`json` — encode and decode"
msgstr "`json`——编码与解码"

#: src/tutorial/stdlib.md:251
msgid ""
"```rut\n"
"use json::{ decodeJson, encodeJson };\n"
"use ink::{ Logger };\n"
"\n"
"pub fn main() {\n"
"    let log = Logger.new(\"json\");\n"
"    let (n, e) = decodeJson<i64>(\"42\");            // (?T, ?E) — see "
"errors\n"
"    let (s, ee) = encodeJson<[i64]>([1, 2, 3]);    // (?str, "
"?EncodeJsonError)\n"
"    if (e == nil && ee == nil) {\n"
"        let text = s;\n"
"        log.info(f\"n={n} s={text}\");\n"
"    }\n"
"}\n"
"```"
msgstr ""
"```rut\n"
"use json::{ decodeJson, encodeJson };\n"
"use ink::{ Logger };\n"
"\n"
"pub fn main() {\n"
"    let log = Logger.new(\"json\");\n"
"    let (n, e) = decodeJson<i64>(\"42\");            // (?T, ?E) — see "
"errors\n"
"    let (s, ee) = encodeJson<[i64]>([1, 2, 3]);    // (?str, "
"?EncodeJsonError)\n"
