msgid ""
"/// The one allocation path for rut values.\n"
"    /// Over budget -> Err(Trap::OutOfMemory); never aborts.\n"
msgstr ""
"/// The one allocation path for rut values.\n"
"    /// Over budget -> Err(Trap::OutOfMemory); never aborts.\n"


