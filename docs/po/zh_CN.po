#: src/examples/01-sort.md:50
msgid "```rut\nuse ink::{ Logger };\nuse pouch::{ Vec };\n\nstruct Bank {\n    data: ?Vec<i32>;\n}\n\nentry fn serialize(c: opaque) -> str {\n    let b = opaque.downcast<?Bank>(c);\n    let xs = b.data;\n    let mut out = \"[\";\n    for (let i = 0; i < xs.len(); i += 1) {\n        if (i > 0) {\n            out = f\"{out}, \";\n        }\n        out = f\"{out}{xs[i]}\";\n    }\n    return f\"{out}]\";\n}\n\npub fn main() {\n    let log = Logger.new(\"sort\");\n    let bank: ?Bank = Bank { data: Vec<i32>.from([5, 2, 9, 2]) };\n    let c = opaque(bank);\n    log.info(f\"serialized: {serialize(c)}\");\n}\n```"
msgstr "```rut\nuse ink::{ Logger };\nuse pouch::{ Vec };\n\nstruct Bank {\n    data: ?Vec<i32>;\n}\n\nentry fn serialize(c: opaque) -> str {\n    let b = opaque.downcast<?Bank>(c);\n    let xs = b.data;\n    let mut out = \"[\";\n    for (let i = 0; i < xs.len(); i += 1) {\n        if (i > 0) {\n            out = f\"{out}, \";\n        }\n        out = f\"{out}{xs[i]}\";\n    }\n    return f\"{out}]\";\n}\n\npub fn main() {\n    let log = Logger.new(\"sort\");\n    let bank: ?Bank = Bank { data: Vec<i32>.from([5, 2, 9, 2]) };\n    let c = opaque(bank);\n    log.info(f\"serialized: {serialize(c)}\");\n}\n```"

