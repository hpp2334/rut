#: src/examples/playground-corpus.md:135
msgid "The `opaque` case is the reference for the erasure primitive â `opaque(v)` forgets the static type, `opaque.downcast<T>` answers the nullable, and `is` names the _box_, never the payload ([opaque â erasure and downcast](../reference/opaque.md)). The case's `erase_and_recover` verbatim, with its two payload types and a `main` so it runs in place:"
msgstr "`opaque` æ¡ä¾æ¯æ¦é¤åè¯­çåç§ââ`opaque(v)` å¿æéæç±»åï¼`opaque.downcast<T>` åç­å¯ç©ºç±»åï¼`is` æåçæ¯_ç_ï¼ç»ä¸æ¯è½½è·ï¼[opaque â æ¦é¤ä¸åä¸è½¬å](../reference/opaque.md)ï¼ãæ¡ä¾ç `erase_and_recover` åæ ·ç§å½ï¼å¸¦ä¸å®çä¸¤ä¸ªè½½è·ç±»ååä¸ä¸ª `main`ï¼è®©å®å°±å°è¿è¡ï¼"

#: src/examples/playground-corpus.md:142
msgid "```rut\nuse ink::{ Logger };\n\nstruct Point { x: f32; y: f32 }\nenum Flavor { Sweet, Sour }\n\nfn erase_and_recover() {\n    let log = Logger.new(\"opaque\");\n    let box1 = opaque(Point { x: 1, y: 2 });    // erasure = type-call;\n    let box2 = opaque(Flavor.Sour);             // zero-copy (shares the cell)\n    let box3 = opaque(\"hello\");\n\n    let p = opaque.downcast<Point>(box1);       // ?Point â the nullable\n    when (p != nil) {\n        true -> { log.info(f\"point {p.x} {p.y}\"); },\n        else  -> { log.info(\"point: nil\"); },\n    }\n    let wrong = opaque.downcast<i32>(box2);     // wrong type: nil, no trap\n    log.info(f\"sour? {opaque.downcast<Flavor>(box2) != nil} wrong? {wrong == nil}\");\n    log.info(f\"is str: {box3 is str}\");   // `is` names the box â misses every payload type; downcast recovers\n}\n\npub fn main() {\n    erase_and_recover();\n}\n```"
msgstr "```rut\nuse ink::{ Logger };\n\nstruct Point { x: f32; y: f32 }\nenum Flavor { Sweet, Sour }\n\nfn erase_and_recover() {\n    let log = Logger.new(\"opaque\");\n    let box1 = opaque(Point { x: 1, y: 2 });    // erasure = type-call;\n    let box2 = opaque(Flavor.Sour);             // zero-copy (shares the cell)\n    let box3 = opaque(\"hello\");\n\n    let p = opaque.downcast<Point>(box1);       // ?Point â the nullable\n    when (p != nil) {\n        true -> { log.info(f\"point {p.x} {p.y}\"); },\n        else  -> { log.info(\"point: nil\"); },\n    }\n    let wrong = opaque.downcast<i32>(box2);     // wrong type: nil, no trap\n    log.info(f\"sour? {opaque.downcast<Flavor>(box2) != nil} wrong? {wrong == nil}\");\n    log.info(f\"is str: {box3 is str}\");   // `is` names the box â misses every payload type; downcast recovers\n}\n\npub fn main() {\n    erase_and_recover();\n}\n```"

