#: src/reference/builtin-generic-types.md:110
msgid "`for (x of v)`"
msgstr ""

#: src/reference/builtin-generic-types.md:110
msgid "iteration; `x` is the shared element"
msgstr ""

#: src/reference/builtin-generic-types.md:111 src/reference/stdlib.md:168
msgid "`slice(from, to) -> ?Vec<T>`"
msgstr ""

#: src/reference/builtin-generic-types.md:111
msgid "fixed-length window (compiler-lowered) — writes through it hit the parent"
msgstr ""

#: src/reference/builtin-generic-types.md:112
msgid "`as_array() -> [T]`"
msgstr ""

#: src/reference/builtin-generic-types.md:112
