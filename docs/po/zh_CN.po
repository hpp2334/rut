#: src/reference/workers-and-channels.md:34
msgid ""
"```rut\n"
"use core::{ RunContext };\n"
"\n"
"async fn worker(cx: RunContext, rx: Receiver<u32>, tx: Sender<u32>) -> nil {\n"
"    while (true) {\n"
"        let msg = await rx.recv();\n"
"        if (msg == nil) { return; }       // all senders gone\n"
"        tx.send(1);                       // acknowledge (send is sync)\n"
"    }\n"
"}\n"
"```"
msgstr ""
"```rutuse core::{ RunContext };async fn worker(cx: RunContext, rx: Receiver<u32>, tx: Sender<u32>) -> nil {    while (true) {        let msg = await rx.recv();        if (msg == nil) { return; }       // all senders gone        tx.send(1);                       // acknowledge (send is sync)    }}```"


