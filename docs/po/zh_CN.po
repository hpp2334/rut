#: src/examples/01-sort.md:117
msgid "`fill` replaces the bank with `n` pseudo-random values from a linear-congruential generator, so sizing a benchmark input is one host round-trip, not one per element. The u32 math must **wrap**, and rut makes that explicit â plain `*` traps on overflow. The entry is verbatim (the `Bank` inlined so the block compiles alone), with a `main` that fills and prints what one call produces:"
msgstr "`fill` ç¨çº¿æ§åä½çæå¨äº§çç `n` ä¸ªä¼ªéæºå¼æ¿æ¢é¶è¡çåå®¹ï¼äºæ¯ç»åºåæµè¯å®è¾å¥å°ºå¯¸åªéä¸æ¬¡å®¿ä¸»å¾è¿ï¼èä¸æ¯æ¯åç´ ä¸æ¬¡ãu32 æ°å­¦å¿é¡»**åç»**ï¼rut æè¿ä¸ç¹åå¾ææç½ç½ââæ®é `*` å¨æº¢åºæ¶è§¦åé·é±ãå¥å£æ¯åæç§å½ï¼`Bank` åèè¿æ¥è®©ä»£ç åç¬ç«ç¼è¯ï¼ï¼éä¸ä¸ªå¡«åå¹¶æå°åæ¬¡è°ç¨äº§åºç `main`ï¼"

#: src/examples/01-sort.md:124
msgid "```rut\nuse ink::{ Logger };\nuse pouch::{ Vec };\n\nstruct Bank { data: ?Vec<i32>; }   // inlined from above â the block runs alone\n\nentry fn fill(c: opaque, n: u32, seed: u32) {\n    let mut b = opaque.downcast<?Bank>(c);\n    let fresh: Vec<i32> = Vec.new();\n    let mut x = seed | 1;         // the LCG needs an odd state\n    for (let i = 0; i < n as i32; i += 1) {\n        x = (x.wrapping_mul(1664525)).wrapping_add(1013904223);\n        fresh.push((x % 1000) as i32);\n    }\n    b.data = fresh;\n}\n\npub fn main() {\n    let log = Logger.new(\"sort\");\n    let bank: ?Bank = Bank { data: nil };\n    let c = opaque(bank);\n    fill(c, 8, 42);\n    let b = opaque.downcast<?Bank>(c);\n    let xs = b.data;\n    let mut out = \"\";\n    for (let x of xs) {\n        out = f\"{out} {x}\";\n    }\n    log.info(f\"fill(8, seed=42):{out}\");\n}\n```"
msgstr "```rut\nuse ink::{ Logger };\nuse pouch::{ Vec };\n\nstruct Bank { data: ?Vec<i32>; }   // inlined from above â the block runs alone\n\nentry fn fill(c: opaque, n: u32, seed: u32) {\n    let mut b = opaque.downcast<?Bank>(c);\n    let fresh: Vec<i32> = Vec.new();\n    let mut x = seed | 1;         // the LCG needs an odd state\n    for (let i = 0; i < n as i32; i += 1) {\n        x = (x.wrapping_mul(1664525)).wrapping_add(1013904223);\n        fresh.push((x % 1000) as i32);\n    }\n    b.data = fresh;\n}\n\npub fn main() {\n    let log = Logger.new(\"sort\");\n    let bank: ?Bank = Bank { data: nil };\n    let c = opaque(bank);\n    fill(c, 8, 42);\n    let b = opaque.downcast<?Bank>(c);\n    let xs = b.data;\n    let mut out = \"\";\n    for (let x of xs) {\n        out = f\"{out} {x}\";\n    }\n    log.info(f\"fill(8, seed=42):{out}\");\n}\n```"

