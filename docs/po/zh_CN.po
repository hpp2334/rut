msgid "```rut\nuse ink::{ Logger };\n\npub fn main() {\n    let log = Logger.new(\"hello\");\n    let n = 10;            // i32 â the integer default\n    let scale = 1.5;       // f32 â the float default\n    let big: u64 = 10;     // u64 via annotation â fits the default\n    let flags = [1, 2, 3]; // [i32] â a fixed heap cell\n    let mut sum = 0;       // `mut` â this one is written to\n    for (let x of flags) {\n        sum += x * n;\n    }\n    log.info(f\"sum={sum} scale={scale}\");\n}\n```"
