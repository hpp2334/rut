msgid "Erasure and checked recovery, in one screen"
msgstr "擦除与受检恢复，一屏之内"


#: src/examples/playground-corpus.md:135
msgid ""
"The `opaque` case is the reference for the erasure primitive — `opaque(v)` forgets the static type, `opaque.downcast<T>` answers the nullable, and `is` names the _box_, never the payload ([opaque — erasure and downcast](../reference/opaque.md)). The case's `erase_and_recover` verbatim, with its two payload types and a `main` so it runs in place:"
msgstr ""
"`opaque` 案例是擦除原语的参照——`opaque(v)` 忘掉静态类型，`opaque.downcast<T>` 回答可空类型，`is` 指名的是_盒_，绝不是载荷（[opaque — 擦除与向下转型](../reference/opaque.md)）。案例的 `erase_and_recover` 原样照录，带上它的两个载荷类型和一个 `main`，让它就地运行："


#: src/examples/playground-corpus.md:142
msgid ""
"```rut\n"
"use ink::{ Logger };\n"
"\n"
"struct Point { x: f32; y: f32 }\n"
"enum Flavor { Sweet, Sour }\n"
"\n"
"fn erase_and_recover() {\n"
"    let log = Logger.new(\"opaque\");\n"
"    let box1 = opaque(Point { x: 1, y: 2 });    // erasure = type-call;\n"
"    let box2 = opaque(Flavor.Sour);             // zero-copy (shares the cell)\n"
"    let box3 = opaque(\"hello\");\n"
"\n"
"    let p = opaque.downcast<Point>(box1);       // ?Point — the nullable\n"
"    when (p != nil) {\n"
"        true -> { log.info(f\"point {p.x} {p.y}\"); },\n"
"        else  -> { log.info(\"point: nil\"); },\n"
"    }\n"
"    let wrong = opaque.downcast<i32>(box2);     // wrong type: nil, no trap\n"
"    log.info(f\"sour? {opaque.downcast<Flavor>(box2) != nil} wrong? {wrong == nil}\");\n"
"    log.info(f\"is str: {box3 is str}\");   // `is` names the box — misses every payload type; downcast recovers\n"
"}\n"
"\n"
"pub fn main() {\n"
"    erase_and_recover();\n"
"}\n"
"```"
msgstr ""
"```rut\n"
"use ink::{ Logger };\n"
"\n"
"struct Point { x: f32; y: f32 }\n"
"enum Flavor { Sweet, Sour }\n"
"\n"
"fn erase_and_recover() {\n"
"    let log = Logger.new(\"opaque\");\n"
"    let box1 = opaque(Point { x: 1, y: 2 });    // erasure = type-call;\n"
"    let box2 = opaque(Flavor.Sour);             // zero-copy (shares the cell)\n"
"    let box3 = opaque(\"hello\");\n"
"\n"
"    let p = opaque.downcast<Point>(box1);       // ?Point — the nullable\n"
"    when (p != nil) {\n"
"        true -> { log.info(f\"point {p.x} {p.y}\"); },\n"
"        else  -> { log.info(\"point: nil\"); },\n"
"    }\n"
"    let wrong = opaque.downcast<i32>(box2);     // wrong type: nil, no trap\n"
"    log.info(f\"sour? {opaque.downcast<Flavor>(box2) != nil} wrong? {wrong == nil}\");\n"
"    log.info(f\"is str: {box3 is str}\");   // `is` names the box — misses every payload type; downcast recovers\n"
"}\n"
"\n"
"pub fn main() {\n"
"    erase_and_recover();\n"
"}\n"
"```"


