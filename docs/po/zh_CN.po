"\n"
"impl Circle {\n"
"    fn new(r: f64) -> Self {\n"
"        return Self { r: r };\n"
"    }\n"
"}\n"
"\n"
"pub fn main() {\n"
"    let log = Logger.new(\"traits\");\n"
"    let c = Circle.new(1.0);\n"
"    log.info(f\"r={c.r}\");\n"
"}\n"
"```"
msgstr ""
