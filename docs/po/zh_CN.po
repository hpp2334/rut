msgid "allowed"
msgstr "允许"


#: src/reference/host-fns.md:134 src/reference/stdlib.md:79
#: src/reference/compiler.md:23 src/reference/typed-bytecode.md:74
msgid "notes"
msgstr "说明"


#: src/reference/host-fns.md:136
