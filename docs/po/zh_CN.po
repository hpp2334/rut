#: src/examples/02-digest.md:61
msgid "```rut\nuse ink::{ Logger };\n\nentry fn crc32(data: bytes) -> u32 {\n    let mut crc: u32 = 0xFFFFFFFFu32;\n    for (let b of data) {\n        crc = crc ^ b as u32;\n        for (let k = 0; k < 8; k += 1) {\n            if ((crc & 1) == 1) {\n                crc = (crc >> 1) ^ 0xEDB88320u32;\n            } else {\n                crc = crc >> 1;\n            }\n        }\n    }\n    return crc ^ 0xFFFFFFFFu32;\n}\n\npub fn main() {\n    let log = Logger.new(\"crc\");\n    let vector = \"123456789\".encode();   // the canonical CRC-32 test vector\n    log.info(f\"crc32(vector) = {crc32(vector)} â check value 0xCBF43926: {crc32(vector) == 0xCBF43926u32}\");\n}\n```"
msgstr "```rut\nuse ink::{ Logger };\n\nentry fn crc32(data: bytes) -> u32 {\n    let mut crc: u32 = 0xFFFFFFFFu32;\n    for (let b of data) {\n        crc = crc ^ b as u32;\n        for (let k = 0; k < 8; k += 1) {\n            if ((crc & 1) == 1) {\n                crc = (crc >> 1) ^ 0xEDB88320u32;\n            } else {\n                crc = crc >> 1;\n            }\n        }\n    }\n    return crc ^ 0xFFFFFFFFu32;\n}\n\npub fn main() {\n    let log = Logger.new(\"crc\");\n    let vector = \"123456789\".encode();   // the canonical CRC-32 test vector\n    log.info(f\"crc32(vector) = {crc32(vector)} â check value 0xCBF43926: {crc32(vector) == 0xCBF43926u32}\");\n}\n```"

