"}\n"
"\n"
"builtin primitive bytes {\n"
"    fn len(self) -> i32;                     // octets\n"
"    fn decode(self) -> str;                  // UTF-8, lossy\n"
"    fn clone(self) -> bytes;                 // the one copy escape hatch\n"
"}\n"
"// type-methods: bytes.zeroed(n) -> bytes, bytes.from(a: [u8]) -> bytes\n"
"\n"
