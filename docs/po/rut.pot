msgstr ""

#: src/tutorial/modules.md:100
msgid ""
"```jsonc\n"
"// greet/pkg/rut.jsonc\n"
"{\n"
"  \"name\": \"greet\",\n"
"  \"entry\": { \"lib\": \"./greet.rut\" },\n"
"\n"
"  \"deps\": {\n"
"    // the toolchain's pouch package, from jsDelivr — pinned by sha256\n"
"    \"pouch\": { \"url\": "
"\"https://cdn.jsdelivr.net/gh/hpp2334/rut@std-v5/dist/std/pouch.rutbundle\", "
"\"sha256\": "
"\"3ceedd188659972ff6c797289e57e9fc9a686da9ea55f49ceb28ce4127c6ac80\" }\n"
"  }\n"
"}\n"
"```"
msgstr ""

#: src/tutorial/modules.md:113
msgid ""
"```rut\n"
"// greet/pkg/greet.rut\n"
"use pouch::{ Vec };\n"
"\n"
"pub struct Greeting {\n"
"    to: str;\n"
"    lines: Vec<str>;\n"
"}\n"
"\n"
"impl Greeting {\n"
"    pub fn new(to: str) -> Self {\n"
"        return Self { to: to, lines: Vec.new() };\n"
"    }\n"
"\n"
"    pub fn add(mut self, line: str) {\n"
"        self.lines.push(line);\n"
"    }\n"
"\n"
"    pub fn render(self) -> str {\n"
"        let mut out = f\"dear {self.to},\";\n"
"        for (let line of self.lines) {\n"
"            out = f\"{out} {line}\";\n"
"        }\n"
"        return out;\n"
"    }\n"
"}\n"
"\n"
"fn shout(msg: str) -> str {   // module-private: no `pub`, never importable\n"
"    return f\"{msg}!\";\n"
"}\n"
"```"
msgstr ""

