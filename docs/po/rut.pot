"```rut\n"
"use ink::{ Logger };\n"
"\n"
"entry fn render_line(topic: str, payload: str) -> str {\n"
"    return f\"[{topic}] {payload}\";\n"
"}\n"
"\n"
"pub fn main() {\n"
"    let log = Logger.new(\"bus\");\n"
"    log.info(render_line(\"broadcast\", \"<ada> hello world\"));\n"
"}\n"
"```"
