"```rut\n"
"use core::{ RunContext };\n"
"use ink::{ Logger };\n"
"use async_host::{ launch_future, sleep };\n"
"\n"
"async fn countdown(cx: RunContext, n: u32) -> u32 {\n"
"    let log = Logger.new(\"count\");\n"
"    let mut i = n;\n"
