// nmap/nmap.d.rut — the native key-table experiment's host surface (the
// mapset-host plan): `pub host fn` decls only — the bodies live in
// rut-std's `install_std_nmap` (RFC 0023 §2). Signatures are concrete
// over the crossing set.
//
// The native side owns KEYS and their RECORDED HASHES (closed set:
// the integer primitives, `bool`, `str`, `bytes`) plus — since round3
// phase 1 — the raw val column below; reference values stay rut-side
// in `nmapset`'s parallel array.
//
// This fixture mirrors the committed `rut/nmap` surface byte-for-byte
// in content: update BOTH when the surface changes.
//
// The two pair-shaped answers travel packed in one scalar because the
// decl crossing set has no tuples:
// - `map_remove`: `>= 0` = removed, the freed slot; `-1` = absent.
// - `map_take_reloc`: `-1` = drained; else `(old << 32) | new`.

pub host fn map_new(cap: i64) -> opaque;

pub host fn map_entry(m: opaque, k: opaque, h: i64) -> i32;

pub host fn map_find(m: opaque, k: opaque, h: i64) -> i32;

pub host fn map_remove(m: opaque, k: opaque, h: i64) -> i32;

pub host fn map_needs_grow(m: opaque) -> bool;

pub host fn map_grow(m: opaque) -> i32;

pub host fn map_take_reloc(m: opaque) -> i64;

pub host fn map_cap(m: opaque) -> i32;

pub host fn map_len(m: opaque) -> i32;

// ---- the typed lanes (the mapset-host plan, phase 2) ---------------
// 15 fns `map_{entry,find,remove}_{i,u,b,s,y}` over the closed key set:
// the key crosses DIRECTLY — no `opaque(..)` mint, no wrapper-hash `h`
// — and the table records the hash the HOST computed (mix64 / FNV-1a
// 64 with mapset's exact constants, bit-for-bit). The `i` lane takes
// `i64` — the wrapper casts i8..i64 into it (sign-extension is the
// `KeyPayload::Bits` law, so the recorded bits match the Opaque lane's);
// the `u` lane takes `u64` raw bits; `b` takes `bool` (0/1 bits);
// `s`/`y` borrow `str`/`bytes` zero-copy.
//
// Answers, per op:
// - `map_find_*`: `>= 0` = the found slot; `-1` = absent.
// - `map_remove_*`: `>= 0` = removed, the freed slot; `-1` = absent.
// - `map_entry_*`: fused grow-first — when inserting would breach the
//   load factor it answers `i32::MIN` (a fresh insert is `-(slot + 1)
//   >= -2^30`, so the encoding is collision-free) and the caller grows
//   + drains + retries; otherwise the found slot or the fresh slot.

pub host fn map_entry_i(m: opaque, k: i64) -> i32;

pub host fn map_entry_u(m: opaque, k: u64) -> i32;

pub host fn map_entry_b(m: opaque, k: bool) -> i32;

pub host fn map_entry_s(m: opaque, k: str) -> i32;

pub host fn map_entry_y(m: opaque, k: bytes) -> i32;

pub host fn map_find_i(m: opaque, k: i64) -> i32;

pub host fn map_find_u(m: opaque, k: u64) -> i32;

pub host fn map_find_b(m: opaque, k: bool) -> i32;

pub host fn map_find_s(m: opaque, k: str) -> i32;

pub host fn map_find_y(m: opaque, k: bytes) -> i32;

pub host fn map_remove_i(m: opaque, k: i64) -> i32;

pub host fn map_remove_u(m: opaque, k: u64) -> i32;

pub host fn map_remove_b(m: opaque, k: bool) -> i32;

pub host fn map_remove_s(m: opaque, k: str) -> i32;

pub host fn map_remove_y(m: opaque, k: bytes) -> i32;

// ---- the val column (nmapset-round3, phase 1) -----------------------
// Raw u64 bits in/out, ONE pair for every primitive val kind
// (i64/u64/f64/bool — the wrapper reinterprets client-side). `slot` is
// the index a previous `map_entry_*` / `map_find_*` / `map_remove_*`
// call answered, valid while that key's slot stays occupied
// (presence-by-key: the column has no nil tags; `map_remove_*` writes
// nothing and the slot's next put stores a fresh val). Out-of-range
// slots trap. Growth relocates the column host-side with the keys, so
// this path needs no relocation drain.

pub host fn map_val_set_u(m: opaque, slot: i32, v: u64);

pub host fn map_val_get_u(m: opaque, slot: i32) -> u64;
