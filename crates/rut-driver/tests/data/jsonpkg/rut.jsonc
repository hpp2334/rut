{
  // the json pkg's test-fixture consumer (the rut-json batch phase 1):
  // the BASE surface end to end — traits, reader/writer, prims, ?T,
  // [T], entries, the reader/writer public surfaces. (The old
  // full-wrapper variant rode json's `[peer-deps]` groups; the key and
  // the groups retired together — the grammar carries `deps` +
  // `dev-deps` only now.)
  "name": "jsonpkg",
    "deps": {
    "json": {
      "path": "../../../../../rut/json"
    }
  }
}
