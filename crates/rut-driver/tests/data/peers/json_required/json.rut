// json_required — the same pouch-free base as json (the fixture copies
// the file; one pkg is one entry file).
pub trait JsonSerialize {
    fn json_serialize(self) -> str;
}

impl JsonSerialize for str {
    fn json_serialize(self) -> str {
        return self;
    }
}

pub fn encode_str(s: str) -> str {
    return s.json_serialize();
}
