{
  // pouch — the hermetic stand-in: a generic class
  // with one method, shaped like the real pkg (a generic export splices
  // into consumers). Rides `base` so T8's peer-of-peer chain is real.
  "name": "pouch",
  "entry": {
    "lib": "./pouch.rut"
  },
  "inline": true,
  "deps": {
    "base": {
      "path": "../base"
    }
  }
}
