// T8's consumer: rides the whole chain — json's group wrapper dispatches
// while pouch's own dep (base) is live beneath it. `Vec<i64>::pouch_tag`
// names pouch's static through the used generic class; its body's
// `base_tag` resolves in pouch's own unit, where base is mounted.
use json::{JVecI64};
use pouch::{Vec};

fn tag() -> str {
    return Vec<i64>::pouch_tag();
}

fn go() -> str {
    let v = Vec<i64>::filled(7, 3);
    return JVecI64(v).json_serialize();
}
