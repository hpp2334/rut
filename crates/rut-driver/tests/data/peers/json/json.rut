// json — the dep-kinds fixture base: the interface and every
// public name live HERE; the base is pouch-free by law (the extraction
// constraint), so json mounts light when no peer is present. The
// peer-gated integration files are the wrapper-only groups beside this
// file — they append to THIS module's source when the peer is present.
pub interface JsonSerialize {
    fn json_serialize(self) -> str;
}

// the base's own satisfaction: `str` carries no members, so the scalar
// crosses in the spelled wrapper (the structural law, base edition)
pub class JStr(str);

impl JStr {
    pub fn json_serialize(self) -> str {
        return self.inner;
    }
}

pub fn encode_str(s: str) -> str {
    return JStr(s).json_serialize();
}
