// the pouch integration group: wrapper-ONLY — it declares the spelled
// manufacture over pouch's Vec (a bare container carries no members, so
// the interface crossing is the wrapper's). Mounted by the peer gate
// when `pouch` is in the program's closure; its `use` joins the unit's
// use list through the ordinary scan of the combined source.
use pouch::{Vec};

pub class JVecI64(Vec<i64>);

impl JVecI64 {
    pub fn json_serialize(self) -> str {
        return "[vec]";
    }
}
