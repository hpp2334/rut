{
  // the light consumer (the rut-json batch phase 1): json mounts ALONE
  // for the plainest reason — the fixture lists only json, so the
  // closure is the base alone (traits, reader/writer, prims, ?T, [T],
  // entries). rut/json declares no presence gating and no light mount:
  // a listed peer would mount like any dep.
  "name": "jsonlight",
    "deps": {
    "json": {
      "path": "../../../../../rut/json"
    }
  }
}
