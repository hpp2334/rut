use ink::{ Logger };

// binary-trees — allocation churn. Nodes are recursive structs naming
// themselves through nullable fields (`?Node`, `nil` when absent — RFC
// 0005 §8 + RFC 0044; `Option` is gone): `make` builds the tree
// bottom-up, and
// the whole tree drops at scope exit — the RC allocation/drop path this
// benchmark stresses. Scale: depth = 14 (32767 nodes).

struct Node {
    value: i32,
    left: ?Node,
    right: ?Node,
}

fn make(depth: i32, v: i32) -> Node {
    if (depth <= 0) {
        return Node { value: v, left: nil, right: nil };
    }
    return Node {
        value: v,
        left: make(depth - 1, v * 2),
        right: make(depth - 1, v * 2 + 1),
    };
}

fn count(n: ?Node) -> i32 {
    let mut c = 1;
    if (n.left != nil) { c += count(n.left); }
    if (n.right != nil) { c += count(n.right); }
    return c;
}

pub fn main() -> nil {
    let root = make(14, 1);
    Logger.new("app").info(f"CHECKSUM {count(root)}");
}
