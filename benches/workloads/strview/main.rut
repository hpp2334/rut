use ink::{ Logger };

use nmapset::{ HashMap };

// strview — the strings-round1 phase-2 row: the nmapset-str six-phase
// churn (same phases, same counters, same prime-weight formula) with
// keys CARVED from one generated parent string instead of built per
// op. The parent is 2n fixed-width 6-char decimal slots (slot(i) =
// f"{100000+i}", injective): the churn keys read slots 0..n-1, the
// never-inserted miss keys read slots n..2n-1, and every op crosses
// the `(parent, i*6, 6)` byte window through the RANGE methods — no
// key cell is ever minted (the twin built `f"k{i}"` on every op).
// This is the shape where the view lever applies (phase 0a: built
// keys gain nothing — these keys are ranges, not mints). New checksum
// pin: the value is computed here first and cross-verified on
// rut/qjs/node (strview.js — the same materialized computation over
// `substring`), then ADDED to expected.json as ONE disclosed line.
// Scale: n = 50000 entries, parent = 600000 chars.

fn build_parent(n: i32) -> str {
    let mut p = "";
    for (let i = 0; i < 2 * n; i += 1) {
        let base = 100000 + i;
        p = f"{p}{base}";
    }
    return p;
}

fn churn(p: str, n: i32) -> i32 {
    let mut m: HashMap<str, i32> = HashMap.new();
    // build — every key is new
    let mut added = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put_range(p, i * 6, 6, i)) {
            added += 1;
        }
    }
    // replace — every key is present
    let mut replaced = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put_range(p, i * 6, 6, i + 3) == false) {
            replaced += 1;
        }
    }
    // hit lookups — sum the stored values
    let mut sum = 0;
    let mut hits = 0;
    for (let i = 0; i < n; i += 1) {
        let q = m.get_range(p, i * 6, 6);
        if (q != nil) {
            hits += 1;
            sum = sum.wrapping_add(q);
        }
    }
    // miss lookups — slots n..2n are never inserted
    let mut misses = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.get_range(p, (n + i) * 6, 6) == nil) {
            misses += 1;
        }
    }
    // remove every third key
    let mut removed = 0;
    for (let i = 0; i < n; i += 3) {
        if (m.remove_range(p, i * 6, 6)) {
            removed += 1;
        }
    }
    // full re-scan: two thirds survive
    let mut present = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.has_range(p, i * 6, 6)) {
            present += 1;
        }
    }
    // re-add the removed keys under negated values
    let mut added2 = 0;
    for (let i = 0; i < n; i += 3) {
        if (m.put_range(p, i * 6, 6, -i)) {
            added2 += 1;
        }
    }
    let mut c = sum;
    c = c.wrapping_add(added.wrapping_mul(31));
    c = c.wrapping_add(replaced.wrapping_mul(37));
    c = c.wrapping_add(hits.wrapping_mul(41));
    c = c.wrapping_add(misses.wrapping_mul(43));
    c = c.wrapping_add(removed.wrapping_mul(47));
    c = c.wrapping_add(present.wrapping_mul(53));
    c = c.wrapping_add(added2.wrapping_mul(59));
    c = c.wrapping_add(m.len().wrapping_mul(61));
    return c;
}

pub fn main() -> nil {
    let n = 50000;
    Logger.new("app").info(f"CHECKSUM {churn(build_parent(n), n)}");
}
