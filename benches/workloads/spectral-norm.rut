import { Logger } from "std:log";

import { Vec } from "std:collection";
// spectral-norm — the benchmark-game power-iteration norm.
// Scale: n = 150, 10 iterations. Same fixed-iteration Newton sqrt as the
// JS twin, so the checksum is exact.

fn fsqrt(x: f64) -> f64 {
    if (x <= 0.0) {
        return 0.0;
    }
    let mut r = x;
    let mut i = 0;
    while (i < 30) {
        r = 0.5 * (r + x / r);
        i += 1;
    }
    return r;
}

fn a(i: i32, j: i32) -> f64 {
    return 1.0 / f64((i + j) * (i + j + 1) / 2 + i + 1);
}

fn mul_av(v: Vec<f64>, mut out: Vec<f64>, n: i32) -> unit {
    for (let i = 0; i < n; i += 1) {
        let mut s = 0.0;
        for (let j = 0; j < n; j += 1) {
            s += a(i, j) * v[j];
        }
        out[i] = s;
    }
}

fn mul_atv(v: Vec<f64>, mut out: Vec<f64>, n: i32) -> unit {
    for (let i = 0; i < n; i += 1) {
        let mut s = 0.0;
        for (let j = 0; j < n; j += 1) {
            s += a(j, i) * v[j];
        }
        out[i] = s;
    }
}

pub fn main() -> unit {
    let n = 150;
    let mut u = Vec<f64>.zeroed(n);
    let v = Vec<f64>.zeroed(n);
    let tmp = Vec<f64>.zeroed(n);
    for (let i = 0; i < n; i += 1) {
        u[i] = 1.0;
    }
    for (let it = 0; it < 10; it += 1) {
        mul_av(u, tmp, n);
        mul_atv(tmp, v, n);
        mul_av(v, tmp, n);
        mul_atv(tmp, u, n);
    }
    let mut vbv = 0.0;
    let mut vv = 0.0;
    for (let i = 0; i < n; i += 1) {
        vbv += u[i] * v[i];
        vv += v[i] * v[i];
    }
    let norm = fsqrt(vbv / vv);
    Logger.new("app").info(f"CHECKSUM {norm}");
}
