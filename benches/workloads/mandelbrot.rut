import { log } from "std:log";

// mandelbrot — escape-time iteration count over a grid.
// Scale: 400 x 300, max_iter = 500. Integer checksum (exact for f64).

fn mandelbrot(
    x0: f64,
    y0: f64,
    x1: f64,
    y1: f64,
    w: i32,
    h: i32,
    max_iter: i32,
) -> i32 {
    let mut checksum = 0;
    for (let y = 0; y < h; y += 1) {
        let ci = y0 + (y1 - y0) * f64(y) / f64(h);
        for (let x = 0; x < w; x += 1) {
            let cr = x0 + (x1 - x0) * f64(x) / f64(w);
            let mut zr = 0.0;
            let mut zi = 0.0;
            let mut i = 0;
            while (i < max_iter) {
                let zr2 = zr * zr;
                let zi2 = zi * zi;
                if (zr2 + zi2 > 4.0) {
                    break;
                }
                zi = 2.0 * zr * zi + ci;
                zr = zr2 - zi2 + cr;
                i += 1;
            }
            checksum += i;
        }
    }
    return checksum;
}

pub fn main() -> unit {
    let checksum = mandelbrot(-2.0, -1.2, 0.8, 1.2, 100, 75, 200);
    log(f"CHECKSUM {checksum}");
}
