{
  // json-roundtrip/ — the std json pkg's own bench row (the rut-json
  // batch, phase 2, survey §2.11's pre-registered method): the SAME
  // generated document as json-decode (the knucleotide LCG, seed 42 —
  // same draws, same order), decoded DIRECTLY into typed rows and
  // re-encoded — encode+decode round trips through the LIB (the
  // interface path: DocRow satisfies json's JsonSerialize /
  // JsonDeserialize structurally — the members live on this file's
  // inherent impls; no hand-rolled twin of the codec). Module dir
  // because it mounts `json` + `pouch`; the peer gate assembles
  // group-pouch onto json because pouch is present in this closure
  // (the JsonVec wrapper is load-bearing here). The checksum is
  // defined over the
  // ROUND-TRIPPED VALUES, not lexemes, and must equal the JS twin's.
  "name": "json_roundtrip",
    "deps": {
    "json": {
      "path": "../../../rut/json"
    },
    "pouch": {
      "path": "../../../rut/pouch"
    },
    "ink": {
      "path": "../../../rut/ink"
    }
  }
}
