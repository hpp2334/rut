{
  // json-decode/ — the rut half of the `json-decode` bench workload: a
  // module dir because it mounts `pouch` (see knucleotide/rut.jsonc).
  "name": "json_decode",
  "entry": {
    "lib": "./main.rut"
  },
  "deps": {
    "pouch": {
      "path": "../../../rut/pouch"
    },
    "ink": {
      "path": "../../../rut/ink"
    }
  }
}
