import { Logger } from "std:log";
import { Math } from "std:math";
import { String } from "std:string";
// fasta — LCG-driven nucleotide string building (the benchmark-game
// string churn). The pieces go through the `std:string` builder, which
// chunks them and flattens once — the rut counterpart of the JS
// `parts.push` + `parts.join""`. This exercises the builder (and the
// immutable `str` it flattens into).
// Scale: n = 10000.

fn fasta(n: i32) -> str {
    let mut b = String.new();
    let letters = "ACGT";
    let mut x: u32 = 42;
    let mut checksum = 0;
    for (let i = 0; i < n; i += 1) {
        x = Math.wrapping_add(Math.wrapping_mul(x, 1103515245), 12345);
        let idx = i32((x >> 16) % 4);
        let mut k = 0;
        for (let c of letters) {
            if (k == idx) {
                b.push_char(c);
            }
            k += 1;
        }
        checksum += idx;
    }
    let out = b.to_str();
    return f"{checksum}:{string_len(out)}";
}

pub fn main() -> unit {
    Logger.new("app").info(f"CHECKSUM {fasta(10000)}");
}
