use { Logger } from "std:log";
use { Math } from "std:math";
// fasta — LCG-driven nucleotide string building (the benchmark-game
// string churn). The result accumulates into one `str`: `out =
// f"{out}{..}"` lowers to a concat whose destination is the accumulator,
// so the engine appends into the uniquely-owned cell — amortized O(n),
// not a copy of the growing prefix per piece.
// Scale: n = 10000.

fn fasta(n: i32) -> str {
    let mut out = "";
    let letters = "ACGT";
    let mut x: u32 = 42;
    let mut checksum = 0;
    for (let i = 0; i < n; i += 1) {
        x = Math.wrapping_add(Math.wrapping_mul(x, 1103515245), 12345);
        let idx = ((x >> 16) % 4) as i32;
        out = f"{out}{letters[idx]}";
        checksum += idx;
    }
    return f"{checksum}:{out.len()}";
}

pub fn main() -> nil {
    Logger.new("app").info(f"CHECKSUM {fasta(10000)}");
}
