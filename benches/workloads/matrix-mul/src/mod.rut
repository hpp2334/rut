use ink::{ Logger };

use pouch::{ Vec };
// matrix-mul — dense n x n f64 multiply-add hot loop, flat buffers.
// Scale: n = 128. Checksum is a float sum (compare with tolerance).

fn gemm(n: i32, a: Vec<f64>, b: Vec<f64>, out: Vec<f64>) -> nil {
    for (let i = 0; i < n; i += 1) {
        for (let k = 0; k < n; k += 1) {
            let aik = a[i * n + k]!;
            for (let j = 0; j < n; j += 1) {
                let oij = out[i * n + j]!;
                out[i * n + j] = oij + aik * b[k * n + j]!;
            }
        }
    }
}

entry fn main() -> nil {
    let n = 64;
    let a = Vec<f64>::filled(0.0, n * n);
    let b = Vec<f64>::filled(0.0, n * n);
    let out = Vec<f64>::filled(0.0, n * n);
    for (let i = 0; i < n * n; i += 1) {
        a[i] = i as f64;
        b[i] = (i % 7) as f64;
    }
    gemm(n, a, b, out);
    let s: f64 = 0.0;
    for (let i = 0; i < n * n; i += 1) {
        s += out[i]!;
    }
    Logger("app").info(f"CHECKSUM {s}");
}
