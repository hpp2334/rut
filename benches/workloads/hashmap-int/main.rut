use ink::{ Logger };

use mapset::{ HashMap };

// hashmap-int — i32-keyed HashMap<i32, i32> churn: interleaved put /
// replace / hit-and-miss get / remove plus a full re-scan, over keys
// scattered by the i32 golden-ratio wrap. The JS twin
// (../hashmap-int.js) runs the identical algorithm on `new Map()` with
// integer keys; checksum = the wrapped value sum plus the phase counts.
// Scale: n = 100000 entries.

fn churn(n: i32) -> i32 {
    let mut m: HashMap<i32, i32> = HashMap.new();
    // build — every key is new
    let mut added = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(i.wrapping_mul(-1640531535), i)) {
            added += 1;
        }
    }
    // replace — every key is present
    let mut replaced = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(i.wrapping_mul(-1640531535), i + 7) == false) {
            replaced += 1;
        }
    }
    // hit lookups — sum the stored values
    let mut sum = 0;
    let mut hits = 0;
    for (let i = 0; i < n; i += 1) {
        let p = m.get(i.wrapping_mul(-1640531535));
        if (p != nil) {
            hits += 1;
            sum = sum.wrapping_add(*p);
        }
    }
    // miss lookups — the second half of the key space is absent
    let mut misses = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.get((i + n).wrapping_mul(-1640531535)) == nil) {
            misses += 1;
        }
    }
    // remove the even keys
    let mut removed = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.remove(i.wrapping_mul(-1640531535))) {
            removed += 1;
        }
    }
    // full re-scan: the odds survive, the evens do not
    let mut present = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.has(i.wrapping_mul(-1640531535))) {
            present += 1;
        }
    }
    // re-add the evens under negated values
    let mut added2 = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.put(i.wrapping_mul(-1640531535), -i)) {
            added2 += 1;
        }
    }
    let mut c = sum;
    c = c.wrapping_add(added.wrapping_mul(31));
    c = c.wrapping_add(replaced.wrapping_mul(37));
    c = c.wrapping_add(hits.wrapping_mul(41));
    c = c.wrapping_add(misses.wrapping_mul(43));
    c = c.wrapping_add(removed.wrapping_mul(47));
    c = c.wrapping_add(present.wrapping_mul(53));
    c = c.wrapping_add(added2.wrapping_mul(59));
    c = c.wrapping_add(m.len().wrapping_mul(61));
    return c;
}

pub fn main() -> nil {
    Logger.new("app").info(f"CHECKSUM {churn(100000)}");
}
