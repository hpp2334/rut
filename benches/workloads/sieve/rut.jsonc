{
  // sieve/ — Sieve of Eratosthenes over a flat Vec<u8>, limit = 500_000.
  // A module dir because it mounts `pouch`; `ink` is declared for the
  // logger. The JS twin is ../sieve.js.
  "name": "sieve",
    "deps": {
    "pouch": {
      "path": "../../../rut/pouch"
    },
    "ink": {
      "path": "../../../rut/ink"
    }
  }
}
