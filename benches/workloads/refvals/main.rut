use ink::{ Logger };

use nmapset::{ HashMap };

// refvals — the refval-exp batch's phase-0 row: a record-valued map, the
// suite's missing ref-V coverage. No bench row today exercises reference
// values at all — every map row (`nmapset-*`, `nmap-primmap`) stores
// primitive/str vals — so this row is the measuring stick the host-val-
// column experiment (`refcolumn`, phase 1) is judged against, and it
// survives that experiment regardless of its verdict.
//
// THE SHAPE: `HashMap<i64, Pt>` over the `[?V]` sidecar (ref V = shared
// cells; the law: `get -> ?V` one-cell aliasing). K = i64 DELIBERATELY —
// the key lane (`map_entry_i`/`map_find_i`, one mix64 hash per op, the
// nmapset-int precedent) is held CONSTANT so the row isolates the
// VALUE-side costs: the record mints, the sidecar cell stores and loads,
// the grow-time relocation drain, and the aliasing law itself. str keys
// would confound every term with the encode()-per-hash cost the
// strings-round1 rows already price.
//
// V = `Pt`, a 2-field record — the smallest honest "user object" shape.
// Under RFC 0044 every binding SHARES its cell, so the row's fourth
// phase is the law in a hot loop: mutate a field through a get-returned
// reference and read the map's stored value back CHANGED. The checksum
// DEPENDS on that write-through (`sum_after` sums the mutated x over
// fresh gets): any engine that ever answers `get` with a copy breaks
// this row loudly instead of silently.
//
// The phases, in the shapes that matter:
//   1. insert/overwrite churn — a fresh `Pt` cell minted per put;
//   2. hit-heavy gets (5:1) — sidecar load + cell deref per hit;
//   3. read-modify-write through the alias — the one-cell law pinned by
//      the checksum itself;
//   4. grow-heavy sweeps — a fresh map walked from cap 8 through every
//      load-factor boundary (the `[?V]` relocation drain, largest
//      drains last), then an overwrite pass and a full read-back.
//
// CHECKSUM DISCIPLINE (the nmap-primmap precedent, adapted): the churn
// accumulates in i64 and prints once, never narrowing; every term is an
// exact integer below 2^53, so the JS twin's doubles compute the SAME
// number bit-exactly (twin gate, `expected.json` pins it). The drain
// term carries a property this row's own A/B stubs rely on (disclosed
// in-source): every value the checksum READS is written AFTER its map's
// last grow (the overwrite passes), so dropping the relocation drain in
// a scratch stub leaves the checksum bit-identical — the stub provably
// moves only drain traffic.
// Scale: n = 100000 entries on the main map, gn = 200000 on the grow
// sweep — ~1.32M map ops and ~650k record mints per run.

struct Pt {
    x: i32,
    y: i32,
}

// the golden-ratio mix on the i64 lane — nmapset-int's key shape,
// widened; distinct i give distinct keys (the multiplier is odd)
fn key(i: i64) -> i64 {
    return i.wrapping_mul(-1640531535);
}

fn churn(n: i32, gn: i32) -> i64 {
    let mut m: HashMap<i64, Pt> = HashMap.new();

    // (1a) build — every key new; one fresh Pt cell per put
    let mut added: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(key(i as i64), Pt { x: i, y: i.wrapping_add(1) })) {
            added += 1;
        }
    }

    // (1b) overwrite churn — every key present, fresh cell per put (the
    // sidecar releases the replaced cell and stores the new one)
    let mut replaced: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(key(i as i64), Pt { x: i.wrapping_add(7), y: i.wrapping_add(8) }) == false) {
            replaced += 1;
        }
    }

    // (2a) hit gets — the sidecar load: arrget + cell deref, both fields
    let mut sum_before: i64 = 0;
    let mut hits: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let p = m.get(key(i as i64));
        if (p != nil) {
            hits += 1;
            sum_before = sum_before.wrapping_add((p.x + p.y) as i64);
        }
    }

    // (2b) miss gets — the second half of the key space is absent (5:1
    // hit-heavy overall)
    let mut misses: i64 = 0;
    for (let i = 0; i < n / 5; i += 1) {
        if (m.get(key((2 * n + i) as i64)) == nil) {
            misses += 1;
        }
    }

    // (3) READ-MODIFY-WRITE THROUGH THE ALIAS — the one-cell law in the
    // hot loop: `p` IS the stored cell; the field write lands in the
    // map. No put, no set — one get, one field store.
    let mut rmw: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let mut p = m.get(key(i as i64));
        if (p != nil) {
            p.x += 1;
            rmw += 1;
        }
    }

    // (3b) read-back over FRESH gets — observes every write-through;
    // sum_after = sum of x + n if (and only if) the alias carried them
    let mut sum_after: i64 = 0;
    let mut hits2: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let p = m.get(key(i as i64));
        if (p != nil) {
            hits2 += 1;
            sum_after = sum_after.wrapping_add(p.x as i64);
        }
    }

    // (4) grow-heavy sweep — a fresh map from cap 8 through every
    // load-factor boundary: 15 grows, the relocation drains moving
    // ~260k cells, the largest last. Then an overwrite pass (fresh
    // cells, written after the last grow — the drain-stub invariant
    // above) and a full read-back of y.
    let mut g: HashMap<i64, Pt> = HashMap.new();
    let mut added_g: i64 = 0;
    for (let i = 0; i < gn; i += 1) {
        if (g.put(key(i as i64), Pt { x: i.wrapping_add(1), y: i.wrapping_mul(2) })) {
            added_g += 1;
        }
    }
    let mut replaced_g: i64 = 0;
    for (let i = 0; i < gn; i += 1) {
        if (g.put(key(i as i64), Pt { x: i.wrapping_add(3), y: i.wrapping_mul(2) }) == false) {
            replaced_g += 1;
        }
    }
    let mut hits_g: i64 = 0;
    let mut sum_g: i64 = 0;
    for (let i = 0; i < gn; i += 1) {
        let p = g.get(key(i as i64));
        if (p != nil) {
            hits_g += 1;
            sum_g = sum_g.wrapping_add(p.y as i64);
        }
    }

    // (5) removal churn on m — remove the evens, re-scan, re-add under
    // fresh cells (tombstones; no growth — cap already 2^18)
    let mut removed: i64 = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.remove(key(i as i64))) {
            removed += 1;
        }
    }
    let mut present: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.has(key(i as i64))) {
            present += 1;
        }
    }
    let mut added2: i64 = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.put(key(i as i64), Pt { x: i.wrapping_mul(3), y: i })) {
            added2 += 1;
        }
    }

    // the checksum — distinct prime weights, i64 throughout, exact in
    // doubles (the twin gate)
    let mut c: i64 = sum_before;
    c = c.wrapping_add(hits.wrapping_mul(13));
    c = c.wrapping_add(misses.wrapping_mul(17));
    c = c.wrapping_add(replaced.wrapping_mul(11));
    c = c.wrapping_add(added.wrapping_mul(7));
    c = c.wrapping_add(rmw.wrapping_mul(19));
    c = c.wrapping_add(sum_after.wrapping_mul(2));
    c = c.wrapping_add(hits2.wrapping_mul(23));
    c = c.wrapping_add(added_g.wrapping_mul(29));
    c = c.wrapping_add(replaced_g.wrapping_mul(31));
    c = c.wrapping_add(hits_g.wrapping_mul(37));
    c = c.wrapping_add(sum_g.wrapping_mul(3));
    c = c.wrapping_add(removed.wrapping_mul(41));
    c = c.wrapping_add(present.wrapping_mul(43));
    c = c.wrapping_add(added2.wrapping_mul(47));
    c = c.wrapping_add((m.len() as i64).wrapping_mul(53));
    c = c.wrapping_add((g.len() as i64).wrapping_mul(59));
    return c;
}

pub fn main() -> nil {
    let c = churn(100000, 200000);
    Logger.new("app").info(f"CHECKSUM {c}");
}
