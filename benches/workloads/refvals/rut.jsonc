{
  // refvals/ — the refval-exp batch's phase-0 row: a RECORD-VALUED map,
  // `HashMap<i64, Pt>` — the suite's first bench row whose values are
  // REFERENCE values (rut records are shared cells, RFC 0044). The values
  // live IN the host table's entries (nmap-hostvals: one fused host
  // crossing per op, the entry retaining the value box). The `refcolumn`
  // host-val-column experiment that once re-spelled this op stream over
  // an alias-row column measured SLOWER and was REVERTED — this row is
  // the permanent baseline. A module dir (not a loose file) because
  // it mounts `nmapset`, which pulls the `nmap_host` host pkg through its
  // own `[deps]`. `ink` is declared for the logger.
  "name": "refvals",
    "deps": {
    "nmapset": {
      "path": "../../../rut/nmapset"
    },
    "ink": {
      "path": "../../../rut/ink"
    }
  }
}
