use ink::{ Logger };

use nmapset::{ HashMap };

// nmap-primmap — the nmapset-round3 phase-2 row: nmapset-int's churn
// over `HashMap<i32, i64>` (the val-column row — keys AND values in
// the native table's val column) instead of the `[?V]` sidecar (keys
// native, values in a rut-side `[?V]` sidecar — the `HashMap<i32, i32>`
// shape nmapset-int runs). The op sequence is
// IDENTICAL — same keys, same values, same counters — so the checksum
// must EQUAL `hashmap-int`'s / `nmapset-int`'s pinned 734932704: the
// churn accumulates in i64 (the val lane is i64) and narrows once at
// the return, which is bit-identical to the i32 wrapping arithmetic
// (two's-complement addition is the same mod 2^32). Until the
// hashmap-surface batch renamed the surface this row spelled the val
// column's direct class name; the family rows resolve to the very same
// class — checksum, fuel and heap pins bit-identical by construction.
// Scale: n = 100000 entries.

fn churn(n: i32) -> i32 {
    let mut m: HashMap<i32, i64> = HashMap.new();
    // build — every key is new
    let mut added: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(i.wrapping_mul(-1640531535), i as i64)) {
            added += 1;
        }
    }
    // replace — every key is present
    let mut replaced: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(i.wrapping_mul(-1640531535), i as i64 + 7) == false) {
            replaced += 1;
        }
    }
    // hit lookups — sum the stored values
    let mut sum: i64 = 0;
    let mut hits: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let p = m.get(i.wrapping_mul(-1640531535));
        if (p != nil) {
            hits += 1;
            sum = sum.wrapping_add(p);
        }
    }
    // miss lookups — the second half of the key space is absent
    let mut misses: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.get((i + n).wrapping_mul(-1640531535)) == nil) {
            misses += 1;
        }
    }
    // remove the even keys
    let mut removed: i64 = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.remove(i.wrapping_mul(-1640531535))) {
            removed += 1;
        }
    }
    // full re-scan: the odds survive, the evens do not
    let mut present: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.has(i.wrapping_mul(-1640531535))) {
            present += 1;
        }
    }
    // re-add the evens under negated values
    let mut added2: i64 = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.put(i.wrapping_mul(-1640531535), 0i64 - i as i64)) {
            added2 += 1;
        }
    }
    let mut c: i64 = sum;
    c = c.wrapping_add(added.wrapping_mul(31));
    c = c.wrapping_add(replaced.wrapping_mul(37));
    c = c.wrapping_add(hits.wrapping_mul(41));
    c = c.wrapping_add(misses.wrapping_mul(43));
    c = c.wrapping_add(removed.wrapping_mul(47));
    c = c.wrapping_add(present.wrapping_mul(53));
    c = c.wrapping_add(added2.wrapping_mul(59));
    c = c.wrapping_add((m.len() as i64).wrapping_mul(61));
    return c as i32;
}

pub fn main() -> nil {
    let c = churn(100000);
    Logger.new("app").info(f"CHECKSUM {c}");
}
