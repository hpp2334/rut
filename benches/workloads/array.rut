use ink::{ Logger };
use pouch::{ Vec };

// array — growable-sequence churn over Vec<i32>: push through the grow
// path, indexed read+write, then a full iteration. The JS twin (array.js)
// drives a plain JS Array with the same op order and scale; the point of
// the row is rut's RC-heap fat-ref slots (one *i32 cell per element)
// against the engines' packed arrays. Scale is bounded by rut's 64 MiB
// VM heap budget (RFC 0039): n elements cost a *T slot plus a boxed
// i32 cell each — measured VM heap peak 38.5 MB at n = 1M.
// Scale: n = 1_000_000. Canonical reference (closed form, both twins;
// n < m so no mod wrap): acc = n(n-1)/2, total = acc + n,
// checksum = 1000000000000.

fn churn(n: i32, m: i32) -> i64 {
    let mut v: Vec<i32> = Vec.new();
    // push churn: n values through the grow path
    for (let i = 0; i < n; i += 1) {
        v.push(i % m);
    }
    // indexed read + write
    let mut acc: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let x: i32 = v[i];
        v[i] = (x + 1) % m;
        acc += x as i64;
    }
    // iterate the whole sequence (Vec for-of yields *T — RFC 0012 §6)
    let mut total: i64 = 0;
    for (let x of v) {
        total += x as i64;
    }
    return acc + total;
}

pub fn main() -> nil {
    let checksum = churn(1000000, 1000003);
    Logger.new("app").info(f"CHECKSUM {checksum}");
}
