use ink::{ Logger };

use pouch::{ Vec };
use calc::{ Math };
// quicksort — deterministic LCG input, in-place Lomuto quicksort, rolled
// checksum. Scale: n = 100_000.
//
// The LCG and the checksum use the `wrapping_*` methods (RFC 0004 §3) so the i32
// math matches JavaScript's `Math.imul(...) | 0` exactly.

fn quicksort(mut xs: Vec<i32>, lo: i32, hi: i32) -> nil {
    if (lo >= hi) {
        return;
    }
    let pivot = xs[hi];
    let mut i = lo - 1;
    for (let j = lo; j < hi; j += 1) {
        if (xs[j] <= pivot) {
            i += 1;
            let t = xs[i];
            xs[i] = xs[j];
            xs[j] = t;
        }
    }
    let t = xs[i + 1];
    xs[i + 1] = xs[hi];
    xs[hi] = t;
    let p = i + 1;
    quicksort(xs, lo, p - 1);
    quicksort(xs, p + 1, hi);
}

pub fn main() -> nil {
    let n = 10000;
    let xs: Vec<i32> = Vec.new();
    let mut x: i32 = 42;
    for (let i = 0; i < n; i += 1) {
        x = (x.wrapping_mul(1664525)).wrapping_add(1013904223);
        xs.push(x % 1000);
    }
    quicksort(xs, 0, n - 1);
    let mut h: i32 = 0;
    for (let i = 0; i < n; i += 1) {
        h = (h.wrapping_mul(31)).wrapping_add(xs[i]);
    }
    Logger.new("app").info(f"CHECKSUM {h}");
}
