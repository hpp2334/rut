{
  // mathhost/ — calc's host-fn helpers (Math::abs/min/max/signum) in a hot
  // loop: every call crosses the FFI — the host-fn hot-path canary.
  // `calc` is a declared path row (the walk mounts the surface; the
  // chain's blanket host-pkg install binds the bodies); `ink` is
  // declared for the logger. The JS twin is ../mathhost.js.
  "name": "mathhost",
    "deps": {
    "calc": {
      "path": "../../../rut/calc"
    },
    "ink": {
      "path": "../../../rut/ink"
    }
  }
}
