use ink::{ Logger };

use pouch::{ Vec };
// fannkuch-redux — pancake flips over all permutations. Scale: n = 7.
// Canonical checksum: sum over all n! permutations of (+/- flips), sign
// toggling every permutation (benchmarks-game definition). The value is
// folded with max-flips: checksum * 1000 + max_flips (exact i32).
// n=7 canonical: checksum 228, max_flips 16.

fn fannkuch(n: i32) -> i32 {
    let perm = Vec<i32>::filled(0, n);
    let perm1 = Vec<i32>::filled(0, n);
    let count = Vec<i32>::filled(0, n);
    for (let i = 0; i < n; i += 1) {
        perm1[i] = i;
    }
    let max_flips = 0;
    let checksum = 0;
    let perm_count = 0;
    let r = n;
    let done = false;
    while (!done) {
        while (r != 1) {
            count[r - 1] = r;
            r -= 1;
        }
        for (let i = 0; i < n; i += 1) {
            perm[i] = perm1[i];
        }
        let flips = 0;
        while (perm[0]! != 0) {
            let k = perm[0]! + 1;
            let i = 0;
            let j = k - 1;
            while (i < j) {
                let t = perm[i]!;
                perm[i] = perm[j];
                perm[j] = t;
                i += 1;
                j -= 1;
            }
            flips += 1;
        }
        if (flips > max_flips) {
            max_flips = flips;
        }
        if (perm_count % 2 == 0) {
            checksum += flips;
        } else {
            checksum -= flips;
        }
        while (r != n) {
            let first = perm1[0]!;
            for (let i = 0; i < r; i += 1) {
                perm1[i] = perm1[i + 1];
            }
            perm1[r] = first;
            let c = count[r]! - 1;
            count[r] = c;
            if (c > 0) {
                break;
            }
            r += 1;
        }
        perm_count += 1;
        if (r == n) {
            done = true;
        }
    }
    return checksum * 1000 + max_flips;
}

entry fn main() -> nil {
    Logger("app").info(f"CHECKSUM {fannkuch(7)}");
}
