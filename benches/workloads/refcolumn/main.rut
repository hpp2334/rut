use ink::{ Logger };

use nmapset::{ RefMap };

// refcolumn — the refval-exp batch's phase-1 EXPERIMENT row: refvals'
// EXACT op sequence over the experimental `RefMap<i64, Pt>` (the host
// table's opaque val column) instead of `HashMap<i64, Pt>` (the `[?V]`
// sidecar). Every phase, key, value, counter and weight is refvals'
// verbatim — K = i64 holds the key lane constant, V = Pt is the same
// 2-field record — so the ONLY difference is the val storage:
//
//   refvals   put = record mint -> sidecar store; get = sidecar load;
//             grow = the wrapper relocation drain
//   refcolumn put = ONE `opaque(v)` box mint -> the box stored behind a
//             host-side self-releasing owner; get = the SAME box
//             re-handed, unwrapped with `opaque.downcast<V>` to the
//             LIVE cell; grow = no drain (the column moves with the
//             keys host-side)
//
// THE CHECKSUM MUST EQUAL refvals' 140052990000 — same values, same
// order, and the one-cell law CARRIES: a get result is the stored cell,
// so phase (3)'s `p.x += 1` writes through and phase (3b)'s fresh-get
// read-back observes it. Any engine that ever answers `get` with a copy
// breaks this row by exactly 2n, exactly like the baseline row.
//
// The known per-op terms phase 2 attributes (documented in-source):
// the per-put box mint (Op::Box), the per-get downcast (tid-check +
// the alias handoff — no allocation under the ?T recovery,
// refval-round2 phase 0; round 1's `(V, bool)` record mint is GONE)
// and the extra box cell per live value (+32 B accounted — the honest
// heap expectation is records-plus-boxes minus the sidecar, NOT raw
// parity) — traded against the deleted sidecar store/load and the
// deleted relocation drain.

struct Pt {
    x: i32,
    y: i32,
}

// the golden-ratio mix on the i64 lane — nmapset-int's key shape,
// widened; distinct i give distinct keys (the multiplier is odd)
fn key(i: i64) -> i64 {
    return i.wrapping_mul(-1640531535);
}

fn churn(n: i32, gn: i32) -> i64 {
    let mut m: RefMap<i64, Pt> = RefMap.new();

    // (1a) build — every key new; one fresh Pt cell (and its box) per put
    let mut added: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(key(i as i64), Pt { x: i, y: i.wrapping_add(1) })) {
            added += 1;
        }
    }

    // (1b) overwrite churn — every key present, fresh cell per put (the
    // host releases the replaced value's owner)
    let mut replaced: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.put(key(i as i64), Pt { x: i.wrapping_add(7), y: i.wrapping_add(8) }) == false) {
            replaced += 1;
        }
    }

    // (2a) hit gets — the box re-handed and unwrapped, both fields
    let mut sum_before: i64 = 0;
    let mut hits: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let p = m.get(key(i as i64));
        if (p != nil) {
            hits += 1;
            sum_before = sum_before.wrapping_add((p.x + p.y) as i64);
        }
    }

    // (2b) miss gets — the second half of the key space is absent (5:1
    // hit-heavy overall)
    let mut misses: i64 = 0;
    for (let i = 0; i < n / 5; i += 1) {
        if (m.get(key((2 * n + i) as i64)) == nil) {
            misses += 1;
        }
    }

    // (3) READ-MODIFY-WRITE THROUGH THE ALIAS — the one-cell law in the
    // hot loop: `p` IS the stored cell; the field write lands in the
    // map. No put, no set — one get, one field store.
    let mut rmw: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let mut p = m.get(key(i as i64));
        if (p != nil) {
            p.x += 1;
            rmw += 1;
        }
    }

    // (3b) read-back over FRESH gets — observes every write-through;
    // sum_after = sum of x + n if (and only if) the alias carried them
    let mut sum_after: i64 = 0;
    let mut hits2: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        let p = m.get(key(i as i64));
        if (p != nil) {
            hits2 += 1;
            sum_after = sum_after.wrapping_add(p.x as i64);
        }
    }

    // (4) grow-heavy sweep — a fresh map from cap 8 through every
    // load-factor boundary: 15 grows, the column moving with the keys
    // HOST-SIDE (no relocation drain on this path). Then an overwrite
    // pass and a full read-back of y.
    let mut g: RefMap<i64, Pt> = RefMap.new();
    let mut added_g: i64 = 0;
    for (let i = 0; i < gn; i += 1) {
        if (g.put(key(i as i64), Pt { x: i.wrapping_add(1), y: i.wrapping_mul(2) })) {
            added_g += 1;
        }
    }
    let mut replaced_g: i64 = 0;
    for (let i = 0; i < gn; i += 1) {
        if (g.put(key(i as i64), Pt { x: i.wrapping_add(3), y: i.wrapping_mul(2) }) == false) {
            replaced_g += 1;
        }
    }
    let mut hits_g: i64 = 0;
    let mut sum_g: i64 = 0;
    for (let i = 0; i < gn; i += 1) {
        let p = g.get(key(i as i64));
        if (p != nil) {
            hits_g += 1;
            sum_g = sum_g.wrapping_add(p.y as i64);
        }
    }

    // (5) removal churn on m — remove the evens, re-scan, re-add under
    // fresh cells (tombstones; no growth — cap already 2^18)
    let mut removed: i64 = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.remove(key(i as i64))) {
            removed += 1;
        }
    }
    let mut present: i64 = 0;
    for (let i = 0; i < n; i += 1) {
        if (m.has(key(i as i64))) {
            present += 1;
        }
    }
    let mut added2: i64 = 0;
    for (let i = 0; i < n; i += 2) {
        if (m.put(key(i as i64), Pt { x: i.wrapping_mul(3), y: i })) {
            added2 += 1;
        }
    }

    // the checksum — refvals' distinct prime weights, i64 throughout,
    // exact in doubles (the twin gate)
    let mut c: i64 = sum_before;
    c = c.wrapping_add(hits.wrapping_mul(13));
    c = c.wrapping_add(misses.wrapping_mul(17));
    c = c.wrapping_add(replaced.wrapping_mul(11));
    c = c.wrapping_add(added.wrapping_mul(7));
    c = c.wrapping_add(rmw.wrapping_mul(19));
    c = c.wrapping_add(sum_after.wrapping_mul(2));
    c = c.wrapping_add(hits2.wrapping_mul(23));
    c = c.wrapping_add(added_g.wrapping_mul(29));
    c = c.wrapping_add(replaced_g.wrapping_mul(31));
    c = c.wrapping_add(hits_g.wrapping_mul(37));
    c = c.wrapping_add(sum_g.wrapping_mul(3));
    c = c.wrapping_add(removed.wrapping_mul(41));
    c = c.wrapping_add(present.wrapping_mul(43));
    c = c.wrapping_add(added2.wrapping_mul(47));
    c = c.wrapping_add((m.len() as i64).wrapping_mul(53));
    c = c.wrapping_add((g.len() as i64).wrapping_mul(59));
    return c;
}

pub fn main() -> nil {
    let c = churn(100000, 200000);
    Logger.new("app").info(f"CHECKSUM {c}");
}
