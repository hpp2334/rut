use ink::{ Logger };

use nmapset::{ HashMap };

// kmer-view — the strings-round1 phase-2 row: the identical k-mer
// counting as nmap-knucleotide (same LCG sequence, same 12-mer fill +
// fragment probes + 1-/2-mer maps, same checksum formula), keyed
// through the RANGE methods instead of slice-then-put: every k-mer
// crosses as the borrowed `(seq, i, k)` byte window over the parent
// (the sv lanes) and no key cell is ever minted — the twin's ~600k
// slice views are gone, each hot op is one direct crossing. Same keys
// (FNV-1a over the same octets), same values, same formula, so the
// checksum MUST equal the pinned 2198604. The .js twin
// (../kmer-view.js) is nmap-knucleotide.js's materialized computation
// UNCHANGED — the parity IS the gate. Scale: seq = 200000 letters.

fn lcg_seq(n: i32) -> str {
    let letters = "ACGT";
    let mut x: u32 = 42;
    let mut seq = "";
    for (let i = 0; i < n; i += 1) {
        x = x.wrapping_mul(1103515245).wrapping_add(12345);
        let idx = ((x >> 16) % 4) as i32;
        seq = f"{seq}{letters[idx]}";
    }
    return seq;
}

// get-or-insert one k-mer count — the twin's op stream with the slice
// deleted: the key is the (seq, i, 12) window itself, so a miss hashes
// the range twice (get + put), a hit three times (put re-probes), and
// neither ever mints a key cell.
fn count12(m: HashMap<str, i32>, seq: str, n: i32) -> i32 {
    for (let i = 0; i < n - 11; i += 1) {
        let p = m.get_range(seq, i, 12);
        if (p != nil) {
            m.put_range(seq, i, 12, p + 1);
        } else {
            m.put_range(seq, i, 12, 1);
        }
    }
    // 100 generated fragment probes — positions stride the sequence
    let mut frag_sum = 0;
    for (let j = 0; j < 100; j += 1) {
        let pos = (j * 2497) % (n - 12);
        let p = m.get_range(seq, pos, 12);
        if (p != nil) {
            frag_sum = frag_sum.wrapping_add(p);
        }
    }
    return frag_sum;
}

fn main_checksum(n: i32) -> i32 {
    let seq = lcg_seq(n);
    let mut m: HashMap<str, i32> = HashMap.new();
    let frag_sum = count12(m, seq, n);
    // 1-mers: four keys, total n
    let mut m1: HashMap<str, i32> = HashMap.new();
    for (let i = 0; i < n; i += 1) {
        let p = m1.get_range(seq, i, 1);
        if (p != nil) {
            m1.put_range(seq, i, 1, p + 1);
        } else {
            m1.put_range(seq, i, 1, 1);
        }
    }
    // 2-mers: sixteen keys, total n - 1
    let mut m2: HashMap<str, i32> = HashMap.new();
    for (let i = 0; i < n - 1; i += 1) {
        let p = m2.get_range(seq, i, 2);
        if (p != nil) {
            m2.put_range(seq, i, 2, p + 1);
        } else {
            m2.put_range(seq, i, 2, 1);
        }
    }
    // the readout — the twin's exact tail: four 1-mer and sixteen
    // built 2-mer lookups over the small maps (only 20 cold ops)
    let letters = "ACGT";
    let mut sum1 = 0;
    let mut sum2 = 0;
    for (let a = 0; a < 4; a += 1) {
        let ca = letters.slice(a, a + 1);
        let p = m1.get(ca);
        if (p != nil) {
            sum1 += p;
        }
        for (let b = 0; b < 4; b += 1) {
            let cb = letters.slice(b, b + 1);
            let q = m2.get(f"{ca}{cb}");
            if (q != nil) {
                sum2 += q;
            }
        }
    }
    let mut c = m.len();
    c = c.wrapping_add(frag_sum);
    c = c.wrapping_add(sum1.wrapping_mul(2));
    c = c.wrapping_add(sum2.wrapping_mul(3));
    c = c.wrapping_add((n - 11).wrapping_mul(5));
    return c;
}

pub fn main() -> nil {
    Logger.new("app").info(f"CHECKSUM {main_checksum(200000)}");
}
