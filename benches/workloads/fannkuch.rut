import { Vec } from "std:collection";
// fannkuch-redux — pancake flips over all permutations. Scale: n = 7.
// Canonical checksum: sum over all n! permutations of (+/- flips), sign
// toggling every permutation (benchmarks-game definition). The value is
// folded with max-flips: checksum * 1000 + max_flips (exact i32).
// n=7 canonical: checksum 228, max_flips 16.

fn fannkuch(n: i32) -> i32 {
    let mut perm = Vec<i32>.zeroed(n);
    let mut perm1 = Vec<i32>.zeroed(n);
    let mut count = Vec<i32>.zeroed(n);
    for (let i = 0; i < n; i += 1) {
        perm1[i] = i;
    }
    let mut max_flips = 0;
    let mut checksum = 0;
    let mut perm_count = 0;
    let mut r = n;
    let mut done = false;
    while (!done) {
        while (r != 1) {
            count[r - 1] = r;
            r -= 1;
        }
        for (let i = 0; i < n; i += 1) {
            perm[i] = perm1[i];
        }
        let mut flips = 0;
        while (perm[0] != 0) {
            let k = perm[0] + 1;
            let mut i = 0;
            let mut j = k - 1;
            while (i < j) {
                let t = perm[i];
                perm[i] = perm[j];
                perm[j] = t;
                i += 1;
                j -= 1;
            }
            flips += 1;
        }
        if (flips > max_flips) {
            max_flips = flips;
        }
        if (perm_count % 2 == 0) {
            checksum += flips;
        } else {
            checksum -= flips;
        }
        while (r != n) {
            let first = perm1[0];
            for (let i = 0; i < r; i += 1) {
                perm1[i] = perm1[i + 1];
            }
            perm1[r] = first;
            count[r] -= 1;
            if (count[r] > 0) {
                break;
            }
            r += 1;
        }
        perm_count += 1;
        if (r == n) {
            done = true;
        }
    }
    return checksum * 1000 + max_flips;
}

pub fn main() -> unit {
    print(f"CHECKSUM {fannkuch(7)}");
}
