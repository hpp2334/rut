// calc/mod.rut — the float math lib's shell: the surface itself lives
// one module down, in `math.rut` (`pub mod math;`). Callers bind the
// module and reach the members qualified —
//
//     use calc::{ math };
//     math::sqrt(2.0f64)
//     math::PI
//
// — or spell the path fully qualified off the pkg name
// (`calc::math::sqrt(x)`, no use). The constants are `calc_host`'s
// SURFACE LETS, re-exported through `math` by its
// `pub use calc_host::{ PI, .. }` (callers never touch `calc_host`).
// The INTEGER numeric methods (`wrapping_*`, `saturating_*`,
// `checked_*`) are core's `builtin impl` methods; `NAN` is core's too
// (`use core::{ NAN }`).

pub mod math;
