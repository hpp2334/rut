{
  // calc/ — the float math surface as a NORMAL lib: every member is a
  // closed-union generic (`sqrt<T requires f32 | f64>`) — the width
  // falls out of the argument, no suffix to spell. The body is the
  // `is` dispatch: `x is f32` folds per member (generic bodies compile
  // per instantiation) and the if's dead-arm pruning drops the other
  // row's call, so each member's body is ONE host call into
  // `calc_host` (whose rows carry the width in their internal names).
  // The closed union is what makes the delivery finite: the pack
  // enumerates every member as a pack-time ledger instantiation, so a
  // consumer's `sqrt<f32>` request is served from the ledger — no
  // template row, no placeholder compile.
  //
  // The CONSTANTS keep the qualified `Math::` head on the host pkg:
  // `use calc_host::{ Math }` then `Math::PI`. The INTEGER numeric
  // methods (`wrapping_*`, `saturating_*`, `checked_*`) are core's
  // `builtin impl` methods; `NAN` is core's too (`use core::{NAN}`).
  "format": "rutbundle",
  "format_version": 12,
  "name": "calc",
  "deps": {
    "calc_host": {
      "path": "../calc_host"
    }
  }
}
