// calc/calc.d.rut — `calc`, the `Math` namespace (RFC 0028): the float
// members are host functions (f64, bodies in `rut-std`). No `host
// class` namespace fiction: these are the module's own functions,
// reached qualified —
//
//   use calc::{ Math };
//   let d = Math.sqrt(x * x + y * y);
//   let a = Math.abs(x);
//
// The INTEGER numeric methods (`wrapping_*`, `saturating_*`,
// `checked_*`) moved to core — `builtin impl` methods on the
// primitives, ambient at the method call (`x.wrapping_add(y)`,
// std/core.d.rut, RFC 0032 §1.1 R2). `NAN` is core's too
// (`use core::{NAN}`).
//
// Constants (f64, compiler-materialized — the surface grammar has no
// `static` field form):
//   Math.PI  Math.TAU  Math.E  Math.SQRT_2  Math.LN_2  Math.LN_10
//   Math.LOG2_E  Math.LOG10_E  Math.INFINITY  Math.NEG_INFINITY
//   Math.EPSILON  Math.MAX  Math.MIN  Math.MIN_POSITIVE
//
// Contract (std/core.d.rut): the surface is kept TRUE to the
// implementation — signatures match the mount tables, never aspirational.

// ---- f64 host functions (the embedding Rust implements them) ----

pub host fn sqrt(x: f64) -> f64;
pub host fn floor(x: f64) -> f64;
pub host fn ceil(x: f64) -> f64;
pub host fn round(x: f64) -> f64;
pub host fn trunc(x: f64) -> f64;
pub host fn exp(x: f64) -> f64;
pub host fn ln(x: f64) -> f64;
pub host fn log2(x: f64) -> f64;
pub host fn log10(x: f64) -> f64;
pub host fn sin(x: f64) -> f64;
pub host fn cos(x: f64) -> f64;
pub host fn tan(x: f64) -> f64;
pub host fn asin(x: f64) -> f64;
pub host fn acos(x: f64) -> f64;
pub host fn atan(x: f64) -> f64;
pub host fn sinh(x: f64) -> f64;
pub host fn cosh(x: f64) -> f64;
pub host fn tanh(x: f64) -> f64;
pub host fn pow(x: f64, y: f64) -> f64;
pub host fn atan2(y: f64, x: f64) -> f64;
pub host fn hypot(x: f64, y: f64) -> f64;
pub host fn copysign(x: f64, y: f64) -> f64;
pub host fn fma(x: f64, y: f64, z: f64) -> f64;

// ---- float helpers (ordinary host fns; the int forms are core's
// `builtin impl` methods) ----

pub host fn abs(x: f64) -> f64;
pub host fn min(x: f64, y: f64) -> f64;
pub host fn max(x: f64, y: f64) -> f64;
pub host fn signum(x: f64) -> f64;
