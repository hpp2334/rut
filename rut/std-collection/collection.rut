// std:collection — the collection module's body (rut source, RFC 0028).
//
// Hashable: hashing and key comparison are ONE contract. The containers
// (`Map<K requires Hashable, V>`, `Set<T>`) land with their RFCs.
//
// `Vec<T>` is implemented here (not as a VM native — RFC 0005/0028): a
// rut class over the runtime buffer primitive, with `len`/`push`/`pop`/
// `from` written in rut. Lands with the module loader (M2).

pub trait Hashable {
    fn hash(self) -> u64;
    fn eq(self, other: Self) -> bool;
}
