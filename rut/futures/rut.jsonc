{
  // futures/ — the standard launcher surface, in rut: the
  // typed half of the embedder's async set. Publishes COMPILED (the
  // linkable-classes phase): the generic `launch_future<T>` and the
  // generic handle class link like any other export — a consumer
  // instantiates and requests the bodies from this pkg (owner-anchored
  // generics), and `LaunchedFutureHandle::abort` crosses on the surface's
  // inherent rows.
  //
  // The laws the types encode:
  // `Future<T>` — cold, yours to hold: await it or launch it (launch
  // consumes like await consumes; nothing frees you from one).
  // `LaunchedFutureHandle<T>` — the receipt: NOT a Future (await
  // diagnoses), not re-launchable (the argument type mismatches —
  // ruling 6's compile-time law), one member: `abort`.
  // `select2`/`select_all` — the structured-competition surface: the
  // engine mints the race, library law cancels the losers.
  // `completer<T>()` — the manually-resolvable future primitive: the
  // mint plus the resolution RIGHT (`Completer<T>`).
  "format": "rutbundle",
  "format_version": 9,
  "name": "futures",
  "entry": {
    "lib": "./futures.rut"
  },
  "deps": {
    "async_host": {
      "path": "../async_host"
    }
  }
}
