// --------------------------------------------------------------
// the nmapset integration group (the wrapper family over the maps):
// appended to json's own source by the peer gate when `nmapset` is in
// the program's closure.
//
// THE WRAPPER LAW, AS LANDED — the map/set families are one wrapper
// per KEY SHAPE (`JMapStr`, `JMapI64`, `JMapBool`, `JMapU64`,
// `JMapBytes`) plus `JSet<T>`: the KEY is a primitive, and primitives
// carry no members, so the key-text parse cannot dispatch through the
// type — it is baked into the wrapper. The key law (the survey §2.6's
// prim-key policy): `str` verbatim, integers decimal, `bool`
// true/false; an unparsable key text is WrongType naming the text;
// duplicates that normalize together ("01" and "1") are LAST WINS —
// nmapset's `put` semantics. (`f64` keys have no row: the union bound
// never admitted them — floats have no stable equality contract — so
// there was never a shape to wrap.) `bytes` keys have no JSON
// spelling: the wrapper exists so the LAW is testable — every decode
// answers WrongType with the disclosure in `expected`.
//
// The value lane is V's OWN `decode` dispatch, per instantiation: the
// scalar values ride json's wrapper shapes (`JsonI64`, `JsonU64`,
// …) — a bare primitive value cannot satisfy the bound, so
// `JMapStr<JsonU64>` is the u64-valued spelling, `to_map()` answers
// `HashMap<str, JsonU64>`, and each entry reads through its own
// `get()`.
//
// THE ENCODE HALF IS NOT LANDED — disclosed, not dropped silently:
// json can encode a map only by WALKING it, and nmapset ships no
// iteration surface (`keys`/`values`/`iter`). An nmapset iteration
// surface is the recorded menu item, and the encode wrappers land
// with it. The decode half is functional.

use core::{opaque}; // the spliced nmapset source's field type — `t: opaque` — must be in this unit's scope
use nmapset::{HashMap, HashSet};

// ---- the key-text folds (§2.6), one private fn per key shape ------

// §2.6's key-text law is LENIENT where JSON values are strict: `"01"`
// and `"1"` normalize together (last wins), so the fold skips no
// grammar and accepts leading zeros — only the width bound is
// enforced (pre-checked, never wraps)
fn key_i64(t: str) -> ?i64 {
    let n = t.len();
    if (n == 0) { return nil; }
    let mut i: i32 = 0;
    let mut neg = false;
    let first = t.slice(0, 1).code() as i32;
    if (first == 0x2D) {
        neg = true;
        i = 1;
        if (n == 1) { return nil; }
    }
    let mut acc: i64 = 0;
    while (i < n) {
        let c = t.slice(i, i + 1).code() as i32;
        if (c < 0x30 || c > 0x39) { return nil; }
        if (acc < -922337203685477580i64) { return nil; }
        acc = acc * 10;
        if (acc < -9223372036854775807i64 - 1i64 + (c - 0x30) as i64) { return nil; }
        acc = acc - (c - 0x30) as i64;
        i += 1;
    }
    if (!neg && acc == -9223372036854775807i64 - 1i64) { return nil; }
    if (neg) { return acc; }
    return -acc;
}

// the u64 key fold — the base's gnu64 (the same law)
fn key_u64(t: str) -> ?u64 {
    return gnu64(t);
}

fn key_bool(t: str) -> ?bool {
    if (t == "true") { return true; }
    if (t == "false") { return false; }
    return nil;
}

// the WrongType mint for an unparsable key text (the failure law:
// the text names itself; `at` rides the reader's position)
fn map_err(at: i64, kt: str, want: str) -> DecodeJsonError {
    return DecodeJsonError {
        kind: DecodeErrorKind.WrongType,
        at: at,
        got: kt,
        expected: want,
    };
}

// ---- the family ----------------------------------------------------

pub class JMapStr<V requires JsonDeserialize>(HashMap<str, V>);

impl<V> JMapStr<V> {
    pub fn decode(mut r: JsonReader) -> (?Self, ?DecodeJsonError) {
        let mut m = HashMap<str, V>.new();
        r.begin_object();
        while (r.more()) {
            let kt = r.next_key();
            if (r.failed()) { return (nil, r.error()); }
            // verbatim (escaped by the reader's string law already)
            let kk: str = kt;
            let (v, e) = V.decode(r);
            if (e != nil) { return (nil, e); }
            let _ = m.put(kk, v);
        }
        r.end_object();
        if (r.failed()) { return (nil, r.error()); }
        return (JMapStr(m), nil);
    }
    pub fn to_map(self) -> HashMap<str, V> { return self.inner; }
}

pub class JMapI64<V requires JsonDeserialize>(HashMap<i64, V>);

impl<V> JMapI64<V> {
    pub fn decode(mut r: JsonReader) -> (?Self, ?DecodeJsonError) {
        let mut m = HashMap<i64, V>.new();
        r.begin_object();
        while (r.more()) {
            let kt = r.next_key();
            if (r.failed()) { return (nil, r.error()); }
            let k = key_i64(kt);
            if (k == nil) { return (nil, map_err(r.here() as i64, kt, "a key this map's key type can parse")); }
            let kk: i64 = k;
            let (v, e) = V.decode(r);
            if (e != nil) { return (nil, e); }
            let _ = m.put(kk, v);
        }
        r.end_object();
        if (r.failed()) { return (nil, r.error()); }
        return (JMapI64(m), nil);
    }
    pub fn to_map(self) -> HashMap<i64, V> { return self.inner; }
}

pub class JMapBool<V requires JsonDeserialize>(HashMap<bool, V>);

impl<V> JMapBool<V> {
    pub fn decode(mut r: JsonReader) -> (?Self, ?DecodeJsonError) {
        let mut m = HashMap<bool, V>.new();
        r.begin_object();
        while (r.more()) {
            let kt = r.next_key();
            if (r.failed()) { return (nil, r.error()); }
            let k = key_bool(kt);
            if (k == nil) { return (nil, map_err(r.here() as i64, kt, "a key this map's key type can parse")); }
            let kk: bool = k;
            let (v, e) = V.decode(r);
            if (e != nil) { return (nil, e); }
            let _ = m.put(kk, v);
        }
        r.end_object();
        if (r.failed()) { return (nil, r.error()); }
        return (JMapBool(m), nil);
    }
    pub fn to_map(self) -> HashMap<bool, V> { return self.inner; }
}

pub class JMapU64<V requires JsonDeserialize>(HashMap<u64, V>);

impl<V> JMapU64<V> {
    pub fn decode(mut r: JsonReader) -> (?Self, ?DecodeJsonError) {
        let mut m = HashMap<u64, V>.new();
        r.begin_object();
        while (r.more()) {
            let kt = r.next_key();
            if (r.failed()) { return (nil, r.error()); }
            let k = key_u64(kt);
            if (k == nil) { return (nil, map_err(r.here() as i64, kt, "a key this map's key type can parse")); }
            let kk: u64 = k;
            let (v, e) = V.decode(r);
            if (e != nil) { return (nil, e); }
            let _ = m.put(kk, v);
        }
        r.end_object();
        if (r.failed()) { return (nil, r.error()); }
        return (JMapU64(m), nil);
    }
    pub fn to_map(self) -> HashMap<u64, V> { return self.inner; }
}

pub class JMapBytes<V requires JsonDeserialize>(HashMap<bytes, V>);

impl<V> JMapBytes<V> {
    pub fn decode(mut r: JsonReader) -> (?Self, ?DecodeJsonError) {
        r.begin_object();
        let kt = r.next_key();
        if (r.failed()) { return (nil, r.error()); }
        return (nil, map_err(r.here() as i64, kt, "a key type JSON can spell (bytes keys have no JSON spelling)"));
    }
    pub fn to_map(self) -> HashMap<bytes, V> { return self.inner; }
}

pub class JSet<T requires JsonDeserialize>(HashSet<T>);

impl<T> JSet<T> {
    pub fn decode(mut r: JsonReader) -> (?Self, ?DecodeJsonError) {
        let mut s = HashSet<T>.new();
        r.begin_array();
        while (r.more()) {
            let (x, e) = T.decode(r);
            if (e != nil) { return (nil, e); }
            let _ = s.put(x);
        }
        r.end_array();
        if (r.failed()) { return (nil, r.error()); }
        return (JSet(s), nil);
    }
    pub fn to_set(self) -> HashSet<T> { return self.inner; }
}
