{
  // json — the 9th std pkg (the rut-json batch, phase 1). The base owns
  // every public name (interfaces, reader/writer classes, entries,
  // errors, the scalar/optional/array wrapper families).
  //
  // Publishes COMPILED (the linkable-classes phase): the entries are
  // GENERIC FUNCTIONS, and instantiation is owner-anchored — a consumer
  // requests `decodeJson<i64>` from this pkg, whose unit compiles the
  // monomorphized body (the surface exports names + signatures; the
  // ledger carries the instantiations), so the container rows travel
  // inside json's binary.
  //
  // The wrapper families over the containers (`JsonVec`, `JMap*`,
  // `JSet` — the old `[peer-deps]` group files) are json's OWN source
  // now: they folded into `mod.rut`, and `pouch` / `nmapset` are plain
  // deps. No presence gating, no light mount: every consumer gets the
  // whole surface, and the packed bundle is CLOSED — its `deps/`
  // carries the strbuild + pouch + nmapset groups under identity dirs
  // (the v11 wire), so the wrappers' `use` heads resolve wherever json
  // travels.
  "format": "rutbundle",
  "format_version": 12,
  "name": "json",
  "deps": {
    "strbuild": {
      "path": "../strbuild"
    },
    "pouch": {
      "path": "../pouch"
    },
    "nmapset": {
      "path": "../nmapset"
    }
  }
}
