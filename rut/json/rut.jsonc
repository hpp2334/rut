{
  // json — the 9th std pkg (the rut-json batch, phase 1). The base owns
  // every public name (interfaces, reader/writer classes, entries,
  // errors, the scalar/optional/array wrapper families).
  //
  // Publishes COMPILED (the linkable-classes phase): the entries are
  // GENERIC FUNCTIONS, and instantiation is owner-anchored — a consumer
  // requests `decodeJson<i64>` from this pkg, whose unit compiles the
  // monomorphized body (the surface exports names + signatures; the
  // ledger carries the instantiations), so the container rows travel
  // inside json's binary.
  //
  // The old `[peer-deps]` wrapper groups (JsonVec, JMap*, JSet) retired
  // with the key: the grammar carries `deps` + `dev-deps` only now, and
  // presence-gated group mounting is gone. The dev-deps keep json's own
  // build closure intact.
  "format": "rutbundle",
  "format_version": 10,
  "name": "json",
    "deps": {
    "strbuild": {
      "path": "../strbuild"
    }
  },
  "dev-deps": {
    "pouch": {
      "path": "../pouch"
    },
    "nmapset": {
      "path": "../nmapset"
    }
  }
}
