// the pouch integration group (the wrapper family over pouch's `Vec`):
// appended to json's own source by the peer gate when `pouch` is in
// the program's closure; a consumer without pouch mounts json light
// and these names simply never exist (a reference then diagnoses D2).
//
// THE WRAPPER LAW (the structural-interfaces fork): `Vec` is pouch's
// class, and satisfaction is having the members on the type's own
// inherent impl — json cannot grow members on another module's class,
// and a bare container never derives. The wrapper is the spelled
// manufacture: `encodeJson(JsonVec(rows))` at the entry,
// `decodeJson<JsonVec<DocRow>>(doc)` at the sink, `to_vec()` unwraps.

use pouch::{Vec};

// The survey §2.6 matrix rows, wrapped: `Vec<T>` encodes an array,
// decodes an array — elements through T's own members, per
// instantiation (the template law: this body monomorphizes per
// `JsonVec<..>` shape, so `x.encode(w)` / `T.decode(r)` bind the
// concrete members — nested `JsonVec<JsonVec<i64>>` closes
// recursively). The bound is the ENCODE direction; the decode member
// delegates to `T.decode` per instantiation (a decode-only T spells
// its array shape through `JsonArr`, the base's pouch-free row).
pub class JsonVec<T requires JsonSerialize | JsonDeserialize>(Vec<T>);

impl<T> JsonVec<T> {
    pub fn encode(self, mut w: JsonWriter) -> ?EncodeJsonError {
        w.begin_array();
        for (let x of self.inner) {
            let e = x.encode(w);
            if (e != nil) { return e; }
        }
        w.end_array();
        return nil;
    }

    pub fn decode(mut r: JsonReader) -> (?Self, ?DecodeJsonError) {
        let mut v = Vec<T>.new();
        r.begin_array();
        while (r.more()) {
            let (x, e) = T.decode(r);
            if (e != nil) { return (nil, e); }
            v.push(x);
        }
        r.end_array();
        if (r.failed()) { return (nil, r.error()); }
        return (JsonVec(v), nil);
    }

    // the unwrap: the materialized Vec
    pub fn to_vec(self) -> Vec<T> { return self.inner; }
}
