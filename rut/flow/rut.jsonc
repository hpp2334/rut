{
  // flow — the push-pipeline package: `Flow<E>` chains, the
  // `IntoFlow`/`FromFlow` entry/sink interfaces. The base owns every
  // public name (the class, the interfaces, the builtin structural
  // adapters) and is pouch-free by law; the optional peers carry the
  // wrapper groups exactly like json's do: a consumer whose closure
  // holds `pouch` gets the VecFlow family, one that holds `nmapset`
  // the SetFlow sink. The dev-deps guarantee both while flow builds
  // itself, so every adapter compiles in flow's own test runs.
  //
  // Publishes COMPILED (the linkable-classes phase), mirroring json's
  // manifest shape; the generic-source riding law carries the class
  // sources beside the binary, so a consumer's `Flow<i32>` compiles at
  // the consumer's link.
  "format": "rutbundle",
  "format_version": 9,
  "name": "flow",
  "entry": {
    "lib": "./flow.rut"
  },
  "deps": {},
  "peer-deps": {
    "pouch": {
      "path": "../pouch",
      "optional": true,
      "lib": "./group-pouch.rut"
    },
    "nmapset": {
      "path": "../nmapset",
      "optional": true,
      "lib": "./group-nmapset.rut"
    }
  },
  "dev-deps": {
    "pouch": {
      "path": "../pouch"
    },
    "nmapset": {
      "path": "../nmapset"
    }
  }
}
