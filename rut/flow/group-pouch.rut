// flow/group-pouch.rut — the pouch-dependent flow group: the Vec
// wrapper family, mounted only when `pouch` is anywhere in the
// consumer's closure. Appended to flow's own source by the peer gate
// when `pouch` is in the program's closure; a consumer without pouch
// mounts flow light and these names simply never exist.
//
// THE WRAPPER LAW (the structural-interfaces fork): `Vec` is pouch's
// class, and satisfaction is having the members on the type's own
// inherent impl — flow cannot grow members on another module's class.
// The adapters are the spelled manufacture: `VecFlow(xs).into_flow()`
// at the entry, `VecFlow<T>.from_flow(pipe)` at the sink (the call
// site spells it; nothing is auto-inserted).

use pouch::{ Vec };

// The entry AND the sink: a growable Vec walks its backing through the
// fused loop (the same walk `for..of` fuses), the emit's `false`
// stopping it; `from_flow` materializes the pipeline into a fresh Vec
// and wraps it, `collected` unwraps.
pub class VecFlow<T>(Vec<T>);

impl<T> VecFlow<T> {
    pub fn into_flow(self) -> Flow<T> {
        return
            Flow.new(
                fn (emit: fn(T) -> bool) -> nil {
                    for (let x of self.inner) {
                        if (!emit(x)) {
                            return;
                        }
                    }
                },
            );
    }

    // the sink (the FromFlow member): the EXPLICIT pipeline — the
    // call site manufactures the wrapper (`VecFlow<T>.from_flow(it)`).
    // No new type variables (T is the class's own), so no
    // generic-method support is needed here.
    pub fn from_flow(it: Flow<T>) -> Self {
        let out: Vec<T> = Vec.new();
        it.iterate(fn (x: T) -> bool { out.push(x); return true; });
        return VecFlow(out);
    }

    // the wrapper's unwrap: the materialized Vec
    pub fn collected(self) -> Vec<T> { return self.inner; }
}
