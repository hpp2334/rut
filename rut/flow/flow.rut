// flow/flow.rut — the push pipeline: `Flow<E>` is a chainable wrapper
// over THE push contract. Rut's iteration is push-style, one schema: a
// type is iterable when an inherent impl marks a member `[iterable]`
// and a `for..of` calls that ONE designated member (`emit` answering
// `false` stops); a Flow is the same drive
// wrapped in adapters — every stage wraps `drive` in one new closure
// (a closure per STAGE, never per element). Pipelines are the clarity
// tier: the fused builtin loops stay the perf tier.
//
// The base is pouch-free by law (json.rut's base shape): the entry
// adapters for the builtin structural targets (`[T]`, `str`, `bytes`)
// compile here, while the Vec family lives in group-pouch.rut and the
// set sink in group-nmapset.rut, the peer-gated integration groups.

// The entry interface: a source becomes a pipeline. A type satisfies
// it STRUCTURALLY — by having `into_flow` on its own inherent impl —
// so `Flow` itself carries the identity member, and the builtin
// structural targets (which can carry no members) enter through the
// spelled adapters (`ArrFlow(xs).into_flow()`). Generic
// `X requires IntoFlow<E>` code accepts chains and adapters alike.
pub interface IntoFlow<E> {
    fn into_flow(self) -> Flow<E>;
}

// The sink interface: a pipeline materializes into the implementing
// type — the member is a no-self static (`fn from_flow(it: Flow<E>)
// -> Self`), and the adapters are the only shapes that can carry it
// (the sink targets are foreign classes). The call site spells it:
// `VecFlow<T>.from_flow(pipe)`, `collected()` unwraps — wrappers are
// explicit manufacture; nothing is auto-inserted.
pub interface FromFlow<E> {
    fn from_flow(it: Flow<E>) -> Self;
}

// The pipeline class: one field, the drive. A `Flow` is as reusable as
// its source allows — stateful stages (`take`, `skip`) hold their
// counter in a record the drive closure mutates, so a drained stage
// stays drained (one drive per chain end).
pub class Flow<E> {
    drive: fn(fn(E) -> bool) -> nil;
}

impl<E> Flow<E> {
    // Wrap a raw push fn: the escape hatch for hand-written sources.
    pub fn new(d: fn(fn(E) -> bool) -> nil) -> Self {
        return Flow { drive: d };
    }

    // Keep the elements the predicate admits.
    pub fn filter(self, p: fn(E) -> bool) -> Self {
        return
            Flow.new(
                fn (emit: fn(E) -> bool) -> nil {
                    (self.drive)(
                        fn (x: E) -> bool {
                            if (p(x)) {
                                return emit(x);
                            }
                            return true;
                        },
                    );
                },
            );
    }

    // The first `n` elements — then stop the source (`emit` answering
    // `false` is the push contract's stop). The counter is a one-field
    // record mutated through the captured handle: a primitive counter
    // would copy per emit call and never move.
    pub fn take(self, n: i32) -> Self {
        let mut st: TakeState = TakeState { n: n };
        return
            Flow.new(
                fn (emit: fn(E) -> bool) -> nil {
                    (self.drive)(
                        fn (x: E) -> bool {
                            if (st.n <= 0) {
                                return false;
                            }
                            st.n -= 1;
                            return emit(x);
                        },
                    );
                },
            );
    }

    // Drop the first `n` elements; pass the rest through.
    pub fn skip(self, n: i32) -> Self {
        let mut st: TakeState = TakeState { n: n };
        return
            Flow.new(
                fn (emit: fn(E) -> bool) -> nil {
                    (self.drive)(
                        fn (x: E) -> bool {
                            if (st.n > 0) {
                                st.n -= 1;
                                return true;
                            }
                            return emit(x);
                        },
                    );
                },
            );
    }

    // Run the source for its side effects.
    pub fn for_each(self, f: fn(E) -> nil) -> nil {
        (self.drive)(fn (x: E) -> bool { f(x); return true; });
    }

    // Count the elements: one drive, no per-element cost beyond the call.
    pub fn count(self) -> i32 {
        let mut total: CountState = CountState { n: 0 };
        (self.drive)(fn (x: E) -> bool { total.n += 1; return true; });
        return total.n;
    }

    // Left fold: `f(acc, x)` across one drive, the accumulator seeded.
    pub fn fold<R>(self, init: R, f: fn(R, E) -> R) -> R {
        let mut st: FoldState<R> = FoldState { acc: init };
        (self.drive)(fn (x: E) -> bool { st.acc = f(st.acc, x); return true; });
        return st.acc;
    }

    // Pair each element with its zero-based index.
    pub fn enumerate(self) -> Flow<(i32, E)> {
        let mut st: CountState = CountState { n: 0 };
        return
            Flow.new(
                fn (emit: fn((i32, E)) -> bool) -> nil {
                    (self.drive)(
                        fn (x: E) -> bool {
                            let pair: (i32, E) = (st.n, x);
                            st.n += 1;
                            return emit(pair);
                        },
                    );
                },
            );
    }

    // Transform each element — introduces a NEW type variable, so the
    // call either annotates its lambda or spells the type argument
    // (`.map<i32>(..)`); a fn path infers too.
    pub fn map<R>(self, f: fn(E) -> R) -> Flow<R> {
        return
            Flow.new(
                fn (emit: fn(R) -> bool) -> nil {
                    (self.drive)(fn (x: E) -> bool { return emit(f(x)); });
                },
            );
    }
}

// take/skip's one-field counters — records, so the drive closure's
// mutations land in shared storage (the capture law: primitives copy,
// records share their cell).
struct TakeState {
    n: i32;
}
struct CountState {
    n: i32;
}
struct FoldState<A> {
    acc: A;
}

// A Flow IS an iterable — the for..of weave reads the designated
// member. The marked member on the class's own inherent impl: the
// exact shape the for-of dispatch keys, `pub` so every consumer's
// loops (and the flow sinks) drive it. The element type E falls out
// of the marked member's own emit parameter.
impl<E> Flow<E> {
    [iterable] pub fn iterate(self, emit: fn(E) -> bool) {
        (self.drive)(emit);
    }
}

// ---- the satisfaction rows ----

// The identity member: a chain re-enters as a source, so generic
// `X requires IntoFlow<E>` code accepts pipelines unchanged. `Flow`'s
// own inherent impl carries it — the one registration-free row.
impl<E> Flow<E> {
    pub fn into_flow(self) -> Flow<E> {
        return self;
    }
}

// The builtin structural targets carry no members (primitives and
// composites never satisfy anything), so they enter through the
// spelled adapters — newtype classes whose inherent impls carry
// `into_flow`.

// The fixed array: a fused loop over the shared handle, the emit's
// `false` stopping the walk.
pub class ArrFlow<T>([T]);

impl<T> ArrFlow<T> {
    pub fn into_flow(self) -> Flow<T> {
        return
            Flow.new(
                fn (emit: fn(T) -> bool) -> nil {
                    for (let x of self.inner) {
                        if (!emit(x)) {
                            return;
                        }
                    }
                },
            );
    }
}

pub class StrFlow(str);

impl StrFlow {
    pub fn into_flow(self) -> Flow<str> {
        return
            Flow.new(
                fn (emit: fn(str) -> bool) -> nil {
                    for (let c of self.inner) {
                        if (!emit(c)) {
                            return;
                        }
                    }
                },
            );
    }
}

pub class BytesFlow(bytes);

impl BytesFlow {
    pub fn into_flow(self) -> Flow<u8> {
        return
            Flow.new(
                fn (emit: fn(u8) -> bool) -> nil {
                    for (let b of self.inner) {
                        if (!emit(b)) {
                            return;
                        }
                    }
                },
            );
    }
}
