// flow/group-nmapset.rut — the mapset sink group: HashSet materializes
// from any pipeline through the spelled wrapper. The KEY union bound
// (`K requires i8 | … | bytes`) already admits exactly the legal
// keys, so the put loop needs no extra admission.
//
// IntoFlow for mapset is DEFERRED, not skipped silently: it requires
// walking the host table, and nmapset ships no iteration surface —
// the exact gap json documents (its group-nmapset map-encode note).
// When that surface lands (a host walk + keys/entries), json's map
// encode and flow's IntoFlow grow together in one step.

use nmapset::{ HashSet };

// The sink wrapper (the FromFlow member): the call site spells
// `SetFlow<T>.from_flow(it)`, `items()` unwraps.
pub class SetFlow<T>(HashSet<T>);

impl<T> SetFlow<T> {
    pub fn from_flow(it: Flow<T>) -> Self {
        let out: HashSet<T> = HashSet.new();
        it.iterate(fn (x: T) -> bool { out.put(x); return true; });
        return SetFlow(out);
    }

    pub fn items(self) -> HashSet<T> { return self.inner; }
}
