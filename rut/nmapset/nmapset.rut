// nmapset/nmapset.rut — the native-key map/set EXPERIMENT (the
// mapset-host plan): generic wrapper classes over the `nmap` host
// table. The pure-rut `mapset` package stays untouched as the reference
// and the general-key implementation; this module is the host-backed
// twin, and its bench rows must checksum identically.
//
// DEVIATION (H3, engine-forced, recorded here instead of §0.3's
// `[deps] mapset`): the graph compiler splices a source dep's FULL
// source into its consumer's ONE compilation unit (`graph.rs`
// `Unit::Inline` — there is no namespaced splice; the mixed-module
// note at graph.rs:258 is deferred). `mapset.rut` declares `HashMap` /
// `HashSet`, so a `[deps] mapset` use splices those declarations into
// this pkg's unit and collides with THIS pkg's same-named classes
// ("duplicate type name `HashMap`"). `rut/mapset` stays untouched.
//
// DIVISION OF LABOR (plan §0.4/§0.5): the native table owns KEYS AND
// THEIR HASHES — the key crosses DIRECTLY on one of the typed lanes
// (15 `map_{entry,find,-remove}_{i,u,b,s,y}` crossings; no `opaque(..)`
// mint, no wrapper-side hashing), and the host computes the recorded
// hash with mapset's EXACT mix64/FNV-1a constants (bit-for-bit, pinned
// by rut-std's `hash_payload` unit tests). Values stay rut-side in a
// `[?V]` parallel array, preserving mapset's `get -> ?V`
// aliasing/nil semantics EXACTLY (no opaque values, no downcast, no
// fresh-cell drift). The key set is CLOSED, and it is now the VISIBLE,
// COMPILE-TIME-ENFORCED contract: the class bounds are a type union —
// `K requires i8 | ... | bytes` — so a user-defined key type fails at
// the instantiation with the union diagnostic (its escape hatches:
// encode the key canonically to `bytes`, or use `mapset`), NOT at the
// crossing. The host-side nmap.rs runtime trap stays as
// belt-and-braces.
//
// WRAPPER SHAPE: the private `KeyLane` trait carries the typed lanes
// (implemented only for the closed set, not exported — unimplementable
// by users), and every hot path is ONE crossing call: `put` = one
// `nentry` (plus, on the fused `i32::MIN` grow-first sentinel, one
// grow + vals-drain + retry); `get`/`has` = one `nfind`; `remove` =
// one `nremove`. No mint, no wrapper hashing, no per-put grow check.
//
// GROWTH: the native table rehashes its own keys from the recorded
// hashes; the wrapper relocates `vals` by draining the relocation
// iterator — `map_take_reloc` answers `(old << 32) | new` per moved
// slot until `-1` (drained). `HashSet` runs the same grow with no vals
// machinery at all — the undrained queue is cleared by the next grow
// and freed with the table (the host side's documented
// drain-after-every-grow law).
//
// ROUND3 PHASE 2 (the nmapset-round3 plan): the host table also owns
// VALUES now — a raw u64 column relocated with the keys inside the
// same grow walk. The `PrimMap*` classes below are its consumers:
// primitive-V maps with no `[?V]` sidecar and no drain pass. `HashMap`
// keeps the sidecar for REFERENCE `V` — cells stay cells, the
// `get -> ?V` aliasing law is untouched — and stays the general
// wrapper; the prim-val story ("users choose", the mapset/nmap
// precedent) is the three lane classes.

use nmap::{ map_new, map_grow, map_take_reloc, map_cap, map_len,
            map_entry_i, map_entry_u, map_entry_b, map_entry_s, map_entry_y,
            map_find_i, map_find_u, map_find_b, map_find_s, map_find_y,
            map_remove_i, map_remove_u, map_remove_b, map_remove_s, map_remove_y,
            map_val_set_u, map_val_get_u, map_val_set_f, map_val_get_f };

// ---- the private key lane (the typed crossings, phase 2) -----------

// One private trait per lane op: `nentry` (fused grow-first insert),
// `nfind` (lookup), `nremove` (tombstone). Implemented ONLY for the
// closed key set; it is not exported, so a user type cannot implement
// or reach it — the class bound's type union is the whole admission
// story, and these methods are just its hot path. Integer members
// widen/identity into the `i`/`u` lanes (sign-extension is the
// `KeyPayload::Bits` law; `-1i8` and `255u8` stay distinct bits on the
// two lanes), `bool` takes the `b` lane, `str`/`bytes` the `s`/`y`
// lanes — the host hashes with mapset's exact bits either way.
trait KeyLane {
    fn nentry(self, t: opaque) -> i32;
    fn nfind(self, t: opaque) -> i32;
    fn nremove(self, t: opaque) -> i32;
}

impl KeyLane for i8 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_i(t, self as i64); }
    fn nfind(self, t: opaque) -> i32 { return map_find_i(t, self as i64); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_i(t, self as i64); }
}

impl KeyLane for i16 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_i(t, self as i64); }
    fn nfind(self, t: opaque) -> i32 { return map_find_i(t, self as i64); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_i(t, self as i64); }
}

impl KeyLane for i32 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_i(t, self as i64); }
    fn nfind(self, t: opaque) -> i32 { return map_find_i(t, self as i64); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_i(t, self as i64); }
}

impl KeyLane for i64 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_i(t, self); }
    fn nfind(self, t: opaque) -> i32 { return map_find_i(t, self); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_i(t, self); }
}

impl KeyLane for u8 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_u(t, self as u64); }
    fn nfind(self, t: opaque) -> i32 { return map_find_u(t, self as u64); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_u(t, self as u64); }
}

impl KeyLane for u16 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_u(t, self as u64); }
    fn nfind(self, t: opaque) -> i32 { return map_find_u(t, self as u64); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_u(t, self as u64); }
}

impl KeyLane for u32 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_u(t, self as u64); }
    fn nfind(self, t: opaque) -> i32 { return map_find_u(t, self as u64); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_u(t, self as u64); }
}

impl KeyLane for u64 {
    fn nentry(self, t: opaque) -> i32 { return map_entry_u(t, self); }
    fn nfind(self, t: opaque) -> i32 { return map_find_u(t, self); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_u(t, self); }
}

impl KeyLane for bool {
    fn nentry(self, t: opaque) -> i32 { return map_entry_b(t, self); }
    fn nfind(self, t: opaque) -> i32 { return map_find_b(t, self); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_b(t, self); }
}

// `==` on `str`/`bytes` is CONTENT equality (RFC 0012 §4) — exactly the
// key equality a hash table means, and the host hashes the content
// byte-wise (FNV-1a 64). A user key type's escape hatch: encode it
// canonically to `bytes` and take this lane.
impl KeyLane for str {
    fn nentry(self, t: opaque) -> i32 { return map_entry_s(t, self); }
    fn nfind(self, t: opaque) -> i32 { return map_find_s(t, self); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_s(t, self); }
}

impl KeyLane for bytes {
    fn nentry(self, t: opaque) -> i32 { return map_entry_y(t, self); }
    fn nfind(self, t: opaque) -> i32 { return map_find_y(t, self); }
    fn nremove(self, t: opaque) -> i32 { return map_remove_y(t, self); }
}

// ---------------------------------------------------- the owners ----

// `HashMap<K, V>` — the host table behind one `opaque` handle plus the
// parallel value array. Admission is the union bound itself (RFC 0043
// §A5, phase 1): a key type outside the closed set fails AT COMPILE
// TIME, naming the offending type and the union (no `f32`/`f64` —
// float keys have no stable equality contract, as in mapset).
pub class HashMap<K requires i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes, V> {
    t: opaque;    // HostBoxed<NativeTable> — keys, recorded hashes, states
    vals: [?V];   // `[nil; cap]` — nil is the empty slot's zero
}

impl HashMap<K, V> {
    pub fn new() -> Self {
        return HashMap.with_capacity(8);
    }

    // `map_new` takes the requested capacity in the crossing (`i64`) and
    // rounds it to a power of two, never below 4 — read back through
    // `map_cap` to size `vals` in one construction.
    pub fn with_capacity(n: i32) -> Self {
        let t: opaque = map_new(n as i64);
        return Self { t: t, vals: [nil; map_cap(t)] };
    }

    // `put` — answers `true` when the key was newly added, `false` when
    // an existing key's value was replaced. ONE crossing call with the
    // grow check FUSED into it: `map_entry_*` answers `i32::MIN` only
    // when inserting would breach the load factor (a fresh insert is
    // `-(slot + 1) >= -2^30`, so the encoding is collision-free), and
    // the wrapper then grows (the native rehash plus the `vals`
    // relocation drain) and retries — mapset's grow-before-entry, but
    // paid only when the sentinel actually fires.
    pub fn put(mut self, k: K, v: V) -> bool {
        let mut at = k.nentry(self.t);
        while (at <= -2147483647) {
            let new_cap = map_grow(self.t);
            let mut next: [?V] = [nil; new_cap];
            while (true) {
                let packed = map_take_reloc(self.t);
                if (packed < 0) {
                    break;
                }
                let old = (packed >> 32) as i32;
                let new = (packed & 4294967295i64) as i32;
                next[new] = self.vals[old];
            }
            self.vals = next;
            at = k.nentry(self.t);
        }
        if (at >= 0) {
            self.vals[at] = v;
            return false;
        }
        let slot = -(at + 1);
        self.vals[slot] = v;
        return true;
    }

    // `get` — `nil` = absent (RFC 0005 §10). The stored cell comes back,
    // not a copy: two gets of one key name ONE cell until a replace
    // re-stores (the aliasing law the parity test pins).
    pub fn get(self, k: K) -> ?V {
        let at = k.nfind(self.t);
        if (at < 0) {
            return nil;
        }
        return self.vals[at];
    }

    pub fn has(self, k: K) -> bool {
        return k.nfind(self.t) >= 0;
    }

    // `remove` — the host tombstones the slot and answers the freed
    // index (or `-1`); the wrapper nils the value cell.
    pub fn remove(mut self, k: K) -> bool {
        let at = k.nremove(self.t);
        if (at < 0) {
            return false;
        }
        self.vals[at] = nil;
        return true;
    }

    pub fn len(self) -> i32 {
        return map_len(self.t);
    }
}

// `HashSet<T>` — the host table alone, zero value machinery: map_new /
// nentry / nfind / nremove / map_len only. The sentinel path needs no
// relocation drain (nothing rides the slots but the keys themselves).
pub class HashSet<T requires i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes> {
    t: opaque;
}

// ---- the prim-val maps (nmapset-round3, phase 2) ---------------------

// `PrimMapI64` / `PrimMapU64` / `PrimMapF64` — the phase-2 consumers of
// the host table's NATIVE val column: keys AND values both live Rust-
// side, so a hit-get is ONE cache line of probing and a put is one
// crossing plus the val store — the wrapper's `[?V]` sidecar, its
// relocation drain (the round3 phase-0 residual's dominant term), and
// its per-grow re-allocation are all GONE by construction (the host
// relocates vals with the keys inside the same re-slot walk; §0.3
// presence-by-key: a val is valid iff its key slot is FULL, so remove
// writes nothing and a get only reads a found slot).
//
// WHY THREE CLASSES, NOT ONE `PrimMap<K, V>`: the plan's single class
// assumed the V reinterpret is spellable client-side per instantiation.
// It is — for the SET direction, where a `v: V` value carries the lane
// dispatch exactly like a KeyLane key. The GET direction has no `V`
// value to dispatch through, and the language offers no other spelling:
// no-self trait methods have no call syntax on primitives (type names /
// type params are not expressions — `V.dec(raw)` / `i64.dec(raw)` both
// diagnose "unknown name"), there is no `as V` cast to a type param,
// and the union bound grants admission only, never per-member
// divergence (the phase-0c verdict). So the class splits over the val
// kind — the mapset/nmap precedent: users choose the lane — and each
// body spells its two concrete reinterprets (`as u64` / `as i64` raw
// wrap; f64 through the `map_val_set_f` / `map_val_get_f` crossings,
// `to_bits`/`from_bits` at the boundary, because rut has NO float
// bitcast: the numeric `as` is a value conversion, RFC 0007 §1).
//
// THE BOOL LANE IS DEFERRED, not dropped silently: `?bool` cannot serve
// the `get -> ?V` nil law in today's checker — a `?bool` value unboxes
// to `bool` at value reads, so `p == nil` / `p != nil` diagnose
// "operands must have equal width (RFC 0004 §3): `bool` vs `nil`"
// (verified: the same compares compile and run for `?i64` / `?u64` /
// `?f64` / `?str`). A bool-val map needs that checker fix first; today
// a bool val encodes as `0u64` / `1u64` in `PrimMapU64`.
//
// `get` keeps the get -> ?V law's prim semantics (round 2): a FRESH opt
// value per hit — prim vals are plain bits, so there is no cell to
// alias and no staleness beyond a held copy of the pre-replace value,
// exactly like today's `[?V]` sidecar of prim vals. Iteration order is
// unchanged by construction (the probe algorithm and slot assignment
// never moved — the phase-1 suite pins the relocation mapping), but
// neither this class nor `HashMap` ships an iteration surface, so the
// parity law holds where order is observable: identical slots, identical
// per-key answers, identical checksums.
pub class PrimMapI64<K requires i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes> {
    t: opaque;    // HostBoxed<NativeTable> — keys, recorded hashes, states, vals
}

impl PrimMapI64<K> {
    pub fn new() -> Self {
        return PrimMapI64.with_capacity(8);
    }

    pub fn with_capacity(n: i32) -> Self {
        return Self { t: map_new(n as i64) };
    }

    // `put` — `true` when the key was newly added. ONE lane call with
    // the grow check fused in, then grow + RETRY — no relocation drain,
    // the column moved with the keys inside `map_grow` — then the val
    // store at the answered slot.
    pub fn put(mut self, k: K, v: i64) -> bool {
        let mut at = k.nentry(self.t);
        while (at <= -2147483647) {
            map_grow(self.t);
            at = k.nentry(self.t);
        }
        if (at >= 0) {
            map_val_set_u(self.t, at, v as u64);
            return false;
        }
        map_val_set_u(self.t, -(at + 1), v as u64);
        return true;
    }

    // `get` — `nil` = absent (RFC 0005 §10); a hit mints a fresh opt
    // from the column's raw bits (`as i64` wrap, the i lane's inverse).
    pub fn get(self, k: K) -> ?i64 {
        let at = k.nfind(self.t);
        if (at < 0) {
            return nil;
        }
        return map_val_get_u(self.t, at) as i64;
    }

    pub fn has(self, k: K) -> bool {
        return k.nfind(self.t) >= 0;
    }

    // `remove` — the host tombstones the slot; presence-by-key means no
    // val write (the stale bits are unreachable, the slot's next put
    // stores a fresh val).
    pub fn remove(self, k: K) -> bool {
        return k.nremove(self.t) >= 0;
    }

    pub fn len(self) -> i32 {
        return map_len(self.t);
    }
}

pub class PrimMapU64<K requires i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes> {
    t: opaque;
}

impl PrimMapU64<K> {
    pub fn new() -> Self {
        return PrimMapU64.with_capacity(8);
    }

    pub fn with_capacity(n: i32) -> Self {
        return Self { t: map_new(n as i64) };
    }

    pub fn put(mut self, k: K, v: u64) -> bool {
        let mut at = k.nentry(self.t);
        while (at <= -2147483647) {
            map_grow(self.t);
            at = k.nentry(self.t);
        }
        if (at >= 0) {
            map_val_set_u(self.t, at, v);
            return false;
        }
        map_val_set_u(self.t, -(at + 1), v);
        return true;
    }

    // raw bits both directions — 2^63..2^64-1 ride untouched
    pub fn get(self, k: K) -> ?u64 {
        let at = k.nfind(self.t);
        if (at < 0) {
            return nil;
        }
        return map_val_get_u(self.t, at);
    }

    pub fn has(self, k: K) -> bool {
        return k.nfind(self.t) >= 0;
    }

    pub fn remove(self, k: K) -> bool {
        return k.nremove(self.t) >= 0;
    }

    pub fn len(self) -> i32 {
        return map_len(self.t);
    }
}

pub class PrimMapF64<K requires i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes> {
    t: opaque;
}

impl PrimMapF64<K> {
    pub fn new() -> Self {
        return PrimMapF64.with_capacity(8);
    }

    pub fn with_capacity(n: i32) -> Self {
        return Self { t: map_new(n as i64) };
    }

    pub fn put(mut self, k: K, v: f64) -> bool {
        let mut at = k.nentry(self.t);
        while (at <= -2147483647) {
            map_grow(self.t);
            at = k.nentry(self.t);
        }
        if (at >= 0) {
            map_val_set_f(self.t, at, v);
            return false;
        }
        map_val_set_f(self.t, -(at + 1), v);
        return true;
    }

    pub fn get(self, k: K) -> ?f64 {
        let at = k.nfind(self.t);
        if (at < 0) {
            return nil;
        }
        return map_val_get_f(self.t, at);
    }

    pub fn has(self, k: K) -> bool {
        return k.nfind(self.t) >= 0;
    }

    pub fn remove(self, k: K) -> bool {
        return k.nremove(self.t) >= 0;
    }

    pub fn len(self) -> i32 {
        return map_len(self.t);
    }
}

impl HashSet<T> {
    pub fn new() -> Self {
        return HashSet.with_capacity(8);
    }

    pub fn with_capacity(n: i32) -> Self {
        return Self { t: map_new(n as i64) };
    }

    // `put` — answers `true` when the element was newly added; on the
    // grow-first sentinel, grow and retry (the undrained relocation
    // queue is cleared by the next grow).
    pub fn put(mut self, t: T) -> bool {
        let mut at = t.nentry(self.t);
        while (at <= -2147483647) {
            map_grow(self.t);
            at = t.nentry(self.t);
        }
        return at < 0;
    }

    pub fn has(self, t: T) -> bool {
        return t.nfind(self.t) >= 0;
    }

    pub fn remove(self, t: T) -> bool {
        return t.nremove(self.t) >= 0;
    }

    pub fn len(self) -> i32 {
        return map_len(self.t);
    }
}
