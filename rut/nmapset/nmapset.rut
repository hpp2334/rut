// nmapset/nmapset.rut — the keyed-collection WRAPPER (the
// nmapset-hostops takeover): the host table owns the keys, their
// hashes, AND their identity — one STABLE birth handle per key,
// relocated with the keys inside the host's own grow — and this file
// is a thin delegation layer: every method is ONE crossing call plus
// at most a sidecar store. The grow-retry sentinel loops and the
// sidecar relocation drain that used to live here are GONE (their
// control flow moved host-side with the fused `map_h*` family,
// nmap.rs / nmap.d.rut); the rut-side `[?V]` parallel array remains
// BY LAW (reference `V` cannot cross — cells stay cells, the
// `get -> ?V` one-cell aliasing law is mapset's exact semantics), but
// it is indexed by the STABLE HANDLE and never drains and never
// reallocates on grow — only the pouch-push doubling when births
// outgrow the pre-size.
//
// Origin: the host-backed twin of the removed pure-rut `mapset`
// package, checksum-pinned row for row — the bench pins
// `734932704` / `1264308351` / `21500055` / `2198604` are still the
// original mapset rows' values, and the takeover CANNOT move them:
// slot assignment, probe order, and iteration position never moved
// (the handle column is additive state), and the op stream is the
// same puts/gets/removes answering the same values.
//
// DIVISION OF LABOR (nmapset-hostops, the survey §2): the host owns
// KEYS + RECORDED HASHES + SLOTS + HANDLES + GROWTH — `map_hput_*`
// grows internally at the load boundary and answers the packed
// `(handle << 1) | newly` i64 (bit 0 = newly; the handle is bounded
// by BIRTHS, not cap, never recycled v1 — a removed key's sidecar
// slot nils and dies with it); `map_hfind_*` / `map_hremove_*` answer
// the key's handle or `-1` (hremove names the DEAD key's own handle,
// so the wrapper nils exactly that slot and releases the cell). The
// wrapper owns the VALUE CELLS — `vals: [?V]` + `vlen`/`vcap`, the
// handle-indexed append-only sidecar. The key set stays the CLOSED,
// COMPILE-TIME-ENFORCED union (`K requires i8 | … | bytes` — a
// user-defined key fails at the instantiation with the union
// diagnostic; escape hatches: encode canonically to `bytes`, or
// vendor the removed mapset source from git history).
//
// THE KEY LANE: the private `KeyLane` trait carries the fused
// crossings (implemented only for the closed set, not exported —
// unimplementable by users); integer members widen/identity into the
// `i`/`u` lanes (sign-extension is the `KeyPayload::Bits` law; `-1i8`
// and `255u8` stay distinct bits on the two lanes), `bool` takes the
// `b` lane, `str`/`bytes` the `s`/`y` lanes — the host hashes with
// mapset's exact mix64/FNV-1a bits either way. The legacy crossing
// families (round-1 opaque lanes, the sentinel `map_entry_*` lanes,
// `map_grow`/`map_take_reloc`, the val-column pairs) stay DECLARED
// and bound in `nmap_host` as escape hatches — this wrapper no longer
// imports them.
//
// THE RANGE METHODS (strings-round1 phase 2, now on the sv handle
// lanes): `put_range` / `get_range` / `has_range` / `remove_range`
// key over a BORROWED `(parent, off, len)` BYTE range of any `str`
// value — hashed/compared over the range zero-copy, ONE owned copy
// stored only on a fresh insert — and an sv key IS the s key of the
// same content: same recorded hash, same slot, same HANDLE, so a
// range key and the equal-content `str` key are interchangeable
// through every method. `off`/`len` are BYTE offsets; a window off
// UTF-8 boundaries or past the parent's end is the host's loud
// `Invalid` trap (the table is left intact). The CONTRACT is
// K = `str` (the only key type with a range spelling; the methods sit
// on the generic class because rut has no per-instantiation
// divergence — the union bound is admission only).
//
// `HashSet` shares the map's `hput` lane and reads bit 0 (`(ans & 1)
// == 1`) — one family, one storage, no value machinery.
//
// REMOVED WITH THE TAKEOVER (the type-name-law private classes):
// `PrimMapI64` / `PrimMapU64` / `PrimMapF64` — the val-column lane
// classes went UNREACHED when the alias rows were repealed (every
// spelling resolves to the family class and its sidecar); their
// crossings stay host-side (the legacy keep), the differently-named
// column class stays the recorded future shape.

use nmap_host::{ map_new, map_cap, map_len,
            map_hput_i, map_hput_u, map_hput_b, map_hput_s, map_hput_y,
            map_hfind_i, map_hfind_u, map_hfind_b, map_hfind_s, map_hfind_y,
            map_hremove_i, map_hremove_u, map_hremove_b, map_hremove_s, map_hremove_y,
            map_hput_sv, map_hfind_sv, map_hremove_sv };

// ---- the private key lane (the fused crossings) ----------------------

// One private trait per lane op: `hput` (fused insert-or-replace +
// internal grow, packed handle|newly answer), `hfind` (the key's
// stable handle), `hremove` (tombstone, the dead key's handle).
// Implemented ONLY for the closed key set; it is not exported, so a
// user type cannot implement or reach it — the class bound's type
// union is the whole admission story, and these methods are just its
// hot path.
trait KeyLane {
    fn hput(self, t: opaque) -> i64;
    fn hfind(self, t: opaque) -> i32;
    fn hremove(self, t: opaque) -> i32;
}

impl KeyLane for i8 {
    fn hput(self, t: opaque) -> i64 { return map_hput_i(t, self as i64); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_i(t, self as i64); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_i(t, self as i64); }
}

impl KeyLane for i16 {
    fn hput(self, t: opaque) -> i64 { return map_hput_i(t, self as i64); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_i(t, self as i64); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_i(t, self as i64); }
}

impl KeyLane for i32 {
    fn hput(self, t: opaque) -> i64 { return map_hput_i(t, self as i64); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_i(t, self as i64); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_i(t, self as i64); }
}

impl KeyLane for i64 {
    fn hput(self, t: opaque) -> i64 { return map_hput_i(t, self); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_i(t, self); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_i(t, self); }
}

impl KeyLane for u8 {
    fn hput(self, t: opaque) -> i64 { return map_hput_u(t, self as u64); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_u(t, self as u64); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_u(t, self as u64); }
}

impl KeyLane for u16 {
    fn hput(self, t: opaque) -> i64 { return map_hput_u(t, self as u64); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_u(t, self as u64); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_u(t, self as u64); }
}

impl KeyLane for u32 {
    fn hput(self, t: opaque) -> i64 { return map_hput_u(t, self as u64); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_u(t, self as u64); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_u(t, self as u64); }
}

impl KeyLane for u64 {
    fn hput(self, t: opaque) -> i64 { return map_hput_u(t, self); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_u(t, self); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_u(t, self); }
}

impl KeyLane for bool {
    fn hput(self, t: opaque) -> i64 { return map_hput_b(t, self); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_b(t, self); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_b(t, self); }
}

// `==` on `str`/`bytes` is CONTENT equality (RFC 0012 §4) — exactly
// the key equality a hash table means, and the host hashes the content
// byte-wise (FNV-1a 64). A user key type's escape hatch: encode it
// canonically to `bytes` and take this lane.
impl KeyLane for str {
    fn hput(self, t: opaque) -> i64 { return map_hput_s(t, self); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_s(t, self); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_s(t, self); }
}

impl KeyLane for bytes {
    fn hput(self, t: opaque) -> i64 { return map_hput_y(t, self); }
    fn hfind(self, t: opaque) -> i32 { return map_hfind_y(t, self); }
    fn hremove(self, t: opaque) -> i32 { return map_hremove_y(t, self); }
}

// ---------------------------------------------------- the owners ----

// `HashMap<K, V>` — the host table behind one `opaque` handle plus the
// handle-indexed sidecar. Admission is the union bound itself (RFC
// 0043 §A5): a key type outside the closed set fails AT COMPILE TIME,
// naming the offending type and the union (no `f32`/`f64` — float keys
// have no stable equality contract, as in mapset).
pub class HashMap<K requires i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes, V> {
    t: opaque;    // HostBoxed<NativeTable> — keys, hashes, states, handles
    vals: [?V];   // the sidecar, indexed by STABLE HANDLE — nil is the slot's zero
    vlen: i32;    // the high-water mark (handles are dense births, monotonic v1)
    vcap: i32;    // vals.len() mirrored, so the store's hot path never re-reads
}

impl HashMap<K, V> {
    pub fn new() -> Self {
        return HashMap.with_capacity(8);
    }

    // `map_new` rounds the request to a power of two, never below 4 —
    // read back through `map_cap` to pre-size the sidecar in one
    // construction. The pre-size is a HINT: births can outgrow it
    // under churn, and `vstore`'s doubling carries that exactly.
    pub fn with_capacity(n: i32) -> Self {
        let t: opaque = map_new(n as i64);
        let cap = map_cap(t);
        return Self { t: t, vals: [nil; cap], vlen: 0, vcap: cap };
    }

    // The sidecar store — the wrapper's ONE piece of machinery: a
    // fresh birth (handle == vlen) appends, doubling when full (the
    // pouch-push spell inlined; NO pouch dep); a replace (handle <
    // vlen) stores over the existing cell. `hd > vlen` would be a
    // host-law breach — the fused lanes answer dense births only.
    fn vstore(mut self, hd: i32, v: V) -> nil {
        if (hd == self.vlen) {
            if (self.vlen == self.vcap) {
                let next_cap = self.vcap * 2;
                let mut next: [?V] = [nil; next_cap];
                for (let i = 0; i < self.vlen; i += 1) {
                    next[i] = self.vals[i];
                }
                self.vals = next;
                self.vcap = next_cap;
            }
            self.vlen += 1;
        }
        self.vals[hd] = v;
    }

    // `put` — `true` when the key was newly added, `false` when an
    // existing key's value was replaced. ONE crossing: `hput` fused
    // the entry, the load check, and any grow host-side; the packed
    // answer's low bit is the newly flag, the rest the handle.
    pub fn put(mut self, k: K, v: V) -> bool {
        let ans = k.hput(self.t);
        self.vstore((ans >> 1) as i32, v);
        return (ans & 1) == 1;
    }

    // `get` — `nil` = absent (RFC 0005 §10). The stored cell comes
    // back, not a copy: two gets of one key name ONE cell until a
    // replace re-stores (the aliasing law, unchanged — the sidecar
    // slot IS the cell and the handle never moves).
    pub fn get(self, k: K) -> ?V {
        let hd = k.hfind(self.t);
        if (hd < 0) {
            return nil;
        }
        return self.vals[hd];
    }

    pub fn has(self, k: K) -> bool {
        return k.hfind(self.t) >= 0;
    }

    // `remove` — the host tombstones the slot and answers the dead
    // key's own handle; the wrapper nils exactly that sidecar slot,
    // releasing the cell. The handle itself is never reused (monotonic
    // v1): a later re-insert of the same key is a NEW birth with a NEW
    // slot, so the nilled slot stays correct forever.
    pub fn remove(mut self, k: K) -> bool {
        let hd = k.hremove(self.t);
        if (hd < 0) {
            return false;
        }
        self.vals[hd] = nil;
        return true;
    }

    pub fn len(self) -> i32 {
        return map_len(self.t);
    }

    // ---- the range-keyed methods (strings-round1, phase 2) ----------
    // The sv lanes as a HashMap surface: the key crosses as a borrowed
    // `(parent, off, len)` BYTE range of any `str` value, hashed and
    // compared OVER THE RANGE (no key cell minted on a probe; a fresh
    // insert stores ONE owned copy). A range key and the equal-content
    // `str` key are THE SAME key through either spelling — same slot,
    // same HANDLE. Answers = the plain methods' laws (`put_range`
    // newly-added; `get_range` the `get -> ?V` law; `remove_range`
    // nils the handle's slot). Traps: the house `Invalid` on a
    // negative/past-end window or one ending mid-codepoint, the table
    // left intact.

    /// `put_range` — insert-or-replace keyed over a byte range of
    /// `parent`; `true` when the key was newly added. ONE crossing;
    /// on a replace the owned stored key keeps its original bytes.
    pub fn put_range(mut self, parent: str, off: i32, len: i32, v: V) -> bool {
        let ans = map_hput_sv(self.t, parent, off, len);
        self.vstore((ans >> 1) as i32, v);
        return (ans & 1) == 1;
    }

    /// `get_range` — `nil` = absent; a hit answers the stored value at
    /// the range key's handle (the same `get -> ?V` law as `get`).
    pub fn get_range(self, parent: str, off: i32, len: i32) -> ?V {
        let hd = map_hfind_sv(self.t, parent, off, len);
        if (hd < 0) {
            return nil;
        }
        return self.vals[hd];
    }

    pub fn has_range(self, parent: str, off: i32, len: i32) -> bool {
        return map_hfind_sv(self.t, parent, off, len) >= 0;
    }

    /// `remove_range` — the host tombstones the range-matched slot
    /// (`true` when it was present); the value cell nils like `remove`.
    pub fn remove_range(mut self, parent: str, off: i32, len: i32) -> bool {
        let hd = map_hremove_sv(self.t, parent, off, len);
        if (hd < 0) {
            return false;
        }
        self.vals[hd] = nil;
        return true;
    }
}

// `HashSet<T>` — the host table alone, zero value machinery. It
// SHARES the map's `hput` lane and reads bit 0 of the packed answer:
// one family, one storage, the handle simply ignored.
pub class HashSet<T requires i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes> {
    t: opaque;
}

impl HashSet<T> {
    pub fn new() -> Self {
        return HashSet.with_capacity(8);
    }

    pub fn with_capacity(n: i32) -> Self {
        return Self { t: map_new(n as i64) };
    }

    // `put` — `true` when the element was newly added (bit 0 of the
    // shared hput answer; the growth it may have fused is host-side).
    pub fn put(mut self, t: T) -> bool {
        return (t.hput(self.t) & 1) == 1;
    }

    pub fn has(self, t: T) -> bool {
        return t.hfind(self.t) >= 0;
    }

    pub fn remove(self, t: T) -> bool {
        return t.hremove(self.t) >= 0;
    }

    pub fn len(self) -> i32 {
        return map_len(self.t);
    }
}
