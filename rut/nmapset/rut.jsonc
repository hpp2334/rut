{
  // nmapset/ — the native-key map/set EXPERIMENT (the mapset-host plan):
  // generic wrapper classes over the `nmap_host` host table. The native side
  // owns keys (and — since round3 — prim vals); reference values stay
  // rut-side (the `[?V]` parallel array), so the `get -> ?V` aliasing
  // semantics are the law. Publishes COMPILED (the linkable-classes
  // phase): the generic classes' methods cross on the surface's inherent
  // rows, and a consumer instantiates + requests the bodies from this pkg
  // (owner-anchored generics).
  //
  // The key contract is a COMPILE-TIME union bound (`K requires
  // i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | bool | str | bytes`),
  // and the boxed-key law seals BOTH sides at the wrapper's edge
  // (`opaque(k)` / `opaque(v)` — the structural-interfaces fork took
  // the typed key lanes with it: satisfaction needs members on the
  // type, and primitives carry none). The host hashes the opened key
  // box with the pinned mix64/FNV constants — originally mapset's,
  // ported bit-for-bit, so the bench pins `734932704` / `1264308351` /
  // `21500055` / `2198604` are the old mapset rows' values. The
  // pure-rut `mapset` pkg itself left the tree in Sep 2026 (stdlib
  // slim-down — a user-defined key escape-hatches to a `bytes`
  // encoding, or vendors the old source from git history).
  "format": "rutbundle",
  "format_version": 10,
  "name": "nmapset",
  "entry": {
    "lib": "./nmapset.rut"
  },
  "deps": {
    "nmap_host": {
      "path": "../nmap_host"
    }
  }
}
