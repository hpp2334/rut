// std/core.d.rut — the prelude surface (RFC 0028): what the language
// itself ships — the `str`/`bytes` fns, the engine builtins `Array`/
// `Option`/`Result`/`Opaque` (RFC 0005, RFC 0014), and the engine-woven
// interfaces `Disposal`/`Index`/`Iterator`.
//
// One surface kind in this file: `builtin` — the ENGINE implements it,
// compiler-lowered (ops and rut-lir lowering, RFC 0032 §1.1). std:core
// registers no host bodies at all; `host fn` is exclusively the
// EMBEDDER'S surface (a registered NativeModule, RFC 0025). The decls
// exist so users and the LSP see every signature — the lockstep test
// keeps them true to rut-lir's lowering tables.
//
// The prelude is IMPORTED, never ambient (RFC 0028): nothing here is in
// scope until a module writes `import { .. } from "std:core"`. The
// compiler's copy of this surface is `rut_core::binary::Surface::core`;
// a driver test asserts the two stay in lockstep. Type-calls spelled
// with the type name (`x as i32` casts — RFC 0007) are syntax, not
// members.

// ---- engine functions (compiler-lowered) ----

// RFC 0011 §1 — the eager shallow copy: a fresh cell, handle fields
// shared. The generic parameter is inferred from the argument.
pub builtin fn own<T>(x: T) -> T;

// RFC 0014 — recover the concrete value from an erasure box: a type
// test plus a guarded unbox, yielding `Option<T>` (None on a mismatch).
pub builtin fn downcast<T>(o: Opaque) -> Option<T>;

// RFC 0034 §2 — `msg` is optional at the call site (1 or 2 arguments).
pub builtin fn assert(cond: bool, msg: str) -> unit;

// RFC 0034 §2 — abort with the message.
pub builtin fn panic(msg: str) -> unit;

// RFC 0005 — box `v` into a fresh one-slot cell; the result is a
// nil-able `*T` (`nil` is the null pointer; dereferencing it traps).
pub builtin fn make_ptr<T>(v: T) -> *T;

// RFC 0016 §3 — run `cleanup(p)` when `p`'s cell refcount reaches zero.
// One callback per pointer; a second attach is a compile error.
pub builtin fn on_drop<T>(p: *T, cleanup: fn(*T)) -> unit;

pub builtin fn string_len(s: str) -> i32;       // number of chars
pub builtin fn string_encode(s: str) -> bytes;  // UTF-8 -> bytes (RFC 0004)
pub builtin fn string_join(parts: Array<str>) -> str;  // join in one pass (RFC 0007)

pub builtin fn bytes_len(b: bytes) -> i32;
pub builtin fn bytes_decode(b: bytes) -> str;   // bytes -> UTF-8 string (lossy)
pub builtin fn bytes_from(a: Array<u8>) -> bytes;  // copy an Array<u8> (RFC 0004)
pub builtin fn bytes_zeroed(n: i32) -> bytes;      // n zeroed octets

// ---- engine builtin types (compiler-lowered members) ----

pub builtin Array<T> {
    fn len(self) -> i32;                    // the heap array's runtime length
}

pub builtin Option<T> {
    fn some(v: T) -> Self;
    fn none() -> Self;                      // element inferred from the binding's annotation
    fn is_some(self) -> bool;
    fn is_none(self) -> bool;
    fn unwrap_or(self, default: T) -> T;
    fn expect(self, msg: str) -> T;      // panics with `msg` on None
}

pub builtin Result<T, E> {
    fn ok(v: T) -> Self;
    fn err(e: E) -> Self;
    fn is_ok(self) -> bool;
    fn is_err(self) -> bool;
    fn unwrap_or(self, default: T) -> T;
    fn expect(self, msg: str) -> T;      // panics with `msg` on Err
}

// RFC 0014 — the erasure box: any non-`dyn` value goes in via `Opaque.new`,
// `downcast<T>(o)` recovers it (and `x is T` probes it). A boot-table type
// whose NAME is import-gated exactly like the containers above; `new`'s
// parameter is any value — the method spells that with its own `<T>`.
pub builtin Opaque {
    fn new<T>(v: T) -> Self;
}

// ---- engine-woven interfaces ----
// `builtin interface` = the engine has built-in knowledge: compiler-
// backed impls and lowering hooks. Users implement them with ordinary
// `impl` blocks. Library contracts without engine knowledge (std:
// collection's `Hashable`) stay plain `interface`.

// RFC 0011/0016 — impl blocks for Disposal run `dispose` at rc 0.
pub builtin interface Disposal {
    fn dispose(mut self) -> unit;
}

// RFC 0012 — the compiler-backed random-access contract. `Index` has a
// length and `get`/`set`; `x[i]` and `x[i] = v` lower through it. The
// element type is the interface argument. `Array`/`str`/`bytes` are
// compiler-backed; `Vec<T>` declares one in std:collection.
pub builtin interface Index<T> {
    fn len(self) -> i32;
    fn get(self, i: i32) -> T;
}

// RFC 0012 — the next()-based cursor contract. `for (x of it)` lowers to
// `next` until `None`. `Vec<T>` ships a cursor (`VecIter<T>`) in
// std:collection.
pub builtin interface Iterator<T> {
    fn next(mut self) -> Option<T>;
}
