// std/core.d.rut — the prelude surface (RFC 0028): what the language
// itself ships — the `str`/`bytes` primitives' natives, the builtin
// `Array`/`Option`/`Result` containers (RFC 0005), and the builtin
// `Disposal` interface. `Vec<T>` is NOT here: it is std-lib rut code in
// `std:collection`, over `Array<T>` with an `impl Iter for Vec<T>`.
//
// This file is the declarative form of the host's builtin tables: every
// member here is a statically bound native (RFC 0032 §1.1 R2 — named
// things are natives, never ops). The LSP consumes it today for hover
// and signature display; rutc consumes it the same way `host class`
// decls are consumed (RFC 0029) when the module loader lands (RFC 0035).
//
// Contract: declare a member here as its native lands — the surface is
// kept TRUE to the implementation (signatures match rut-lir's builtin
// tables), never aspirational. Type-calls spelled with the type name
// (`x as i32` casts — RFC 0007) are syntax, not members.
//
// The prelude is IMPORTED, never ambient (RFC 0028): nothing here is in
// scope until a module writes `import { .. } from "std:core"`. The
// compiler's copy of this surface is `rut_core::binary::Surface::core`;
// a driver test asserts the two stay in lockstep.

// RFC 0011 §1 — the eager shallow copy: a fresh cell, handle fields
// shared. The generic parameter is inferred from the argument.
pub host fn own<T>(x: T) -> T;

// RFC 0014 — recover the concrete value from an erasure box: a type
// test plus a guarded unbox, yielding `Option<T>` (None on a mismatch).
pub host fn downcast<T>(o: Opaque) -> Option<T>;

// RFC 0034 §2 — `msg` is optional at the call site (1 or 2 arguments).
pub host fn assert(cond: bool, msg: str) -> unit;

// RFC 0034 §2 — abort with the message.
pub host fn panic(msg: str) -> unit;

pub host fn string_len(s: str) -> i32;       // number of chars
pub host fn string_encode(s: str) -> bytes;  // UTF-8 -> bytes (RFC 0004)
pub host fn string_join(parts: Array<str>) -> str;  // join in one pass (RFC 0007)

pub host fn bytes_len(b: bytes) -> i32;
pub host fn bytes_decode(b: bytes) -> str;   // bytes -> UTF-8 string (lossy)
pub host fn bytes_from(a: Array<u8>) -> bytes;  // copy an Array<u8> (RFC 0004)
pub host fn bytes_zeroed(n: i32) -> bytes;      // n zeroed octets

pub host class Array<T> {
    fn len(self) -> i32;                    // the heap array's runtime length
}

pub host class Option<T> {
    fn some(v: T) -> Self;
    fn none() -> Self;                      // element inferred from the binding's annotation
    fn is_some(self) -> bool;
    fn is_none(self) -> bool;
    fn unwrap_or(self, default: T) -> T;
    fn expect(self, msg: str) -> T;      // panics with `msg` on None
}

pub host class Result<T, E> {
    fn ok(v: T) -> Self;
    fn err(e: E) -> Self;
    fn is_ok(self) -> bool;
    fn is_err(self) -> bool;
    fn unwrap_or(self, default: T) -> T;
    fn expect(self, msg: str) -> T;      // panics with `msg` on Err
}

// RFC 0014 — the erasure box: any non-`dyn` value goes in via `Opaque.new`,
// `downcast<T>(o)` recovers it (and `x is T` probes it). A boot-table type
// whose NAME is import-gated exactly like the containers above; `new`'s
// parameter is any value — the method spells that with its own `<T>`.
pub host class Opaque {
    fn new<T>(v: T) -> Self;
}

// RFC 0011/0016 — impl blocks for Disposal run `dispose` at rc 0; a
// builtin interface with ordinary nominal impls (RFC 0028: part of the
// prelude, spelled here because .d.rut declares traits too).
pub interface Disposal {
    fn dispose(mut self) -> unit;
}

// RFC 0012 — the compiler-backed random-access contract. `Index` has a
// length and `get`/`set`; `x[i]` and `x[i] = v` lower through it. The
// element type is the interface argument. `Array`/`str`/`bytes` are
// compiler-backed; `Vec<T>` declares one in std:collection.
pub interface Index<T> {
    fn len(self) -> i32;
    fn get(self, i: i32) -> T;
}

// RFC 0012 — the next()-based cursor contract. `for (x of it)` lowers to
// `next` until `None`. `Vec<T>` ships a cursor (`VecIter<T>`) in
// std:collection.
pub interface Iterator<T> {
    fn next(mut self) -> Option<T>;
}
