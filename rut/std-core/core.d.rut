// std/core.d.rut — the prelude surface (RFC 0028): what the language
// itself ships — the `string`/`bytes` primitives' natives, the builtin
// `Array`/`Option`/`Result` containers (RFC 0005), and the builtin
// `Disposal` trait. `Vec<T>` is NOT here: it is std-lib rut code in
// `std:collection`, over `Array<T>` with an `impl Slice<T> for Vec<T>`.
//
// This file is the declarative form of the host's builtin tables: every
// member here is a statically bound native (RFC 0032 §1.1 R2 — named
// things are natives, never ops). The LSP consumes it today for hover
// and signature display; rutc consumes it the same way `host class`
// decls are consumed (RFC 0029) when the module loader lands (RFC 0035).
//
// Contract: declare a member here as its native lands — the surface is
// kept TRUE to the implementation (signatures match rut-lir's builtin
// tables), never aspirational. Type-calls spelled with the type name
// (`i32(x)` conversions — RFC 0007) are syntax, not members.

pub host primitive string {
    fn len(self) -> i32;
    fn encode(self) -> bytes;                // UTF-8 -> bytes (RFC 0004)
}

pub host primitive bytes {
    fn len(self) -> i32;
    fn decode(self) -> string;               // bytes -> UTF-8 string (lossy)
    fn from(a: Array<u8>) -> bytes;          // copy an Array<u8> (RFC 0004)
}

pub host class Array<T> {
    fn len(self) -> i32;                    // the heap array's runtime length
}

pub host class Option<T> {
    fn some(v: T) -> Self;
    fn none() -> Self;                      // element inferred from the binding's annotation
    fn is_some(self) -> bool;
    fn is_none(self) -> bool;
    fn unwrap_or(self, default: T) -> T;
    fn expect(self, msg: string) -> T;      // panics with `msg` on None
}

pub host class Result<T, E> {
    fn ok(v: T) -> Self;
    fn err(e: E) -> Self;
    fn is_ok(self) -> bool;
    fn is_err(self) -> bool;
    fn unwrap_or(self, default: T) -> T;
    fn expect(self, msg: string) -> T;      // panics with `msg` on Err
}

// RFC 0011/0016 — impl blocks for Disposal run `dispose` at rc 0; a
// builtin trait with ordinary nominal impls (RFC 0028: part of the
// prelude, spelled here because .d.rut declares traits too).
pub trait Disposal {
    fn dispose(mut self) -> unit;
}
