// std/math.d.rut — `std:math`, the `Math` namespace (RFC 0028). The float
// members are host functions (`rt:`-backed, `f64`); the integer members are
// compiler-lowered intrinsics, generic over every integer width (RFC 0032
// §1.1 R2). The class carries no `self` members: `fn f(x) -> y` without
// `self` IS a class method (RFC 0010 §2).
//
//   import { Math } from "std:math";
//   let d = Math.sqrt(x * x + y * y);
//   let wrapped = Math.wrapping_mul(x, 1103515245);
//
// Constants (f64, compiler-materialized — the surface grammar has no
// `static` field form):
//   Math.PI  Math.TAU  Math.E  Math.SQRT_2  Math.LN_2  Math.LN_10
//   Math.LOG2_E  Math.LOG10_E  Math.INFINITY  Math.NEG_INFINITY
//   Math.NAN  Math.EPSILON  Math.MAX  Math.MIN  Math.MIN_POSITIVE
//
// Contract (std/core.d.rut): the surface is kept TRUE to the implementation
// — signatures match rut-lir's lowering tables, never aspirational. The
// integer members are shown at `i32`; the implementation is width-generic.

pub host class Math {
    // ---- f64 host functions ----
    fn sqrt(x: f64) -> f64;
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
    fn round(x: f64) -> f64;
    fn trunc(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn ln(x: f64) -> f64;
    fn log2(x: f64) -> f64;
    fn log10(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn tan(x: f64) -> f64;
    fn asin(x: f64) -> f64;
    fn acos(x: f64) -> f64;
    fn atan(x: f64) -> f64;
    fn sinh(x: f64) -> f64;
    fn cosh(x: f64) -> f64;
    fn tanh(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn atan2(y: f64, x: f64) -> f64;
    fn hypot(x: f64, y: f64) -> f64;
    fn copysign(x: f64, y: f64) -> f64;
    fn fma(x: f64, y: f64, z: f64) -> f64;

    // ---- integer intrinsics (compiler-lowered; width-generic) ----
    fn wrapping_add(x: i32, y: i32) -> i32;
    fn wrapping_sub(x: i32, y: i32) -> i32;
    fn wrapping_mul(x: i32, y: i32) -> i32;
    fn wrapping_shl(x: i32, n: i32) -> i32;
    fn saturating_add(x: i32, y: i32) -> i32;
    fn saturating_sub(x: i32, y: i32) -> i32;
    fn saturating_mul(x: i32, y: i32) -> i32;
    fn checked_add(x: i32, y: i32) -> Option<i32>;
    fn checked_sub(x: i32, y: i32) -> Option<i32>;
    fn checked_mul(x: i32, y: i32) -> Option<i32>;
    fn abs(x: i32) -> i32;
    fn min(x: i32, y: i32) -> i32;
    fn max(x: i32, y: i32) -> i32;
    fn signum(x: i32) -> i32;
}
