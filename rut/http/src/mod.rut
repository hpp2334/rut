// http/src/mod.rut — the std HTTP lane's rut face (the redesign): an
// ASYNC-ONLY, unsuffixed face over the `http_host` rows. Only the
// operations that really wait are async points — `send`, `body`,
// `next` — everything else (the client, the five verbs, the builder
// chain, `build`, the response readbacks, the reader mint) is sync
// construction sugar. NO `text()` (callers await `body()` then
// `.decode()`); NO query/params struct; NO `_async` suffixes anywhere.
//
// THE SHAPE: the verbs hand back a `RequestBuilder`; `build()` freezes
// a re-sendable `Request`; `send()` is THE async point — the plan's
// usage chain compiles verbatim:
//
//     let (resp, err) = await client.request()
//         .method(ClientQueryMethod::Post)
//         .url("https://example.com/api")
//         .header("Accept", "application/json")
//         .body(payload)
//         .build()
//         .send();
//     if (err != nil) {
//         let why: str = err!.reason;   // the transport failure's text
//         return 1;                     // or however the handler answers
//     }
//
// and the terse case is `await client.get(u).build().send()` — the same
// pair comes back.
//
// The async points are `async { }` blocks (the async primitive): each
// sync method MINTS the frame inside itself and answers it typed
// `Future<T>`; the caller's `await` consumes it. The cx is the
// weave's — injected, never spelled, never passed.
//
// THE LAWS (the host side owns them; this face is the thin wrapper):
// send answers the ANSWER CHANNEL — `(?Response, ?SendError)`, json's
// law: success `(Response, nil)`, a transport failure `(nil,
// SendError)`, exactly one side nil, always; the host status field's
// reserved 0 stays the host protocol's internal encoding, never the
// face's failure signal. Send resolves at HEADERS (the wire body stays
// unread — true streaming); `body()` drains the remaining wire in one
// future; `byte_stream()` mints the reader and `next()` walks it chunk
// by chunk (nil = EOF-or-failed — `error()`/`read_error()` name which);
// body xor stream per response — a late/second taker DEGRADES (empty
// drain / immediate EOF), never traps. A mid-read wire death is DATA —
// the sticky `read_error()` goes non-nil and stays. Cancellation is
// best-effort (a worker thread finishes its blocking read; the late
// result is discarded — disclosed).
use core::{ Future };
use http_host::net::{ http_send, http_status, http_err, http_read_err, http_resp_stream };
use http_host::stream::{ http_body, http_stream_next };
use strbuild::{ StringBuilder };

// the method dial — a builder input, never a wire format (the wire
// sees the canonical verb str below)
pub enum ClientQueryMethod { Get, Post, Put, Patch, Del }

/// the shared client handle. The host lanes own their client state
/// (the reqwest lane's shared blocking client; the fixture lane's
/// virtual clock), so the handle crosses `http_send` untouched — the
/// field exists so the face holds a client like the plan spells and a
/// future per-client lane can key on it.
pub class HttpClient {
    c: opaque;
}

impl HttpClient {
    [constructor] pub fn new() -> Self {
        return Self { c: opaque(nil) };
    }

    /// the manual entry: method defaults to GET
    pub fn request(self) -> RequestBuilder {
        return RequestBuilder { c: self.c, m: "GET", url: "", headers: StringBuilder(), body: "".encode() };
    }

    // the five verbs — BUILD sugars: sync, no I/O, each a one-step
    // builder with the method dialed
    pub fn get(self, url: str) -> RequestBuilder {
        return self.request().url(url);
    }
    pub fn post(self, url: str) -> RequestBuilder {
        return self.request().method(ClientQueryMethod::Post).url(url);
    }
    pub fn put(self, url: str) -> RequestBuilder {
        return self.request().method(ClientQueryMethod::Put).url(url);
    }
    pub fn patch(self, url: str) -> RequestBuilder {
        return self.request().method(ClientQueryMethod::Patch).url(url);
    }
    /// the DELETE verb — spelled `del` for brevity at the call site: the
    /// same crossing under a short name, the wire still sees the
    /// canonical `DELETE`
    pub fn del(self, url: str) -> RequestBuilder {
        return self.request().method(ClientQueryMethod::Del).url(url);
    }
}

/// the chain: every step sync, every step `Self` (the shared-handle
/// law — a builder mutates in place, the chain is spelling sugar)
pub class RequestBuilder {
    c: opaque;
    m: str;
    url: str;
    headers: StringBuilder;   // repeatable, accumulates
    body: bytes;              // empty = none (the disclosed merge)
}

impl RequestBuilder {
    pub fn method(self, m: ClientQueryMethod) -> Self {
        when (m) {
            ClientQueryMethod::Get -> { self.m = "GET"; },
            ClientQueryMethod::Post -> { self.m = "POST"; },
            ClientQueryMethod::Put -> { self.m = "PUT"; },
            ClientQueryMethod::Patch -> { self.m = "PATCH"; },
            ClientQueryMethod::Del -> { self.m = "DELETE"; },
        }
        return self;
    }

    pub fn url(self, url: str) -> Self {
        self.url = url;
        return self;
    }

    /// repeatable — each call appends one `Name: value` line
    pub fn header(self, name: str, value: str) -> Self {
        if (self.headers.len() > 0) {
            self.headers.append("\n");
        }
        self.headers.append(name);
        self.headers.append(": ");
        self.headers.append(value);
        return self;
    }

    pub fn body(self, b: bytes) -> Self {
        self.body = b;
        return self;
    }

    /// freeze: a re-sendable Request (its own copy of the accumulated
    /// header block; the builder stays mutable for another build)
    pub fn build(self) -> Request {
        return Request { c: self.c, m: self.m, url: self.url, headers: self.headers.build(), body: self.body };
    }
}

/// the frozen request: canonical method str, the "\n"-joined header
/// block ("" = none), body bytes (empty = none)
pub class Request {
    c: opaque;
    m: str;
    url: str;
    headers: str;
    body: bytes;
}

impl Request {
    /// THE async point — resolves at HEADERS. The `async { }` block
    /// mints the frame inside the call; `await` consumes the returned
    /// future. The block's reads (self's fields) capture by value at
    /// the mint — the capture law. Answers the ANSWER CHANNEL (json's
    /// law): success `(Response, nil)`, a transport failure
    /// `(nil, SendError)` — exactly one side nil, always.
    pub fn send(self) -> Future<(?Response, ?SendError)> {
        let c = self.c;
        let m = self.m;
        let url = self.url;
        let headers = self.headers;
        let body = self.body;
        return async {
            let r: opaque = await http_send(c, m, url, headers, body);
            // the failure's OWN door: http_err answers nil exactly when
            // the transport did not fail — the face never reads the
            // status field's reserved 0 (the sentinel stays the host's
            // internal encoding, never the face's failure signal)
            let reason: ?str = http_err(r);
            if (reason != nil) {
                let why: str = reason!;
                return (nil, SendError { reason: why });
            }
            return (Response { r: r }, nil);
        };
    }
}

/// the send-time transport failure's reason — the answer channel's
/// err side, json's `?EncodeJsonError` mirror (the details-struct
/// half of the error-type law). No kind enum in v1: the host
/// protocol owns no kind fact — the reason text is everything the
/// send lane produces.
pub struct SendError {
    reason: str;   // the transport failure text (the host's Display)
}

/// the response handle: the host owns the layout, rut holds the opaque
pub class Response {
    r: opaque;
}

impl Response {
    /// the HTTP status word — always a real status here: the channel's
    /// resp side never carries a failed mint (0 stays the host
    /// protocol's internal reservation, documented on the host side)
    pub fn status(self) -> i32 { return http_status(self.r); }

    /// the 2xx test
    pub fn ok(self) -> bool {
        let s = self.status();
        return s >= 200 && s < 300;
    }

    /// the sticky mid-read failure — nil until one fails, then
    /// non-nil forever; meaningful after awaiting `body()`/`next()`
    pub fn read_error(self) -> ?str { return http_read_err(self.r); }

    /// the drain: the remaining wire in ONE future — empty after the
    /// stream lane took over (the one-shot law's degrade)
    pub fn body(self) -> Future<bytes> {
        let r = self.r;
        return async {
            return await http_body(r);
        };
    }

    /// mint the reader: instant, sync. One-shot vs `body()` — a late
    /// mint (after a drain, or a second mint) answers a dead reader
    /// whose `next()` is an immediate EOF.
    pub fn byte_stream(self) -> ByteStream {
        return ByteStream { s: http_resp_stream(self.r), r: self.r };
    }
}

/// the chunk reader. Two handles, one disclosure: the row set has no
/// stream-side error readback — `error()` reads the SAME sticky fact
/// through the response row (`http_read_err`), so the class carries
/// the response handle beside the reader.
pub class ByteStream {
    s: opaque;
    r: opaque;
}

impl ByteStream {
    /// one chunk per future; nil = EOF-or-failed (`error()` names
    /// which). The chunk source is bounded end to end.
    pub fn next(self) -> Future<?bytes> {
        let s = self.s;
        return async {
            return await http_stream_next(s);
        };
    }

    /// the same sticky read failure, read through the response row
    pub fn error(self) -> ?str { return http_read_err(self.r); }
}
