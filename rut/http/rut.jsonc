{
  // http/ — the std HTTP lane's rut face: the async-only client, builder
  // and response classes over the `http_host` rows (the ink pattern).
  // Publishes COMPILED (the linkable-classes phase): the classes' methods
  // cross on the surface's inherent rows, so every consumer's call site
  // binds them from this pkg's binary.
  "format": "rutbundle",
  "format_version": 10,
  "name": "http",
  "entry": {
    "lib": "./http.rut"
  },
  "deps": {
    "http_host": {
      "path": "../http_host"
    },
    "strbuild": {
      "path": "../strbuild"
    }
  }
}
