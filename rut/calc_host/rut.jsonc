{
  // calc_host/ — the float math HOST package: the concrete rows behind
  // `calc`'s generic surface. The width lives in the internal row name
  // (`sqrt_f64` / `sqrt_f32`) — `calc` (the normal lib beside this dir)
  // wraps them as closed-union generics (`sqrt<T requires f32 | f64>`,
  // the `is` dispatch picking the row per member), so callers never
  // spell a suffix. A `type = "host"` tree package: the surface is
  // calc.d.rut, the BODIES stay rut-std behind the inert host-pkg
  // install (`.host_pkg(rut_std::math::pkg())`) — the declaration
  // mounts, the embedding Rust binds.
  //
  // The CONSTANTS are the SURFACE LETS (calc.d.rut's `pub let PI:
  // f64 = ..;` rows — the manifest's `consts` key is retired) and
  // bind BARE at this pkg's root (`use calc_host::{ PI }`); `calc`'s
  // math module re-exports the family (`pub use calc_host::{ PI, .. }`),
  // so callers reach them as `math::PI` through the ordinary module
  // path and never spell `calc_host`:
  //   PI TAU E SQRT_2 LN_2 LN_10 LOG2_E LOG10_E INFINITY
  //   NEG_INFINITY EPSILON MAX MIN MIN_POSITIVE.
  //
  // Contract (std/core.d.rut): the surface is kept TRUE to the
  // implementation — signatures match the mount tables, never
  // aspirational.
  "name": "calc_host",
  "type": "host",
  "entry": {
    "type": "./calc.d.rut"
  }
}
