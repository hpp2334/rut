// calc_host/calc.d.rut — the float math HOST rows: f64 bodies in
// `rut-std`, each with an f32 twin. The width is in the row name
// (`sqrt_f64` / `sqrt_f32`) — these are the INTERNAL spellings;
// callers reach the math through `calc`'s math module
// (`use calc::{ math }` — `math::sqrt<T requires f32 | f64>` routes
// per member), never through this pkg. The constants below are this
// pkg's SURFACE LETS, bound BARE at its root and re-exported through
// calc's math module (`math::PI`).
//
// The INTEGER numeric methods (`wrapping_*`, `saturating_*`,
// `checked_*`) are core's `builtin impl` methods on the primitives;
// `NAN` is core's too (`use core::{NAN}`).
//
// Contract (std/core.d.rut): the surface is kept TRUE to the
// implementation — signatures match the mount tables, never
// aspirational.

// ---- the constants (surface lets — f64 literals, the one spelling;
// the non-finite pair is `inf` / `-inf`) ----

pub let PI: f64 = 3.141592653589793;
pub let TAU: f64 = 6.283185307179586;
pub let E: f64 = 2.718281828459045;
pub let SQRT_2: f64 = 1.4142135623730951;
pub let LN_2: f64 = 0.6931471805599453;
pub let LN_10: f64 = 2.302585092994046;
pub let LOG2_E: f64 = 1.4426950408889634;
pub let LOG10_E: f64 = 0.4342944819032518;
pub let INFINITY: f64 = inf;
pub let NEG_INFINITY: f64 = -inf;
pub let EPSILON: f64 = 2.220446049250313e-16;
pub let MAX: f64 = 1.7976931348623157e308;
pub let MIN: f64 = -1.7976931348623157e308;
pub let MIN_POSITIVE: f64 = 2.2250738585072014e-308;

// ---- f64 host functions (the embedding Rust implements them) ----

pub host fn sqrt_f64(x: f64) -> f64;
pub host fn floor_f64(x: f64) -> f64;
pub host fn ceil_f64(x: f64) -> f64;
pub host fn round_f64(x: f64) -> f64;
pub host fn trunc_f64(x: f64) -> f64;
pub host fn exp_f64(x: f64) -> f64;
pub host fn ln_f64(x: f64) -> f64;
pub host fn log2_f64(x: f64) -> f64;
pub host fn log10_f64(x: f64) -> f64;
pub host fn sin_f64(x: f64) -> f64;
pub host fn cos_f64(x: f64) -> f64;
pub host fn tan_f64(x: f64) -> f64;
pub host fn asin_f64(x: f64) -> f64;
pub host fn acos_f64(x: f64) -> f64;
pub host fn atan_f64(x: f64) -> f64;
pub host fn sinh_f64(x: f64) -> f64;
pub host fn cosh_f64(x: f64) -> f64;
pub host fn tanh_f64(x: f64) -> f64;
pub host fn pow_f64(x: f64, y: f64) -> f64;
pub host fn atan2_f64(y: f64, x: f64) -> f64;
pub host fn hypot_f64(x: f64, y: f64) -> f64;
pub host fn copysign_f64(x: f64, y: f64) -> f64;
pub host fn fma_f64(x: f64, y: f64, z: f64) -> f64;

// ---- float helpers (ordinary host fns; the int forms are core's
// `builtin impl` methods) ----

pub host fn abs_f64(x: f64) -> f64;
pub host fn min_f64(x: f64, y: f64) -> f64;
pub host fn max_f64(x: f64, y: f64) -> f64;
pub host fn signum_f64(x: f64) -> f64;

// ---- f32 twins (same libm bodies on `f32`) ----

pub host fn sqrt_f32(x: f32) -> f32;
pub host fn floor_f32(x: f32) -> f32;
pub host fn ceil_f32(x: f32) -> f32;
pub host fn round_f32(x: f32) -> f32;
pub host fn trunc_f32(x: f32) -> f32;
pub host fn exp_f32(x: f32) -> f32;
pub host fn ln_f32(x: f32) -> f32;
pub host fn log2_f32(x: f32) -> f32;
pub host fn log10_f32(x: f32) -> f32;
pub host fn sin_f32(x: f32) -> f32;
pub host fn cos_f32(x: f32) -> f32;
pub host fn tan_f32(x: f32) -> f32;
pub host fn asin_f32(x: f32) -> f32;
pub host fn acos_f32(x: f32) -> f32;
pub host fn atan_f32(x: f32) -> f32;
pub host fn sinh_f32(x: f32) -> f32;
pub host fn cosh_f32(x: f32) -> f32;
pub host fn tanh_f32(x: f32) -> f32;
pub host fn pow_f32(x: f32, y: f32) -> f32;
pub host fn atan2_f32(y: f32, x: f32) -> f32;
pub host fn hypot_f32(x: f32, y: f32) -> f32;
pub host fn copysign_f32(x: f32, y: f32) -> f32;
pub host fn fma_f32(x: f32, y: f32, z: f32) -> f32;
pub host fn abs_f32(x: f32) -> f32;
pub host fn min_f32(x: f32, y: f32) -> f32;
pub host fn max_f32(x: f32, y: f32) -> f32;
pub host fn signum_f32(x: f32) -> f32;
