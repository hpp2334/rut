// core/core.d.rut — the prelude surface (RFC 0028): what the language
// itself ships — the `str`/`bytes`/`opaque` primitives, the compiler-
// lowered fns, and the engine-woven trait `Iterator` (the
// `Disposal`/`Index` contracts are gone, v1.1). The array `[T]` is pure
// grammar — no decl carries it (RFC 0005 §9).
//
// One surface kind in this file: `builtin` — the ENGINE implements it,
// compiler-lowered (ops and rut-lir lowering, RFC 0032 §1.1): the
// primitives/fns below, and the `builtin impl <prim>` numeric
// methods. core registers no host bodies at all; `host fn` is
// exclusively the EMBEDDER'S surface (a registered NativeModule, RFC
// 0025). The decls exist so users and the LSP see every signature — the
// lockstep test keeps them true to rut-lir's lowering tables.
//
// Builtin names are AMBIENT (RFC 0028 revised, builtin-surface): no
// `use` is needed — `pub builtin` is gone, `builtin` declares with no
// visibility at all. (Pkg mounting by `use` — ink/pouch/calc — is a
// different mechanism and unaffected.) The compiler's copy of this
// surface is `rut_core::binary::Surface::core`; a driver test asserts
// the two stay in lockstep. Type-calls spelled with the type name
// (`x as i32` casts — RFC 0007) are syntax, not members.

// ---- engine functions (compiler-lowered) ----

// RFC 0034 §2 — `msg` is optional at the call site (1 or 2 arguments).
builtin fn assert(cond: bool, msg: str) -> nil;

// RFC 0034 §2 — abort with the message.
builtin fn panic(msg: str) -> nil;

// RFC 0016 §3 — run `cleanup(p)` when `p`'s cell refcount reaches zero.
// One callback per pointer; a second attach is a compile error.
// (RFC 0044: the old `&v`/`*T` surface is now the nullable `?T` — a
// `?T` binding IS the cell reference.)
builtin fn on_drop<T>(p: ?T, cleanup: fn(?T)) -> nil;

// v1.1 codepoint access (RFC 0004 — `char` is gone): `s.code()` reads
// the FIRST codepoint as a `u32` (traps on empty); `str.from_code(n)`
// builds the 1-codepoint str. Compiler-lowered, no use needed for
// the method form; the type-method spells `str.from_code(..)`.
//
// pub method  s.code() -> u32
// pub type-method  str.from_code(n: u32) -> str

builtin fn string_join(parts: [str]) -> str;  // join in one pass (RFC 0007)

// RFC 0036 (err-channel phase 2) — the opt-in stack snapshot:
// `capture_stacktrace()` walks the VM's frame chain and stores RAW
// frames only — no names, no source access, no symbolication at
// capture. Every member symbolicates LAZILY, per access, against the
// loaded program; out-of-range `i` traps (the index is a bug, not
// data). Opt-in at raise sites: the err-propagation path stays
// zero-cost. Builtin CLASS, not a primitive: a trace is a stateful
// engine snapshot with methods (RFC 0025's `builtin class` row — the
// decl is a pure signature contract).
builtin fn capture_stacktrace() -> StackTrace;

builtin class StackTrace {
    fn len(self) -> i32;                 // frame count (innermost first)
    fn name(self, i: i32) -> str;        // frame i's function name
    fn line(self, i: i32) -> i32;        // call-site line (0 when stripped)
    fn col(self, i: i32) -> i32;         // call-site column (0 when stripped)
    fn render(self) -> str;              // the RFC 0036 symbolication string
}

// The growable string builder (json-perf phase 2): the accumulator with
// amortized-O(1) appends — the shape the `out = f"{out}{t}"` field
// accumulator could never be (every append copied the whole prefix).
// Construct `StrBuf(cap)` with an octet capacity hint (pre-sizing; `0`
// grows from small). A cell like `StackTrace`: methods mutate through
// it, assignment shares it. The general machinery any encoder/tokenizer
// wants; the engine never learns what is being built.
builtin class StrBuf {
    fn push(self, s: str);        // append a str's octets — amortized O(|s|)
    fn push_code(self, c: u32);   // append one codepoint (invalid scalars
                                  // mint U+FFFD — the from_code rule)
    fn len(self) -> i32;          // codepoints so far (tracked, O(1))
    fn finish(self) -> str;       // the ONE materialization: a fresh
                                  // immutable str; the builder keeps its
                                  // buffer (finish twice = same text)
}

// The weak reference (RFC 0017 v1): a WeakBox side cell holding an
// UNRETAINED word to the referent — a weak never keeps anything alive.
// Construction is a CALL of the type name itself (the `opaque(v)` law):
// `Weak(v)` mints `Weak<T>` over v's cell and traps on a nil `v`
// ("weak on nil"); `T` must be a reference type (`Weak<i32>` diagnoses —
// primitives move by value; `Weak<?U>` is legal and `upgrade` answers
// `??U`). The referent's death nulls every box BEFORE any user code
// runs — `upgrade()` answers `nil` deterministically from then on, even
// from inside the dying cell's own cleanup. A weak edge closes no
// cycle: strong cycles still leak to `Vm::drop` (RFC 0017 §2's stated
// rule — this class is the first-class answer, not a collector).
builtin class Weak<T> {
    fn upgrade(self) -> ?T;       // the live referent retained into a
                                  // fresh ?T, or nil once the referent
                                  // died (repeat upgrades are stable)
}


// ---- engine builtin primitives (compiler-lowered members) ----
// The boot primitives declare their surface here — `builtin primitive`,
// never a class (RFC 0002 §3, builtin-surface): the Rust-side
// representation is the boot table's, unchanged. v1.1: the primitive
// members are declared per type — `str`/`bytes` carry their own member
// contracts (RFC 0004 v1.1); `len` is the sequence member shared by
// every sequence.
builtin primitive str {
    fn len(self) -> i32;            // codepoints
    fn code(self) -> u32;           // the FIRST codepoint (traps on empty)
    fn code_at(self, i: i32) -> u32; // the codepoint at codepoint index i
                                     // (traps out of bounds — the index is
                                     // a bug, not data)
    fn encode(self) -> bytes;       // the UTF-8 octets
    fn slice(self, from: i32, to: i32) -> str;  // O(1) view [from, to) — codepoint bounds (RFC 0042)
    // The fused host-side scan/classify (json-perf phase 2) — the
    // tokenizer primitive: walk codepoints from `from`, classify each
    // through the caller's `[u8]` table (`set[min(cp, set.len()-1)]`,
    // `0` keeps scanning), stop at the FIRST nonzero class; the whole
    // per-byte loop runs in the host, so a tokenizer drives it in
    // O(calls), not O(bytes) of interpreted ops. Returns the packed
    // pair `(stop_index << 8) | stop_class`; end of input is
    // `(s.len() << 8) | 0`.
    fn scan(self, from: i32, set: [u8]) -> i64;
    // Does the codepoint run at `from` spell `head`? Compared host-side
    // (no per-character str cells); false past the end.
    fn starts_with(self, from: i32, head: str) -> bool;
}

builtin primitive bytes {
    fn len(self) -> i32;            // octets
    fn decode(self) -> str;         // UTF-8 (lossy)
    fn clone(self) -> bytes;        // a one-shot buffer copy — the ONLY
                                    // copy escape hatch (RFC 0044):
                                    // every binding shares its cell,
                                    // this member mints a fresh one
}
// type-methods: bytes.zeroed(n) -> bytes, bytes.from(a: [u8]) -> bytes
// NOTE: `Option`/`Result`/`own` were removed in v1.1 — absence is
// `nil` on a `?T` or a `(T, err)` tuple; use sites diagnose
// with the removal and its replacement.

// The array `[T]` (RFC 0005 §9) declares NOTHING here: the type is
// grammar (`[T]`), construction is the repeat `[v; n]` — a VALUE and a
// count — and `a[i]`/`a.len()` are compiler-lowered (RFC 0032 §1.1).
// The `Array` name itself is removed: use sites diagnose with the
// removal and its replacement.

// RFC 0014 — the erasure box: any value goes in via `opaque(v)`,
// `opaque.downcast<T>(o)` recovers it (and `x is T` probes it). A
// boot-table type whose member is the static on the primitive; the free
// `downcast<T>` fn is gone — the member form is the one surface
// (builtin-surface phase 2 deleted the engine alias too: a bare
// `downcast<T>(o)` call diagnoses with the removal). Construction is a
// CALL of the type name itself — `opaque.new(v)` was folded into
// `opaque(v)` in the `?T` sweep (RFC 0044), there is no `new` static.
// The recovery is the nullable (RFC 0044): a match IS the box's inner
// cell (the alias law — mutation through it is the source's; a prim
// payload reads the copied value), a mismatch is `nil` — never a
// zero-value/flag tuple (refval-round2; RFC 0014 amended).
// (builtin-surface phase 2: the interner/boot name is spelled
// `opaque` — the type name is part of every host `.d.rut` crossing.)
builtin primitive opaque {
    fn downcast<T>(o: Self) -> ?T;
}

// ---- numeric methods on the integer primitives (RFC 0032 §1.1 R2) ----
// `builtin impl <prim>` — compiler-lowered methods ON the primitive,
// ambient like the primitive itself: `x.wrapping_add(y)` needs no `use`
// (primitives have none). One block per width; the wrapping/saturating/
// checked ops replace the trap-on-overflow `+`/`-`/`*`/`<<` (RFC 0004
// §3); `checked_*` answers the v1.1 tuple `(T, bool)` — `ok` is false
// exactly when the mathematical result escaped the width.

builtin impl i8 {
    fn wrapping_add(self, y: i8) -> i8;
    fn wrapping_sub(self, y: i8) -> i8;
    fn wrapping_mul(self, y: i8) -> i8;
    fn wrapping_shl(self, n: i8) -> i8;
    fn saturating_add(self, y: i8) -> i8;
    fn saturating_sub(self, y: i8) -> i8;
    fn saturating_mul(self, y: i8) -> i8;
    fn checked_add(self, y: i8) -> (i8, bool);
    fn checked_sub(self, y: i8) -> (i8, bool);
    fn checked_mul(self, y: i8) -> (i8, bool);
}

builtin impl i16 {
    fn wrapping_add(self, y: i16) -> i16;
    fn wrapping_sub(self, y: i16) -> i16;
    fn wrapping_mul(self, y: i16) -> i16;
    fn wrapping_shl(self, n: i16) -> i16;
    fn saturating_add(self, y: i16) -> i16;
    fn saturating_sub(self, y: i16) -> i16;
    fn saturating_mul(self, y: i16) -> i16;
    fn checked_add(self, y: i16) -> (i16, bool);
    fn checked_sub(self, y: i16) -> (i16, bool);
    fn checked_mul(self, y: i16) -> (i16, bool);
}

builtin impl i32 {
    fn wrapping_add(self, y: i32) -> i32;
    fn wrapping_sub(self, y: i32) -> i32;
    fn wrapping_mul(self, y: i32) -> i32;
    fn wrapping_shl(self, n: i32) -> i32;
    fn saturating_add(self, y: i32) -> i32;
    fn saturating_sub(self, y: i32) -> i32;
    fn saturating_mul(self, y: i32) -> i32;
    fn checked_add(self, y: i32) -> (i32, bool);
    fn checked_sub(self, y: i32) -> (i32, bool);
    fn checked_mul(self, y: i32) -> (i32, bool);
}

builtin impl i64 {
    fn wrapping_add(self, y: i64) -> i64;
    fn wrapping_sub(self, y: i64) -> i64;
    fn wrapping_mul(self, y: i64) -> i64;
    fn wrapping_shl(self, n: i64) -> i64;
    fn saturating_add(self, y: i64) -> i64;
    fn saturating_sub(self, y: i64) -> i64;
    fn saturating_mul(self, y: i64) -> i64;
    fn checked_add(self, y: i64) -> (i64, bool);
    fn checked_sub(self, y: i64) -> (i64, bool);
    fn checked_mul(self, y: i64) -> (i64, bool);
}

builtin impl u8 {
    fn wrapping_add(self, y: u8) -> u8;
    fn wrapping_sub(self, y: u8) -> u8;
    fn wrapping_mul(self, y: u8) -> u8;
    fn wrapping_shl(self, n: u8) -> u8;
    fn saturating_add(self, y: u8) -> u8;
    fn saturating_sub(self, y: u8) -> u8;
    fn saturating_mul(self, y: u8) -> u8;
    fn checked_add(self, y: u8) -> (u8, bool);
    fn checked_sub(self, y: u8) -> (u8, bool);
    fn checked_mul(self, y: u8) -> (u8, bool);
}

builtin impl u16 {
    fn wrapping_add(self, y: u16) -> u16;
    fn wrapping_sub(self, y: u16) -> u16;
    fn wrapping_mul(self, y: u16) -> u16;
    fn wrapping_shl(self, n: u16) -> u16;
    fn saturating_add(self, y: u16) -> u16;
    fn saturating_sub(self, y: u16) -> u16;
    fn saturating_mul(self, y: u16) -> u16;
    fn checked_add(self, y: u16) -> (u16, bool);
    fn checked_sub(self, y: u16) -> (u16, bool);
    fn checked_mul(self, y: u16) -> (u16, bool);
}

builtin impl u32 {
    fn wrapping_add(self, y: u32) -> u32;
    fn wrapping_sub(self, y: u32) -> u32;
    fn wrapping_mul(self, y: u32) -> u32;
    fn wrapping_shl(self, n: u32) -> u32;
    fn saturating_add(self, y: u32) -> u32;
    fn saturating_sub(self, y: u32) -> u32;
    fn saturating_mul(self, y: u32) -> u32;
    fn checked_add(self, y: u32) -> (u32, bool);
    fn checked_sub(self, y: u32) -> (u32, bool);
    fn checked_mul(self, y: u32) -> (u32, bool);
}

builtin impl u64 {
    fn wrapping_add(self, y: u64) -> u64;
    fn wrapping_sub(self, y: u64) -> u64;
    fn wrapping_mul(self, y: u64) -> u64;
    fn wrapping_shl(self, n: u64) -> u64;
    fn saturating_add(self, y: u64) -> u64;
    fn saturating_sub(self, y: u64) -> u64;
    fn saturating_mul(self, y: u64) -> u64;
    fn checked_add(self, y: u64) -> (u64, bool);
    fn checked_sub(self, y: u64) -> (u64, bool);
    fn checked_mul(self, y: u64) -> (u64, bool);
}

// Constants: `NAN` — core's one const (f64 bits, materialized with
// `ConstRaw`), name-explicit like every other prelude name:
// `use core::{NAN}`. The float constants (`PI`, `E`, `INFINITY`, …)
// stay `calc`'s.

// ---- engine-woven traits ----
// `builtin trait` = the engine has built-in knowledge: compiler-
// backed impls and lowering hooks. Users implement them with ordinary
// `impl` blocks. Library contracts without engine knowledge (a
// package's own trait — e.g. an encoding contract for map keys) stay
// plain `trait`.

// v1.1 removals — `Disposal`/`Index` are gone from the prelude:
// cleanups attach with `on_drop` (RFC 0016) and indexing is builtin
// over `[T]`/`Vec`/`str`/`bytes`. Library contracts without engine
// knowledge (`Hashable`) stay plain `trait` in their module.

// RFC 0012 §6 — the iteration protocol. A type is iterable when it
// declares this member (duck-typed satisfaction); `for (x of it)`
// desugars to `it.__iterate(emit)` with a fresh per-iteration binding:
// `emit` returning `false` stops the iteration (a `break`).
builtin trait Iterator<E> {
    fn __iterate(self, emit: fn(E) -> bool);
}
