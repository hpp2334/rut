// mapset/mapset.rut — the keyed-collection package (RFC 0028's map/set
// intent, realized as pure rut source): `Hashable` (the ONE key
// contract — hashing and hash-consistent equality), the open-addressing
// `RawHashTable` core, and the two owners, `HashMap<K, V>` and
// `HashSet<T>`. No host surface anywhere — no host fns, no `Opaque`
// handles; consumers mount this package like any tree pkg
// (`pouch`/`ink` pattern).
//
// The package spells no `use`: `[T]` (RFC 0005 §9), `&x`, the
// primitives, and the ambient primitive members (`str.encode()`,
// `a.len()`) cover everything written here. Storage is pointer arrays —
// `keys: [*Hashable]`, `vals: [*V]` — born from the repeat `[nil; n]`
// (`nil` is the slot's zero, RFC 0005 §10); element stores keep `&v`.
//
// Counters (`count`/`tomb`/`cap`) are `u32` — non-negative domain
// values. Probe/index temporaries stay `i32` (`len()` and indexing are
// i32) with a single `as i32` at the index boundary; the load-factor
// compare widens to `u64` (u32 `×10` would overflow near 429M entries).
//
// HOT-LOOP LAW (bench-verified): hoist SCALAR field reads (`cap`, the
// counters) into locals — that is pouch's `cap`-mirror precedent — but
// NEVER bind an array field to a local inside a per-call method:
// materializing a binding from an array value deep-copies the buffer
// (the engine's copy law), so `let states = self.states` in `probe`
// made every put/get O(cap). Hot methods index the fields directly —
// `self.states[at]` is an in-place element access (no copy); the only
// array bindings here live in `rehash`, which runs O(log n) times and
// NEEDS the old arrays held across the `self.*` reassignment.

// The ONE key contract (RFC 0028): hashing and key comparison are a
// single trait — `hash_eq` must be CONSISTENT with `hash` (equal keys
// answer equal hashes), or a map loses entries. `hash_eq` is not `==`
// identity: it compares key content as the key type means it.
pub trait Hashable {
    fn hash(self) -> u64;
    fn hash_eq(self, other: Self) -> bool;
}

// FNV-1a 64 over the bytes (digest.rut's op vocabulary: `^` plus
// `wrapping_mul` — no 64-bit shifts needed).
fn fnv1a64(data: bytes) -> u64 {
    let mut h: u64 = 14695981039346656037u64;
    for (let b of data) {
        h = (h ^ b as u64).wrapping_mul(1099511628211u64);
    }
    return h;
}

// One FNV-1a-style fold of a u64 word — the integer/bool `hash` shape:
// mix the value's bits so the table's low-bit mask spreads them.
fn mix64(bits: u64) -> u64 {
    return (14695981039346656037u64 ^ bits).wrapping_mul(1099511628211u64);
}

// ---- primitive impls (mapset's own trait, prim targets — RFC 0012 §2;
// a primitive's INHERENT surface stays core's `builtin impl`) ----
// No `f32`/`f64` impl: float keys have no stable equality contract in
// this package — omit them by policy.

impl Hashable for i8 {
    fn hash(self) -> u64 { return mix64(self as u64); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for i16 {
    fn hash(self) -> u64 { return mix64(self as u64); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for i32 {
    fn hash(self) -> u64 { return mix64(self as u64); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for i64 {
    fn hash(self) -> u64 { return mix64(self as u64); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for u8 {
    fn hash(self) -> u64 { return mix64(self as u64); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for u16 {
    fn hash(self) -> u64 { return mix64(self as u64); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for u32 {
    fn hash(self) -> u64 { return mix64(self as u64); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for u64 {
    fn hash(self) -> u64 { return mix64(self); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for bool {
    fn hash(self) -> u64 {
        if (self) { return mix64(1); }
        return mix64(0);
    }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

// `==` on `str`/`bytes` is CONTENT equality (RFC 0012 §4) — exactly the
// key equality a hash table means, and consistent with the byte-wise
// `hash`.
impl Hashable for str {
    fn hash(self) -> u64 { return fnv1a64(self.encode()); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

impl Hashable for bytes {
    fn hash(self) -> u64 { return fnv1a64(self); }
    fn hash_eq(self, other: Self) -> bool { return self == other; }
}

// ----------------------------------------------------- the core ----

// The shared open-addressing core both classes own. Module-internal —
// not `pub`: consumers meet it only through `HashMap`/`HashSet`.
//
// `hashes` records each stored key's hash: the probe's u64 pre-filter
// before the vtable `hash_eq` (most probe steps never dispatch), and
// the rehash re-slots from it — a stored key is hashed exactly once per
// lifetime. `states` is one byte per slot: 0 EMPTY · 1 FULL · 2 DEAD
// (a tombstone — the probe steps through it, insertion may reuse it).
// `cap` is a power of two, so the index mask is `cap - 1`.
class RawHashTable {
    keys: [*Hashable];
    hashes: [u64];
    states: [u8];
    count: u32;   // FULL slots
    tomb: u32;    // DEAD slots
    cap: u32;     // power of two, >= 4
}

impl RawHashTable {
    pub fn with_capacity(n: i32) -> Self {
        let mut cap: u32 = 4;
        if (n > 0) {
            let want = n as u32;
            while (cap < want) {
                cap = cap * 2;
            }
        }
        return Self {
            keys: [nil; cap as i32],
            hashes: [0u64; cap as i32],
            states: [0u8; cap as i32],
            count: 0,
            tomb: 0,
            cap: cap,
        };
    }

    // The capacity, at the i32 boundary (`len()` and indexing are i32).
    pub fn cap(self) -> i32 {
        return self.cap as i32;
    }

    // The ONE three-stage probe pass: state byte, recorded hash, then
    // the vtable `hash_eq` (only on a FULL slot whose recorded hash
    // matches). `i >= 0` — FULL match at `i`; `i < 0` — the insertion
    // slot, encoded `-(at+1)`, with DEAD reuse folded in (the first
    // DEAD slot on the sequence wins). Callers grow past the load
    // factor first, so an EMPTY slot always exists and the pass ends.
    pub fn probe(self, hk: Hashable, h: u64) -> i32 {
        let mask = (self.cap - 1) as i32;
        let mut at = ((h as u32) & (self.cap - 1)) as i32;
        let mut dead = -1;
        while (true) {
            let st = self.states[at];
            if (st == 0) {
                if (dead >= 0) {
                    return -(dead + 1);
                }
                return -(at + 1);
            }
            if (st == 1 && self.hashes[at] == h) {
                let k = *(self.keys[at]);
                if (k.hash_eq(hk)) {
                    return at;
                }
            }
            if (st == 2 && dead < 0) {
                dead = at;
            }
            at = (at + 1) & mask;
        }
    }

    // Take a slot found by `probe`: key cell, recorded hash, FULL. A
    // DEAD slot reused drops out of the tomb count.
    pub fn occupy(mut self, at: i32, hk: Hashable, h: u64) {
        if (self.states[at] == 2) {
            self.tomb -= 1;
        }
        self.states[at] = 1;
        self.keys[at] = &hk;
        self.hashes[at] = h;
        self.count += 1;
    }

    // Tombstone a FULL slot (the key cell releases with the store of
    // `nil`); the entry leaves `count` but stays on the probe path.
    pub fn mark_dead(mut self, i: i32) {
        self.keys[i] = nil;
        self.states[i] = 2;
        self.count -= 1;
        self.tomb += 1;
    }

    // The load factor: `(count + tomb + 1) / cap >= 0.7`. Widened to
    // u64 — u32 `×10` would overflow near 429M entries.
    pub fn needs_grow(self) -> bool {
        return (self.count as u64 + self.tomb as u64 + 1) * 10 >= self.cap as u64 * 7;
    }

    // Double the table and re-slot every FULL entry from its RECORDED
    // hash — no key is hashed again (that is what `hashes` is for).
    // Answers the old→new slot map (`map[old] = new`, `-1` for a slot
    // that was not FULL) so the owners relocate their parallel arrays
    // by it. `count` is unchanged; the tombstones are gone.
    pub fn rehash(mut self) -> [i32] {
        let old_keys = self.keys;
        let old_hashes = self.hashes;
        let old_states = self.states;
        let old_cap = self.cap as i32;
        let new_cap = self.cap * 2;
        self.keys = [nil; new_cap as i32];
        self.hashes = [0u64; new_cap as i32];
        self.states = [0u8; new_cap as i32];
        self.cap = new_cap;
        self.tomb = 0;
        let mut map: [i32] = [-1; old_cap];
        for (let i = 0; i < old_cap; i += 1) {
            if (old_states[i] != 1) {
                continue;
            }
            let h = old_hashes[i];
            let at = self.first_free(h);
            self.keys[at] = old_keys[i];
            self.hashes[at] = h;
            self.states[at] = 1;
            map[i] = at;
        }
        return map;
    }

    // The first EMPTY slot on `h`'s probe sequence — fresh-table
    // insertion (a new or just-rehashed table has no DEAD slots).
    pub fn first_free(self, h: u64) -> i32 {
        let mask = (self.cap - 1) as i32;
        let mut at = ((h as u32) & (self.cap - 1)) as i32;
        while (self.states[at] != 0) {
            at = (at + 1) & mask;
        }
        return at;
    }

    pub fn len(self) -> i32 {
        return self.count as i32;
    }
}

// ---------------------------------------------------- the owners ----

// `HashMap<K, V>` — a thin owner: the core plus the parallel value
// array. The admission-only bound (`K requires Hashable`, RFC 0043
// §A5) gates which instantiations compile and proves the K-value →
// `Hashable`-slot widening in the body; key ops go through the slot
// (vtable dispatch), never on bare `K`. Keys are homogeneous per map
// by construction — `hash_eq` never sees a mixed pair.
pub class HashMap<K requires Hashable, V> {
    t: RawHashTable;
    vals: [*V];   // `[nil; cap]` — nil is the empty slot's zero
}

impl HashMap<K, V> {
    pub fn new() -> Self {
        return HashMap.with_capacity(8);
    }

    pub fn with_capacity(n: i32) -> Self {
        let t = RawHashTable.with_capacity(n);
        return Self { t: t, vals: [nil; t.cap()] };
    }

    // `put` — answers `true` when the key was newly added, `false when
    // an existing key's value was replaced. Grow (re-slot the core,
    // relocate `vals` by the old→new map) comes before the probe.
    pub fn put(mut self, k: K, v: V) -> bool {
        let hk: Hashable = k;
        let h = hk.hash();
        if (self.t.needs_grow()) {
            let map = self.t.rehash();
            let mut next: [*V] = [nil; self.t.cap()];
            let n = map.len();
            for (let i = 0; i < n; i += 1) {
                let at = map[i];
                if (at >= 0) {
                    next[at] = self.vals[i];
                }
            }
            self.vals = next;
        }
        let at = self.t.probe(hk, h);
        if (at >= 0) {
            self.vals[at] = &v;
            return false;
        }
        let slot = -(at + 1);
        self.t.occupy(slot, hk, h);
        self.vals[slot] = &v;
        return true;
    }

    // `get` — `nil` = absent (RFC 0005 §10). A `(V, bool)` pair is
    // impossible without a default `V` — the pointer is the answer.
    pub fn get(self, k: K) -> *V {
        let hk: Hashable = k;
        let at = self.t.probe(hk, hk.hash());
        if (at < 0) {
            return nil;
        }
        return self.vals[at];
    }

    pub fn has(self, k: K) -> bool {
        let hk: Hashable = k;
        return self.t.probe(hk, hk.hash()) >= 0;
    }

    pub fn remove(mut self, k: K) -> bool {
        let hk: Hashable = k;
        let h = hk.hash();
        let at = self.t.probe(hk, h);
        if (at < 0) {
            return false;
        }
        self.t.mark_dead(at);
        self.vals[at] = nil;
        return true;
    }

    pub fn len(self) -> i32 {
        return self.t.len();
    }
}

// `HashSet<T>` — the core alone, zero value machinery.
pub class HashSet<T requires Hashable> {
    t: RawHashTable;
}

impl HashSet<T> {
    pub fn new() -> Self {
        return HashSet.with_capacity(8);
    }

    pub fn with_capacity(n: i32) -> Self {
        return Self { t: RawHashTable.with_capacity(n) };
    }

    // `put` — answers `true` when the element was newly added.
    pub fn put(mut self, t: T) -> bool {
        let ht: Hashable = t;
        let h = ht.hash();
        if (self.t.needs_grow()) {
            self.t.rehash();
        }
        let at = self.t.probe(ht, h);
        if (at >= 0) {
            return false;
        }
        self.t.occupy(-(at + 1), ht, h);
        return true;
    }

    pub fn has(self, t: T) -> bool {
        let ht: Hashable = t;
        return self.t.probe(ht, ht.hash()) >= 0;
    }

    pub fn remove(mut self, t: T) -> bool {
        let ht: Hashable = t;
        let at = self.t.probe(ht, ht.hash());
        if (at < 0) {
            return false;
        }
        self.t.mark_dead(at);
        return true;
    }

    pub fn len(self) -> i32 {
        return self.t.len();
    }
}
