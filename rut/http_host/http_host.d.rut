// http_host/http_host.d.rut — the std HTTP surface's host rows (the
// rut/http plan): four crossings, concrete over the crossing set
// (RFC 0023 §1). The bodies live in rut-std
// (`rut_std::http::install_std_http_with` — the fixture lane — and
// `install_std_http`, the reqwest lane); `http`'s `Response` class is
// the rut wrapper over the returned `opaque` handle.
//
// The handle: status 0 is RESERVED for transport failure (0 is never
// a real HTTP status); an HTTP status — any, 4xx/5xx included — is
// not a transport failure.
//
// The readback rows answer through the typed answer lanes (the
// legal-host-returns phase): `?str` crosses back nil-flattened (nil
// unless status 0), `bytes` as an owned copy — each answer mints a
// fresh cell the CALLER's register owns, so no claim bookkeeping
// survives on the payload side (§0.8 h's trust law is retired with
// the any lane).

pub host fn http_get(url: str) -> opaque;

pub host fn http_status(r: opaque) -> i32;   // 0 = transport error

pub host fn http_err(r: opaque) -> ?str;     // nil unless status 0

pub host fn http_body(r: opaque) -> bytes;   // the body octets
