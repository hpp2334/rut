{
  // http_host/ — the std HTTP surface's host rows (the rut/http plan):
  // a pure declaration surface organized as a MODULE TREE — `pub mod
  // net;` + `pub mod stream;` in the root, the rows in `net/mod.d.rut`
  // and `stream/mod.d.rut` beside it. The embedding Rust binds the
  // bodies (`http::pkg()` / `pkg_with`) through the pkg scope with
  // scope-relative paths (`"net::http_send"`, `"stream::http_body"`);
  // the `http` package wraps them in the Response class.
  //
  // The root surface is `mod.d.rut` beside this manifest — the default
  // root (lib parity with a body's `mod.rut`); no `entry.type` is
  // spelled. The registration scope IS the package name; the use path
  // spells the tree too (`use http_host::net::{ http_send, http_status }`).
  "format": "rutbundle",
  "format_version": 11,
  "name": "http_host",
  "type": "host"
}
