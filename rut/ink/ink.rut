// ink/ink.rut — the logger (RFC 0028).
//
// The primitives are the host functions `create_logger`/`logger_log` from
// the host module `rt` (RFC 0022/0026): the host owns the logger's
// layout, so rut only ever holds an `Opaque` handle. `Logger` is an
// ordinary rut class over that handle; a host or user may mount their own
// `ink` in its place.
use core::{ Opaque };
use rt::{ create_logger, logger_log };

pub class Logger {
    internal: Opaque;
}

impl Logger {
    pub fn new(name: str) -> Self {
        return Self { internal: create_logger(name) };
    }

    pub fn debug(self, msg: str) -> nil { logger_log(self.internal, 0, msg); }
    pub fn info(self, msg: str) -> nil { logger_log(self.internal, 1, msg); }
    pub fn warn(self, msg: str) -> nil { logger_log(self.internal, 2, msg); }
    pub fn error(self, msg: str) -> nil { logger_log(self.internal, 3, msg); }
    pub fn log(self, msg: str) -> nil { logger_log(self.internal, 1, msg); }
}
