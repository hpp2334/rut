/target
/.wrangler/
demo/node_modules
integrations/vscode-extension/node_modules
integrations/vscode-extension/out
integrations/vscode-extension/bin
integrations/vscode-extension/dist
*.vsix

# `.rut/` scratch under a workspace — the CLI walk's own
# `.rut/unpacked/` root (`.zip` deps unpack once beside the project);
# the editor no longer writes here (its dep walk is read-only and
# reads the global store); the dep store itself is global under
# `$RUT_HOME`
.rut/

# mdbook build output
docs/book/
docs/book-zh/

# the --book deploy merge output (en at root + zh under /zh/, assembled
# by scripts/deploy.cjs from the two editions above)
docs/dist-book/

# the zh edition's build-time config shim (book.toml -> ../book.zh.toml
# plus src/theme/po symlinks; created and removed by the zh build)
docs/.book-zh/

# the book's run-button artifacts (built from crates/rut-wasm, not committed;
# scripts/deploy.cjs --book and docs/wasm/ own the build+copy lane)
docs/wasm/

# the wasm-pack pkg dirs (the wasm-bindgen glue + module; npm scripts
# and CI build them with wasm-pack --target web / no-modules). The
# rut-lsp-wasm pkg ALSO carries the crate's JS face + .d.ts, installed by
# crates/rut-lsp-wasm/scripts/build-lsp-pkg.mjs after wasm-pack
crates/rut-wasm/pkg/
crates/rut-wasm/pkg-book/
crates/rut-lsp-wasm/pkg/
__pycache__/
