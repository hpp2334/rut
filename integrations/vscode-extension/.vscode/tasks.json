{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "esbuild",
          "pattern": { "regexp": "^\\s*$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\s*$",
            "endsPattern": "^\\s*$"
          }
        }
      ]
    }
  ]
}
