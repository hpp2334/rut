{
  "name": "rut-vscode",
  "displayName": "rut",
  "description": "rut language support — semantic tokens, diagnostics, document symbols, hover, completions and go-to-definition via an in-process wasm module (no server process)",
  "version": "0.2.1",
  "publisher": "rut",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hpp2334/rut.git",
    "directory": "integrations/vscode-extension"
  },
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:rut"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rut",
        "aliases": [
          "rut"
        ],
        "extensions": [
          ".rut"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rut",
        "scopeName": "source.rut",
        "path": "./syntaxes/rut.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "rut",
        "scopes": {
          "keyword": [
            "keyword.other"
          ],
          "number": [
            "constant.numeric"
          ],
          "string": [
            "string"
          ],
          "type": [
            "entity.name.type"
          ],
          "function": [
            "entity.name.function"
          ],
          "method": [
            "entity.name.function.member"
          ],
          "variable": [
            "variable.other"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "property": [
            "variable.other.property"
          ],
          "enum": [
            "entity.name.type.enum"
          ],
          "enumMember": [
            "variable.other.enummember"
          ],
          "class": [
            "entity.name.type.class"
          ],
          "trait": [
            "entity.name.type.trait"
          ],
          "operator": [
            "keyword.operator"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build:wasm": "cargo build -p rut-lsp-wasm --target wasm32-unknown-unknown --release && node scripts/copy-wasm.mjs",
    "test": "npm run test:grammar && npm run compile && npm run test:e2e && npm run test:host",
    "test:grammar": "node test/grammar-corpus.js",
    "test:e2e": "node test/e2e-wasm.js",
    "test:host": "node scripts/run-vscode-test.mjs",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
